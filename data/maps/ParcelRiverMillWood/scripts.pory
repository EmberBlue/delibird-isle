script ParcelRiverMillWood_Jens {
    trainerbattle_single(TRAINER_SKALD_MWD_JENS,
        format("JENS: Camped a week. Seen a KECLEON twice, maybe. Maybe once. Battle while I think."),
        format("JENS: Twice. Definitely twice."),
        ParcelRiverMillWood_Jens_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_MWD_JENS_R2)) {
        goto(ParcelRiverMillWood_Jens_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_MWD_JENS_R3)) {
        goto(ParcelRiverMillWood_Jens_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_MWD_JENS_R4)) {
        goto(ParcelRiverMillWood_Jens_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_MWD_JENS_R5)) {
        goto(ParcelRiverMillWood_Jens_R5)
    }
    msgbox(format("JENS: The wood has more in it than the mill book says. The book only counts what sells."), MSGBOX_DEFAULT)
    end
}
