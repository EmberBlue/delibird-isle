// ParcelRiverMillWood -- the Elvsund mill wood: the coppice that fed the mill race, west of the
// river town (Petalburg Woods). Eight trainers, a sawyer, two signs; in and out by the
// south-east track from Elvsund's west edge (0,28-29).

mapscripts ParcelRiverMillWood_MapScripts {
}

script ParcelRiverMillWood_Halle {
    trainerbattle_single(TRAINER_SKALD_MWD_HALLE,
        format("HALLE: This stand is twelve years old. The beetles know it to the week. Battle!"),
        format("HALLE: To the week."),
        ParcelRiverMillWood_Halle_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_MWD_HALLE_R2)) {
        goto(ParcelRiverMillWood_Halle_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_MWD_HALLE_R3)) {
        goto(ParcelRiverMillWood_Halle_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_MWD_HALLE_R4)) {
        goto(ParcelRiverMillWood_Halle_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_MWD_HALLE_R5)) {
        goto(ParcelRiverMillWood_Halle_R5)
    }
    msgbox(format("HALLE: Cut on a round and the wood never runs out. Cut it all once and you get one winter."), MSGBOX_DEFAULT)
    end
}
script ParcelRiverMillWood_Halle_FirstWin {
    msgbox(format("HALLE: Cut on a round and the wood never runs out. Cut it all once and you get one winter."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_Halle_R2 {
    lock
    faceplayer
    msgbox(format("HALLE: Back this way? I've not been idle. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HALLE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_MWD_HALLE_R2, format("HALLE: Still yours."))
    msgbox(format("HALLE: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_Halle_R3 {
    lock
    faceplayer
    msgbox(format("HALLE: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HALLE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_MWD_HALLE_R3, format("HALLE: Noted. Properly, this time."))
    msgbox(format("HALLE: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_Halle_R4 {
    lock
    faceplayer
    msgbox(format("HALLE: Nearly the top, they say. Not past me. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HALLE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_MWD_HALLE_R4, format("HALLE: …Fair."))
    msgbox(format("HALLE: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_Halle_R5 {
    lock
    faceplayer
    msgbox(format("HALLE: The region's different now. Let's see if you are?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HALLE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_MWD_HALLE_R5, format("HALLE: That's the one I wanted to see."))
    msgbox(format("HALLE: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_Petter {
    trainerbattle_single(TRAINER_SKALD_MWD_PETTER,
        format("PETTER: NINCADA under every stump. I count them for the mill book. Don't step on the stumps. Fight!"),
        format("PETTER: You stepped round them. Good."),
        ParcelRiverMillWood_Petter_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_MWD_PETTER_R2)) {
        goto(ParcelRiverMillWood_Petter_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_MWD_PETTER_R3)) {
        goto(ParcelRiverMillWood_Petter_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_MWD_PETTER_R4)) {
        goto(ParcelRiverMillWood_Petter_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_MWD_PETTER_R5)) {
        goto(ParcelRiverMillWood_Petter_R5)
    }
    msgbox(format("PETTER: The mill book has columns for timber and columns for bugs. The bugs are the only column that's gone up."), MSGBOX_DEFAULT)
    end
}
