script ParcelRiverMillWood_Sawyer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_PLANK_DONE)) {
        msgbox(format("SAWYER: Five stands on the Board's paper became two, and the two are mine to leave standing.\pThe hill farmer's boat is in the water. I went and knocked on the keel. Still sound."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PLANK) && !flag(FLAG_SKALD_Q_PLANK_HAVE)) {
        msgbox(format("SAWYER: A keel plank for a hill farmer's boat. Hm.\pThe Board's paper wants five stands. This plank came off the one stand I'd cut anyway, twelve winters ago, and it's been drying under the eaves since. It's the only seasoned timber in the valley that isn't on a Board invoice."), MSGBOX_DEFAULT)
        msgbox(format("SAWYER: Take it to him. Tell him it's the last of the old round. He'll know what that means for the next one."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_PLANK_HAVE)
        msgbox(format("You shoulder the plank. It smells of a summer that happened before you were born."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SAWYER: The Board's paper says one stand a year again. The wood's paper agrees for once. I read both. The race ran an hour last week. The miller stood in it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("SAWYER: The Board's paper said three stands. Then HAUKFELL's ground went and the Board's paper said five -- timber for the warming centre, for the relocation houses.\pGood cause. The wood's paper still says one. I'm cutting two and not sleeping."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SAWYER: Coppice wood. Twelve-year round, one stand a year, and the mill never wanted for timber in forty years.\pThe Board's paper says take three stands this year. The wood's paper says no. I read the wood's."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverMillWood_SignEdge {
    msgbox(format("ELVSUND MILL WOOD. Coppice cut on a twelve-year round.\pTake what fell. Leave what stands."), MSGBOX_SIGN)
    end
}
script ParcelRiverMillWood_SignRace {
    msgbox(format("The mill race starts here. The wheel has been still since the Board metered the water."), MSGBOX_SIGN)
    end
}
script ParcelRiverMillWood_ItemGreatBall { finditem(ITEM_GREAT_BALL) end }
script ParcelRiverMillWood_ItemEther { finditem(ITEM_ETHER) end }
script ParcelRiverMillWood_ItemParalyzeHeal { finditem(ITEM_PARALYZE_HEAL) end }
script ParcelRiverMillWood_DeadEndNorth {
    msgbox(format("The track runs out in brush. Nobody has cut it since the mill slowed."), MSGBOX_SIGN)
    end
}
script ParcelRiverMillWood_DeadEndSouth {
    msgbox(format("The old race track. Grown over to the knee. The water it fed doesn't come this way now."), MSGBOX_SIGN)
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelRiverMillWood_PairCoppice {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOODCUTTER: The race has water in it. First time since you started."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: The Board let it through?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: The Board publishes two columns and can't explain the second one, so it lets water through to make the numbers quieter. Same wheel either way. Turn it."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("APPRENTICE: The ranger counted the stools. All of them. Took the whole afternoon."), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: And?"), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: Said a coppice is the only place in the region where the count's supposed to go down and come back. Wrote that in the notebook and underlined it."), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: …Fetch the saw. We've a stand to cut while someone's watching how it's done."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("WOODCUTTER: You cut the stand to the stool and the stool sends up twenty poles. Twelve years later you cut again. Your grandfather's stools, my cuts."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: And the trees don't mind?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: The trees have been doing this with us for a thousand years. It's the only thing in this wood that's getting older on purpose."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: Why does the race run dry, then?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: That's not the wood. That's the Board."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelRiverMillWood_Board1 {
    msgbox(format("A SURVEY BOARD at the mill wood gate. Second growth, planted after the mill cut the first. The NINCADA husks are counted on the trunks in the first week of summer; the week comes earlier and the husks come fewer.\pThe board shows both lines. They cross the year the children now in the school were born."), MSGBOX_SIGN)
    end
}

script ParcelRiverMillWood_Board2 {
    msgbox(format("A SURVEY BOARD on a stump wide enough to sit on. The stump is the count: the rings were marked with a nail every fifty years by someone with time. The last nail is in the bark.\pThe Survey added the SEEDOT count underneath, because a wood that drops seed is a wood that is still trying."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round four ---

script ParcelRiverMillWood_PairStump {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOODCUTTER: Two stands, not five. The Board's paper came back with three crossed out."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Which two?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: The two without husks. Someone read the count. Someone always does, eventually. It's the eventually that costs."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: The ranger counted the husks with me. Forty. She wrote the week."), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: The week matters more than the forty."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Why?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: Because forty's a lot and the week's early, and only one of those is good news."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("WOODCUTTER: Five stands marked for the Board. Five."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Which five?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: The five with the NINCADA on them. Of course. The paper doesn't know what a husk is."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Can I keep the husks?"), MSGBOX_DEFAULT)
        msgbox(format("WOODCUTTER: Count them first. Then keep them."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards, round two (2026-11-10) ---

script ParcelRiverMillWood_Board3 {
    msgbox(format("A SURVEY BOARD in the second growth. SHROOMISH under the planted spruce and none under the old oak stump.\pThe board explains in one line: planted wood holds the damp, cut ground does not, and a SHROOMISH knows the difference before the soil scientist does."), MSGBOX_SIGN)
    end
}

// --- survey boards, round five (2026-11-10) ---

script ParcelRiverMillWood_Board10 {
    msgbox(format("A SURVEY BOARD by the charcoal clamp. Burners worked this wood for two hundred years and left the clamps as rings of black earth. SHROOMISH grow on the rings and nowhere else nearby.\pThe board explains: the burners fed the soil by accident for two centuries. The Board's planted spruce feed nothing."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round six ---

script ParcelRiverMillWood_PairRide {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FORESTER: Two stands, marked, standing. The paper came back agreeing with us."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: Because of the count?"), MSGBOX_DEFAULT)
        msgbox(format("FORESTER: Because of the week. Forty husks is a lot of husks. An early week is a wood in trouble. The Board can read trouble when it's underlined."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("APPRENTICE: The ranger walked every ride. Counted husks on every trunk."), MSGBOX_DEFAULT)
        msgbox(format("FORESTER: Every trunk?"), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: Every trunk. It took two days. She wrote forty, and the week, and underlined the week."), MSGBOX_DEFAULT)
        msgbox(format("FORESTER: Then she knows more about this wood than the Board does. Good. Somebody should."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("FORESTER: Mark the two with no husks on them."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: For felling?"), MSGBOX_DEFAULT)
        msgbox(format("FORESTER: For the Board's paper. The Board wants five. We'll give it the two the NINCADA don't want either."), MSGBOX_DEFAULT)
        msgbox(format("APPRENTICE: Will they take two?"), MSGBOX_DEFAULT)
        msgbox(format("FORESTER: They'll take what's marked. Nobody from the Board has ever walked a ride."), MSGBOX_DEFAULT)
    }
    release
    end
}
