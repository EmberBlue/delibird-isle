    msgbox(format("FOLKE: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("FOLKE: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_MWD_FOLKE_R2, format("FOLKE: Still yours."))
    msgbox(format("FOLKE: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
