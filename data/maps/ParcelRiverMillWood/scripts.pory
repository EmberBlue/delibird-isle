script ParcelRiverMillWood_Folke {
    trainerbattle_single(TRAINER_SKALD_MWD_FOLKE,
        format("FOLKE: Marking the next cut. Orange paint stays, blue goes. Don't lean on the orange ones. Fight."),
        format("FOLKE: Orange ones held."),
        ParcelRiverMillWood_Folke_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_MWD_FOLKE_R2)) {
