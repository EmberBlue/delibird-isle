// ParcelHighlandsHouse2 -- a house in Highlands: residents in two story states (before / after the hearing).

mapscripts ParcelHighlandsHouse2_MapScripts {
}

script ParcelHighlandsHouse2_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: He's on the cap crew. Full wage, reading a gauge that says nothing. He sleeps.\pI'd pay for that out of my own wage if they stopped."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The bore's capped. He's on half wage pending survey. He sleeps at night now. I'll take the half."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: He's been sent to the coast for a month. 'Marine survey.' Same crew, same drill, different water.\pI know which of us he'd keep. I'm less sure which of us is keeping him."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Bore crew's wife. He's paid by MEREHOLT and fed by me, and I know which of us he'd keep."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelHighlandsHouse2_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("BOY: Dad reads the cap now. He says the hill under it says nothing, and nothing is what you want a hill to say.\pI asked what the sea said. He said: later."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: The ranger found the tarn under the hill. Dad says he knew. I asked why he didn't say. He said that's the whole question, son."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("BOY: Dad's drilling the sea now! He says the water under the sea is older than the water under the hill.\pI asked if it's older than Grandad. He said everything is. Grandad didn't laugh that time."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: Dad says the hill's full of water that's older than the town. I asked if it's older than Grandad. He said older than everything."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelHighlandsHouse2_ReadDresser {
    msgbox(format("A bore crew payslip on the dresser, and under it a bill for the same amount from the valley store. The two have been laid together on purpose."), MSGBOX_SIGN)
    end
}

script ParcelHighlandsHouse2_ReadShelf {
    msgbox(format("A geology primer with a child's bookmark in it: a strip of core-sample tape. The page is about ice."), MSGBOX_SIGN)
    end
}

script ParcelHighlandsHouse2_ReadPantry {
    msgbox(format("Jars of preserved bilberries, dated. The dates stop two summers ago. The slope where they grew is in the valley now."), MSGBOX_SIGN)
    end
}
