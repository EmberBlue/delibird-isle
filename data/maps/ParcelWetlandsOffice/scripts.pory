// ParcelWetlandsOffice -- the Mereholt Tidewater Division gauging office at
// Reedmere (the Weather Institute building, reused). The polite face of the
// development Dorsey keeps hinting at.

mapscripts ParcelWetlandsOffice_MapScripts {
}

script ParcelWetlandsOffice_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("CLERK: The office is open. The councilman isn't in it. A Board monitor comes Tuesdays and posts the channel readings in the window.\pPeople stop and read a number. I didn't know people did that."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: The councilman is here. He's in the back room with a man from the Board and a monitoring schedule. I've been told to say the office is open. It is. That's new."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("CLERK: The councilman is in the basin, I'm told. Then the river. Then the coast. He's everywhere except here.\pThe office is operating normally. I've said that so often the words have stopped meaning anything. That's probably normal too."), MSGBOX_DEFAULT)
        release
        end
    }
    if (defeated(TRAINER_SKALD_ENFORCER)) {
        msgbox(format("CLERK: The councilman isn't here. The councilman isn't anywhere, apparently.\pI've been told to say the office is operating normally. The office is operating normally."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Welcome to the TIDEWATER DIVISION. We gauge every channel on the backwater, hourly.\pFlow, depth, turbidity. It's all public. Well. It's all filed."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsOffice_Tech {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("TECHNICIAN: Both sets of gauges, posted monthly, side by side. The old ones still miss things.\pWe leave them up so you can see what missing looks like."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("TECHNICIAN: The gauges picked it up this time. The new ones. The old ones were set to miss it; the hearing said so in better words. I've recalibrated. I sleep now."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("TECHNICIAN: I pulled the gauge logs for the week of the kill. Flat. Then I pulled the river Board's logs, because they're public now, and theirs aren't flat.\pSame make of gauge. Different water, or different hands. I've put in for a transfer to find out which."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH1_EVIDENCE)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("TECHNICIAN: The gauges didn't pick up anything. Nothing. A kill like that and the numbers are flat.\pEither the gauges are wrong or the gauges are where the water isn't."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("TECHNICIAN: Four gauges on the channels and one on the falls. Hourly. The readings go to the coast office.\pNo, I don't see them after that."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsOffice_Rep {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MEREHOLT REP: The FOUNDATION has revised the partnership page again. It's shorter. I wrote the short one.\pI'd like that noted somewhere it will be read."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MEREHOLT REP: The FOUNDATION believes in partnership. We've a new partnership page: local hands, local jobs, local water, and a local monitor who isn't ours. I'm reading it aloud to people. It's a start."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MEREHOLT REP: The FOUNDATION welcomes the river community's engagement. Partnership is a process.\pWe have revised the brochure. The new one has fewer numbers in it. Do take one."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MEREHOLT REP: The FOUNDATION believes in partnership. Local hands, local jobs, local water.\pYou'll find we have nothing to hide here, RANGER. Nothing at all. Do have a brochure."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsOffice_Local {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("FISHER: Boat's mine, loan's the review's, catch is small and it's mine too. I waited an hour for the wrong man for years.\pI'm done waiting. I'm out at five."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: The boat loan came through. Not from the councilman. From a fund the review set up. I waited an hour for the wrong man for a year. The right one was a form."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("FISHER: Still waiting on the boat loan. The councilman's at the river, they say, explaining a sheet of numbers to people who can read.\pI can read. I'm just not on the sheet. Yet."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: I came to ask about the boat loan. Been waiting an hour.\pThe councilman said to ask. The councilman isn't the one at the desk."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsOffice_ReadBinders {
    msgbox(format("Binders: CHANNEL GAUGE READINGS, by month. Every one the same thickness. Flat numbers take up as much room as the other kind."), MSGBOX_SIGN)
    end
}

script ParcelWetlandsOffice_ReadTerminal {
    msgbox(format("A terminal. Four channel gauges and one on the falls, all reading NORMAL.\pThe fifth gauge is drawn on the screen in a place the falls are not."), MSGBOX_SIGN)
    end
}

script ParcelWetlandsOffice_ReadGaugeDesk {
    msgbox(format("The gauge desk. Under the blotter, the corner of a hand-drawn map: where the gauges are, and in red, where the water actually goes."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelWetlandsOffice_Programme {
    msgbox(format("The programme from the office's opening, framed. TIDEWATER MONITORING OFFICE, A COMMUNITY PARTNERSHIP.\pTen o'clock, the ribbon. Commissioner Dorsey. Ten fifteen, remarks: the Foundation's programme officer. Ten thirty, the gauges explained: a technician. Eleven, refreshments, courtesy of Mereholt Coastal.\pA drawing of the five gauges on the back. Four of them stand where the gauges stand. The fifth is drawn at the falls.\pThere are no falls on this river. There were, once, before the sluice. The artist worked from the Board's old map, and nobody at the ribbon noticed."), MSGBOX_SIGN)
}

// --- notices (2026-11-10) ---

script ParcelWetlandsOffice_Notice {
    msgbox(format("A notice in the office window, the Board's, typed: CHANNEL READINGS POSTED TUESDAYS.\pUnder it, pencilled, a column of readings somebody has copied off the Tuesday sheets week by week, so that the whole year can be read at once, which the Board's sheet, one week at a time, never allowed."), MSGBOX_SIGN)
    end
}
