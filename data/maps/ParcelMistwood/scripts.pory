script ParcelMistwood_T_Selma {
    trainerbattle_single(TRAINER_SKALD_MW_SELMA,
        format("SELMA: The deadfall blocks the north corridor. I've waited two days for someone with CUT. Battle while we wait?"),
        format("SELMA: You've got CUT, haven't you. Go on, then."),
        ParcelMistwood_T_Selma_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_MW_SELMA_R2)) {
        goto(ParcelMistwood_T_Selma_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_MW_SELMA_R3)) {
        goto(ParcelMistwood_T_Selma_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_MW_SELMA_R4)) {
        goto(ParcelMistwood_T_Selma_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_MW_SELMA_R5)) {
        goto(ParcelMistwood_T_Selma_R5)
    }
    msgbox(format("SELMA: FERNWICK's past the deadfall. Big town. CORPS station. The HALL where TARN fails everybody."), MSGBOX_DEFAULT)
    end
}
