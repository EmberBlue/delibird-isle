mapscripts ParcelCoastHouse3_MapScripts {
}
script ParcelCoastHouse3_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: The exact day the numbers started going down: I gave it to the hearing. The date, the ledger page, the signature under it. It wasn't mine. It wasn't HOLLIS's either. It was above both of us."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("CLERK: I file the catch logs. I know the day the numbers turned. Today a survey came in that knows the same day, from the fish's side of it.\pI still like my flat. I've started keeping a copy, though. Of the day."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: I file the catch logs at the coast office. I could tell you the exact day the numbers started going down. I won't. I like my flat. It has a view of the harbour."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastHouse3_ReadDresser {
    msgbox(format("A view of the harbour, framed, on the dresser. The frame is better than the photograph. The photograph is older than the flat."), MSGBOX_SIGN)
    end
}

script ParcelCoastHouse3_ReadDrawer {
    msgbox(format("A locked drawer. Behind the lock, by the shape of it, a ledger.\pThe clerk said she wouldn't tell you the day. The drawer knows it."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelCoastHouse3_PaperLease {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The lease for the flat, still framed. The rent went up the month after the sitting, by a figure that is not an accident.\pHe stayed. He has started keeping a copy of the day the numbers turned in the frame behind the lease, where the landlord's agent will not think to look."), MSGBOX_SIGN)
    } else {
        msgbox(format("The lease for the flat, framed, which tells you something. HARBOUR VIEW, FURNISHED. The landlord is a company with a quay address and a parent you have seen the kerning of.\pThe rent is low for the view. The clerk knows exactly how low, and files the catch logs accordingly."), MSGBOX_SIGN)
    }
    end
}
