// ParcelFloodbasinHouse2 -- a Leirvik family (the fisher outside is the husband).
mapscripts ParcelFloodbasinHouse2_MapScripts {
}
script ParcelFloodbasinHouse2_Wife {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: Third flood, and the Board man says the fourth comes slower with the sluice. The water line's on the wall. I'm leaving it. If the fourth comes, I want to measure him against it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: We signed the sheet. Then the river people stood up and didn't sign anything, and got their numbers read out instead.\pI've been thinking about which of us got the better deal. The water line's still a hand higher. The thinking's new."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Third flood this one. The water line's on the wall there, see. Every year a hand higher.\pWe signed the councilman's sheet. You sign the sheet, you get the vouchers. That's how it works now."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinHouse2_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: The WOOPER with the wrong feet is famous now! A lady drew it! It still doesn't go anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: The WOOPER's still there! A ranger from the river drew a picture of its feet and said the word 'specimen'.\pI don't know what that is, but she said it like it was important. The WOOPER didn't mind."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: I found a WOOPER with the wrong feet! Gran made me put it back in the puddle. It's still there. It doesn't go anywhere."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFloodbasinHouse2_ReadDresser {
    msgbox(format("The water line on the wall runs behind the dresser. Somebody has written the year beside each line in pencil. Three lines.\pThe pencil is kept on the dresser."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasinHouse2_ReadDrawer {
    msgbox(format("A drawer of relief vouchers, unspent, in rubber bands.\pSigning gets you the vouchers. Nobody said you had to use them."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelFloodbasinHouse2_PaperReliefSheet {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A carbon of the relief sheet, and under it now a second carbon, of the river people's petition, with forty-one names she has read so often she knows them in order.\pShe did not sign the petition. She has written on the back of her copy: next time."), MSGBOX_SIGN)
    } else {
        msgbox(format("A carbon of the relief sheet they signed, kept flat under the bread board. Blankets, two. Oil, one. Vouchers, two. CAUSE OF NEED: FLOOD. Signed, countersigned, stamped.\pThe woman keeps it because she was told to keep it. She does not know what for. Neither did the aide."), MSGBOX_SIGN)
    }
    end
}
