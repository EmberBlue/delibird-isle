// ParcelRiverBoard -- the Elvsund Water Board office (a Mereholt Foundation
// partnership). SLUICE audits here: gym 4, the Sluice clearance, HM04.

const LOCALID_RB_SLUICE = 1

mapscripts ParcelRiverBoard_MapScripts {
}

script ParcelRiverBoard_Sluice {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelRiverBoard_Sluice_Rematch)
    }
    if (flag(FLAG_BADGE04_GET)) {
        if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
            msgbox(format("SLUICE: STRESSED. I read your filing. I'd have rated it the same, and I'd have been overruled.\pYou weren't. Interesting."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("SLUICE: Mind the cut upstream. The Board rated it an improvement. I metered it. The water disagrees with the rating."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SLUICE: Sluice Division. Every drop that crosses this spine is metered, rated, and accounted to someone.\pYou want clearance to work this watershed? Show me you read a ledger as well as a current."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_GYM4, format("SLUICE: …Balanced. Down to the drop. The crossing's yours."))
    setflag(FLAG_BADGE04_GET)
    call(Common_EventScript_PlayGymBadgeFanfare)
    msgbox(format("SLUICE: That's your Sluice clearance. Line item 04. It certifies you fit to move what the river leaves in the way. Signed, sealed, on the ledger."), MSGBOX_DEFAULT)
    giveitem(ITEM_HM04)
    msgbox(format("SLUICE: STRENGTH. Shoulders a boulder out of a channel where it has no business sitting.\pThe river drops plenty of those. So does the Board."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverBoard_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Allocations reposted with six names under them. Objections reopened. The Phase 2 file came off the shelf and into the hearing. You can read it now. Everyone can. Nobody asks."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Allocations are posted. Objections are closed. The councilman's Phase 2 file is on the shelf and no, you can't read it. Ratepayers only. You're not a ratepayer."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Ratepayer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Plot nine. Metered, still. The rate came down a page. I pay for water that used to be free and now it's cheaper. I'm told that's a win. I'm trying to feel it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Plot nine. Metered since spring. I pay for water that used to run past my gate for nothing.\pThe FOUNDATION says the meters are fair. The FOUNDATION sells the meters."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Meterman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("METER READER: Fourteen plots, fourteen meters, hourly, and the readings go to SLUICE first now, not the coast office. She reads them herself. She's a slow reader. Deliberately."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("METER READER: Fourteen plots, fourteen meters, hourly. The readings go to the coast office. SLUICE keeps a copy. She's not supposed to. Don't tell her I said."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Ledger {
    msgbox(format("THE ALLOCATION LEDGER. Plots 1-14, metered flow, rates. A column headed PHASE 2 -- UPSTREAM RESERVE. The reserve is the clean reach, allocated in full. To the Foundation."), MSGBOX_SIGN)
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelRiverBoard_Sluice_Rematch {
    lock
    faceplayer
    msgbox(format("SLUICE: The hearing rated your filing. I metered it. For once the rating and the meter agree.\pI'd like a balance read at full flow. No clearance on the end of it. Will you?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SLUICE: Noted. The ledger keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM4_R, format("SLUICE: …Balanced. Down to the drop, again."))
    msgbox(format("SLUICE: Come back when the gauge moves. It will."), MSGBOX_DEFAULT)
    release
    end
}
