// ParcelRiverBoard -- the Elvsund Water Board office (a Mereholt Foundation
// partnership). SLUICE audits here: gym 4, the Sluice clearance, HM04.

const LOCALID_RB_SLUICE = 1

mapscripts ParcelRiverBoard_MapScripts {
}

script ParcelRiverBoard_Sluice {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelRiverBoard_Sluice_Rematch)
    }
    if (flag(FLAG_BADGE04_GET)) {
        if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
            msgbox(format("SLUICE: STRESSED. I read your filing. I'd have rated it the same, and I'd have been overruled.\pYou weren't. Interesting."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("SLUICE: Mind the cut upstream. The Board rated it an improvement. I metered it. The water disagrees with the rating."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SLUICE: Sluice Division. Every drop that crosses this spine is metered, rated, and accounted to someone.\pYou want clearance to work this watershed? Show me you read a ledger as well as a current."), MSGBOX_DEFAULT)
    msgbox(format("SLUICE: A ledger question first. The gauge at the ford reads NORMAL. Does that mean the river is normal?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("SLUICE: The gauge is normal. The river is two hands under the gauge. They moved the mark to a new datum and kept the word.\pRead the book, not the stamp. The stamp is what they pay for."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("SLUICE: No. The gauge is normal. The river is two hands under it. The mark moved and the water didn't.\pYou read the book, not the stamp. Good. It's the only free reading in this office."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_EXAM_4)
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM4, format("SLUICE: …Balanced. Down to the drop. The crossing's yours."))
    setflag(FLAG_BADGE04_GET)
    call(Common_EventScript_PlayGymBadgeFanfare)
    msgbox(format("SLUICE: That's your Sluice clearance. Line item 04. It certifies you fit to move what the river leaves in the way. Signed, sealed, on the ledger."), MSGBOX_DEFAULT)
    giveitem(ITEM_HM04)
    msgbox(format("SLUICE: STRENGTH. Shoulders a boulder out of a channel where it has no business sitting.\pThe river drops plenty of those. So does the Board."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverBoard_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("CLERK: Allocations posted, names under them, objections open the first of every month. I keep the Phase 2 file on the counter now.\pAnyone can read it. Almost nobody does. The point is the almost."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Allocations reposted with six names under them. Objections reopened. The Phase 2 file came off the shelf and into the hearing. You can read it now. Everyone can. Nobody asks."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("CLERK: Allocations are posted. The Phase 2 file has gone to the coast office 'for review'. You still can't read it. Nobody can; it's on a truck.\pThe HAUKFELL relocation forms are on the shelf where it was. Ratepayers only. There are fewer ratepayers."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Allocations are posted. Objections are closed. The councilman's Phase 2 file is on the shelf and no, you can't read it. Ratepayers only. You're not a ratepayer."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Ratepayer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: Plot nine. Metered. Cheaper. The bore crew's wife has moved to the valley.\pI pay for water off a hill nobody's drilling. It's the best bill I've had."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Plot nine. Metered, still. The rate came down a page. I pay for water that used to be free and now it's cheaper. I'm told that's a win. I'm trying to feel it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("MAN: Plot nine. Metered. And now the bore crew's wife is at the counter paying for water off a hill that's melting into the river.\pThe FOUNDATION sells the meters and drills the hill. I'd admire it if I weren't paying for both."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Plot nine. Metered since spring. I pay for water that used to run past my gate for nothing.\pThe FOUNDATION says the meters are fair. The FOUNDATION sells the meters."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Meterman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("METER READER: Fourteen plots, fourteen meters, and the readings go to SLUICE and then to the window. People read them.\pI used to think I was the only one who read a meter."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("METER READER: Fourteen plots, fourteen meters, hourly, and the readings go to SLUICE first now, not the coast office. She reads them herself. She's a slow reader. Deliberately."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("METER READER: Readings went up this month. All fourteen. SLUICE says it's meltwater off the high ground. The coast office says it's seasonal.\pThe ledger doesn't say anything. It just balances, and it balanced higher."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("METER READER: Fourteen plots, fourteen meters, hourly. The readings go to the coast office. SLUICE keeps a copy. She's not supposed to. Don't tell her I said."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoard_Ledger {
    msgbox(format("THE ALLOCATION LEDGER. Plots 1-14, metered flow, rates. A column headed PHASE 2 -- UPSTREAM RESERVE. The reserve is the clean reach, allocated in full. To the Foundation."), MSGBOX_SIGN)
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelRiverBoard_Sluice_Rematch {
    lock
    faceplayer
    msgbox(format("SLUICE: The hearing rated your filing. I metered it. For once the rating and the meter agree.\pI'd like a balance read at full flow. No clearance on the end of it. Will you?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SLUICE: Noted. The ledger keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM4_R, format("SLUICE: …Balanced. Down to the drop, again."))
    msgbox(format("SLUICE: Come back when the gauge moves. It will."), MSGBOX_DEFAULT)
    release
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelRiverBoard_GaugeBook {
    msgbox(format("The gauge book, open on the counter. One line a week, in different hands, for a long time.\pThe early pages are wet. Spring readings over the top mark, the word FLOOD in the margin twice a year, a note that the ford was impassable from thaw to midsummer.\pThe middle pages are the book the Board quotes. The gauge reads NORMAL for eleven years running. The hand is the same hand all the way through, neat, unhurried.\pThe last pages are dry. Two hands below the mark. Three. A week with no reading and a note: gauge out of water, reset to new datum.\pNORMAL was never crossed out. They moved the mark."), MSGBOX_SIGN)
    if (flag(FLAG_SKALD_Q_BOOK)) {
        setflag(FLAG_SKALD_Q_BOOK_FOUND)
    }
}

// --- books, round two (2026-11-10) ---

script ParcelRiverBoard_Allocations {
    msgbox(format("The Board's ledger of allocations, chained to the shelf like the gauge book. Who may take how much from the Elvsund, by year, in the clerk's hand.\pThe early pages are short. Mills: two. Farms: eleven, a rod each. The town: drinking and the wash-house. The river: the rest, unwritten, because nobody thought to write what was not taken."), MSGBOX_SIGN)
    msgbox(format("The middle pages lengthen. Farms: thirty, and the rods become pipes. Mereholt Logistics, for the depot: a figure. Mereholt Coastal, for the cold store: a figure. Irrigation improvement scheme, Foundation grant: the largest figure on the page, in a different ink.\pThe last pages are the sum. Allocations exceed the mean summer flow in seven of the last ten years. The clerk has written the gauge's figure beside the total and drawn no line between them. Nobody has asked the clerk to."), MSGBOX_SIGN)
    msgbox(format("On the inside cover, newest, the Board's stamp and SLUICE's initial: When the sum is larger than the river, the river decides. It has started deciding."), MSGBOX_SIGN)
    end
}

// --- side quests, round five (2026-11-10) ---

script ParcelRiverBoard_FindDrawer {
    if (flag(FLAG_SKALD_Q_LABEL) && !flag(FLAG_SKALD_Q_LABEL_FOUND)) {
        msgbox(format("The bottom drawer behind the Board's counter, a card in a brass holder: CORRESPONDENCE, PUBLIC, ANECDOTAL. Inside, a shoebox, and in the shoebox forty years of a fisherman's notes, dated, depths in a hand that got shakier and never got less exact.\pSomeone has crossed out ANECDOTAL on the card in pencil and written nothing in its place yet."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_LABEL_FOUND)
    } else {
        msgbox(format("The bottom drawer. CORRESPONDENCE, PUBLIC, and a word crossed out. The shoebox is still inside."), MSGBOX_SIGN)
    }
    end
}
