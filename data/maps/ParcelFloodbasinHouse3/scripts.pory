// ParcelFloodbasinHouse3 -- a house in Floodbasin: residents in two story states (before / after the hearing).

mapscripts ParcelFloodbasinHouse3_MapScripts {
}

script ParcelFloodbasinHouse3_OldWoman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("OLD WOMAN: No third line. The sheds are dry and so's my door. I keep the pencil mark. The day the hall voted.\pPencil's enough for a day that didn't flood."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD WOMAN: Phase 2 goes ahead. Dry sheds. My door frame gets a third line or it doesn't. The paper says it doesn't. The paper wasn't here in '09."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD WOMAN: Two water lines on the door frame, and now a third mark, in pencil: the day the river hall voted against Phase 2.\pNo water that day. I marked it anyway. Some lines you make on purpose."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD WOMAN: The pulse came through this house twice. Once in '09, once the spring you came. Both water lines are on the door frame. Look."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFloodbasinHouse3_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: Still got the blanket. Still warm. DORSEY shook my hand last month. I let him.\pA blanket's a blanket and a hand's a hand."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: I kept the blanket. MEREHOLT on it. It's warm. I'm not giving back a warm blanket to make a point."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: DORSEY came back from the river and didn't shake anybody's hand. First time I've seen him not.\pHe stood where the sandbags were and looked at the bridge a long while. Good handshake, that man. I'd still take it. I'd think first now."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: We stacked the sandbags where the photographer stood. DORSEY shook my hand in front of the camera. It was a good handshake. I'll give him that."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFloodbasinHouse3_ReadDresser {
    msgbox(format("A newspaper photograph on the dresser: a councilman shaking a man's hand in front of sandbags. The man in the photograph lives here.\pHe has not cut it out. He has not thrown it away."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasinHouse3_ReadDrawer {
    msgbox(format("The top drawer sticks. It has stuck since the second flood. Everything in this house has a before and an after."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelFloodbasinHouse3_PaperInsurance {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The insurer's letter, and clipped to it a new one: the policy will cover flood from the next renewal, at a premium the letter does not give.\pThe old woman has written on the card under the water lines: they found a word for it once somebody else did."), MSGBOX_SIGN)
    } else {
        msgbox(format("A letter from the insurer, read to softness. The policy covers storm, fire, theft and subsidence. It does not cover FLOOD, which is defined on the back as any water that rises, as opposed to water that falls.\pThe old woman has written the definition out on a card and stuck it to the door frame under the water lines."), MSGBOX_SIGN)
    }
    end
}
