mapscripts ParcelRiverHouse2_MapScripts {
}
script ParcelRiverHouse2_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: He reads the meters to the window now and his voice carries down the street. Fourteen plots.\pPeople wait for it. It's the town clock."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: My husband reads the meters for the Board. He read them to the hearing. Out loud. Fourteen plots. His voice held. I was proud, and I was frightened, and the pay's still steady."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("WOMAN: He came home with the readings and told me what they said. First time in eleven years. Meltwater, all fourteen plots.\pI didn't ask. He told me. That's a different marriage. I'm not sure yet which I prefer."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: My husband reads the meters for the Board. Good wage. Steady. I don't ask what the readings say. He doesn't tell me. That's a marriage."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverHouse2_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: Dad's ledger is a book now. For real. The clerk had it bound. It's on the Board counter and anyone can turn the pages.\pI turned them. It's still numbers. It's our numbers."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Dad read the river's ledger to a room full of people. I went. It's still not a book. It was a book for one afternoon."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("GIRL: Dad says the river's a ledger and now the mountain's writing in it. I asked if mountains can write. He said they can't spell, but they're very loud."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: Dad says the river's a ledger. I thought a ledger was a book. The river isn't a book. I checked."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse2_ReadDresser {
    msgbox(format("A Board meter reader's badge on the dresser, and a child's drawing of a river with numbers in it instead of fish."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse2_ReadShelf {
    msgbox(format("Board ledgers, one per year. The current one is at home instead of at the Board. That is new, and it is not an accident."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelRiverHouse2_PaperMeterBook {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Her husband's meter book, the carbon side, open on the table now where anyone can see it. Fourteen plots, a reading a week, and the hearing's stamp on the page he read aloud.\pShe has read it. She says the numbers were always in the house; she just needed somebody outside it to say they counted."), MSGBOX_SIGN)
    } else {
        msgbox(format("Her husband's meter book, the carbon side. Fourteen plots, a reading a week, in a hand that does not change. Eleven years of NORMAL in the Board's column beside his numbers, which are not normal and never were.\pShe has never read it. She keeps it dry."), MSGBOX_SIGN)
    }
    end
}
