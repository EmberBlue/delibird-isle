// ParcelRiverHouse6 -- a house in River: residents in two story states (before / after the hearing).

mapscripts ParcelRiverHouse6_MapScripts {
}

script ParcelRiverHouse6_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: SLUICE had me re-read every gauge on the spine after the hearing. Same numbers. She wanted them in my hand, not the Board's."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("MAN: Readings are up, all fourteen plots. The Board wrote 'seasonal'. I wrote 'meltwater, HAUKFELL'. The Board reads what I write, then writes over it.\pI've started keeping the first sheet. SLUICE's idea. She's full of them."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Meter reader for the WATER BOARD. I read what the river does. The Board reads what I write. Different things, sometimes."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse6_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: The river's budget got bigger! Dad says it's not money. I said I know, Dad."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("GIRL: Dad says the mountain's spending the river's budget. I said that's stealing. He said it's accounting. I said that's the same thing. He laughed, but not the good laugh."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: Dad says the river has a budget. I said rivers don't have money. He said that's the problem."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse6_ReadDresser {
    msgbox(format("A first sheet of meter readings on the dresser, the real one, kept at home. SLUICE's idea.\pFourteen plots. The word MELTWATER, written small."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse6_ReadShelf {
    msgbox(format("A child's arithmetic book, open at a page about budgets. In the margin, in a child's hand: RIVERS DON'T HAVE MONEY."), MSGBOX_SIGN)
    end
}
