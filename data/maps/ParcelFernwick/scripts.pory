    msgbox(format("HENRIK: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HENRIK: No hurry. The water keeps."), MSGBOX_DEFAULT)
