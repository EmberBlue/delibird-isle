// --- Grettir's pond (side quest) -------------------------------------------------
script ParcelFernwick_PondLook {
    lock
    if (flag(FLAG_SKALD_Q_GRETTIR) && !flag(FLAG_SKALD_Q_GRETTIR_SEEN)) {
        msgbox(format("Still water over bare clay. Nothing. Nothing.\pThen a SURSKIT, skating out from the reeds the CORPS planted. Just the one. It found the pond on its own."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_GRETTIR_SEEN)
        release
        end
    }
    msgbox(format("The park pond. Still water. A SURSKIT skates across it and back."), MSGBOX_SIGN)
    release
    end
}

// --- PERRIN, encounter 1 (the peer; §04) -------------------------------------------
script ParcelFernwick_PerrinScene {
    if (flag(FLAG_SKALD_PERRIN_1)) {
        setvar(VAR_TEMP_5, 1)
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("PERRIN: WREN!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelFernwick_PerrinIn)
    waitmovement(0)
    msgbox(format("PERRIN: There you are! WREN, right? I'm PERRIN. Same cohort, different dispatch. TARN passed me yesterday. Yes, PASSED, first go.\pEveryone keeps saying the CORPS doesn't do rankings. Let's find out."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_1, format("PERRIN: Huh. Okay. OKAY."))
    msgbox(format("PERRIN: See you up the road. HALE's sending me to the landing too. The FOUNDATION's got an outreach grant for provisionals, did you know? You should apply. It pays."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelFernwick_PerrinOut)
    waitmovement(0)
    removeobject(LOCALID_PERRIN)
    setflag(FLAG_SKALD_PERRIN_1)
    setvar(VAR_TEMP_5, 1)
    releaseall
    end
}
script ParcelFernwick_PerrinTalk {
    lock
    faceplayer
    msgbox(format("PERRIN: Hang on, I'm coming to you."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_ParcelFernwick_PerrinIn { walk_down * 2 }
movement Movement_ParcelFernwick_PerrinOut { walk_up * 2 }

script ParcelFernwick_PondPage {
    if (!flag(FLAG_SKALD_Q_PAGE)) {
        end
    }
    msgbox(format("Under the pond's edge, a page gone to pulp. One line still legible, in a square hand:\p'Marsh page. 28 pairs. The low years start here.'"), MSGBOX_SIGN)
    setflag(FLAG_SKALD_Q_PAGE_FOUND)
    end
}

// --- town life (2026-11-10): the pairs ---

script ParcelFernwick_PairCorps {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: The Director's office sent a letter. The certification programme is 'under review for independence'."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: Meaning the FOUNDATION's third of it."), MSGBOX_DEFAULT)
        msgbox(format("CLERK: Meaning eight stations instead of twelve, if they walk. HALE says he'd rather have eight honest ones."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: HALE's said that for twenty years. Now someone's written it down where it counts."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("CLERK: The river meeting's in the papers. Forty-one ratepayers and a Board that won't name a year."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: And a ranger who stood in the back and wrote it all down."), MSGBOX_DEFAULT)
        msgbox(format("CLERK: Writing it down isn't standing up."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: Ask the Board which one they're more afraid of."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("CLERK: HALE took another provisional. From JOHTO, this one. No partner. No badges. Nothing."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: He takes them with nothing on purpose. Says you can see what they do with it."), MSGBOX_DEFAULT)
        msgbox(format("CLERK: What do they do with it?"), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: Mostly leave. The ones that stay, you remember."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwick_PairPond {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: There's a SMEARGLE on the far bank. It paints the line where the water was."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: I've seen it. It's not painting where the water was. It's painting where the water is."), MSGBOX_DEFAULT)
        msgbox(format("BOY: That's the same line."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: This year it is. Watch it next year. That's the whole job, you know. Watching next year."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: The ranger counted the pond. Twenty-eight pairs of WINGULL, they said, same as the old notebook."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: Same number. Half the water. Work that out for your homework."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Fewer places to land, so they land closer together?"), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: So the count looks fine. Good. You'll be a surveyor or a liar, and the difference is who you tell."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("OLD MAN: The pond came up to that stone when I was your age. Every spring."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Which stone?"), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: That one. The dry one. You're standing on it."), MSGBOX_DEFAULT)
        msgbox(format("BOY: It's a long way from the water."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: It didn't move."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- the stringer (2026-11-10): INGER, Skaldmere Courier ---

script ParcelFernwick_Stringer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("INGER: The hearing is on the front page. My piece above the fold, the Commissioner's reply below it. Nine years I've had that upside down.\pHALE still won't talk to me. He sent a note. It said: the record has a circulation now. Thank you. I've framed it. It's the only review I've had."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("INGER: The Poisoned Waters piece ran. Page four. The Commissioner's reply ran page two. That's the ratio in this region: his two to my four."), MSGBOX_DEFAULT)
        if (flag(FLAG_SKALD_CH_QUOTE)) {
            msgbox(format("INGER: Your sentence is in it, under your name. The editor wanted it cut. I said the ranger said it on the record, and the record is the one thing he can't cut. He didn't know what I meant. He will."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("INGER: You're in it without your name, because you didn't give me one. 'A ranger read the manifest.' Passive voice. I hate it. It's what you left me."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("INGER: The HQ. I'm not allowed in. HALE says the Corps doesn't talk to the press; it talks to the record.\pI told him the record doesn't have a circulation. He said that's its one advantage. I've been trying to think of an answer for six years."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- side quests, round three (2026-11-10) ---

script ParcelFernwick_Gardener {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_STONE_DONE)) {
        msgbox(format("GARDENER: Twelve paces. I've started watering the far bank. It won't bring it back. It's something to do with my hands."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALD_Q_STONE)) {
        if (flag(FLAG_SKALD_Q_STONE_FOUND)) {
            msgbox(format("GARDENER: Dry. Twelve paces from the water. I knew. I wanted somebody with a notebook to know too.\pTake this. I was going to give it to the pond."), MSGBOX_DEFAULT)
            giveitem(ITEM_RARE_CANDY, 1)
            setflag(FLAG_SKALD_Q_STONE_DONE)
        } else {
            msgbox(format("GARDENER: South, set in the pavement. A dark stone. Dry, I expect."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("GARDENER: The pond garden's mine to keep. The pond isn't anyone's to keep, it seems.\pThere's a stone in the pavement south of here that the water came up to every spring when I was a girl. Find it and tell me if it's wet."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_STONE)
    }
    release
    end
}

script ParcelFernwick_HighWaterStone {
    if (flag(FLAG_SKALD_Q_STONE) && !flag(FLAG_SKALD_Q_STONE_FOUND)) {
        msgbox(format("A dark stone set in the pavement, worn smooth on top. The high-water stone. The pond is twelve paces north of it and does not reach.\pIt is dry. It has been dry long enough for the moss to give up on it."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_STONE_FOUND)
    } else {
        msgbox(format("A dark stone set in the pavement, dry, twelve paces from the water."), MSGBOX_SIGN)
    }
    end
}

// --- side quests, round four (2026-11-10) ---

script ParcelFernwick_FindJar {
    if (flag(FLAG_SKALD_Q_JAR) && !flag(FLAG_SKALD_Q_JAR_FOUND)) {
        msgbox(format("A sample jar on the kerb, a third full, the water gone green against the glass. The label says POND, SOUTH BANK, and a date nine days old, and a name.\pSomebody has moved it an inch so the path stays clear, and no further."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_JAR_FOUND)
    } else {
        msgbox(format("A sample jar on the kerb, nine days old now and counting. The label has started to curl."), MSGBOX_SIGN)
    }
    end
}

script ParcelFernwick_PairStation {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CADET: The Director's letter says 'independence review'. HALE says it means eight honest stations or twelve bought ones, and the Director has to choose in writing."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: HALE's waited twenty years for someone to have to choose in writing."), MSGBOX_DEFAULT)
        msgbox(format("CADET: What if the Director chooses twelve?"), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Then HALE will run eight anyway and the paper will say why. That's what the ranger changed. Not the choice. The saying why."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD WOMAN: The new one spoke at the river meeting, or stood at the back and wrote. Same thing, in this town."), MSGBOX_DEFAULT)
        msgbox(format("CADET: HALE read the minutes out at briefing. All of them. Took the whole hour."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: And?"), MSGBOX_DEFAULT)
        msgbox(format("CADET: And then he said: that's what the job is. And sent us out. Nobody asked what he meant. We knew."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("CADET: Twelve stations, the poster says. We run eight."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: The poster's the FOUNDATION's. The eight are HALE's. Count the ones with a light on."), MSGBOX_DEFAULT)
        msgbox(format("CADET: Why does nobody fix the poster?"), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Because the poster paid for two of the eight. You'll understand the arithmetic when you've been cold in a station the poster didn't build."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelFernwick_Board1 {
    msgbox(format("A SURVEY BOARD outside the Corps HQ. FERNWICK. The Corps certifies rangers; the Survey certifies the ground. The board is the Survey's and says so.\pIt lists what a provisional ranger should be able to count by the end of the forest season, in order: the pond, the seep, the canopy, the floor. The floor is last because it is hardest."), MSGBOX_SIGN)
    end
}

script ParcelFernwick_Board2 {
    msgbox(format("A SURVEY BOARD by the pond. WINGULL pairs on the Fernwick pond: 28 in the first spring of the record, 28 in the tenth. The board gives the number with a warning under it.\pA count that holds is not always a habitat that holds. Sometimes it is a habitat that has stopped being able to lose anything else."), MSGBOX_SIGN)
    end
}
