// ParcelFernwick -- FERNWICK, the Corps district town on the bluff above the
// marsh water. Reworked from Rustboro's bones (data/layouts/ParcelFernwick/
// build.py is the map source). The District Station (Hale) is the big
// building on the terrace, the Certification Hall (Tarn) faces the square,
// the Survey office is the school building. Plain voice throughout.

const LOCALID_PERRIN   = 21
const LOCALID_FW_SMEARGLE = 22

mapscripts ParcelFernwick_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelFernwick_OnTransition
}

// The late Smeargle beat (§04 "the memory"): only after the record is filed
// and the epilogue has run does a SMEARGLE sit on the pond bank. Hidden
// otherwise; gone once it has decided.
script ParcelFernwick_OnTransition {
    setflag(FLAG_VISITED_PARCEL_FERNWICK)
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && !flag(FLAG_SKALD_SMEARGLE_DONE)) {
        clearflag(FLAG_SKALD_SMEARGLE_HIDDEN)
    } else {
        setflag(FLAG_SKALD_SMEARGLE_HIDDEN)
    }
    end
}

script ParcelFernwick_Smeargle {
    lock
    faceplayer
    msgbox(format("A SMEARGLE sits on the bank with its tail in the pond. It is not painting the water. It is painting the line where the water was, a hand higher, in a colour that is not in the pond.\pIt looks at you. It looks at the notebook under your arm. It goes back to the line."), MSGBOX_DEFAULT)
    msgbox(format("You know this stillness. You have been waiting most of your life to be allowed to stand in it again.\pIt finishes the line. It does not look up. It leaves the tail in the water, waiting, the way they do when they are asking."), MSGBOX_DEFAULT)
    msgbox(format("Let it come?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("You leave it the bank and the line. Some records are better kept by the one making them.\pIt will be here. It has decided that much."), MSGBOX_DEFAULT)
        release
        end
    }
    givemon(SPECIES_SMEARGLE, 45)
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        msgbox(format("There is no room for it, in the party or the boxes. It seems to know. It goes back to the line.\pMake room, and come back."), MSGBOX_DEFAULT)
        release
        end
    }
    playse(SE_PIN)
    msgbox(format("WREN received SMEARGLE."), MSGBOX_DEFAULT)
    msgbox(format("It is not Sketch. It does not try to be.\pIt paints the first page of the notebook you brought from Johto -- the one with the marsh plant nobody else could name -- then sets its tail down beside the page, and waits for the next one."), MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_SKALD_SMEARGLE_DONE)
    removeobject(LOCALID_FW_SMEARGLE)
    release
    end
}

// South road -> back into Mistwood (different primary tileset: warp, not connection).
script ParcelFernwick_ToMistwood {
    warp(MAP_PARCEL_MISTWOOD, 14, 1)
    waitstate
    end
}

// --- the north checkpoint --------------------------------------------------------
script ParcelFernwick_GateWard {
    trainerbattle_single(TRAINER_SKALD_GATE_STATION,
        format("WARD: Station checkpoint. Nobody goes north to the marsh without clearance.\pCard. …Provisional, Tidewater. Four clearances, no photograph that looks like you; they never do, the camera's the FOUNDATION's.\pYou want the fifth stamp? Earn it."),
        format("WARD: Cleared. Logged."),
        ParcelFernwick_GateWard_Defeated)
    lock
    faceplayer
    msgbox(format("WARD: You're in the log. Keep your card on you. The next checkpoint won't take my word for it."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_GateWard_Defeated {
    setflag(FLAG_SKALDMERE_GATE_STATION)
    msgbox(format("WARD: Station clearance: granted. No ceremony. That's not what this is."), MSGBOX_DEFAULT)
    release
    end
}

// --- trainers ----------------------------------------------------------------------
script ParcelFernwick_Lookout {
    trainerbattle_single(TRAINER_SKALD_LOOKOUT,
        format("GARR: Nice view from up here. You can see the whole marsh.\pYou can see who's coming, too."),
        format("GARR: Tch."))
    msgbox(format("GARR: Write your little report. It changes nothing out here."), MSGBOX_AUTOCLOSE)
    end
}

script ParcelFernwick_Birder {
    trainerbattle_single(TRAINER_SKALD_BIRDER,
        format("NERI: Shh! I'm counting nests! ...Okay. Fine. One battle."),
        format("NERI: Fewer nests every spring, and now fewer wins."))
    msgbox(format("NERI: Nobody writes the nest counts down but me. Somebody should."), MSGBOX_AUTOCLOSE)
    end
}

// --- residents ---------------------------------------------------------------------
script ParcelFernwick_Ranger {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("RANGER: Half the station's been called to the hearings as witnesses. The other half is covering their shifts.\pHALE's doing both."), MSGBOX_DEFAULT)
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("RANGER: HALE's inside. He's got the river minutes open on the desk and he's read them four times.\pHe keeps saying 'six people stood up.' Like he can't believe a room would do that."), MSGBOX_DEFAULT)
        release
        end
    } else {
        msgbox(format("RANGER: District Station. HALE's inside, if you're the one he keeps mentioning.\pHe mentions you a lot, for a man who doesn't talk."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwick_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: A fishing village before the station, a fishing village with paperwork after, and now a fishing village in a hearing transcript. I read my own name in it. Page forty. I said 'the water's low'. I did say that."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD MAN: They say the river village had a meeting where six people spoke and nobody shouted. Six! In this town we can't get two to agree on the tide.\pPaperwork did that. Yours, I'm told."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: This was a fishing village before the Corps put the station here.\pNow it's a fishing village with paperwork."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: TARN smiled. I saw it. Tidewater regulation or not, he smiled when they read your name on the wireless. Half a second. Don't tell him I told you."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: TARN read the river minutes aloud in the Hall. To the cadets. The whole thing, in that voice.\pOne of them cried. He said that was the correct response and carried on."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_BADGE01_GET)) {
        msgbox(format("WOMAN: You passed TARN's exam? He didn't smile, did he. He never smiles. I think it's a Tidewater regulation."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("WOMAN: The Certification Hall's right there. TARN runs the exams.\pHe's not as scary as the sign makes him look. He's scarier."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwick_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: I'm gonna be a RANGER! Not a MEREHOLT guy. Their boots are still the best. But the RANGER's name was on the radio."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: The MEREHOLT guy came through with new boots and nobody asked where he got them.\pI'm gonna be a RANGER. Just a RANGER. You can get wet in any boots."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: I'm gonna be a RANGER when I grow up! Or a fisherman.\pOr a MEREHOLT guy. They have the best boots."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: The pond's still ducks. WINGULL. But GRETTIR says a POLIWAG came up the channel. One. He's watching for it. I'm watching GRETTIR."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GIRL: A man from the river said the water there has names on it now. Like, who gets how much.\pCan we put names on our pond? I'd put POLIWAG. They'd have to come back if their name was on it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: The pond used to have POLIWAG in it! Now it just has ducks.\pWell. WINGULL. Same thing."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Fisher {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: Marsh water's still low. Your paper didn't raise it. It put a number on the discharge upstream, and a man with a jar. I'll row where I can and walk where I can't. Same as before. Less angry."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("FISHER: Water's still low. But the dredge crew got told to hold at the landing, and nobody told them why.\pI know why. Everybody who reads knows why. You wrote it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: The marsh water's been low since spring. You can walk to places you used to row to.\pThat's not good, whatever the Council says."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Scientist {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_JAR) && !flag(FLAG_SKALD_Q_JAR_DONE)) {
        if (flag(FLAG_SKALD_Q_JAR_FOUND)) {
            msgbox(format("SCIENTIST: Nine days. Nine days a jar of the pond sat in the sun with my name on it and nobody kicked it over. This town respects a label more than it respects the pond.\pTake these. I'm going to go and fill a new one."), MSGBOX_DEFAULT)
            giveitem(ITEM_HYPER_POTION, 2)
            setflag(FLAG_SKALD_Q_JAR_DONE)
        } else {
            msgbox(format("SCIENTIST: A jar on the kerb, south path. Labelled POND, with a date."), MSGBOX_DEFAULT)
        }
        release
        end
    } elif (!flag(FLAG_SKALD_Q_JAR_DONE)) {
        msgbox(format("SCIENTIST: I left a sample jar on the kerb by the south path last week. Pond water. Labelled. I meant to come back with the kit and I came back with excuses.\pIf it's still there, read me the label. I want to know if the date on it shames me."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_JAR)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SURVEYOR: Forty years of measuring and nobody cared. Now the lawyers want the numbers by Thursday.\pWe don't have a Thursday setting."), MSGBOX_DEFAULT)
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("SURVEYOR: Forty years of measuring, and this is the first autumn anyone's asked for the numbers before the argument instead of after.\pILEX says it's you. I say it's the numbers. We're both right, which she hates."), MSGBOX_DEFAULT)
        release
        end
    } else {
        msgbox(format("SURVEYOR: We measure. That's all we do. Forty years of measuring.\pILEX is inside. She'll tell you it's boring. She's lying."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwick_Gentleman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GENTLEMAN: MEREHOLT paid for the fountain. It still says so. The hearing didn't take the plaques down. I'd have liked it to. Then I thought: let them stay. They say exactly what they say."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GENTLEMAN: The plate on the fountain has been polished. Twice this month. Somebody up the coast is nervous about plates.\pI find I read the small ones more carefully than I used to."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GENTLEMAN: MEREHOLT paid for the fountain. It says so on the fountain.\pIt says so on most things around here, if you read the small plates."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Day rate at the marsh works is down. Nobody asks what the work is now either. The deal's the same. The pay's not. Funny how the deal's the bit nobody renegotiates."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("CLERK: Day rate's down. First time in three years. Half the marsh crew's been stood down 'pending review.'\pPending your review, is what they mean. Nobody's said it to my face. They say it to the fountain."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Day rate at the marsh works is up again. Don't ask what the work is.\pNobody asks. That's the deal."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_Mother {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MOTHER: My boy still wants to be a RANGER. I've stopped saying RANGERS don't get paid. They don't. But somebody read one out at a hearing and the whole town went quiet."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MOTHER: My boy's stopped saying the MEREHOLT part. He heard the men at the fountain talking about the river meeting.\pHe asked me what an allocation was. I had to ask the clerk."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MOTHER: My boy wants to be a RANGER. I told him RANGERS don't get paid.\pHe said that's fine, he'll be a MEREHOLT guy on weekends."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwick_ItemSuperPotion {
    finditem(ITEM_SUPER_POTION)
    end
}

// --- signs --------------------------------------------------------------------------
script ParcelFernwick_HallSign {
    msgbox(format("SKALDMERE CLIMATE CORPS\nCERTIFICATION HALL\pForest Certification: practical examination.\nExaminer: TARN, Tidewater Division."), MSGBOX_SIGN)
    end
}

script ParcelFernwick_HQSign {
    msgbox(format("SKALDMERE CLIMATE CORPS\nDISTRICT STATION\pRangers, provisionals and the public: front desk."), MSGBOX_SIGN)
    end
}

script ParcelFernwick_SurveySign {
    msgbox(format("SKALDMERE SURVEY\nDistrict office\pLong-baseline monitoring. Soil cores, water logs, repeat photography.\pWe do not issue press releases."), MSGBOX_SIGN)
    end
}

script ParcelFernwick_FisherSign {
    msgbox(format("GRETTIR'S\nRods. Bait. Marsh advice.\pThe advice is free and you won't take it."), MSGBOX_SIGN)
    end
}

script ParcelFernwick_CitySign {
    msgbox(format("FERNWICK\nDistrict seat, Saltmarsh Coast\pA smaller plate: PROMENADE AND FOUNTAIN BY THE MEREHOLT FOUNDATION."), MSGBOX_SIGN)
    end
}

// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelFernwick_T_Ella {
    trainerbattle_single(TRAINER_SKALD_FW_ELLA,
        format("ELLA: The park pond's new. Nothing lives in it yet. The CORPS says give it a year. Battle?"),
        format("ELLA: A year, they said."),
        ParcelFernwick_T_Ella_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_ELLA_R2)) {
        goto(ParcelFernwick_T_Ella_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FW_ELLA_R3)) {
        goto(ParcelFernwick_T_Ella_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FW_ELLA_R4)) {
        goto(ParcelFernwick_T_Ella_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FW_ELLA_R5)) {
        goto(ParcelFernwick_T_Ella_R5)
    }
    msgbox(format("ELLA: TARN failed my brother twice. He's at the HALL every day anyway. That's FERNWICK."), MSGBOX_DEFAULT)
    end
}
script ParcelFernwick_T_Ella_FirstWin {
    msgbox(format("ELLA: TARN failed my brother twice. He's at the HALL every day anyway. That's FERNWICK."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Ella_R2 {
    lock
    faceplayer
    msgbox(format("ELLA: I kept the team up for this. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ELLA: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_ELLA_R2, format("ELLA: Still yours."))
    msgbox(format("ELLA: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Ella_R3 {
    lock
    faceplayer
    msgbox(format("ELLA: I moved the whole team on. Let's see if you have?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ELLA: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_ELLA_R3, format("ELLA: …Fair."))
    msgbox(format("ELLA: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Ella_R4 {
    lock
    faceplayer
    msgbox(format("ELLA: I've watched you walk past twice. Not a third time. Battle?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ELLA: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_ELLA_R4, format("ELLA: …Again, then. Later."))
    msgbox(format("ELLA: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Ella_R5 {
    lock
    faceplayer
    msgbox(format("ELLA: The region's different now. Let's see if you are?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ELLA: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_ELLA_R5, format("ELLA: Noted. Properly, this time."))
    msgbox(format("ELLA: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Henrik {
    trainerbattle_single(TRAINER_SKALD_FW_HENRIK,
        format("HENRIK: The district station sends provisionals north and gets reports back. Never the provisionals. Battle!"),
        format("HENRIK: Some come back, then."),
        ParcelFernwick_T_Henrik_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_HENRIK_R2)) {
        goto(ParcelFernwick_T_Henrik_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FW_HENRIK_R3)) {
        goto(ParcelFernwick_T_Henrik_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FW_HENRIK_R4)) {
        goto(ParcelFernwick_T_Henrik_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FW_HENRIK_R5)) {
        goto(ParcelFernwick_T_Henrik_R5)
    }
    msgbox(format("HENRIK: ILEX files everything at the survey office. Everything. I asked her what for. She said 'later'."), MSGBOX_DEFAULT)
    end
}
