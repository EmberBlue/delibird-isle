script ParcelFernwick_T_Leon {
    trainerbattle_single(TRAINER_SKALD_FW_LEON,
        format("LEON: The square's the only place in FERNWICK with grass worth a bug. Battle!"),
        format("LEON: Worth a bug. Not a battle."),
        ParcelFernwick_T_Leon_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_LEON_R2)) {
