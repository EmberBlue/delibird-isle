    faceplayer
    msgbox(format("LEON: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("LEON: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_LEON_R4, format("LEON: Noted. Properly, this time."))
    msgbox(format("LEON: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Leon_R5 {
    lock
    faceplayer
    msgbox(format("LEON: The region's different now. Let's see if you are?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("LEON: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_FW_LEON_R5, format("LEON: …Again, then. Later."))
    msgbox(format("LEON: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Thea {
    trainerbattle_single(TRAINER_SKALD_FW_THEA,
        format("THEA: Cadet THEA, station duty. HALE says spar every provisional who crosses the plaza. You crossed it."),
        format("THEA: HALE will want the score."),
        ParcelFernwick_T_Thea_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_THEA_R2)) {
        goto(ParcelFernwick_T_Thea_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FW_THEA_R3)) {
        goto(ParcelFernwick_T_Thea_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FW_THEA_R4)) {
        goto(ParcelFernwick_T_Thea_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FW_THEA_R5)) {
        goto(ParcelFernwick_T_Thea_R5)
    }
    msgbox(format("THEA: Every cadet wants the Reedmere posting. The marsh is where things happen. Things aren't good, but they happen."), MSGBOX_DEFAULT)
    end
}
script ParcelFernwick_T_Thea_FirstWin {
    msgbox(format("THEA: Every cadet wants the Reedmere posting. The marsh is where things happen. Things aren't good, but they happen."), MSGBOX_DEFAULT)
    release
    end
}
