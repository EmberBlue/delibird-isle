script ParcelFernwick_T_Marte {
    trainerbattle_single(TRAINER_SKALD_FW_MARTE,
        format("MARTE: South square's where the MISTWOOD road comes in. Everyone comes in tired. Easy battles."),
        format("MARTE: Not that tired, then."),
        ParcelFernwick_T_Marte_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_MARTE_R2)) {
