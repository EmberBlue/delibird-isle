        goto(ParcelFernwick_T_Marte_R5)
    }
    msgbox(format("MARTE: The CENTER's free for provisionals. The MART isn't. The CORPS pays for healing, not REPELS. Funny priorities."), MSGBOX_DEFAULT)
    end
}
