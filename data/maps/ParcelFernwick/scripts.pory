script ParcelFernwick_T_Steinar {
    trainerbattle_single(TRAINER_SKALD_FW_STEINAR,
        format("STEINAR: Down from the marsh road. The plaza's the only flat ground in forty miles. Battle for it."),
        format("STEINAR: Share the flat ground, then."),
        ParcelFernwick_T_Steinar_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FW_STEINAR_R2)) {
        goto(ParcelFernwick_T_Steinar_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FW_STEINAR_R3)) {
        goto(ParcelFernwick_T_Steinar_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FW_STEINAR_R4)) {
        goto(ParcelFernwick_T_Steinar_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FW_STEINAR_R5)) {
        goto(ParcelFernwick_T_Steinar_R5)
    }
    msgbox(format("STEINAR: The north checkpoint's WARD's. He doesn't bend. The marsh is past him and the marsh is worse than he is."), MSGBOX_DEFAULT)
    end
}
script ParcelFernwick_T_Steinar_FirstWin {
    msgbox(format("STEINAR: The north checkpoint's WARD's. He doesn't bend. The marsh is past him and the marsh is worse than he is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFernwick_T_Steinar_R2 {
    lock
    faceplayer
    msgbox(format("STEINAR: I kept the team up for this. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("STEINAR: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
