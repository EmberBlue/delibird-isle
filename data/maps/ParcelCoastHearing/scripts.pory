// ParcelCoastHearing -- the quota hearing hall (the Battle Tent lobby). Closed
// between seasons; in session once the testimony has landed.
mapscripts ParcelCoastHearing_MapScripts {
}
script ParcelCoastHearing_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: The hearing's in session. They read a CORPS filing into the record this morning. Parts of it twice.\pThe review board wants the author. I told them the author was a RANGER. They said that's not a title. I said no, it isn't."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("CLERK: Objections in writing, to the Board. One came in today that wasn't an objection. It was a survey, with a card number on it.\pThe Board reads everything. I've put yours on top. I'm not supposed to have a top."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Quota hearings are seasonal. Next session after the harvest. Objections in writing, to the Board. The Board reads them. The Board's very good at reading."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastHearing_Waiter1 {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_CARBON) && !flag(FLAG_SKALD_Q_CARBON_DONE)) {
        if (flag(FLAG_SKALD_Q_CARBON_FOUND)) {
            msgbox(format("FISHER: That's it. Year four. One sentence. I didn't know you were allowed more than one."), MSGBOX_DEFAULT)
            msgbox(format("FISHER: Nine again. Here -- my wife packs me a lunch for every hearing and I never eat it. Nerves. Take it; it keeps better than I do."), MSGBOX_DEFAULT)
            giveitem(ITEM_LEFTOVERS)
            setflag(FLAG_SKALD_Q_CARBON_DONE)
            msgbox(format("FISHER: Nine carbons and a ranger's survey in the same tray. First time the tray's had company."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("FISHER: Blue carbon. 'OBJECTION' in capitals. Somewhere on this floor."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: Nine objections, nine carbon copies, and the tenth one got read into the record. I've kept the chair warm nine years. It was worth the sitting."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_CARBON_DONE)) {
        msgbox(format("FISHER: Nine seasons, nine objections, nine carbons. Eight, this morning. The fourth year's gone. It was in the folder and now it isn't.\pIt fell out in here somewhere. The benches, the clerk's table, under the chairs. A blue carbon, my handwriting, 'OBJECTION' at the top in capitals, because I didn't know how to do it then.\pFind it for me? I can't lose a year. I've got too few of them in here as it is."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_CARBON)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("FISHER: Nine seasons, nine objections, nine carbons. Today a ranger's survey went in the same tray as mine.\pFirst time I've had company in the tray. I've started a tenth. Might as well have it ready."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: I've sat in this chair every season for nine years. Nine objections. I keep the carbon copies. Nobody else has them."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastHearing_Waiter2 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: They changed the size rule back. Nobody told us when they changed it the first time. This time there was a notice, in the hall, in big letters. Progress is a notice."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: The size changed the week before and nobody told the fish. Your survey says the fish are all one size now, so maybe the fish told the size.\pMy husband laughed when I said that. First time since the grounding."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: My husband's boat was grounded for an undersize catch. The size changed the week before. Nobody told the fish."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastHearing_Notice {
    msgbox(format("QUOTA REVIEW BOARD -- members: MEREHOLT COASTAL HOLDINGS (3), the FOUNDATION (2), the Union (1), the Council (1). Quorum: four. The Union seat has been vacant for two years."), MSGBOX_SIGN)
    end
}

script ParcelCoastHearing_Carbon {
    if (flag(FLAG_SKALD_Q_CARBON) && !flag(FLAG_SKALD_Q_CARBON_FOUND)) {
        msgbox(format("Behind the clerk's bench, folded small where a shoe pushed it: a blue carbon copy. OBJECTION, in capitals, pressed hard enough to tear.\pThe objection is one sentence long. It is about the size of a fish."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_CARBON_FOUND)
        end
    }
    msgbox(format("The clerk's bench. Behind it, the floor where nine seasons of chairs have scraped the same two lines."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelCoastHearing_Tray {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The clerk's tray. The record of the sitting, typed, still warm from the carbon.\pITEM 7. Objection, Mereholt Coastal dredging consent, renewal. Nine prior objections noted. The objector was heard.\pITEM 8. Submission, Skaldmere Climate Corps, provisional ranger. A field survey in forty-one stakes, four baselines and one notebook. Entered in full.\pITEM 9. Submission, the Skaldmere Survey. Red-cloth baselines, six zones, thirty-one years. Entered in full. The Commissioner asked whether the markers were official. The Surveyor said they were older than the office asking.\pITEM 10. Statement read on behalf of Dr. Heron, in her absence, by the ranger. Four sentences. Entered. The room was silent for a time the clerk did not record.\pITEM 11. The Mereholt Foundation recovery model, as tabled by the Commissioner in the spring. Withdrawn by the Foundation's officer before the vote, without comment.\pDISPOSITION. Dredging consent: suspended pending review. Permafrost exploratory licence: deferred. The keystone marsh: referred for listing. The chair thanked the room and adjourned.\pSomeone has written in pencil along the bottom edge: nine years for one afternoon. Worth it."), MSGBOX_SIGN)
    } else {
        msgbox(format("The clerk's tray. The order of business for the next sitting, typed.\pITEM 1. Minutes. ITEM 2. Apologies. ITEM 3. The Commissioner's report on public-private partnership.\pITEM 4. Mereholt Coastal, dredging consent, renewal. Recommended for approval, officer's report attached.\pITEM 5. Mereholt Permafrost, exploratory licence, Haukfell. Recommended for approval, officer's report attached.\pITEM 6. Recovery model, Mereholt Foundation, tabled for information. Not for debate.\pITEM 7. Objection, from the floor, as in previous seasons. Noted.\pItem 7 is one line. It has been one line for nine years."), MSGBOX_SIGN)
    }
}
