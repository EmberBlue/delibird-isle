// --- the epilogue, stop 8 of 8: the bridge, one POLIWAG, the credits ---
script ParcelRoute1_Epilogue {
    lockall
    delay(20)
    msgbox(format("The bridge on ROUTE 1. The first morning, the whole crowd of them was jammed up under it, going nowhere, and you thought something was chasing them."), MSGBOX_DEFAULT)
    closemessage
    clearflag(FLAG_TEMP_2)
    addobject(LOCALID_R1_POLIWAG2)
    delay(30)
    applymovement(LOCALID_R1_POLIWAG2, Movement_Epilogue_PoliwagDownstream)
    waitmovement(0)
    msgbox(format("One POLIWAG, in the middle of the stream, going downstream at its own pace. Nobody helping it. It has the room.\pYou write it down."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 0)
    setrespawn(HEAL_LOCATION_PARCEL_FERNWICK)
    fadescreenspeed(FADE_TO_BLACK, 24)
    special(SkaldGameClear)
    waitstate
    releaseall   // never reached: the credits take over and end in a soft reset
    end
}
movement Movement_Epilogue_PoliwagDownstream {
    delay_16
    walk_down * 3
}

script ParcelRoute1_Whistle {
    if (flag(FLAG_SKALD_Q_HALVAR) && !flag(FLAG_SKALD_Q_HALVAR_FOUND)) {
        msgbox(format("Something glints in the shallows where the water has drawn back from the stones. A brass whistle on a rotted lanyard, green with the inlet.\pYou fish it out. It still has a pea in it."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_HALVAR_FOUND)
        end
    }
    msgbox(format("The inlet by the bridge, drawn back from its stones. Low water. Things show in low water that were never meant to."), MSGBOX_SIGN)
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelRoute1_PairBridge {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ANGLER: One POLIWAG went downstream on its own this morning. Middle of the stream. Taking its time."), MSGBOX_DEFAULT)
        msgbox(format("CADET: Just one?"), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: One's the number you start with. I've fished this bank forty years and I've never once seen the first one before."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("CADET: The ranger from the ferry read the bridge the first morning. Before the badge, before anything."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: Read it how?"), MSGBOX_DEFAULT)
        msgbox(format("CADET: Stood where you're standing and wrote down what the frogs were doing. Then went south to the station like it was nothing."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: It was something. People stand here and see a bridge."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("ANGLER: The POLIWAG were under the bridge again this morning. Jammed up. Going nowhere."), MSGBOX_DEFAULT)
        msgbox(format("CADET: Something chasing them?"), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: Nothing chases a POLIWAG into a bridge. Something's wrong with the water downstream and they know it before we do."), MSGBOX_DEFAULT)
        msgbox(format("CADET: I'll write it up."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: Write it up. That's two of us who've noticed in forty years."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelRoute1_Board1 {
    msgbox(format("A SURVEY BOARD, fresh paint over older paint. ROUTE 1. Saltmarsh edge: the grass floods on the big tides and drains in a day, and the WOOPER move with it, so they are counted at the culvert and not the pool.\pCount this spring: 31. The old board underneath said 50. Nobody painted that out. It wore off."), MSGBOX_SIGN)
    end
}

script ParcelRoute1_Board2 {
    msgbox(format("A SURVEY BOARD by the road. WINGULL pairs on the shore pilings, counted at dawn: 14. The Survey's rule for shore birds is written under the number in a smaller hand.\pA pair that nests found enough fish. A pair that stays and does not nest found enough to stay. Watch which."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round four ---

script ParcelRoute1_PairSalt {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD WOMAN: The gate's open. No crest. Someone unscrewed it in the night."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: Was it the ranger?"), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: The ranger doesn't unscrew things. The ranger writes them down and other people unscrew them. Pick the samphire. It's a good year."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_BRIDGE_SCENE)) {
        msgbox(format("GIRL: A POLIWAG came through the culvert the wrong way. The ranger saw it."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Wrong way for whom?"), MSGBOX_DEFAULT)
        msgbox(format("GIRL: For the POLIWAG."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Then it's the right way for something else. Find out what. That's what the ranger's doing."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("OLD WOMAN: Pick below the tide line, not above. Above is the gate's. Below is everyone's."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: The gate has a crest on it."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: The gate has a crest. The marsh has samphire. Pick the samphire."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: What's the crest for?"), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Managing. Keep picking."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards, round two (2026-11-10) ---

script ParcelRoute1_Board3 {
    msgbox(format("A SURVEY BOARD at the grass edge. TAILLOW nest in the old pilings and feed over the marsh; where they feed is where the insects are, and where the insects are is where the marsh still works.\pThe board draws their flight lines as arrows. The arrows have shortened since the first drawing. They have not turned."), MSGBOX_SIGN)
    end
}

// --- survey boards, round four (2026-11-10) ---

script ParcelRoute1_Board5 {
    msgbox(format("A SURVEY BOARD at the north end of the route, where the saltmarsh gives up and the trees begin. The Survey calls this a line and draws it on the board as one, year by year.\pThe trees have not moved. The marsh has. The line is where it always was; the marsh is shorter on its side of it."), MSGBOX_SIGN)
    end
}
