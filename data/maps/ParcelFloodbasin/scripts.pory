script ParcelFloodbasin_T_Anders {
    trainerbattle_single(TRAINER_SKALD_FLD_ANDERS,
        format("ANDERS: The MASQUERAIN by the lake have wings like oil on water. Pretty. Battle!"),
        format("ANDERS: Pretty and useless."),
        ParcelFloodbasin_T_Anders_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FLD_ANDERS_R2)) {
        goto(ParcelFloodbasin_T_Anders_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FLD_ANDERS_R3)) {
        goto(ParcelFloodbasin_T_Anders_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FLD_ANDERS_R4)) {
        goto(ParcelFloodbasin_T_Anders_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FLD_ANDERS_R5)) {
        goto(ParcelFloodbasin_T_Anders_R5)
    }
    msgbox(format("ANDERS: Oil on water. I said it as a compliment. Then I saw the lake."), MSGBOX_DEFAULT)
    end
}
