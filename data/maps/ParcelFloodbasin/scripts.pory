// ParcelFloodbasin -- §01/§06 zone 3, Chapter 2: "the wetlands are sick".
// Legacy contamination resurfacing from a decades-old Mereholt operation; the
// amphibian guild is the keystone AND the indicator AND the loser. Rebuilt
// 2026-11 on vanilla Route 120 (General + Fortree): you arrive from the
// Corridor at the bottom-left, LEIRVIK (the hamlet) sits above the south
// lake, the long bridge over the upper lake carries the tells, the old pump
// house is the works door, and BREEN's checkpoint seals the rubble to the
// River at the top-left. Flag logic unchanged; words plain.
//
// VAR_SKALDMERE_CH2_EVIDENCE bits:
//   0  discharge pipe noted     1  sheen on the water      2  dead reed band
//   3  deformed Wooper observed 4  sick apex (Karp) observed
//   5  booth visited (the mask) 6  classifier read complete (Ilex, Fernwick)
// VAR_TEMP_1 guards the arrival trigger, VAR_TEMP_3 the relief scene,
// VAR_TEMP_4 the checkpoint. FLAG_SKALD_FLD_RELIEF_DONE marks Dorsey's scene.

const LOCALID_BASIN_REMEDIATOR = 1
const LOCALID_BASIN_KID        = 2
const LOCALID_BASIN_DEFORMED_WOOPER = 3
const LOCALID_BASIN_SICK_KARP  = 4
const LOCALID_BASIN_ITEM       = 5
const LOCALID_FLOODBASIN_GYM   = 6
const LOCALID_FLD_DORSEY       = 10
const LOCALID_FLD_AIDE_1       = 11
const LOCALID_FLD_AIDE_2       = 12
const LOCALID_FLD_VIL_OLDWOMAN = 13
const LOCALID_FLD_VIL_MAN      = 14
const LOCALID_FLD_VIL_GIRL     = 15
const LOCALID_FLD_VIL_FISHER   = 16

mapscripts ParcelFloodbasin_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelFloodbasin_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SKALD_EPILOGUE, 2: ParcelFloodbasin_Epilogue
    ]
}

script ParcelFloodbasin_OnTransition {
    // Dorsey and his aides hold the relief line until the Wetland
    // Certification is signed; after that the line is gone and the hamlet is
    // just a hamlet again. FLAG_TEMP_2 hides them.
    if (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        setflag(FLAG_TEMP_2)
    } else {
        clearflag(FLAG_TEMP_2)
    }
    end
}

// --- first entry: the rain, the smell ------------------------------------------
script ParcelFloodbasin_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_FLOODBASIN_ARRIVAL)) {
        end
    }
    lockall
    bufferpartymonnick(0, 0)
    msgbox(format("The trees open onto a low, wide basin. Rain ticks on the reeds.\pSomething is wrong with the smell."), MSGBOX_DEFAULT)
    msgbox(format("{STR_VAR_1} walks on, but slower, and keeps to the middle of the path."), MSGBOX_DEFAULT)
    msgbox(format("HALE's brief, on paper: LEGACY CONTAMINATION. OWNERSHIP UNCONTESTED. ACTIVE REMEDIATION CITED.\pWalk the upstream. Read it for yourself."), MSGBOX_DEFAULT)
    msgbox(format("Voices, off to the east. A lot of them. Somebody is giving a speech in the rain."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_FLOODBASIN_ARRIVAL)
    releaseall
    end
}

// --- the relief line: Dorsey's first big scene ---------------------------------
// He is good at this. That is the horror. Triggered on the hamlet's entries.
script ParcelFloodbasin_ReliefScene {
    if (flag(FLAG_SKALD_FLD_RELIEF_DONE) || flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        setvar(VAR_TEMP_3, 1)
        end
    }
    lockall
    msgbox(format("DORSEY: --and the Council hears you. Third flood in two years. You've been patient. Patience should be paid for."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: Fuel vouchers. Dry goods. The FOUNDATION's boat runs to FERNWICK twice a day until the road's clear. Nobody pays.\pMRS. ASKE. Your roof. I haven't forgotten. Thursday."), MSGBOX_DEFAULT)
    msgbox(format("OLD WOMAN: Bless you, councilman. Bless you."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_FLD_DORSEY, Movement_FLD_DorseyLookUp)
    waitmovement(0)
    msgbox(format("DORSEY: And there's our RANGER. Good. Come down, come down. Witness this. That's your job, isn't it? Witnessing."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: The CORPS sends a report. I send a boat.\pNo, don't argue, I'm not blaming you. I'm telling you what people remember. They remember the boat."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: The water goes down by Thursday. It always does. Then the smell goes. Then they forget, until the next one.\pThat's the basin. That's just the basin."), MSGBOX_DEFAULT)
    msgbox(format("GIRL: Mister DORSEY, is the water bad? Gran says don't touch it."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: Your gran's right, sweetheart. Not until it's gone down. Here. Take two, one for your brother."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_FLD_DORSEY, Movement_FLD_DorseyFaceDown)
    waitmovement(0)
    msgbox(format("DORSEY: Walk the basin, RANGER. Read your stakes. When you're done, the booth by the bridge will have the remediation file ready for you. All of it. We've nothing to hide."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: And take a blanket. FOUNDATION's. Everyone takes one; the nights are the nights whatever you think of the crest.\pTake one?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("You take it. It is warm, and it says FOUNDATION in the corner, and both of those are true.\pDORSEY: Good. Warm first. Argue later. That's the only order it works in."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_CH_BLANKET)
    } else {
        msgbox(format("You leave it on the pile.\pDORSEY: No? …Your business. They write that down too, you know. Who didn't take one. Not me. Them."), MSGBOX_DEFAULT)
    }
    setflag(FLAG_SKALD_FLD_RELIEF_DONE)
    setvar(VAR_TEMP_3, 1)
    releaseall
    end
}

movement Movement_FLD_DorseyLookUp { face_up delay_16 }
movement Movement_FLD_DorseyFaceDown { face_down }

script ParcelFloodbasin_Dorsey {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("DORSEY: Phase 2 is a dry shed and a pump that works. I'd have liked more. I've stopped writing what I'd have liked.\pThe FOUNDATION's man was courteous, RANGER. Put that down. It's true, and it's the least of it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DORSEY: You'll write that the FOUNDATION's man was courteous after the hearing. I was. I am. Phase 2 goes ahead, RANGER. Dry sheds. You'd have built them too. You'd just have built them slower."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("DORSEY: I heard KOLE lost his temper. He's young. I'll have a word.\pYou'll write that the FOUNDATION's man was uncooperative. Write also that the FOUNDATION's boat ran twice a day. Both are true."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DORSEY: Vouchers are for residents, RANGER. You've got a CORPS stipend. Try the booth by the bridge if you want paperwork."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_Aide1 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("AIDE: Vouchers are back, from a different fund, with a different crest. Same sheet. I kept the sheet.\pForty-one names, and I know every one of them now."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("AIDE: Fuel vouchers are finished. The relief sheet went to the hearing as an exhibit. Forty-one signatures. The councilman's name was the forty-second. I'd not noticed that before."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("AIDE: Vouchers are suspended pending the coast office's review. I'm to say 'suspended', not 'stopped'.\pThe sheet's still here. Nobody's come to sign it since the river hall voted. Nobody's come to collect it either."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("AIDE: Fuel vouchers on the left, dry goods on the right. Sign the sheet. Yes, the FOUNDATION keeps the sheet. For the records."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_Aide2 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("AIDE: Consulted, this time, means asked. I asked all forty-one. Eleven said no to the shed.\pEleven is in the minutes. I typed it myself."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("AIDE: Forty-one households. The hearing asked how many were consulted on Phase 2. I said forty-one signed. They said that wasn't the question. It wasn't."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("AIDE: Forty-one signatures, and the councilman hasn't looked at the sheet once since he came back from the river.\pHe looks at the bridge instead. I don't know what he sees there. Water, I expect."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("AIDE: Forty-one households. Forty-one signatures. The councilman likes a full sheet."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_VilOldWoman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_ROOF_DONE)) {
        msgbox(format("MRS. ASKE: The roof's held two storms. Tuesdays, they come now, for anyone.\pI make tea on Tuesdays. I never thought I'd have a day."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ROOF_DONE)) {
        msgbox(format("MRS. ASKE: They came Tuesday. Not Thursday. Tuesday. Eleven years and it took a stranger looking at a tarp."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ROOF_FOUND)) {
        msgbox(format("MRS. ASKE: You looked? Then go and tell the aide you looked. Say it like you mean to write it down. They move faster for the writing down."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ROOF)) {
        msgbox(format("MRS. ASKE: The house behind the third one, dear. Blue tarp. You can't miss it. Everyone misses it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_FLD_RELIEF_DONE)) {
        msgbox(format("MRS. ASKE: Thursday, he said. It's been four Thursdays. The tarp's on the house behind the third one.\pGo and look at it, dear. And then go and tell the aide you looked."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_ROOF)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MRS. ASKE: He knows my name. He said it at the hearing, into a microphone, as an example of local partnership. Eleven years, and I was an example."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_FLD_RELIEF_DONE)) {
        msgbox(format("MRS. ASKE: He knows my name. Eleven years on the Council and he knows my name.\pThe CORPS man before you didn't. I'm not saying that to be unkind."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MRS. ASKE: Wait your turn, dear. We've all been flooded."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_VilMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_BROWN_DONE)) {
        msgbox(format("MAN: The vials went to the review. They came back with a number on each. Shine's got a name now.\pI'd rather it had stayed mud."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_BROWN) && !flag(FLAG_SKALD_Q_BROWN_DONE)) {
        if (flag(FLAG_SKALD_Q_BROWN_A) && flag(FLAG_SKALD_Q_BROWN_B) && flag(FLAG_SKALD_Q_BROWN_C)) {
            msgbox(format("MAN: Three. You held them up to the light the way I would've if I'd had the vials.\pBrown's just mud. Mud don't shine. That shine's the thing nobody asks about, and now it's in three bottles with my name on the sheet as the one who asked."), MSGBOX_DEFAULT)
            msgbox(format("MAN: Here. Came up with the brown water the third flood and I've kept it dry since. Yours."), MSGBOX_DEFAULT)
            giveitem(ITEM_MAX_ELIXIR)
            setflag(FLAG_SKALD_Q_BROWN_DONE)
            msgbox(format("MAN: Vouchers are for asking quietly. Bottles are for asking out loud."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("MAN: The marks. A scrape off each one."), MSGBOX_DEFAULT)
        if (!flag(FLAG_SKALD_Q_BROWN_A)) {
            msgbox(format("MAN: The first is on the house beside the relief tent."), MSGBOX_DEFAULT)
        }
        if (!flag(FLAG_SKALD_Q_BROWN_B)) {
            msgbox(format("MAN: The second is on the hamlet wall, the house by the lane."), MSGBOX_DEFAULT)
        }
        if (!flag(FLAG_SKALD_Q_BROWN_C)) {
            msgbox(format("MAN: The third is on the house with the tarp roof. Highest of the three."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Three floods, three times the vouchers, and the water still comes up brown. Your paper says why. In the hearing they read the why aloud. The water didn't change colour. I did."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_BROWN_DONE)) {
        msgbox(format("MAN: The water comes up brown and nobody's asked why but me, and I got vouchers for asking. You've got vials. I've seen the belt.\pThree flood marks on the hamlet. Take a scrape off each one. If it's mud it's mud. If it's the other thing, somebody's going to have to say so.\pThe marks are the brown lines on the walls. You can't miss them. Everybody misses them."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_BROWN)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: Three floods, three times the vouchers, and the fourth time I asked why the water's brown, somebody up the river asked it for me. In a hall. With the Board sitting there.\pNo vouchers for that. Better than vouchers."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Three floods. Three times the vouchers. Nobody's asked why the water comes up brown now.\pI asked. I got vouchers."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_VilGirl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: The WOOPER with the wrong feet had babies. Their feet are right. The CORPS lady came back and drew those too.\pShe cried a bit. She said it was the cold."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: The WOOPER with the wrong feet is still in the puddle. A CORPS lady came and drew it. She said it's in a report now. It doesn't know. It's a WOOPER."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GIRL: The WOOPER with the wrong feet is still in the puddle. A lady from the river came and drew it. Drew it! In a book!\pShe said it's going in a report. I said it's going in a puddle. We were both right."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: My brother found a WOOPER with the wrong feet. Gran made him put it back. It didn't go anywhere. It just sat."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_VilFisher {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_DEADLINE_DONE)) {
        msgbox(format("FISHER: The water's never reached past the big stone, and this spring it didn't reach the stone before it. First time.\pI put a stick where it stopped. You've made a man of sticks out of me."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_DEADLINE) && !flag(FLAG_SKALD_Q_DEADLINE_DONE)) {
        if (flag(FLAG_SKALD_Q_DEADLINE_FOUND)) {
            msgbox(format("FISHER: Past the big stone. It's never reached past the big stone. The works are further up than they say the water goes, then.\pHere. For the smell. There's no cure for the smell, but these are for the rest."), MSGBOX_DEFAULT)
            giveitem(ITEM_ANTIDOTE, 3)
            setflag(FLAG_SKALD_Q_DEADLINE_DONE)
        } else {
            msgbox(format("FISHER: The bank. The line of them. Find where it stops."), MSGBOX_DEFAULT)
        }
        release
        end
    } elif (!flag(FLAG_SKALD_Q_DEADLINE_DONE)) {
        msgbox(format("FISHER: After every pulse there's a line on the bank where the fish lie. The Board man says it's weather. I say it's a line, and lines have a top end.\pGo along the bank and find the top of it. Tell me how far up it reaches this year."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_DEADLINE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: Does writing fix anything, I asked you. The vouchers are still stopped. The boat's still stopped. But a Board man came and measured the water instead of telling me about it. Writing did that."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("FISHER: Vouchers stopped. Boat stopped. Water's the same.\pYour lot wrote something down, I hear. Does writing it down dry anything out?"), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: I don't fish the lake anymore. I fish the top lake, past the bridge. The water's clearer up there.\pClearer. Not clear."), MSGBOX_DEFAULT)
    release
    end
}

// --- the five observation points ------------------------------------------------
script ParcelFloodbasin_Discharge {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The discharge pipe. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A concrete pipe in the bank, mouth fouled with brown crust. Stamped: DISCHARGE -- AUTHORIZED USE ONLY.\pThe authorization is decades old. The crust is fresher than that. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelFloodbasin_Sheen {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 1)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The sheen. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A faint iridescence crawls on the lake, bending the rain wrong.\pIt is not new. The cattails downstream carry the same stain at their bases. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelFloodbasin_DeadReeds {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 2)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The dead reed band. Photographed."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A band of dead reeds along the bank, straw-pale. The reeds above and below it are fine.\pThe kill line is exactly the height of the flood six months ago. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- the visible indicators (Pokémon, not signs) ---------------------------------
script ParcelFloodbasin_DeformedWooper {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 3)
    special(SkaldmereCertTaskMark)
    msgbox(format("A WOOPER, low in the puddle. Two left feet.\pIt doesn't flinch. It has been like this since it hatched, and that was recent. Written down."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_SickKarp {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 4)
    special(SkaldmereCertTaskMark)
    msgbox(format("A grown MAGIKARP lists against the bridge piling, scales greying.\pIt was never in the pipe. It was at the top of the food web. Poison climbs. Written down."), MSGBOX_DEFAULT)
    release
    end
}

// --- the mask: the outreach booth ---------------------------------------------------
script ParcelFloodbasin_BoothSign {
    msgbox(format("MEREHOLT FOUNDATION COMMUNITY OUTREACH\pRemediation underway. Please report concerns to your local representative.\pThe paint is wet from the rain. The sign is older."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasin_Remediator {
    lock
    faceplayer
    setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("KOLE: Write up whatever you write up."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("KOLE: Oh. RANGER! Welcome to the active remediation site.\pWe've been at it… some time now. The FOUNDATION does great work."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: When was the last reading?"), MSGBOX_DEFAULT)
    msgbox(format("KOLE: …A quarter or two. We're due."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: The councilman said you'd have the remediation file for me."), MSGBOX_DEFAULT)
    msgbox(format("KOLE: Did he. Well. It's at the office. The coast office."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: Who signed off on the discharge stamp on that pipe?"), MSGBOX_DEFAULT)
    msgbox(format("KOLE: You'd have to ask the office. I just check the boxes."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: I'm asking. The WOOPER has two left feet."), MSGBOX_DEFAULT)
    closemessage
    delay(30)
    msgbox(format("KOLE: Move along, RANGER. This isn't your patch."), MSGBOX_DEFAULT)
    trainerbattle_single(TRAINER_SKALD_REMEDIATOR,
        format("KOLE: Tch. Fine. We'll do this the loud way."),
        format("KOLE: Hmph."))
    msgbox(format("KOLE: Write up whatever you write up.\pThis basin ran sick before you got here. It'll run sick after."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- PIPER (the kid) and the route trainers ---------------------------------------------
script ParcelFloodbasin_BasinKidTrainer {
    trainerbattle_single(TRAINER_SKALD_BASIN_KID,
        format("PIPER: Gran fishes here. Used to. Wanna battle?"),
        format("PIPER: Ohh. You're good!"),
        ParcelFloodbasin_BasinKidTrainer_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_BASIN_KID_R2)) {
        goto(ParcelFloodbasin_BasinKidTrainer_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_BASIN_KID_R3)) {
        goto(ParcelFloodbasin_BasinKidTrainer_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_BASIN_KID_R4)) {
        goto(ParcelFloodbasin_BasinKidTrainer_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_BASIN_KID_R5)) {
        goto(ParcelFloodbasin_BasinKidTrainer_R5)
    }
    msgbox(format("PIPER: She doesn't eat what she catches anymore. Sells it to the people who don't ask."), MSGBOX_DEFAULT)
    end
}
script ParcelFloodbasin_BasinKidTrainer_FirstWin {
    msgbox(format("PIPER: She doesn't eat what she catches anymore. Sells it to the people who don't ask."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasin_BasinKidTrainer_R2 {
    lock
    faceplayer
    msgbox(format("PIPER: Back this way? I've not been idle. Rematch?"), MSGBOX_YESNO)
