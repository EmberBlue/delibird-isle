script ParcelFloodbasin_Oskar {
    trainerbattle_single(TRAINER_SKALD_FLD_OSKAR,
        format("OSKAR: The puddle field used to be the best grazing in the district. Now it's the best puddles. Battle."),
        format("OSKAR: Best puddles. Worst battle."),
        ParcelFloodbasin_Oskar_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_FLD_OSKAR_R2)) {
        goto(ParcelFloodbasin_Oskar_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_FLD_OSKAR_R3)) {
        goto(ParcelFloodbasin_Oskar_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_FLD_OSKAR_R4)) {
        goto(ParcelFloodbasin_Oskar_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_FLD_OSKAR_R5)) {
        goto(ParcelFloodbasin_Oskar_R5)
    }
    msgbox(format("OSKAR: The ground here doesn't drain anymore. Something underneath it is full."), MSGBOX_DEFAULT)
    end
}
