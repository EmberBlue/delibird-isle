    end
}

// --- Gym 3: Mereholt Logistics / Quarry & Roadworks checkpoint (BREEN) -------------------
// The haul road to the river neck. A trigger on the one-tile passage, so the
// clearance can't be walked around; the rubble past him needs HM06.
script ParcelFloodbasin_Checkpoint {
    if (flag(FLAG_BADGE03_GET)) {
        setvar(VAR_TEMP_4, 1)
        end
    }
    lockall
    msgbox(format("BREEN: Stop there."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_FLOODBASIN_GYM, Movement_FLD_BreenApproach)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_FLD_FaceLeft)
    waitmovement(0)
    msgbox(format("BREEN: Logistics. This is a haul road, not a hiking trail. Nobody moves up to the river neck on my road without clearing me first.\pMIRREN cleared you? MIRREN clears anyone who can read. I need people who can carry."), MSGBOX_DEFAULT)
    msgbox(format("BREEN: Though the stakes say you read. Prove it quick. The basin runs brown after a pulse.\pBrown's lake water stirred up, is it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("BREEN: Lake water's grey. Brown is soil, off the banks they cut upstream. The lake gets the blame because the lake can't argue.\pCarry, then. Reading you'll learn on the road, same as the rest of us."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("BREEN: …Soil. Upstream soil, off the cut banks. Lake water's grey. Hm. You did read the stakes.\pNow carry."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_EXAM_3)
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM3, format("BREEN: …Fine. You can carry weight. Move up."))
    setflag(FLAG_BADGE03_GET)
    call(Common_EventScript_PlayGymBadgeFanfare)
    msgbox(format("BREEN: Quarry clearance. Logs you fit to move earth on division ground. Tool's bonded to it."), MSGBOX_DEFAULT)
    giveitem(ITEM_HM06)
    msgbox(format("BREEN: ROCK SMASH. The slide past me's been there since spring. Nobody's cleared it because nobody's needed to go up.\pMind the loads coming down. They don't stop for paperwork."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_FLOODBASIN_GYM, Movement_FLD_BreenAside)
    waitmovement(0)
    setvar(VAR_TEMP_4, 1)
    releaseall
    end
}
script ParcelFloodbasin_GymBreen {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelFloodbasin_GymBreen_Rematch)
    }
    msgbox(format("BREEN: Cleared. The neck's open to you. Mind the loads coming down."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_FLD_BreenApproach { walk_right * 2 }
movement Movement_FLD_BreenAside { walk_left * 3 walk_down face_up }
movement Movement_FLD_FaceLeft { face_left }

