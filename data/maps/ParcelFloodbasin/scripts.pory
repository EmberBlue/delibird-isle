// --- the epilogue, stop 2 of 8 ---
script ParcelFloodbasin_Epilogue {
    lockall
    delay(20)
    msgbox(format("LEIRVIK. The relief tent is gone. The sandbags are stacked where DORSEY's photographer stood.\pPhase 2 goes ahead. Dry sheds, like PERRIN said. The next pulse will come from somewhere, and now there's a page that says where."), MSGBOX_DEFAULT)
    msgbox(format("MRS ASKE's roof has a man on it. Thursday. He is not the FOUNDATION's and the ladder is his own.\pIn the basin the water runs grey after a pulse now, not brown. It isn't clean. It's honest, which is further than it had got in twenty-two years."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 3)
    warp(MAP_PARCEL_RIVER, 16, 30)
    waitstate
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelFloodbasin_GymBreen_Rematch {
    lock
    faceplayer
    msgbox(format("BREEN: Carry weight, you said. I'm asking again, heavier.\pNothing to clear. Just me, the whole crew's worth. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("BREEN: Mind the loads, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM3_R, format("BREEN: …Fine. You can carry it."))
    msgbox(format("BREEN: Any time the loads are down. Mind them."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFloodbasin_TarpRoof {
    if (!flag(FLAG_SKALD_Q_ROOF)) {
        end
    }
    msgbox(format("A blue tarp weighted with stones over half a roof. Four Thursdays of weather on it.\pThe stones have shifted. Somebody re-stacks them every morning."), MSGBOX_SIGN)
    setflag(FLAG_SKALD_Q_ROOF_FOUND)
    end
}

script ParcelFloodbasin_MarkA {
    if (flag(FLAG_SKALD_Q_BROWN) && !flag(FLAG_SKALD_Q_BROWN_A)) {
        msgbox(format("A brown line a hand above the sill, on the house beside the relief tent. You scrape it into a vial. It smells of the lake, and of something that is not the lake.\pSample one."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_BROWN_A)
        end
    }
    msgbox(format("A brown line on the wall, a hand above the sill. The flood's signature."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasin_MarkB {
    if (flag(FLAG_SKALD_Q_BROWN) && !flag(FLAG_SKALD_Q_BROWN_B)) {
        msgbox(format("The second mark, on the hamlet wall, higher than the first. The scrape comes away greasy.\pSample two."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_BROWN_B)
        end
    }
    msgbox(format("A brown line on the hamlet wall, higher than the one by the tent."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasin_MarkC {
    if (flag(FLAG_SKALD_Q_BROWN) && !flag(FLAG_SKALD_Q_BROWN_C)) {
        msgbox(format("The third mark, on the house with the tarp roof, highest of all. Under the brown there is a sheen like the one on the water by the booth.\pSample three."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_BROWN_C)
        end
    }
    msgbox(format("A brown line under the tarp roof's eaves, highest of the three."), MSGBOX_SIGN)
    end
}

// The zone's survey stake (§13 fix E): reads the chapter's evidence back.
script ParcelFloodbasin_SurveyStake {
    msgbox(format("A survey stake by the hamlet sign, red cloth at the top, the cloth gone pale on the side the floods come from."), MSGBOX_SIGN)
    setvar(VAR_0x8004, 2)
    special(SkaldSurveyStake)
    msgbox(gStringVar4, MSGBOX_SIGN)
    if (flag(FLAG_SKALD_SECOND) && !flag(FLAG_SKALD_SECOND_2)) {
        msgbox(format("Second reading. The works are fenced and a pump runs inside the fence. The basin runs grey after a pulse now, not brown.\pSTRESSED, not COLLAPSING. The first time a word on this stake has moved the right way. You write it and do not underline it."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_SECOND_2)
    }
    end
}

// --- town life (2026-11-10): the pairs ---

script ParcelFloodbasin_PairBlankets {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MRS ASKE: Thursday. The roof. Nine years of Thursdays and this one a man came."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: Because the works are 'under active remediation' now. Capitals. There's a sign."), MSGBOX_DEFAULT)
        msgbox(format("MRS ASKE: There was always a sign."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: There's a fence round the sign now, and a man inside the fence with a pump. Small things. I'll take small things."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("NEIGHBOUR: The ranger's stake by the hamlet sign. People stop at it now. Read what it says and go on."), MSGBOX_DEFAULT)
        msgbox(format("MRS ASKE: What does it say?"), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: It says what we've all said, in order, with the dates. That's all. Somehow that's the thing nobody had done."), MSGBOX_DEFAULT)
        msgbox(format("MRS ASKE: DORSEY read it. He read it twice and then he smiled at me. I didn't like the second smile."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("MRS ASKE: Third blanket in two years. I've a drawer of FOUNDATION blankets. I could open a shop."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: Don't say that where the aide can hear. He'll write down that you're grateful."), MSGBOX_DEFAULT)
        msgbox(format("MRS ASKE: I am grateful. For the blanket. It's a good blanket."), MSGBOX_DEFAULT)
        msgbox(format("NEIGHBOUR: It's the water I'd like a word about. Nobody's handing out any of that."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFloodbasin_PairBoat {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FERRYMAN: Last run tonight. The FOUNDATION's pulled the boat. 'Needs have been reassessed.'"), MSGBOX_DEFAULT)
        msgbox(format("LAD: The road's clear. We don't need the boat."), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: We never needed the boat. We needed the road clear. Took nine years and a hearing to say it in that order."), MSGBOX_DEFAULT)
        msgbox(format("LAD: What'll you do?"), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: Row. I did before. The river's still there, whoever's paying."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("LAD: The ranger wouldn't take the free boat. Walked the road both ways with the water up to the knee."), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: Rangers are paid to be difficult."), MSGBOX_DEFAULT)
        msgbox(format("LAD: A third of them by the FOUNDATION, the poster says."), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: You've been reading posters. That's how it starts. Get in the boat."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("FERRYMAN: FOUNDATION's boat. Twice a day to FERNWICK. Nobody pays."), MSGBOX_DEFAULT)
        msgbox(format("LAD: Then who pays you?"), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: The FOUNDATION. I just said."), MSGBOX_DEFAULT)
        msgbox(format("LAD: And who pays the FOUNDATION?"), MSGBOX_DEFAULT)
        msgbox(format("FERRYMAN: …Get in the boat."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- the stringer (2026-11-10): INGER, Skaldmere Courier ---

script ParcelFloodbasin_Stringer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("INGER: The works are fenced and there's a man inside the fence with a pump. I ran a photograph of the pump.\pA pump is not a story. In Leirvik, after twenty-two years, a pump is the story. The editor didn't argue. He's from here."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("INGER: Your stake by the hamlet sign made the paper. Not the words -- the photograph. People standing in a row reading a stick.\pIt did better than the Commissioner with the blanket. He noticed. He asked me which photographer. I said the same one as always. He didn't like that either."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("INGER: Third flood, third relief line, third photograph of the Commissioner handing a child a blanket. I've got a drawer of them.\pDifferent child each time. Same blanket. I've never been allowed to print that sentence. I'm saying it to you so it exists somewhere."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- side quests, round three (2026-11-10) ---

script ParcelFloodbasin_WellWoman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_PLATE_DONE)) {
        msgbox(format("WOMAN: Discharge licensed. The licence is suspended. I say that to myself now, at the pump.\pIt helps more than the first thing did."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PLATE_DONE)) {
        msgbox(format("WOMAN: Discharge licensed. I say it to myself when the aide comes round with the blankets. It helps, a little."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALD_Q_PLATE)) {
        if (flag(FLAG_SKALD_Q_PLATE_FOUND)) {
            msgbox(format("WOMAN: Discharge licensed. Where did you think it went.\pThat's what he wouldn't say. I'd like to hit something. Here; I've no use for these now."), MSGBOX_DEFAULT)
            giveitem(ITEM_FULL_HEAL, 2)
            setflag(FLAG_SKALD_Q_PLATE_DONE)
        } else {
            msgbox(format("WOMAN: The pump house plate. Up at the works, on the wall. Brass, I'm told."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("WOMAN: The works up the basin. There's a plate on the pump house. My husband read it once and came home and wouldn't say what it said.\pYou read things for a living. Read me the plate."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_PLATE)
    }
    release
    end
}

// --- side quests, round four (2026-11-10) ---

script ParcelFloodbasin_FindDeadline {
    if (flag(FLAG_SKALD_Q_DEADLINE) && !flag(FLAG_SKALD_Q_DEADLINE_FOUND)) {
        msgbox(format("The top of the line. MAGIKARP, mostly, pale, lying where the pulse left them, and the last one is past the big stone that nobody has ever had to use as a marker before.\pYou put a stake of reed in the mud beside it, because there is no cloth, and because somebody should."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_DEADLINE_FOUND)
    } else {
        msgbox(format("A reed stake in the mud beside a big stone. The line reached here this year. The reed is bending already."), MSGBOX_SIGN)
    }
    end
}

script ParcelFloodbasin_PairBank {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("LAUNDRESS: Grey, not brown. The sheets. It's not clean. It's honest."), MSGBOX_DEFAULT)
        msgbox(format("BARGEMAN: You sound like the ranger."), MSGBOX_DEFAULT)
        msgbox(format("LAUNDRESS: The ranger sounds like my washing book. We've all been saying the same thing for twenty years in different places. Now it's in one place."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BARGEMAN: The ranger's stake by the sign has the dates of every pulse on it. Every one. I've been on this water twenty years and I couldn't have told you the dates."), MSGBOX_DEFAULT)
        msgbox(format("LAUNDRESS: I could. They're in my washing book."), MSGBOX_DEFAULT)
        msgbox(format("BARGEMAN: You never said."), MSGBOX_DEFAULT)
        msgbox(format("LAUNDRESS: Nobody asked the laundress. The ranger did."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("LAUNDRESS: Third wash this month and the sheets come up brown."), MSGBOX_DEFAULT)
        msgbox(format("BARGEMAN: Hang them in the hall. The Commissioner's photographer won't want brown sheets behind the blankets."), MSGBOX_DEFAULT)
        msgbox(format("LAUNDRESS: That's exactly where I'm hanging them."), MSGBOX_DEFAULT)
        msgbox(format("BARGEMAN: …Good."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelFloodbasin_Board1 {
    msgbox(format("A SURVEY BOARD at the basin edge. THE FLOODBASIN. The marsh filters the water for everything downstream; that is its work and the reason it is here.\pThe CROAGUNK carry two poisons, their own and the one they drink. The Survey tests the CROAGUNK to test the water. The result is one word a year. Six words. None of them is clean."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasin_Board2 {
    msgbox(format("A SURVEY BOARD by the relief tents. Deformity count, POLIWAG, spring sample of one hundred, in a column down the board: 0, 0, 1, 0, 3, 4, 7, 9.\pA sign beside the board says the site is being remediated. The board does not argue with the sign. It is a column of numbers."), MSGBOX_SIGN)
    end
}
