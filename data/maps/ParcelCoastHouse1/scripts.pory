mapscripts ParcelCoastHouse1_MapScripts {
}
script ParcelCoastHouse1_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: Husband on half days, son's boat grounded to spring, daughter still at the FOUNDATION desk typing the review. Three wages, one cramped house, and the first dinner in years where nobody talked about fish."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: Three wages, one crest, and this week the crest is nervous. My daughter says the desk's been rewriting brochures since the ranger's survey went to the Board.\pArithmetic's still arithmetic. But somebody's checking the sums for once."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: My husband's on the cannery line, my son's on the boats, my daughter's at the FOUNDATION desk. Three wages, one crest. If it goes, we go with it. That's not loyalty. That's arithmetic."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastHouse1_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: GYDA says the water's clearer off the breakwater. I'm going to dive it when I'm old enough. Mum says that's the first thing I've said that she can plan for."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_SHELL_DONE)) {
        msgbox(format("BOY: It's on the windowsill. Mum says it's the first real one in years. I'm going to find the second one myself."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_SHELL_FOUND)) {
        msgbox(format("BOY: A SHELL! A real one! Whole! Mum, LOOK!\pYou can have these. They're for divers. I'm not one yet. You can give them back when I am."), MSGBOX_DEFAULT)
        giveitem(ITEM_DIVE_BALL, 3)
        setflag(FLAG_SKALD_Q_SHELL_DONE)
        release
        end
    }
    msgbox(format("BOY: I'm going to be a diver! GYDA says there's nothing down there to see. I'll see it anyway.\pI've never found a shell on our beach. Not one. Just drum rings. If you find one, that's proof there's something."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastHouse1_ReadDresser {
    msgbox(format("Three pay slips in a row on the dresser, each with the same crest in the corner. Somebody has lined up the crests so they all face the same way."), MSGBOX_SIGN)
    end
}

script ParcelCoastHouse1_ReadDrawer {
    msgbox(format("The top drawer holds a child's diving mask, still in its box, and a shell on a bed of cotton wool.\pThe box has been opened and closed a great many times."), MSGBOX_SIGN)
    end
}
