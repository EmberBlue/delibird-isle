// ParcelWeatherInstitute1F -- the Climate Station's institute, ground floor.
mapscripts ParcelWeatherInstitute1F_MapScripts {
}
script ParcelWeatherInstitute1F_Reception {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("RECEPTION: The director sees anyone, any day. He's taken down the sign that said otherwise.\pHe kept it. It's in his office, face to the wall."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("RECEPTION: The director is upstairs. He sees anyone now. He says the four divisions were the easy part. Go up."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WEATHER_CLEARED)) {
        msgbox(format("RECEPTION: You've beaten the four and the director. He's asked me to stop saying 'the rules'.\pHe says there was only ever one rule, and it was his, and he isn't sure about it any more. I've never heard him say isn't sure. I wrote it down."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("RECEPTION: The director is upstairs. He sees anyone who's beaten the four divisions, and nobody who hasn't. Those are his rules. They're the only rules here he made himself."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeatherInstitute1F_Tech1 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("TECHNICIAN: Over-the-fence data, monthly, beside the roof data. The two lines have started to agree.\pThe director says that's the dish catching up. I say it's the fence."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("TECHNICIAN: The drawer's open. The over-the-fence data went to the review in three boxes. We publish it monthly now, next to the plot data. The drawer's for sandwiches."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WEATHER_CLEARED)) {
        msgbox(format("TECHNICIAN: The director took the drawer upstairs after your battle. All twelve months of the over-the-fence log.\pHe said he wanted to read what the sky did while he was modelling it. He hasn't come down. We've started sending the sandwiches up."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("TECHNICIAN: We publish the plot data monthly. The over-the-fence data goes in a drawer. The drawer is very full."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeatherInstitute1F_Tech2 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_CASTFORM_DONE)) {
        msgbox(format("TECHNICIAN: Still rain form. It has rained very gently on my desk for a year.\pI've stopped moving the in-tray. The paper dries."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_CASTFORM_DONE)) {
        msgbox(format("TECHNICIAN: Back at its desk. Rain form, still. It rains very gently on my in-tray now. I've moved the in-tray."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_CASTFORM_FOUND)) {
        msgbox(format("TECHNICIAN: Under the director's desk. Of course. Rain form. Of course.\pTake this. Management sends them for 'morale'. This is the most morale I've had all year."), MSGBOX_DEFAULT)
        giveitem(ITEM_RARE_CANDY)
        setflag(FLAG_SKALD_Q_CASTFORM_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_CASTFORM)) {
        msgbox(format("TECHNICIAN: Upstairs. It went up the back stair during the storm drill. Look under things. It likes under things."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WEATHER_ARRIVAL)) {
        msgbox(format("TECHNICIAN: Ours is missing. The CASTFORM. It went up the back stair during the storm drill and nobody's seen it since.\pIf you're going up to the director anyway. Look under things."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_CASTFORM)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("TECHNICIAN: A CASTFORM in every office, still. 'Adaptive thinking.' One of them changed form during the hearing broadcast. Rain. Nobody's explained it. Nobody wants to."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("TECHNICIAN: A CASTFORM in every office. Management's idea. 'Adaptive thinking.' They mostly sleep."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeatherInstitute1F_Board {
    lock
    msgbox(format("STATION MISSION. 'To demonstrate that regional climate outcomes are manageable through targeted intervention.' Somebody has underlined 'demonstrate' in pencil and written: to whom?"), MSGBOX_SIGN)
    if (flag(FLAG_SKALD_Q_DRAWER) && !flag(FLAG_SKALD_Q_DRAWER_SEEN)) {
        msgbox(format("Under the board, a drawer. Inside: the over-the-fence log. Twelve months of the real sky, in pencil.\pRain up a third. Frost days down by half. Nobody signed it. Written down, with the date."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_DRAWER_SEEN)
    }
    release
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelWeatherInstitute1F_Scenarios {
    msgbox(format("The model, pinned to the wall in three sheets. SCENARIO A: TARGETED INTERVENTION. SCENARIO B: ENHANCED INTERVENTION. SCENARIO C: FULL MANAGEMENT.\pEvery curve on every sheet ends in the same word: MANAGEABLE. Someone has pencilled a fourth sheet on the back of a requisition form and pinned it under the three. SCENARIO D: WHAT HAPPENED. The curve is the over-the-fence log, copied out. It does not end in a word. It ends at this month, because that is where the pencil stopped."), MSGBOX_SIGN)
    end
}

// --- books, round two (2026-11-10) ---

script ParcelWeatherInstitute1F_Register {
    msgbox(format("The Station's register, open on the stand under the roof dish's cable. Forty years of the same page: first frost, last frost, ice-out on the tarn, the first storm named.\pFIRST FROST. The dates walk down the column a day or two a year, with the odd year that walks back and gets a tick from somebody relieved. The ticks stop twenty years in.\pICE-OUT. The tarn used to go in a week in late spring. The column has it going in a fortnight, then a month, then, in the last three years, not going at all, because it did not fully come."), MSGBOX_SIGN)
    msgbox(format("STORMS NAMED. Four a year, then six, then the year with eleven, when the Director's hand gets smaller to fit them in.\pIn the margin of the last page, the Director's initials beside a note not meant for the page: The dish measures. The register remembers. I was hired for the first and I have ended up keeping the second. I do not know which the Council wants.\pUnder it, the Survey's initial and one line: Both. Keep both."), MSGBOX_SIGN)
    msgbox(format("A loose sheet is tucked in the back: the Survey's dusk counts from the Reedmere hide, copied by hand into the Station's own columns, year by year, so that the frost and the lights can be read together. Nobody at the Station admits to doing it."), MSGBOX_SIGN)
    end
}
