// ParcelFernwickHouse7 -- a house in Fernwick: residents in two story states (before / after the hearing).

mapscripts ParcelFernwickHouse7_MapScripts {
}

script ParcelFernwickHouse7_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: They say the works have a new page in their permit. I'd like to go home. Not yet. The nose knows before the paper does."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: They've stood the dredge crew down at REEDMERE. My sister says the landing's quiet in a different way now.\pNot the sick quiet. The waiting kind. She's thinking about going back. I'm not. Not yet."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: We moved here from REEDMERE when the water turned. The house smells of marsh when it rains. I don't mind."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse7_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: The map's been corrected. First time in eleven years. Your name's on the correction slip."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: Drove the basin relief twice and the river minutes once. The minutes weighed more than the sandbags, the way HALE carried them.\pThe map's still wrong about three zones. Getting it wrong about fewer, maybe."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: I drive the station truck. Eight zones, one truck, and a map that's wrong about three of them."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse7_ReadDresser {
    msgbox(format("A dresser from another house. You can tell by the water line on its legs, a hand above the floor.\pIt came from REEDMERE. So did the line."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse7_ReadDrawer {
    msgbox(format("The station truck's logbook, kept at home where the station can't lose it. Eight zones.\pThe mileage to three of them is crossed out and rewritten."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse7_ReadPots {
    msgbox(format("Two pots of marsh reed, grown indoors. They should not grow indoors. They do."), MSGBOX_SIGN)
    end
}
