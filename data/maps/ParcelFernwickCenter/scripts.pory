mapscripts ParcelFernwickCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelFernwickCenter_OnTransition
}

script ParcelFernwickCenter_OnTransition {
    setrespawn(HEAL_LOCATION_PARCEL_FERNWICK)
    end
}

script ParcelFernwickCenter_Nurse {
    setvar(VAR_0x800B, LOCALID_FC_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
    end
}

script ParcelFernwickCenter_Trainer {
    lock
    faceplayer
    msgbox(format("BOY: The nurse healed my WOOPER. Then it got sick again.\pIt's a WOOPER thing, apparently."), MSGBOX_DEFAULT)
    release
    end
}
