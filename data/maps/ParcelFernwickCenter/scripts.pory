mapscripts ParcelFernwickCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelFernwickCenter_OnTransition
}

script ParcelFernwickCenter_OnTransition {
    setrespawn(HEAL_LOCATION_PARCEL_FERNWICK)
    end
}

script ParcelFernwickCenter_Nurse {
    setvar(VAR_0x800B, LOCALID_FC_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
    end
}

script ParcelFernwickCenter_Trainer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: The nurse healed my WOOPER. It stayed healed this time. She says the water in the channel is better. The WOOPER says nothing. It's a WOOPER."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: My WOOPER's fine now. The nurse says the ones from upstream are fine and the ones from the landing aren't.\pShe's started writing down which is which. She never did that before."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: The nurse healed my WOOPER. Then it got sick again.\pIt's a WOOPER thing, apparently."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickCenter_ReadRack {
    msgbox(format("Leaflets: SURVEY CERTIFICATION -- PRACTICAL EXAMS WEEKLY. Under it, in pen: ask for TARN. Don't smile."), MSGBOX_SIGN)
    end
}

script ParcelFernwickCenter_ReadMap {
    msgbox(format("A map of the district. Someone has drawn the marsh's old shoreline on it in pencil, a finger-width out from the printed one."), MSGBOX_SIGN)
    end
}

// --- books, round two (2026-11-10) ---

script ParcelFernwickCenter_Bound {
    msgbox(format("A bound volume of THE SKALDMERE COURIER on the Centre's shelf, the years before you came. The nurse says people read it while they wait and nobody has ever finished it.\pMEREHOLT TO FUND TWO FIELD STATIONS. The Foundation's Chair, photographed with the Corps' director at Fernwick. A new era of partnership for the region's environment.\pPRESERVE GATE OPENED AT SALTWICK. Managed access to the saltmarsh, a Foundation crest on the gate. A fisher quoted, briefly, asking who manages the sea."), MSGBOX_SIGN)
    msgbox(format("RECORD HERRING YEAR. A photograph of the quay heaped. Smaller, inside: the Survey notes the record is for landings, not for fish.\pHAUKFELL BORE EXPLORATORY ONLY, COMPANY ASSURES. The first use of the phrase in print. INGER, then on page six, counts its uses by the end of the year: fourteen.\pLAB OPENS ON THE SALTWICK FRONT. A regional ecologist, returned from Johto to lead the Foundation's resilience programme. She is photographed not smiling. The caption calls it modesty."), MSGBOX_SIGN)
    msgbox(format("CORRECTION. The Courier regrets that last week's figure for the Reedmere WOOPER count was supplied by the Foundation and not, as stated, by the Survey. The Survey's figure is lower.\pThe volume ends there. The next year is the one you arrived in, and it is on the board by the door, one page at a time."), MSGBOX_SIGN)
    end
}
