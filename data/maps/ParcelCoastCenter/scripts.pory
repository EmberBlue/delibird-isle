const LOCALID_CPC_NURSE = 1
mapscripts ParcelCoastCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelCoastCenter_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}
script ParcelCoastCenter_OnTransition {
    setrespawn(HEAL_LOCATION_PARCEL_COAST)
    end
}
script ParcelCoastCenter_Nurse {
    setvar(VAR_0x800B, LOCALID_CPC_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
    end
}
script ParcelCoastCenter_Trainer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SAILOR: The WINGULL came in today without hooks in them. Three. The nurse didn't know what to do with a well bird. Neither did I."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("SAILOR: The nurse read your survey to the waiting room. The hooks, the starving. She said 'coastal thing', and then she said 'that's not a diagnosis, is it.'\pFirst time I've heard her say what something isn't."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SAILOR: Half the WINGULL in here come in with hooks in them. The other half come in with nothing in them. Starved. The nurse says it's a coastal thing."), MSGBOX_DEFAULT)
    release
    end
}
