mapscripts ParcelFernwickHouse3_MapScripts {
}

script ParcelFernwickHouse3_OldWoman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("OLD WOMAN: I bake a loaf for the hut on the marsh every week and the carrier takes it. Nobody told me to.\pSomebody out there should have bread."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD WOMAN: So that's where she went. The marsh. I sold her the bread for it.\pI'm glad somebody found her. I'm glad it was you."), MSGBOX_DEFAULT)
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD WOMAN: Somebody from the river bought bread here on the way to the coast. Said the whole village had stood up to the Board.\pI thought about the scientist's bread again. She never stood up to anything in my shop. She just bought it and went."), MSGBOX_DEFAULT)
        release
        end
    } else {
        msgbox(format("OLD WOMAN: The scientist came through here on her way somewhere. Bought bread. Didn't say where she was going.\pI've thought about that bread a lot."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwickHouse3_ReadShelf {
    msgbox(format("Recipe books, and one field guide to marsh plants that does not belong with them. A receipt marks a page.\pOne loaf. Paid in coin."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse3_ReadFridge {
    msgbox(format("Bread, under a cloth. Today's. She bakes whether or not anyone is coming through."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse3_ReadDresser {
    msgbox(format("A dresser of good plates. One has been moved to the front and turned so its chip faces the wall."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse3_Granddaughter {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: Gran's loaf goes to the marsh now. A day's bread for a day's counting, she says.\pI write the date on the paper. That's my part."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Gran kept the receipt. One loaf, paid in coin. It's in the field guide now, at the marsh plants, where she says the scientist would have wanted it.\pI'm not allowed to bake with the field guide open. I do anyway. The pages smell of flour. She pretends not to notice."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("GIRL: Gran says a loaf is a day. You bake it in the morning and it's gone by night, and the next day you bake again, and that's how you know you're alive.\pShe said it about the scientist's bread. Then she stopped talking and kneaded for a long time."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GIRL: I do the morning batch. Gran does the talking.\pShe says the ovens in this town have been warm for two hundred years without a break and she's not going to be the one who lets them go cold. So I get up at four."), MSGBOX_DEFAULT)
    }
    release
    end
}
