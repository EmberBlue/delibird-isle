// ParcelIsleChandlery -- Kit's shop. Rope, lamp oil, and the town's POKé BALLS.

mapscripts ParcelIsleChandlery_MapScripts {
}

script ParcelIsleChandlery_Kit {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("KIT: I've sold more rope this week than all winter. Everyone wants to tie something down before the hearings.\pThe shelf's stocked. Need anything?"), MSGBOX_YESNO)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("KIT: RANGER stock's in! The RANGERS pay on time, which is more than I can say for some people.\pNeed anything?"), MSGBOX_YESNO)
    } else {
        msgbox(format("KIT: Off the ferry? Then you'll want a lamp, and you'll want to not ask about the weather.\pThe shelf's stocked, when the boat remembers us. Need anything?"), MSGBOX_YESNO)
    }
    if (var(VAR_RESULT) == 1) {
        pokemart(ParcelIsleChandlery_Items)
    }
    msgbox(format("KIT: Mind the fog out there!"), MSGBOX_DEFAULT)
    release
    end
}

raw `
	.align 2
ParcelIsleChandlery_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_NET_BALL
	.2byte ITEM_POTION
	.2byte ITEM_SUPER_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_REPEL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_NONE
`

script ParcelIsleChandlery_Hjalmar {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HJALMAR: Rope, lamp oil, and gossip. KIT sells two of those.\pThe third is free now, and it's all anyone's buying."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("HJALMAR: Rope, lamp oil, and gossip. KIT sells two of those.\pThe third you get by standing here long enough. I've been here an hour."), MSGBOX_DEFAULT)
    }
    release
    end
}
