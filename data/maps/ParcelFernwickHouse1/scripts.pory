mapscripts ParcelFernwickHouse1_MapScripts {
}

script ParcelFernwickHouse1_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: My brother's on the correction crew now. Same river, other side of the pipe. Dinner's loud.\pMy sister and him argue about the width. In paces. Both of them."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: My brother's dredge is idle pending survey. My sister wrote the survey. Dinner at ours is louder now. That's better. I think it's better."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: My brother's crew got stood down. He came to dinner. He talked. First time in a year the table had three voices on it.\pHe's angry at the wrong people still, but he's angry out loud, and that's a start."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: My brother works the marsh dredge. My sister works for the Corps.\pDinner at ours is very quiet."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse1_ReadCounter {
    msgbox(format("Three plates set, three chairs, one radio. The radio is set to the weather, which is the only thing everyone in this house agrees to listen to."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse1_ReadFridge {
    msgbox(format("A list on the fridge: DO NOT DISCUSS. The list is empty.\pSomebody wrote the heading, and nobody has dared add to it."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse1_ReadShelf {
    msgbox(format("A shelf of Corps field guides and a shelf of dredging manuals, spine to spine. Neither side has been dusted. Both have been read."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse1_Sister {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("SISTER: He read my second survey at the table too. Didn't say anything. Then he asked where the paces start from.\pThat's a question. I'll take a question."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SISTER: I wrote the Reedmere survey. The pipe. He read it at the dinner table with the gravy going cold and didn't say a word till the end.\pThen he said: that's my shift you've written about. I said yes. He said: you spelled the foreman's name wrong. I had. He fixed it. That's us, now. He fixes my spelling."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("SISTER: Corps, provisional, two years. He's on the dredge. We don't talk about work, so we don't talk.\pThe radio's on the weather because the weather's the one thing that happens to both of us the same. Sit down if you like. There's a third chair; it's been empty a while."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("SISTER: Corps, provisional, two years. He's on the dredge. We don't talk about work, so we don't talk.\pThe radio's on the weather because the weather's the one thing that happens to both of us the same."), MSGBOX_DEFAULT)
    }
    release
    end
}
