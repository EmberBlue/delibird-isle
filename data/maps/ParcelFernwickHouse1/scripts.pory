mapscripts ParcelFernwickHouse1_MapScripts {
}

script ParcelFernwickHouse1_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: My brother's dredge is idle pending survey. My sister wrote the survey. Dinner at ours is louder now. That's better. I think it's better."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: My brother's crew got stood down. He came to dinner. He talked. First time in a year the table had three voices on it.\pHe's angry at the wrong people still, but he's angry out loud, and that's a start."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: My brother works the marsh dredge. My sister works for the Corps.\pDinner at ours is very quiet."), MSGBOX_DEFAULT)
    release
    end
}
