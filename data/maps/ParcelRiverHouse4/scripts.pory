// ParcelRiverHouse4 -- a house in River: residents in two story states (before / after the hearing).

mapscripts ParcelRiverHouse4_MapScripts {
}

script ParcelRiverHouse4_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: Six names on the allocation. I read mine every market day. It hasn't moved.\pThat's what fair looks like, it turns out. It looks like a number that stays."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The Board posted the allocations with six names under them. I read mine twice. It's fair. First time I've written 'fair' on a form."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("WOMAN: Fish on market day, vegetables the rest, and now blankets with a crest from a van. The Board meters the water and the FOUNDATION hands out the wool.\pI took a blanket. It's a good blanket. I know what I took it with."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Fish on market day, vegetables the rest. The river gives both and the Board meters both."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse4_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("BOY: Twenty-two stalls! The hill people have potatoes now. I counted them twice. The ranger way.\pHALE's boy from FERNWICK counts his pond the same. We compared."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: Nineteen stalls today! I counted twice, like the ranger does."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("BOY: Fourteen stalls this spring, and now nineteen, because the hill people set up on the end with nothing on the table.\pI count them anyway. Mum says an empty stall still counts. I don't know. I counted it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: I count the stalls. Twenty-two on a good day. Fourteen this spring."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse4_ReadDresser {
    msgbox(format("A chalk slate on the dresser: STALLS. Twenty-two, rubbed out. Fourteen, rubbed out. Nineteen. The chalk is nearly gone."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse4_ReadDrawer {
    msgbox(format("Market scales in the drawer, and a Board water receipt under them. Fish on one side of the scale, metered water on the other."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelRiverHouse4_PaperStallLicence {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The market stall licence, renewed. The Board has crossed out FOUNDATION RATE and written BOARD RATE above it, which is the same number with a different name on it.\pShe has written beside the box that says FAIR: ask the six. She has not decided whether that is a joke."), MSGBOX_SIGN)
    } else {
        msgbox(format("The market stall licence, renewed each spring. Produce and fish, FOUNDATION RATE. The rate is printed; the licence fee is printed; the word FAIR is printed, in a box, as if it were a quantity.\pShe pays it. Everyone pays it. The box says fair."), MSGBOX_SIGN)
    }
    end
}
