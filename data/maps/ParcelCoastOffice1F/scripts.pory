// ParcelCoastOffice1F -- the Mereholt Foundation coast office, ground floor:
// the public exhibit. The plaque is CH6 bit 4, and the reveal: the Board's
// "sustainable harvest" model is Dr. Heron's methods, in Heron's hand.
mapscripts ParcelCoastOffice1F_MapScripts {
}
script ParcelCoastOffice1F_Reception {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("RECEPTION: Welcome to the MEREHOLT FOUNDATION. The exhibit's reopened. It's smaller.\pIt's mostly a map with the stakes on it, and the Survey's name under the map. Ms. AUNE insisted."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("RECEPTION: Welcome to the MEREHOLT FOUNDATION. The exhibit is closed for revision. Ms. AUNE is upstairs. She said if a RANGER came, to send you up, and to say nothing clever."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("RECEPTION: Welcome to the MEREHOLT FOUNDATION. The exhibit is closed for 'updating'. Ms. AUNE is upstairs. The brochures are being reprinted.\pDo take the old one. It's a collector's item now, the way things are going."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("RECEPTION: Welcome to the MEREHOLT FOUNDATION. The exhibit is free. Ms. AUNE is upstairs; she's expecting a RANGER. Do take a brochure."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastOffice1F_Visitor {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: I come in for the warm. There's a new thing on the wall where the model was. A map, with little red flags.\pI like it better. It doesn't promise anything."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: I come in for the warm. The model on the wall's been taken down. There's a lighter patch where it was. I understand the patch."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("MAN: I come in for the warm. Today they're taking the model off the wall. 'Updating.' I asked what was wrong with it. The young man said nothing's wrong with it.\pFewer fish every year and the model's fine. I'll miss it. It was very clever."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: I come in for the warm. They don't mind. The model on the wall's very clever. I don't understand a word of it and there's fewer fish every year, so I suppose it's working."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastOffice1F_Plaque {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 4)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The plaque. In the notebook, with the name underlined twice."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("SUSTAINABLE HARVEST FRAMEWORK -- MEREHOLT COASTAL FISHERIES. Yield curves. Age-class diagrams. The recovery model that governs every quota on this coast.\pSmall, at the bottom: after the methods of DR. E. HERON, with thanks."), MSGBOX_SIGN)
    msgbox(format("The hand in the diagrams is the hand in the notebook's margins. The same abbreviations. The same way of drawing a food web with the keystone circled.\pShe was never silenced. She is the citation. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelCoastOffice1F_Model {
    msgbox(format("A scale model of the harbour under glass. Tiny boats. A tiny cannery. The sea painted the blue it used to be. No urchins in the model."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelCoastOffice1F_Report {
    msgbox(format("STEWARDSHIP. The Foundation's annual report, on a stand, open at the chair's foreword. Heavy paper. A ranger on a ridge.\pIt has been my privilege, after a career in the Corps, to see conservation from the other side of the table, where decisions are funded rather than wished for.\pThis year the Foundation supported two field stations, forty-four certifications, the regional recovery model, and storm relief on Delibird Isle.\pThe region's habitats are resilient. Our science shows it. Our partners prove it every day.\pThe facing page is a chart. Forty years of curves, rising. There is no axis on the left. There is a logo where the axis would be."), MSGBOX_SIGN)
}

script ParcelCoastOffice1F_Leaflet {
    msgbox(format("A rack of leaflets, fanned. LEIRVIK WORKS: REMEDIATION UPDATE. The same leaflet, four printings, four years.\pThe first: works to commence in the spring. The second: works rescheduled following a review of the hydrology. The third: phase one complete, phase two to follow. Phase one was a fence.\pThe fourth: the Foundation continues to work closely with the community. A photograph of a booth, a banner, a child with a balloon.\pThe plate in the basin says what is in the water. None of the four leaflets does."), MSGBOX_SIGN)
}
