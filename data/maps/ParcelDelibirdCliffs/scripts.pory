    lock
    faceplayer
    msgbox(format("SOLVEIG: Nearly the top, they say. Not past me. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SOLVEIG: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_SOLVEIG_R4, format("SOLVEIG: Right. That's the whole of it."))
    msgbox(format("SOLVEIG: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
