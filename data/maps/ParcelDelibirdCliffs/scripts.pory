// ParcelDelibirdCliffs -- the Shoreline Cliffs (§09 / §13 fix A). The warming
// edge of Delibird Isle: a grass cliff-top running east from the village to the
// point beacon, and the beach below it, where species that should not be this
// far north yet are (range shift, §06). Two of Marta's three parcels land here:
// Tomas at the cliff foot, Rune at the beacon. Play the warmth straight; the
// dread is in the names on Einar's list. Trainers are 28-32 (zone 6).

const LOCALID_CLF_TOMAS = 1
const LOCALID_CLF_RUNE  = 2
const LOCALID_CLF_EINAR = 3

mapscripts ParcelDelibirdCliffs_MapScripts {
}

// --- Tomas: the first door on the round ------------------------------------------
script ParcelDelibirdCliffs_Tomas {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Tomas: The floor slopes a little more every year and the hearing didn't change that. It changed who's counting.\pMe, now. I've a book."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_DELIVERED)) {
        msgbox(format("Tomas: Warm through, thanks to you. Mind the corner of my cabin -- the floor slopes to the sea a little more each winter.\pUsed to be level. I remember it level."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_PARCEL)) {
        msgbox(format("An old fisher straightens, slow, by a cabin whose seaward corner has settled into the sand.\pTomas: From Marta? You carried this all the way down the cliff for an old man you've never met."), MSGBOX_DEFAULT)
        msgbox(format("Tomas: That's the island in you already, and you only just landed.\pHere -- take this for the road. No, take it. That's how it works. You'll learn."), MSGBOX_DEFAULT)
        giveitem(ITEM_HYPER_POTION)
        setflag(FLAG_SKALDMERE_DELIBIRD_DELIVERED)
        msgbox(format("Tomas: Now go on with the rest of the round. Marta will have a bird ready for you when it's done. She always does.\pIt's how she says thank you. Don't refuse it -- that's the one rude thing you can do here."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Tomas: Moved the cabin down here when the green went soft under it. The sand's honest, at least. It tells you when it's moving.\pCold off the water today. There's coffee in the square if you've come up short. Up here you never go without."), MSGBOX_DEFAULT)
    release
    end
}

// --- Rune: the point beacon --------------------------------------------------------
script ParcelDelibirdCliffs_Rune {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Rune: The beacon's in your record, is it? Good.\pIt's a long time since anyone wrote the point down for anything but wrecks."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_DEL_RUNE_DONE)) {
        msgbox(format("Rune: Tea's on. Marta's tea. You can taste the island in it, she says.\pI say you can taste the peat smoke, and that's the same thing."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_PARCEL)) {
        msgbox(format("An old man polishes a brass fitting on the beacon housing. It does not need polishing.\pRune: From Marta. The good tea and a blanket for the night watch. She never forgets the point. Nobody else remembers it."), MSGBOX_DEFAULT)
        msgbox(format("Rune: Four generations my family lit a fire here for the boats. Now it's a bulb, and MEREHOLT paid for the bulb, and the boats have radar.\pI polish it anyway. A thing kept is a thing kept."), MSGBOX_DEFAULT)
        msgbox(format("Rune: Take that -- it's what the old lamp used to flash with. Careful of the edge going back.\pThe edge is a different place every spring."), MSGBOX_DEFAULT)
        giveitem(ITEM_BRIGHT_POWDER)
        setflag(FLAG_SKALD_DEL_RUNE_DONE)
        release
        end
    }
    msgbox(format("Rune: The point beacon. Lit every night, fire or bulb, for as long as there've been boats stupid enough to need it.\pThe cliff under us has lost a boat's length since my father's day. We'll move the housing back again next year. It's what we do."), MSGBOX_DEFAULT)
    release
    end
}

// --- Einar: forty years of a shore, and a new name on the list ------------------
script ParcelDelibirdCliffs_Einar {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_FIRSTONE_DONE)) {
        msgbox(format("EINAR: Midwinter again this year, in chalk, in a better hand. The children keep the list now. I just read it.\pForty-two years. Dated."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_FIRSTONE) && !flag(FLAG_SKALD_Q_FIRSTONE_DONE)) {
        if (flag(FLAG_SKALD_Q_FIRSTONE_FOUND)) {
            msgbox(format("EINAR: Midwinter, this year, in chalk, in a hand with a backwards letter. It's on the list, then. Dated.\pForty-one years and the list has started writing itself faster than I can. Here. From the point, from when the water was cold."), MSGBOX_DEFAULT)
            giveitem(ITEM_DIVE_BALL, 2)
            setflag(FLAG_SKALD_Q_FIRSTONE_DONE)
        } else {
            msgbox(format("EINAR: The beach pools below. The children's chalk. The date."), MSGBOX_DEFAULT)
        }
        release
        end
    } elif (!flag(FLAG_SKALD_Q_FIRSTONE_DONE)) {
        msgbox(format("EINAR: Forty years of the list and CORSOLA's on it. The next thing on it, by my reckoning, will be a TENTACOOL in the beach pools. The children say there's one already.\pGo down and look. If there is, read me the date off whatever they've written beside it. Children date things."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_FIRSTONE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Einar: Your paper has my list in it. Forty years of a shore, in a footnote.\pI'll take a footnote. Footnotes are where the truth gets kept while the main text is still arguing."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("Einar: The coast counted its catch out loud, I hear. All one age. I've been saying it about the gulls for ten years.\pNobody counts the gulls. The gulls are fine. The gulls are always fine, until the list says otherwise."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("A man with binoculars does not lower them.\pEinar: CORSOLA. In the shallows off the point. Forty years I've kept the list for this shore and I had never once written that name.\pNow it's every tide. The water's warm enough for them. It isn't supposed to be warm enough for them.\pThat is the whole of what I know, and it took forty years."), MSGBOX_DEFAULT)
    release
    end
}

// --- signs -------------------------------------------------------------------------
script ParcelDelibirdCliffs_TrailSign {
    msgbox(format("SHORELINE CLIFFS\pThe beach is by the stairs at either end. Tomas's cabin is below the east stairs. The point beacon is past the rocks.\pMind the edge. It is not where the map says."), MSGBOX_SIGN)
    end
}

script ParcelDelibirdCliffs_BeaconSign {
    msgbox(format("THE POINT BEACON\pKept by the Reikvold family, four generations. Fire, then oil, then the bulb.\pSmaller, newer, bolted on: LIGHTING UPGRADE FUNDED BY THE MEREHOLT FOUNDATION."), MSGBOX_SIGN)
    end
}

// --- items ---------------------------------------------------------------------------
script ParcelDelibirdCliffs_ItemMaxRepel {
    finditem(ITEM_MAX_REPEL)
    end
}
script ParcelDelibirdCliffs_ItemBigPearl {
    finditem(ITEM_BIG_PEARL)
    end
}
script ParcelDelibirdCliffs_ItemUltraBall {
    finditem(ITEM_ULTRA_BALL)
    end
}

// --- trainers (28-32) ------------------------------------------------------------------
script ParcelDelibirdCliffs_T_Solveig {
    trainerbattle_single(TRAINER_SKALD_CLF_SOLVEIG,
        format("SOLVEIG: A picnic on the cliffs at Midwinter! Gran would have called me mad. Gran never had a Midwinter you could sit out in.\pBattle while the tea brews?"),
        format("SOLVEIG: Tea's ready anyway."),
        ParcelDelibirdCliffs_T_Solveig_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CLF_SOLVEIG_R2)) {
        goto(ParcelDelibirdCliffs_T_Solveig_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CLF_SOLVEIG_R3)) {
        goto(ParcelDelibirdCliffs_T_Solveig_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_CLF_SOLVEIG_R4)) {
        goto(ParcelDelibirdCliffs_T_Solveig_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_CLF_SOLVEIG_R5)) {
        goto(ParcelDelibirdCliffs_T_Solveig_R5)
    }
    msgbox(format("SOLVEIG: It's lovely. That's the awful part.\pIt's genuinely lovely up here now."), MSGBOX_DEFAULT)
    end
}
script ParcelDelibirdCliffs_T_Solveig_FirstWin {
    msgbox(format("SOLVEIG: It's lovely. That's the awful part.\pIt's genuinely lovely up here now."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Solveig_R2 {
    lock
    faceplayer
    msgbox(format("SOLVEIG: You again. I've had time to think about last time. Go again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SOLVEIG: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_SOLVEIG_R2, format("SOLVEIG: …Fair."))
    msgbox(format("SOLVEIG: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Solveig_R3 {
    lock
    faceplayer
    msgbox(format("SOLVEIG: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SOLVEIG: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_SOLVEIG_R3, format("SOLVEIG: …Fair."))
    msgbox(format("SOLVEIG: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
