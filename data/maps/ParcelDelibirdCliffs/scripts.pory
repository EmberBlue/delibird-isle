script ParcelDelibirdCliffs_T_Astrid {
    trainerbattle_single(TRAINER_SKALD_CLF_ASTRID,
        format("ASTRID: Out here the water's the same every year. It's the land that changes.\pYou've got a board under you, you've got a battle."),
        format("ASTRID: Good current on you."),
        ParcelDelibirdCliffs_T_Astrid_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CLF_ASTRID_R2)) {
        goto(ParcelDelibirdCliffs_T_Astrid_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CLF_ASTRID_R3)) {
        goto(ParcelDelibirdCliffs_T_Astrid_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_CLF_ASTRID_R4)) {
        goto(ParcelDelibirdCliffs_T_Astrid_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_CLF_ASTRID_R5)) {
        goto(ParcelDelibirdCliffs_T_Astrid_R5)
    }
    msgbox(format("ASTRID: I used to have to watch for ice floes off the point. Now I watch for the tour boats.\pI'd take the floes back."), MSGBOX_DEFAULT)
    end
}
script ParcelDelibirdCliffs_T_Astrid_FirstWin {
    msgbox(format("ASTRID: I used to have to watch for ice floes off the point. Now I watch for the tour boats.\pI'd take the floes back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Astrid_R2 {
    lock
    faceplayer
    msgbox(format("ASTRID: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASTRID: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_ASTRID_R2, format("ASTRID: Still yours."))
    msgbox(format("ASTRID: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Astrid_R3 {
    lock
    faceplayer
    msgbox(format("ASTRID: Three stamps, then five. Fine. Me next?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASTRID: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_ASTRID_R3, format("ASTRID: …Fair."))
    msgbox(format("ASTRID: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Astrid_R4 {
    lock
    faceplayer
    msgbox(format("ASTRID: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASTRID: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_ASTRID_R4, format("ASTRID: Right. That's the whole of it."))
    msgbox(format("ASTRID: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdCliffs_T_Astrid_R5 {
    lock
    faceplayer
    msgbox(format("ASTRID: Last one. I've put everything I've got into this team. Go?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASTRID: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CLF_ASTRID_R5, format("ASTRID: Noted. Properly, this time."))
    msgbox(format("ASTRID: Five. Write that one down too. I'll know you did."), MSGBOX_DEFAULT)
    release
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelDelibirdCliffs_PairBeach {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MOTHER: EINAR's put the date on the CORSOLA. Then he put the date the first TENTACOOL came, under it. He says the list is a clock now."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: What time is it?"), MSGBOX_DEFAULT)
        msgbox(format("MOTHER: Later than it was. Go and swim. It really is warm."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("GIRL: The ranger wrote down the CORSOLA. EINAR showed them the list."), MSGBOX_DEFAULT)
        msgbox(format("MOTHER: Forty years on the list and never seen till now."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: That's good, isn't it? It's on the list!"), MSGBOX_DEFAULT)
        msgbox(format("MOTHER: It's on the list the way a storm is on the forecast, love. Being right about it is not the same as wanting it."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GIRL: The water's warm enough to swim! At Midwinter!"), MSGBOX_DEFAULT)
        msgbox(format("MOTHER: Yes."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: Why aren't you happy?"), MSGBOX_DEFAULT)
        msgbox(format("MOTHER: I'm happy for you. Go and swim. I'll be the one on the beach not being happy, and you can ask me about it when you're older."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- side quests, round four (2026-11-10) ---

script ParcelDelibirdCliffs_FindFirstone {
    if (flag(FLAG_SKALD_Q_FIRSTONE) && !flag(FLAG_SKALD_Q_FIRSTONE_FOUND)) {
        msgbox(format("A tide pool on the warm beach. In it, a TENTACOOL, small, slow, a long way from anywhere it belongs. On the rock beside the pool, in chalk, in a child's hand: FIRST ONE, and this Midwinter's date, with one letter the wrong way round.\pSomebody has drawn a circle round the whole thing, pool and all, to keep it."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_FIRSTONE_FOUND)
    } else {
        msgbox(format("A tide pool with a chalk circle round it. FIRST ONE, and a date. The TENTACOOL has gone back out, or down. The chalk is staying."), MSGBOX_SIGN)
    }
    end
}

// --- survey boards (2026-11-10) ---

script ParcelDelibirdCliffs_Board1 {
    msgbox(format("A SURVEY BOARD on the cliff path. SHORELINE CLIFFS. The ledges hold the colony and the SNEASEL rob it, as they have since the record began. The board gives the nest count and the raid count. Both fall.\pWhen the robber and the robbed fall together, the Survey writes, the cause is not the robber."), MSGBOX_SIGN)
    end
}

script ParcelDelibirdCliffs_Board2 {
    msgbox(format("A SURVEY BOARD at the bench. STARYU below, in the cold current, lit when the water is clean. The board's instruction is one line: sit until dark and count the lights.\pThe second line is newer. If there are none, write none. None is a reading."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round four ---

script ParcelDelibirdCliffs_PairLedge {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BIRDER: Two hundred and nine. Up three."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: Three."), MSGBOX_DEFAULT)
        msgbox(format("BIRDER: I know. I wrote it in pencil. Three is a pencil number. Ten is ink."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("WOMAN: The ranger sat on the bench till dark and counted the lights in the water."), MSGBOX_DEFAULT)
        msgbox(format("BIRDER: STARYU. I've never counted them. I count up, not down."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: Maybe that's why the island's two counts short."), MSGBOX_DEFAULT)
        msgbox(format("BIRDER: Maybe. Hand me the glass."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("BIRDER: Two hundred nests on the ledges. Two hundred and six."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: You count every year and every year it's less."), MSGBOX_DEFAULT)
        msgbox(format("BIRDER: It's less by less this year."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: Is that good?"), MSGBOX_DEFAULT)
        msgbox(format("BIRDER: It's the shape of the number. I'll take the shape."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards, round two (2026-11-10) ---

script ParcelDelibirdCliffs_Board3 {
    msgbox(format("A SURVEY BOARD on the path above the pools. CORSOLA in the warm pools, new; KRABBY in the cold ones, fewer. The children chalk the pools' names on the rock and the Survey copies the chalk onto the board before the rain takes it.\pThe children are the Survey's best field team on this island, and know it."), MSGBOX_SIGN)
    end
}
