script ParcelDelibirdCliffs_T_Geir {
    trainerbattle_single(TRAINER_SKALD_CLF_GEIR,
        format("GEIR: CORSOLA on the line. In this water. My father fished this tide line fifty years and never saw one north of the Coast.\pBattle while I think about that."),
        format("GEIR: Hm. Caught, properly."),
        ParcelDelibirdCliffs_T_Geir_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CLF_GEIR_R2)) {
        goto(ParcelDelibirdCliffs_T_Geir_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CLF_GEIR_R3)) {
