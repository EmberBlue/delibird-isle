// ParcelWetlandsHouse2 -- a house in Wetlands: residents in two story states (before / after the hearing).

mapscripts ParcelWetlandsHouse2_MapScripts {
}

script ParcelWetlandsHouse2_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_REED) && !flag(FLAG_SKALD_Q_REED_DONE)) {
        if (flag(FLAG_SKALD_Q_REED_FOUND)) {
            msgbox(format("OLD MAN: Nineteen. There were forty in that bed when I was your age. Fifty-one when my father cut it.\pNineteen goes to the river hall in your writing, not mine. Yours gets read."), MSGBOX_DEFAULT)
            msgbox(format("OLD MAN: Take this. Found it in the beds years back; the heron that owned it was quicker than me. It'll be quicker than whatever you're facing, too."), MSGBOX_DEFAULT)
            giveitem(ITEM_QUICK_CLAW)
            setflag(FLAG_SKALD_Q_REED_DONE)
            msgbox(format("OLD MAN: Eight years to come back, and nineteen stands. Write both. One without the other is a lie by halves."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("OLD MAN: West of the landing, the reed bed past the pond. Taller than you. Count them."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: GUNNAR's SURSKIT count went up this month. First time. He told everyone. He told me twice."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_REED_DONE)) {
        msgbox(format("OLD MAN: Twelve-year rounds, I told you. Eight, now. I've said eight to the river hall and the river hall wants it counted, not said.\pMy knees won't do the beds any more. Go and count the stands still standing in the bed west of the landing, past the pond. Count the ones taller than you. That's the rule. Taller than a person is a stand."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_REED)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD MAN: The reeds came back at eight years this time. Not twelve. I wrote eight down and sent it to the river hall, because somebody said they were collecting.\pSixty years cutting reed and I've never sent a number anywhere. It felt like posting a letter to the weather."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: I cut reed for thatch. Twelve-year rounds, like the mill wood. The reeds don't come back on the twelve now. Eight, maybe."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsHouse2_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: Forty-nine! I'm the clicker now. GUNNAR says I'm 'very accurate'."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: GUNNAR says the river people counted their frogs in front of everybody. With a clicker, like ours!\pForty-four. I'm going to count again when the water's colder. GUNNAR says colder is when it matters."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: I helped GUNNAR count. He let me hold the clicker. Forty-four!"), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsHouse2_ReadDresser {
    msgbox(format("A reed knife on the dresser, and a notebook: TWELVE. Then EIGHT, with a line under it, and a river hall address on the facing page."), MSGBOX_SIGN)
    end
}

script ParcelWetlandsHouse2_ReadDrawer {
    msgbox(format("GUNNAR's spare clicker, in the drawer, on a ribbon. Forty-four, it still says. Nobody has pressed it since."), MSGBOX_SIGN)
    end
}
