// ParcelCorridorAdit -- Mereholt Subsurface Survey Adit 3, under the plateau
// east of the culvert. Pumped dry and abandoned; needs Flash. The first place
// HM05 is for. One of the chalk marks on the wall is in Heron's hand.

mapscripts ParcelCorridorAdit_MapScripts {
}

script ParcelCorridorAdit_ItemRareCandy { finditem(ITEM_RARE_CANDY) end }
script ParcelCorridorAdit_ItemEscapeRope { finditem(ITEM_ESCAPE_ROPE) end }

script ParcelCorridorAdit_Mark {
    msgbox(format("Survey marks chalked on the rock, one above the other. Dates. Water heights.\pThe oldest is the highest. The newest is a hand-span lower, and the hand that wrote it is not the same hand.\pUnder it, small: H."), MSGBOX_SIGN)
    end
}

script ParcelCorridorAdit_Satchel {
    lock
    if (flag(FLAG_SKALD_Q_FLOW) && !flag(FLAG_SKALD_Q_FLOW_FOUND)) {
        msgbox(format("A survey satchel wedged in the rock, dry. Inside: FLOW SURVEY -- HOLLOWBEND SPUR -- PRE-CONSTRUCTION. Eleven pages.\pThe culvert bore in the plan is 1.2 metres. Taken."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_FLOW_FOUND)
        release
        end
    }
    msgbox(format("A crack in the rock where a satchel used to be wedged. Dry. Empty now."), MSGBOX_SIGN)
    release
    end
}

script ParcelCorridorAdit_Pump {
    msgbox(format("The pump housing, rusted to the rock. MEREHOLT SUBSURFACE, a serial number, and a brass plate: DEWATERED. The date is the year before the culvert went in.\pBelow the plate, scratched: and never watered again. The seepage pools on the floor say otherwise. Slowly, in its own time, the ground is getting its water back without asking the plate."), MSGBOX_SIGN)
    end
}
