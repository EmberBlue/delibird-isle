// ParcelTownLodging -- the lodging from §07 ("the door with the lamp lit").
// The letter scene (§07 Scene 2) will be staged here when the full prologue
// cutscene lands; for now it is warmth, a bed, and a keeper who doesn't pry.

mapscripts ParcelTownLodging_MapScripts {
}

script ParcelTownLodging_Keeper {
    lock
    faceplayer
    msgbox(format("Keeper: The scientist's room is paid through the season.\pShe insisted. Before."), MSGBOX_DEFAULT)
    msgbox(format("Keeper: You look wrung out.\nRest a while?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        closemessage
        fadescreen(FADE_TO_BLACK)
        call(Common_EventScript_OutOfCenterPartyHeal)
        fadescreen(FADE_FROM_BLACK)
        msgbox(format("Morning comes gray and early.\pYour partner looks rested.\nSo, almost, do you."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Keeper: The kettle's always on."), MSGBOX_DEFAULT)
    }
    release
    end
}


// §07 Scene 2 -- the mentor's letter, on the desk in her paid-up room.
// The three quoted lines are canonical-verbatim.
script ParcelTownLodging_Letter {
    lock
    msgbox(format("A letter lies on the desk, addressed in a careful field-hand you know from years of margins."), MSGBOX_DEFAULT)
    msgbox(format("You don't need to be brilliant.\nYou need to be honest."), MSGBOX_DEFAULT)
    msgbox(format("If the data is real, people will try to bury it. Not because they're evil--because it threatens what they've built."), MSGBOX_DEFAULT)
    msgbox(format("Meet me at the lab in the morning.\nCome early. Bring curiosity.\nBring boots."), MSGBOX_DEFAULT)
    msgbox(format("The letter is dated three weeks ago."), MSGBOX_DEFAULT)
    release
    end
}
