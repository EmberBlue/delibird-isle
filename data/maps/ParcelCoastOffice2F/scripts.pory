// ParcelCoastOffice2F -- Hollis Aune's office. The kindest threat in the game.
mapscripts ParcelCoastOffice2F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelCoastOffice2F_OnTransition
}

script ParcelCoastOffice2F_OnTransition {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        clearflag(FLAG_SKALD_PERRIN_DESK)
    } else {
        setflag(FLAG_SKALD_PERRIN_DESK)
    }
    end
}
script ParcelCoastOffice2F_Hollis {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
        msgbox(format("HOLLIS: The conservation programme is being restructured. Her word. I typed the memo myself. I still type well.\pYou'll want to know whether I'd do it again. So do I, RANGER. So do I."), MSGBOX_DEFAULT)
        msgbox(format("HOLLIS: No tea today. There's nowhere left to put the kindness."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("HOLLIS: The tea's still on, RANGER. The offer with it. Think about how you write it. That's all I ever ask."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HOLLIS: RANGER. Sit. You've been thorough; the whole coast, I hear. Good. Thoroughness is rare. Two cups, I don't need to ask."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: I'll be direct, since you've earned direct. Your survey will be read. By the Board, by the press, by the people who fund what recovery there is out there.\pAnd the model they trust, the one keeping this coast working at all, has one name on it."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: …DR. HERON's."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: I would hate for one unmeasured word from you to undo her life's work. For her to be remembered as the scientist whose model failed, instead of the one whose science is the only reason there's a fishery left to argue about."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: So think about how you write it. For her sake. That's the whole of what I'm asking.\pIt's very good tea. Drink it while it's hot."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastOffice2F_Secretary {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SECRETARY: Ms. AUNE still sees everyone. Fewer come. She remembers how each of them took their tea. She has started making it herself."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SECRETARY: Ms. AUNE sees everyone. Fishers, mayors, RANGERS. She remembers how they take their tea. She remembers everything. It's why they sent her."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastOffice2F_Perrin {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelCoastOffice2F_Perrin_Last)
    }
    msgbox(format("PERRIN: They gave me a desk. The one by the window. HOLLIS said I'd earned it.\pI read your filing. All of it. Twice. I typed the response. It's very good. It's the best thing I've ever written and it isn't true."), MSGBOX_DEFAULT)
    msgbox(format("PERRIN: I'm not sorry. I'm not NOT sorry. Is that an answer?\pGo on. You've got a ferry. I've got a window."), MSGBOX_DEFAULT)
    release
    end
}

// --- post-game: one more, for him, not the ranking ---
script ParcelCoastOffice2F_Perrin_Last {
    if (flag(FLAG_SKALD_PERRIN_7_DONE)) {
        msgbox(format("PERRIN: I'm staying. Someone should be in here who's read it. That's me, now.\pThe window's good. You can see the ferry from it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("PERRIN: WREN. They put the hearing on the office speaker. HOLLIS listened to all of it with her tea going cold.\pOne more. Not for the ranking. For me. Please."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("PERRIN: Then later. I'll be at this desk. It's a good desk."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_7, format("PERRIN: …Okay. Okay. That one I'll keep."))
    setflag(FLAG_SKALD_PERRIN_7_DONE)
    msgbox(format("PERRIN: I'm staying. Someone should be in here who's read it. That's me, now.\pGo on. You've got a region. I've got a window."), MSGBOX_DEFAULT)
    release
    end
}
