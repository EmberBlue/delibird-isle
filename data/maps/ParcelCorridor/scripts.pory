        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_COR_GEIR_R3, format("GEIR: …Again, then. Later."))
    msgbox(format("GEIR: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
