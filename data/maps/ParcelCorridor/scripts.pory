script ParcelCorridor_Per {
    trainerbattle_single(TRAINER_SKALD_COR_PER,
        format("PER: The moths only come out where the big trees are left. I counted. Battle?"),
        format("PER: You counted better."),
        ParcelCorridor_Per_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_COR_PER_R2)) {
        goto(ParcelCorridor_Per_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_COR_PER_R3)) {
        goto(ParcelCorridor_Per_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_COR_PER_R4)) {
        goto(ParcelCorridor_Per_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_COR_PER_R5)) {
        goto(ParcelCorridor_Per_R5)
    }
    msgbox(format("PER: Six DUSTOX in the old stand by the ledges. Zero in the cut. That's a number, isn't it? That's a finding."), MSGBOX_DEFAULT)
    end
}
