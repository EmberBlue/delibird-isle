script ParcelCorridor_Else {
    trainerbattle_single(TRAINER_SKALD_COR_ELSE,
        format("ELSE: Quiet, isn't it. Too quiet. Nothing lives in a cut like this except trainers."),
        format("ELSE: And now one fewer."),
        ParcelCorridor_Else_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_COR_ELSE_R2)) {
        goto(ParcelCorridor_Else_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_COR_ELSE_R3)) {
        goto(ParcelCorridor_Else_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_COR_ELSE_R4)) {
        goto(ParcelCorridor_Else_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_COR_ELSE_R5)) {
        goto(ParcelCorridor_Else_R5)
    }
    msgbox(format("ELSE: There used to be a stream through the grass here. You can still see where. Dry as a bone."), MSGBOX_DEFAULT)
    end
}
