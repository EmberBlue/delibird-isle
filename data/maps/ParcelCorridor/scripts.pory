// --- PERRIN, encounter 3 (the peer; §04) -------------------------------------------
script ParcelCorridor_PerrinScene {
    if (flag(FLAG_SKALD_PERRIN_3)) {
        setvar(VAR_TEMP_5, 1)
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("PERRIN: WREN!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelCorridor_PerrinIn)
    waitmovement(0)
    msgbox(format("PERRIN: The basin's next. MIRREN says it's a mess. The FOUNDATION says it's 'in remediation'.\pI'm going with the people who have a plan. Battle, before you talk me out of it."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_3, format("PERRIN: You didn't talk me out of it."))
    msgbox(format("PERRIN: You know the difference between us? You write down what's there. I write down what's possible.\pTheirs reads better in a report. Mine, I mean. Ours."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelCorridor_PerrinOut)
    waitmovement(0)
    removeobject(LOCALID_PERRIN)
    setflag(FLAG_SKALD_PERRIN_3)
    setvar(VAR_TEMP_5, 1)
    releaseall
    end
}
script ParcelCorridor_PerrinTalk {
    lock
    faceplayer
    msgbox(format("PERRIN: Hang on, I'm coming to you."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_ParcelCorridor_PerrinIn { walk_down * 2 }
movement Movement_ParcelCorridor_PerrinOut { walk_up * 2 }

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelCorridor_Mirren_Rematch {
    lock
    faceplayer
    msgbox(format("MIRREN: You filed the basin as what it is, and then you filed everything else the same way. Half the division is still rounding up.\pI don't round. Full strength, no gate, nothing signed at the end. Want it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("MIRREN: Suit yourself. The rock doesn't move."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM2_R, format("MIRREN: …Steady. Still."))
    msgbox(format("MIRREN: Same time tomorrow, if you like. The rock doesn't move."), MSGBOX_DEFAULT)
    release
    end
}

// The zone's survey stake (§13 fix E): reads the chapter's evidence back.
script ParcelCorridor_SurveyStake {
    msgbox(format("A survey stake by the checkpoint, red cloth at the top. The bare stakes along the cut are MEREHOLT's. This one is yours."), MSGBOX_SIGN)
    setvar(VAR_0x8004, 1)
    special(SkaldSurveyStake)
    msgbox(gStringVar4, MSGBOX_SIGN)
    if (flag(FLAG_SKALD_SECOND) && !flag(FLAG_SKALD_SECOND_1)) {
        msgbox(format("Second reading. Four grates in the culvert, culvert type, and two frogs through them this morning, upstream. The slide is cleared and the adit is dark and quiet.\pThe schedule still says next month about something. It always will. You write the two frogs."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_SECOND_1)
    }
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelCorridor_PairCulvert {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ROADMAN: The grates came. Four of them. Culvert type."), MSGBOX_DEFAULT)
        msgbox(format("SURVEY HAND: Five months after next month. And a sixth form, this one with a real date on it, and a ranger's initials."), MSGBOX_DEFAULT)
        msgbox(format("ROADMAN: Frogs through yet?"), MSGBOX_DEFAULT)
        msgbox(format("SURVEY HAND: Two this morning. Upstream. Against the current, which is the point."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("SURVEY HAND: The ranger didn't try to stop the crew. I half expected it."), MSGBOX_DEFAULT)
        msgbox(format("ROADMAN: What did they do?"), MSGBOX_DEFAULT)
        msgbox(format("SURVEY HAND: Stood at the culvert and wrote until the foreman got uncomfortable and offered a date. Then wrote the date down. The foreman looked like he'd been stabbed."), MSGBOX_DEFAULT)
        msgbox(format("ROADMAN: A date in a notebook's worse than a shout. You can't argue with it later."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("ROADMAN: Grates next month, the office says."), MSGBOX_DEFAULT)
        msgbox(format("SURVEY HAND: The office has said next month for five months. I've stopped writing the date on the form; I write 'next month' and it's always right."), MSGBOX_DEFAULT)
        msgbox(format("ROADMAN: What goes down the pipe meanwhile?"), MSGBOX_DEFAULT)
        msgbox(format("SURVEY HAND: Everything that fits. That's what a pipe is for, they'd say."), MSGBOX_DEFAULT)
    }
    release
    end
}
