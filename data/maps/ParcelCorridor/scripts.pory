script ParcelCorridor_Rune {
    trainerbattle_single(TRAINER_SKALD_COR_RUNE,
        format("RUNE: The ledges are the best bit. You can jump them. Can you jump me?"),
        format("RUNE: Jumped."),
        ParcelCorridor_Rune_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_COR_RUNE_R2)) {
        goto(ParcelCorridor_Rune_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_COR_RUNE_R3)) {
        goto(ParcelCorridor_Rune_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_COR_RUNE_R4)) {
        goto(ParcelCorridor_Rune_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_COR_RUNE_R5)) {
        goto(ParcelCorridor_Rune_R5)
    }
    msgbox(format("RUNE: The CORPS cadets won't jump the ledges. 'Erosion.' It's a ledge!"), MSGBOX_DEFAULT)
    end
}
