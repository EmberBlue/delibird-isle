// ParcelCoastUnion -- the fishermen's union hall. Quotas, notes, and the men who hold them.
mapscripts ParcelCoastUnion_MapScripts {
}
script ParcelCoastUnion_Chair {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CHAIR: The review grounds half the fleet two days a week. Half the hall wants your head. The other half knows the fish were gone anyway and somebody finally said so.\pI'm the other half. Barely."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CHAIR: Union of Coastal Fishers. Forty-one boats. Forty-one notes held by MEREHOLT COASTAL LENDING. Guess how our votes go on quota day.\pWe're not cowards, RANGER. We're mortgaged."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastUnion_Fisher1 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: HARLAND spoke for the river and the coast both, in one breath. The hearing let him. Nine minutes. I timed it. Best nine minutes this hall's had."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("FISHER: HARLAND lost. On the quay, to a ranger, and shook hands, and then he came in here and said: it's written now. Like that settled something.\pForty-one notes with the lender. Forty-one men who heard him say it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: HARLAND came down from the river to fish the coast because the river was done. Now the coast's done. There's nowhere further down."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastUnion_Fisher2 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: The Board's model said six years. The review threw the model out and said 'we don't know'. I'll take 'we don't know'. It's the first true thing they've said about the stock."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("FISHER: The Board's model said six years, six years ago. Your survey says COLLAPSING, this year.\pOne of those is a date you can check. The hall voted to put yours on the notice board. The lender's man was in the room. He didn't object. He wrote it down."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: The Board's model says the stock recovers in six years if we hold the quota. It said that six years ago."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastUnion_Board {
    msgbox(format("MINUTES. Motion to request an independent stock survey: proposed, seconded, deferred. Deferred. Deferred. Deferred. Four years of the same line."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelCoastUnion_Carbons {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The folder of carbons, on the table where anyone can read it now. Ten sheets. The tenth is white, not blue, and typed: READ INTO THE RECORD.\pYear one. OBJECTION. The dredge is taking the ground the fish spawn on and I object.\pYear two. OBJECTION. The dredge is taking the ground and the harbour is silting where it never did and I object.\pYear three. OBJECTION. Last year's objection stands. Add: the small fish are gone from the east side.\pYear four. OBJECTION. One sentence, pressed hard enough to tear. It is about the size of a fish.\pYear five. Objection. I have stopped writing it in capitals. I am told it is noted. I would like to know where.\pYear six. Objection. The catch book is in the cannery. Anyone may read it. I object to the catch book.\pYear seven. Objection. My son has taken work on the dredge. I object to that too and he knows it.\pYear eight. Objection. Nine fishers signed this one. We would like a reply.\pYear nine. Objection, with the red-cloth dates the Surveyor gave me. Thirty-one years. Read them.\pYear ten, typed, this season. The objector was heard. The ranger's survey was heard. The Surveyor's baselines were heard. Item 7 took the whole afternoon."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALD_Q_CARBON_DONE)) {
        msgbox(format("The folder of carbons, closed with a rubber band. Nine blue sheets, one a year. The fourth is creased from a shoe and smoothed flat again.\pYear one. OBJECTION. The dredge is taking the ground the fish spawn on and I object.\pYear two. OBJECTION. The dredge is taking the ground and the harbour is silting where it never did and I object.\pYear three. OBJECTION. Last year's objection stands. Add: the small fish are gone from the east side.\pYear four. OBJECTION. One sentence, pressed hard enough to tear. It is about the size of a fish.\pYear five. Objection. I have stopped writing it in capitals. I am told it is noted. I would like to know where.\pYear six. Objection. The catch book is in the cannery. Anyone may read it. I object to the catch book.\pYear seven. Objection. My son has taken work on the dredge. I object to that too and he knows it.\pYear eight. Objection. Nine fishers signed this one. We would like a reply.\pYear nine. Objection, with the red-cloth dates the Surveyor gave me. Thirty-one years. Read them.\pNine. The tenth sheet is still in the typewriter upstairs."), MSGBOX_SIGN)
    } else {
        msgbox(format("A folder with a rubber band round it. CARBONS, in capitals, and under that, smaller: do not lend.\pBlue sheets, one a year, each headed OBJECTION. Eight. Between the third and the fifth there is a gap where a sheet should be.\pThe first reads: the dredge is taking the ground the fish spawn on and I object. The eighth is signed by nine fishers and asks for a reply.\pNobody has written a reply on any of them."), MSGBOX_SIGN)
    }
}

script ParcelCoastUnion_Roll {
    msgbox(format("The membership roll. A name, a boat, a year joined. Three columns, four decades.\pThe boats are crossed through more often than the names. A boat sold is one line; a boat sold to the dredge company is two lines and a word nobody has rubbed out.\pThe newest line has a name and no boat. The chair wrote it in himself: the oysterman's grandson, who has never fished. Members, the chair says, are whoever the sea has taken something from. The roll agrees."), MSGBOX_SIGN)
    end
}
