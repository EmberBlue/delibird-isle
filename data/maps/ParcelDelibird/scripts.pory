// --- the epilogue, stop 5 of 8 ---
script ParcelDelibird_Epilogue {
    lockall
    delay(20)
    msgbox(format("DELIBIRD ISLE. The thaw didn't stop because a hearing sat. The festival ground is a third mud.\pThe delivery list is up on the square again, longer than last year, and every house on it has a name beside it before noon."), MSGBOX_DEFAULT)
    msgbox(format("MARTA's list has your name beside a door you have never been through. KETIL says the bird put it there. It goes where something's needed; it always has.\pUp the slope the wet ground shines back at the lights. Someone has set a row of stakes along the line of it, red cloth on every one. They did not wait for a surveyor."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 6)
    warp(MAP_PARCEL_MARSH, 19, 9)
    waitstate
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelDelibird_GymIlex_Rematch {
    lock
    faceplayer
    msgbox(format("Ilex: The snowline is lower than last Midwinter. I have the number now. It's in your record.\pThe Skyline is mine to read. Read it with me once more, from the top. Will you?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("Ilex: Then watch the snowline with me a while."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM8_R, format("Ilex: Steady. You still keep the frame."))
    msgbox(format("Ilex: The cloth is in my pocket. Whenever you like."), MSGBOX_DEFAULT)
    release
    end
}

// --- town life (2026-11-10): the pairs ---

script ParcelDelibird_PairLights {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GRANDMOTHER: The square's lit. Nobody cheered. Did you notice? Nobody cheered."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Was that wrong?"), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: It was right. You don't cheer a lamp in a storm. You stand near it."), MSGBOX_DEFAULT)
        msgbox(format("BOY: The ranger stood near it."), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: The ranger looked up the slope at the wet ground, same as me. Then stood near it anyway. That's the whole of being grown."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("BOY: The ranger did the whole round. Three doors, on foot. MARTA gave them the bird."), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: MARTA gave them the bird because the bird chose. You don't give a DELIBIRD. It goes."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Where would it go?"), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: Wherever something's needed. It has a worse sense of self-preservation than you do."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GRANDMOTHER: The stringer's up the ladder again. Every bulb on the eaves tested, and it's a month off."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Why so early?"), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: Because the ground under the ladder was dry last year and it isn't this year. She wants it done before it isn't a ladder you'd want to stand on."), MSGBOX_DEFAULT)
        msgbox(format("BOY: Can I hold the ladder?"), MSGBOX_DEFAULT)
        msgbox(format("GRANDMOTHER: Hold the ladder. That's what boys are for."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelDelibird_PairGround {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WIFE: The FOUNDATION's paper about moving the festival. MARTA wrote back 'thank you, and no'. In those words."), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: And the Council?"), MSGBOX_DEFAULT)
        msgbox(format("WIFE: Sent a surveyor. A real one, with the red cloth. To ask us where we'd want to be, if."), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: If."), MSGBOX_DEFAULT)
        msgbox(format("WIFE: If. First time anyone's said it to us as a question."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("HUSBAND: The ranger measured the slump with a tape. Wrote the number on the stake and the date under it."), MSGBOX_DEFAULT)
        msgbox(format("WIFE: What was the number?"), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: Doesn't matter. What matters is there'll be another number next year under it, and anyone can see which way they go."), MSGBOX_DEFAULT)
        msgbox(format("WIFE: That's not comfort."), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: No. It's a ruler. We've had comfort. It came with a crest on it."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("WIFE: TOMAS's cabin corner is in the ground to the sill. Ketil's talking about moving him."), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: Moving him where? Every cabin on the north side has a corner going."), MSGBOX_DEFAULT)
        msgbox(format("WIFE: Then we move the north side."), MSGBOX_DEFAULT)
        msgbox(format("HUSBAND: We've moved it twice in my life. Each time it caught us up."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- side quests, round three (2026-11-10) ---

script ParcelDelibird_LampStringer {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_SCRATCH_DONE)) {
        msgbox(format("STRINGER: Two hands. I say it before I go up the ladder now. Then I go up the ladder."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALD_Q_SCRATCH)) {
        if (flag(FLAG_SKALD_Q_SCRATCH_FOUND)) {
            msgbox(format("STRINGER: Two hands. …Two hands in nine years. It isn't the ladder.\pI'll string them anyway. Here. For climbing things that sink."), MSGBOX_DEFAULT)
            giveitem(ITEM_RARE_CANDY, 1)
            setflag(FLAG_SKALD_Q_SCRATCH_DONE)
        } else {
            msgbox(format("STRINGER: The warming hut wall. A scratch at head height. Mine was, the first year."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("STRINGER: I string the lights. Every year the foot of the ladder sits a little lower against the hut wall, and I tell myself it's the ladder.\pThere's a scratch on the hut wall from the first year, head height. Go and read how far below it the ground is now. I can't make myself."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_SCRATCH)
    }
    release
    end
}

script ParcelDelibird_HutScratch {
    if (flag(FLAG_SKALD_Q_SCRATCH) && !flag(FLAG_SKALD_Q_SCRATCH_FOUND)) {
        msgbox(format("A scratch on the hut wall at head height, with a year beside it, nine winters back. The ground beneath it has gone down two hands since. The sill is in the earth.\pSomeone has added a second scratch, this year, level with the first. The wall hasn't moved. The island has."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_SCRATCH_FOUND)
    } else {
        msgbox(format("Two scratches on the hut wall, level with each other, nine years apart. The ground between them has gone."), MSGBOX_SIGN)
    }
    end
}
