// ParcelIsleSigrunHouse -- Sigrun's. Empty but for the photograph and the
// gull that comes in the window.

mapscripts ParcelIsleSigrunHouse_MapScripts {
}

script ParcelIsleSigrunHouse_Wingull {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
    msgbox(format("A WINGULL, in the house like it owns the place.\pIt looks at you, then at the window, then at you."), MSGBOX_DEFAULT)
    waitmoncry
    release
    end
}

script ParcelIsleSigrunHouse_Photo {
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("A photo of a man on a boat, laughing, one hand on the rail.\pOn the hull, in the corner of the frame: a green-and-gray crest. The same one as the gate, the office, the blankets."), MSGBOX_SIGN)
    } else {
        msgbox(format("A photo of a man on a boat, laughing, one hand on the rail.\pThe frame is the cleanest thing in the room."), MSGBOX_SIGN)
    }
    end
}
