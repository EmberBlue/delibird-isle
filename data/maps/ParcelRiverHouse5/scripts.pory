// ParcelRiverHouse5 -- a house in River: residents in two story states (before / after the hearing).

mapscripts ParcelRiverHouse5_MapScripts {
}

script ParcelRiverHouse5_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("OLD MAN: The race ran all spring. The wheel turned. I ground a sack of flour on it and the baker said it was fine flour, and I said it was forty years of flour.\pHe gave it back. Said it was too good to sell."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: The allocation gives the race a trickle in spring. A trickle turns a wheel if you've the patience. I've the patience."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("OLD MAN: They say the ground up at HAUKFELL lets go in the spring the way the race let go of its water. No noise. Just gone one morning.\pI oil a wheel that doesn't turn. Those people oil a house that moves. We should talk."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: I ran the mill until the race went dry. The wood's still there. The race is still there. The water isn't."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse5_OldWoman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("OLD WOMAN: Two lunches, every day. Him and the HAUKFELL man. They sit by the race and watch it run and don't say a word.\pMen. I'd want to say something."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD WOMAN: He came back from the mill wet to the knee and grinning. The race ran an hour. One hour, in forty years of waiting."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("OLD WOMAN: I packed him two lunches today. One for the mill, one for the man from HAUKFELL who sits by the dry race and doesn't say anything.\pMy husband doesn't say anything either. They get on."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD WOMAN: My husband walks to the mill every morning to oil a wheel that doesn't turn. I pack him a lunch. It's a marriage."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse5_ReadDresser {
    msgbox(format("A mill key on the dresser, oiled. The lock it fits has not been turned in years. The key has."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse5_ReadDrawer {
    msgbox(format("Two lunch tins in the drawer. One has been in use for forty years. The other is new."), MSGBOX_SIGN)
    end
}
