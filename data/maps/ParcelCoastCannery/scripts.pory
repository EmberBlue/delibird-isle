// ParcelCoastCannery -- the Mereholt cannery floor. Two shifts a day. The fish stop; the cannery doesn't.
mapscripts ParcelCoastCannery_MapScripts {
}
script ParcelCoastCannery_Foreman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FOREMAN: Half speed by order instead of by shortage. Same speed, different reason. The lads say it feels different. I say a line's a line. I'm wrong, I think."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("FOREMAN: Half speed, and this morning head office said hold the line a day 'pending the ranger's report'. Pending YOUR report. We've never been pending anything.\pThe line's quiet. You can hear the water running in the pipes. It's not a nice sound."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FOREMAN: Mind the line. We're at half speed; there's not the fish to run it full. Head office says run it anyway. So we run it. Water's cheap."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastCannery_Line {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WORKER: A big one came down the line yesterday. The whole line stopped to look. Then we went on. That's all we ever wanted. Something worth stopping for."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WORKER: Same size, same size, same size, and today the inspector stopped the line to look at one. First time in a year the line's stopped for a fish.\pIt was the same size as the others. She looked anyway. She said that's what you did. Looked."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WORKER: Every fish I gut's the same size. Used to be you'd get a big one and the whole line would stop to look. Nobody's stopped in a year."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastCannery_Inspector {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("INSPECTOR: Every landing weighed, every weight logged, every log to the review now, not the coast office. Same numbers. Different reader. That's the whole change. It's enough."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("INSPECTOR: Every landing weighed. Every weight logged. Every log to the coast office. The numbers are still perfect.\pI read your survey. I've started a second column. What the numbers add up to. It's not my department. It's a column."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("INSPECTOR: Quota compliance. Every landing weighed, every weight logged, every log to the coast office. The numbers are perfect. I check them myself.\pWhat the numbers add up to isn't my department."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastCannery_Board {
    msgbox(format("QUOTA BOARD. This month: 41 tonnes landed, 40 tonnes permitted. Over by one. A note in red: ROUNDING. Last year's board, under it: 112 tonnes."), MSGBOX_SIGN)
    end
}
