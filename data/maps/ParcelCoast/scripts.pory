// ParcelCoast -- the MEREHOLT COAST (§01/§06 zone 7, Chapter 6): the endgame
// ramp; the extraction economy made physical and unmasked. Rebuilt 2026-11 on
// vanilla Slateport City (General + Slateport): the ferry lands at the
// lighthouse quay, the market is the fish market, the shipyard is the cannery,
// the museum is the Foundation's coast office (the plaque downstairs, HOLLIS
// upstairs), the Fan Club is the fishermen's union, the Battle Tent is the
// hearing hall. The coast reads COLLAPSING. Two things land here: HARLAND's
// arc comes home, and the plaque decodes the notebook -- the Board's model is
// Dr. Heron's. Flag logic unchanged; words plain.
//
// VAR_SKALDMERE_CH6_EVIDENCE bits (count 0..5, mask 0x3F):
//   0 dredge scar   1 urchin barren   2 the catch all one size
//   3 the empty pilings   4 the plaque (mask + Heron reveal; Office 1F)   5 Harland
//   6 classified + filed (Hale)

const LOCALID_COAST_GYM    = 1
const LOCALID_COAST_HALE   = 2
const LOCALID_COAST_WORKER = 3
const LOCALID_COAST_SAILOR = 6
const LOCALID_COAST_AIDE   = 7

const LOCALID_PERRIN = 33

mapscripts ParcelCoast_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelCoast_HideAide
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SKALD_EPILOGUE, 7: ParcelCoast_Epilogue
        VAR_TEMP_1, 0: ParcelCoast_FirstEntry
    ]
}

// the Mereholt aide only appears once the testimony has landed
script ParcelCoast_HideAide {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        clearflag(FLAG_TEMP_4)
    } else {
        setflag(FLAG_TEMP_4)
    }
    end
}

script ParcelCoast_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_COAST_ARRIVAL)) {
        end
    }
    lockall
    msgbox(format("The ferry rounds the headland and the harbour opens up, and it is BUSY. Cranes. Hulls. The gut-and-ice smell of a working catch. Gulls over all of it.\pIt looks alive."), MSGBOX_DEFAULT)
    msgbox(format("Everything wears the MEREHOLT crest. The cranes. The fuel drums. The waiting trucks. The side of the fishing boat tied at the end of the quay."), MSGBOX_DEFAULT)
    msgbox(format("HALE's note is shorter than usual: THE COAST. You've read the others. This one doesn't bother to hide. See if you can still read it anyway."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_COAST_ARRIVAL)
    releaseall
    end
}

// --- the tells along the water -------------------------------------------------------
script ParcelCoast_Dredge {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The dredge line. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("Offshore the water goes from green to grey in a straight line, as if ruled. Below it the bottom is scraped flat: no weed, no stone, no shadow of anything.\pA dredge did that. Nothing has grown back. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelCoast_Barren {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 1)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The urchin barren. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("Under the quay the rock is purple with urchins, thousands, shoulder to shoulder, and nothing else. No kelp. No fish between the fronds, because there are no fronds.\pThe thing that ate urchins is gone. Fished, or dredged, or both. The urchins ate the rest. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelCoast_Catch {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 2)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The catch, all one size. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("The day's catch on the stall, iced. Every fish the same length, give or take a finger. No big ones. No small ones.\pA stock fished to one age, the age that just reaches the net. The old fish are gone and the young ones don't get to be old. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelCoast_Pilings {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 3)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The empty pilings. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("The old pier's pilings stand bare to the waterline. Pilings in a harbour are supposed to be furred with life: weed, mussels, the small fish that live in them.\pThese are clean as fence posts. Nothing settles here now. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- HARLAND: the arc comes home, the Tradewind clearance (gym 6), the shift ----------
script ParcelCoast_GymHarland {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelCoast_GymHarland_Rematch)
    }
    if (flag(FLAG_BADGE06_GET)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("HARLAND: They read your file aloud at the quota hearing. Parts of it twice. My name's in it, where I put it.\pThe review grounds half the fleet two days a week now. The lawyers call it ruin. It'll pinch, right enough. Winters pinched anyway."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: They tell me all it bought is time. Aye. Time's what a season is, RANGER. I've lived season to season my whole life. It's more than I'd been given yet."), MSGBOX_DEFAULT)
            release
            end
        }
        if (!flag(FLAG_SKALD_COAST_SHIFT_DONE)) {
            msgbox(format("HARLAND: Come out with me. One shift. You've read the water from the quay. Read it from the net."), MSGBOX_DEFAULT)
            msgbox(format("Go out on the boat?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == 0) {
                msgbox(format("HARLAND: Tide's at six. Offer stands till then."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            fadescreen(FADE_TO_BLACK)
            msgbox(format("HARLAND: There. That's the dredge line. See the colour change? Below that there's nothing to lift and nothing to hide in. We fish the edge of it like a man scraping a plate."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: Net's coming up. Watch."), MSGBOX_DEFAULT)
            msgbox(format("The net comes over the rail. Urchins. A plastic drum with the crest on it. Eleven fish, every one the same length. Two go back over the side for being under the size.\pHARLAND: That's a shift. That's what nothing looks like, written in fish."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: The note on the boat is MEREHOLT's. The quota's MEREHOLT's. The ice, the fuel, the stall I sell at. I could stop. I'd be a man with no boat who stopped. Nobody'd write that down."), MSGBOX_DEFAULT)
            msgbox(format("{PLAYER}: I'm writing it down."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: …Aye. I know. Haul in. We're done."), MSGBOX_DEFAULT)
            closemessage
            delay(60)
            fadescreen(FADE_FROM_BLACK)
            msgbox(format("HARLAND: Nine fish, landed. Write that number. Nobody else will."), MSGBOX_DEFAULT)
            setflag(FLAG_SKALD_COAST_SHIFT_DONE)
            release
            end
        }
        msgbox(format("HARLAND: It was never one report that'd turn this. Always all of them. Mine too, if I find the spine.\pWrite it true, RANGER. That's the whole of what I've got left to ask."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HARLAND: So. You came all the way down to the bottom of it. Where the money is.\pThe note on this boat is MEREHOLT's. The quota's MEREHOLT's. The stall I sell at. Set it all side by side and it's one crest. I did, at the river. You made me."), MSGBOX_DEFAULT)
    msgbox(format("HARLAND: I'm not your villain. I'm the man they send the bill to. Write that true and I'll vouch for you on this water, which I don't do twice.\pBut you'll earn it the fisher's way. Show me."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_GYM6, format("HARLAND: …Aye. You read the water. I'll not pretend you didn't."))
    setflag(FLAG_BADGE06_GET)
    call(Common_EventScript_PlayGymBadgeFanfare)
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 5)
    special(SkaldmereCertTaskMark)
    msgbox(format("HARLAND: That's the Tradewind clearance. Out here it means you can be trusted on the water, a thing I don't hand out twice.\pHere. You'll want this more than I do."), MSGBOX_DEFAULT)
    giveitem(ITEM_HM02)
    msgbox(format("HARLAND: FLY. Carries you back to any harbour you've already made. A fisher's mercy, that. Some days the only kindness is a fast way home.\pUse it better than I've used my seasons."), MSGBOX_DEFAULT)
    release
    end
}

// --- HALE at the quay: the classification, the reveal confirmed, the certification ------
script ParcelCoast_Hale {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HALE: They read it aloud at the hearing. All of it. HOLLIS sat through every page without moving. I watched her. She's the one who taught me to sit still."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("HALE: Rest while you can. The next place doesn't have a quay to stand on, or a HOLLIS to pour you tea.\pIt has her."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH6_EVIDENCE)
    setvar(VAR_0x8004, 63)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) == 6) {
        msgbox(format("HALE: The dredge scar. The urchins. The catch all one age. The empty pilings. The plaque. The man on the boat.\pName it."), MSGBOX_DEFAULT)
        specialvar(VAR_RESULT, SkaldmereClassifyCoast)
        msgbox(format("HALE: COLLAPSING.\pThe grazer's gone, the urchins own the kelp, the apex is fished to nothing, and the web is coming apart in front of you in real time."), MSGBOX_DEFAULT)
        msgbox(format("HALE: The overfishing you could still stop, if anyone with the power to wanted to. The dredged seabed you cannot. Half of it savable, half already gone. The hardest kind of place to write down honestly."), MSGBOX_DEFAULT)
        msgbox(format("{PLAYER}: HALE. The model on the plaque. The methods are hers. DR. HERON's. She isn't lost, she's…"), MSGBOX_DEFAULT)
        msgbox(format("HALE: I know. Have known a while.\pI told you at the start her ending up at that lab wasn't random. This is the rest of that sentence."), MSGBOX_DEFAULT)
        msgbox(format("HALE: Your mentor didn't vanish, {PLAYER}. She made a bargain. And the bargain is out there right now with her name on the paperwork, strangling a kelp bed.\pI'm sorry. You came looking for a hero. You found a citation."), MSGBOX_DEFAULT)
        setvar(VAR_0x8004, 6)
        special(SkaldmereCertTaskMark)
        msgbox(format("HALE: Coastal Certification. For reading a place that's screaming and keeping your hand steady enough to write it down anyway."), MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        waitfanfare
        setflag(FLAG_SKALDMERE_COASTAL_CERT)
        giveitem(ITEM_MAX_POTION, 5)
        giveitem(ITEM_FULL_HEAL, 5)
        msgbox(format("HALE: There's one place left. Inland. The deep corridor, the marsh all of this used to drain from. Unfished, unbuilt. Too raw to be worth taking. Yet.\pThat's where she went to hide. That's where we finish."), MSGBOX_DEFAULT)
        msgbox(format("HALE: Rest first. Then come to the station at FERNWICK, and we go inland, and we tell the truth with our whole chest, and we live with what it costs.\pThat was always the job, {PLAYER}. This is just the first time it's cost this much."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HALE: Don't name it from the office window. Walk the quay. The dredge line, the barren, the catch on the stall, the pilings, the plaque in the office. And talk to the man on the boat. Especially him.\pThen come and tell me what it is."), MSGBOX_DEFAULT)
    release
    end
}

// --- the people in the picture ---------------------------------------------------------------
script ParcelCoast_Worker {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WORKER: Four generations on this quay, and it took a ranger's notebook to put the fifth in a hearing room. My boy spoke. Two minutes. He was good."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WORKER: You named it. The whole quay knew by the tide after. COLLAPSING. We've known for years; we'd just never heard it said by somebody with a card.\pThere's people in the frame, RANGER. You put us in it. That's fair. Keep us in it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WORKER: Four generations my family's worked this quay. Good work. Honest work.\pDon't let that badge let you forget there's people in the frame, RANGER. We didn't dredge it. We haul what we're told to haul, or we don't eat."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Vendor1 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: Cod. Different sizes today. The review's inspector weighs them herself. Customers ask why they're not tidy. I tell them. First time I've told them."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: Cod, iced this morning. All one size. A customer asked why today, first time ever.\pI said ask the ranger. She said the ranger already did. I sold her two anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Cod, iced this morning. All the same size, aren't they. Customers like that. Tidy. Nobody asks why there's no big ones."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Vendor2 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Urchin roe's off the list. The review says the bottom's a nursery, not a shelf. Nothing else down there to sell. That was the point, wasn't it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("MAN: Urchin roe. The FOUNDATION buyer didn't come this morning. First morning in a year.\pYou wrote 'urchins' in your survey, I hear. Funny how a word gets to a buyer before it gets to a fisherman."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Urchin roe! The FOUNDATION found a market for it overseas. Clever. There's nothing else down there to sell."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Vendor3 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: Ice is still FOUNDATION ice. Fuel's still FOUNDATION fuel. The rent went down a page in the review. I sell fish. I noticed the page."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: FOUNDATION ice, FOUNDATION fuel, FOUNDATION rent, and today a FOUNDATION man came round asking what the ranger bought.\pI said fish. He wrote it down. Everybody's writing things down this week. I liked it better when it was just you."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Ice is FOUNDATION ice. Fuel's FOUNDATION fuel. The stall rent goes to a FOUNDATION company. I sell fish. That's the only bit of this that's mine."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Vendor4 {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: WAILMER in the harbour mouth yesterday. One. My father would have laughed at one. I stood on the quay and watched it like a boy."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("OLD MAN: Walk across the harbour on the backs of the WAILMER. My father said it. Now it's in a ranger's book, with a date beside it.\pFirst time anybody's written down what my father said. He'd have hated the date. He'd have liked the rest."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: Fifty years ago you could walk across the harbour on the backs of the WAILMER. My father said that. His father said it to him. Somebody has to keep saying it."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: The gulls dived today. Mum stopped on the quay to watch. She didn't say anything. She held my hand very tight."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("GIRL: The gulls still don't dive. But a man from the FOUNDATION stood on the quay and watched them not dive for an hour.\pMum says that's new. Watching's new. I've been watching for ages."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: The gulls follow the boats in but they don't dive anymore. Mum says they know something we don't."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Docker {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DOCKER: Cannery's on half days. Half days, full pay. HARLAND's lot argued it in the union hall for a week. I slept in a bed in daylight. Strange thing."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("DOCKER: Two shifts, seven days, and this morning head office rang the cannery twice. The cannery never stops. The phone never rang.\pYou wrote something. I don't know what. The phone knows."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DOCKER: Two shifts a day, seven days. The cannery never stops. The fish stop. The cannery doesn't."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_GullMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: I count the boats out and the boats in. Half the number now, by order. The crates per boat went up. Nobody asked me. I'm telling you anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("OLD MAN: Boats out, boats in. Same number. Crates, fewer. And now somebody's counted the counting: your survey has my crates in it.\pNobody asked me to count. Somebody read it anyway. That's all a counter wants, in the end."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: I count the boats out and the boats in. Same number. I count the crates. Fewer every month. Nobody asked me to count. Nobody asked the gulls either."), MSGBOX_DEFAULT)
    release
    end
}

// --- the ferry home ---------------------------------------------------------------------------
script ParcelCoast_ReturnFerry {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SAILOR: Back to SALTWICK, RANGER? Go on. They'll want to see the one who did it. Don't let them buy you a drink. They'll try."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SAILOR: Back to SALTWICK, RANGER? Can't say I blame you. Nothing to do here but watch them take it."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SAILOR: I'll wait. The catch isn't going anywhere. Less of it every run, but it isn't going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    closemessage
    playse(SE_SHIP)
    delay(40)
    warp(MAP_PARCEL_ISLE, 15, 31)
    waitstate
    end
}

// --- the Mereholt aide: the summons (post-testimony) --------------------------------------------
script ParcelCoast_MereholtAide {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
        msgbox(format("AIDE: No message came down. She said you would already have everything she'd say."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("AIDE: Ms. BROOKE is up from the mainland office. She has asked for you. By name, no title on it.\pThe boardroom. Top floor. Now, if you would."), MSGBOX_DEFAULT)
    msgbox(format("Go up?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("AIDE: She'll wait. She prices patience like everything else. Accurately."), MSGBOX_DEFAULT)
        release
        end
    }
    closemessage
    warp(MAP_PARCEL_BOARDROOM, 4, 2)
    waitstate
    end
}

// --- items and signs -----------------------------------------------------------------------------
script ParcelCoast_ItemA { finditem(ITEM_PEARL) end }
script ParcelCoast_ItemB { finditem(ITEM_BIG_PEARL) end }
script ParcelCoast_ItemMaxElixir { finditem(ITEM_MAX_ELIXIR) end }
script ParcelCoast_SignQuay {
    msgbox(format("MEREHOLT COASTAL WORKS -- LIGHTHOUSE QUAY\pFerry to SALTWICK, twice daily. Landing fees to the office. No fishing from the quay. The quay is for the fleet."), MSGBOX_SIGN)
    end
}
script ParcelCoast_SignMarket {
    msgbox(format("FISH MARKET\pStalls 1-12 let by MEREHOLT COASTAL HOLDINGS. Catch to be weighed at the cannery before sale. Undersize fish are not to be landed. Undersize is whatever the Board says this month."), MSGBOX_SIGN)
    end
}

// --- trainers ---------------------------------------------------------------------------------------
script ParcelCoast_Brage {
    trainerbattle_single(TRAINER_SKALD_COAST_BRAGE,
        format("BRAGE: Off the boats, on the beach, nothing to do till the tide. Battle me, RANGER, I'm bored of losing at cards."),
        format("BRAGE: Lost at that too."),
        ParcelCoast_Brage_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_COAST_BRAGE_R2)) {
        goto(ParcelCoast_Brage_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_COAST_BRAGE_R3)) {
        goto(ParcelCoast_Brage_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_COAST_BRAGE_R4)) {
        goto(ParcelCoast_Brage_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_COAST_BRAGE_R5)) {
        goto(ParcelCoast_Brage_R5)
    }
    msgbox(format("BRAGE: Ten years on the trawlers. We used to come in with the deck awash. Now you can see the planks the whole trip home."), MSGBOX_DEFAULT)
    end
}
script ParcelCoast_Brage_FirstWin {
    msgbox(format("BRAGE: Ten years on the trawlers. We used to come in with the deck awash. Now you can see the planks the whole trip home."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Brage_R2 {
    lock
    faceplayer
    msgbox(format("BRAGE: You again. I've had time to think about last time. Go again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("BRAGE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_COAST_BRAGE_R2, format("BRAGE: …Fair."))
    msgbox(format("BRAGE: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Brage_R3 {
    lock
    faceplayer
    msgbox(format("BRAGE: Three stamps, then five. Fine. Me next?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("BRAGE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_COAST_BRAGE_R3, format("BRAGE: Still yours."))
    msgbox(format("BRAGE: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoast_Brage_R4 {
    lock
    faceplayer
    msgbox(format("BRAGE: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("BRAGE: Another time, then."), MSGBOX_DEFAULT)
