    trainerbattle_no_intro(TRAINER_SKALD_COAST_TORE_R3, format("TORE: Noted. Properly, this time."))
    msgbox(format("TORE: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
