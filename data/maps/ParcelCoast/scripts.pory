// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelCoast_T_Helge {
    trainerbattle_single(TRAINER_SKALD_COAST_HELGE,
        format("HELGE: Quay crew. We tie up the fleet and count what's missing. Battle, it's quicker than counting."),
        format("HELGE: Quicker, yes."),
        ParcelCoast_T_Helge_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_COAST_HELGE_R2)) {
        goto(ParcelCoast_T_Helge_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_COAST_HELGE_R3)) {
        goto(ParcelCoast_T_Helge_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_COAST_HELGE_R4)) {
        goto(ParcelCoast_T_Helge_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_COAST_HELGE_R5)) {
        goto(ParcelCoast_T_Helge_R5)
    }
    msgbox(format("HELGE: Forty-one boats went out. Forty-one came back. The count's always right. It's the holds that are wrong."), MSGBOX_DEFAULT)
    end
}
script ParcelCoast_T_Helge_FirstWin {
    msgbox(format("HELGE: Forty-one boats went out. Forty-one came back. The count's always right. It's the holds that are wrong."), MSGBOX_DEFAULT)
