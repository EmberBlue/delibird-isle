// --- the shell (side quest) ----------------------------------------------------------
script ParcelCoast_Shell {
    lock
    if (!flag(FLAG_SKALD_Q_SHELL_FOUND)) {
        msgbox(format("Half-buried in the sand between two drum rings: a shell. Whole. Pink inside.\pThe first one anyone has found on this beach in years. Taken."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_SHELL_FOUND)
        release
        end
    }
    msgbox(format("Sand. Drum rings. The hollow where a shell was."), MSGBOX_SIGN)
    release
    end
}

// --- PERRIN, encounter 6 (the peer; §04) -------------------------------------------
script ParcelCoast_PerrinScene {
    if (flag(FLAG_SKALD_PERRIN_6)) {
        setvar(VAR_TEMP_5, 1)
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("PERRIN: WREN!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelCoast_PerrinIn)
    waitmovement(0)
    msgbox(format("PERRIN: Coastal Holdings liaison. New card, new coat. Don't look at me like that.\pOne last time, WREN. Then I'm done pretending we're on the same side. I never was. I just liked you."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_6, format("PERRIN: …Yeah. I know."))
    msgbox(format("PERRIN: Write it true, then. Whatever it costs. I'll be upstairs, typing the response.\pI type well. HOLLIS says so."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelCoast_PerrinOut)
    waitmovement(0)
    removeobject(LOCALID_PERRIN)
    setflag(FLAG_SKALD_PERRIN_6)
    setvar(VAR_TEMP_5, 1)
    releaseall
    end
}
script ParcelCoast_PerrinTalk {
    lock
    faceplayer
    msgbox(format("PERRIN: Hang on, I'm coming to you."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_ParcelCoast_PerrinIn { walk_down * 2 }
movement Movement_ParcelCoast_PerrinOut { walk_up * 2 }

// --- the epilogue, stop 7 of 8: the quay, with HALE where he always stands ---
script ParcelCoast_Epilogue {
    lockall
    delay(20)
    msgbox(format("MEREHOLT COAST. The cranes swing on schedule. The quota review runs to spring, and the boats go out under it and come back with what there is."), MSGBOX_DEFAULT)
    msgbox(format("HALE: You want to know if it was worth it. Wrong verb. Ask if it was true.\pIt was. Go and rest. Then go and read something else. There's a lot of region left."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 8)
    warp(MAP_PARCEL_ROUTE1, 8, 26)
    waitstate
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelCoast_GymHarland_Rematch {
    lock
    faceplayer
    msgbox(format("HARLAND: They read you aloud at the hearing. I'd read you the old way, too. Boat's in, nets are dry, and the crew's been training on the dredge line out of spite.\pFull strength. Aye?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HARLAND: Tide's at six. Offer stands."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM6_R, format("HARLAND: …Aye. You read the water. Still."))
    msgbox(format("HARLAND: Tide's at six. Any day you like."), MSGBOX_DEFAULT)
    release
    end
}

// --- Councilman DORSEY (fix B, zone 6): the quay ---
script ParcelCoast_Dorsey {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DORSEY: Development that listens. I said it at the hearing. They wrote down 'listens' in quotes. I've seen the transcript.\pThe quotes are fair."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_DORSEY_CO)) {
        msgbox(format("DORSEY: You'll find the hearing room up the street when the time comes. I'll be in it. I sit on the review board's local panel. Somebody from here should.\pI know what that looks like. Revolving door. The door revolves because the building only has one."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DORSEY: --six berths, a cold store, and forty jobs that weren't here in spring. And a plaque, because people like to see a thing has a date on it.\pRANGER. The coast too. You're thorough; HOLLIS said so. Witness the quay. Write 'forty'. It's a true number.\pThey're all true numbers. That has never been the problem."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALD_DORSEY_CO)
    release
    end
}

// The zone's survey stake (§13 fix E): reads the chapter's evidence back.
script ParcelCoast_SurveyStake {
    msgbox(format("A survey stake set into a crack in the quay stones, red cloth snapping in the wind off the harbour. The dockers walk round it."), MSGBOX_SIGN)
    setvar(VAR_0x8004, 5)
    special(SkaldSurveyStake)
    msgbox(gStringVar4, MSGBOX_SIGN)
    end
}
