// ParcelFernwickHQ -- the Corps District Station. Hale runs the region's
// story from this room: every chapter's dispatch lives here. Flag logic is
// the old station's, unchanged; the words are plain now.

mapscripts ParcelFernwickHQ_MapScripts {
}

script ParcelFernwickHQ_Reception {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("RECEPTION: HALE sleeps most nights now. I can tell by the mornings.\pDon't tell him. He'd stop."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("RECEPTION: HALE slept. A whole night. I know because he came in and didn't look like that. Don't tell him I noticed."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("RECEPTION: HALE slept. Four hours, in the chair. First time since you went north.\pDon't tell him I noticed. He thinks nobody notices anything in this building. It's a building full of rangers."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("RECEPTION: Welcome to the District Station. HALE's the one who looks like he hasn't slept.\pHe hasn't."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHQ_Ranger {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("RANGER: The poster's up, and the river minutes are up beside it. HALE says they're the same poster.\pI'm starting to see it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("RANGER: 'We don't win. We reduce harm.' HALE put the poster back up. He didn't say anything. He just put it back up."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("RANGER: The poster's still down. But he's pinned up the river minutes where it was.\pSix names in the margin, in his hand. Not ours. Theirs. The ones who stood up."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("RANGER: 'We don't win. We reduce harm.' It was on a poster in here.\pHALE took the poster down. Said posters don't reduce anything."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHQ_Hale {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        if (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
            if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
                if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
                    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
                        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
                            if (!flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
                                msgbox(format("HALE: It's filed. It's true. Who reads it was never ours to control. Writing it down was."), MSGBOX_DEFAULT)
                                msgbox(format("HALE: One reader's asked for you already. MEREHOLT. The coast office. BROOKE herself, up from the mainland.\pYou owe her nothing. Go anyway. You've earned watching her face while she says whatever she's decided to say."), MSGBOX_DEFAULT)
                                release
                                end
                            }
                            msgbox(format("HALE: It's filed. It's true. Who reads it was never ours to control.\pGet some rest, {PLAYER}. You've earned a night that isn't about the work."), MSGBOX_DEFAULT)
                            release
                            end
                        }
                        msgbox(format("HALE: Five certifications. You've seen the whole sweep of it now, forest to mountain to the works on the coast.\pAnd you've seen whose name is in the footnotes."), MSGBOX_DEFAULT)
                        msgbox(format("HALE: One place left. The Last Corridor, inland. The keystone marsh everything drains from. Where she went.\pI'll walk you to the treeline. I won't go in. This one's yours."), MSGBOX_DEFAULT)
                        msgbox(format("HALE: Ready?"), MSGBOX_YESNO)
                        if (var(VAR_RESULT) == 0) {
                            msgbox(format("HALE: Take the time you need. It's kept this long."), MSGBOX_DEFAULT)
                            release
                            end
                        }
                        closemessage
                        warp(MAP_PARCEL_MARSH, 37, 27)
                        waitstate
                        end
                    }
                    msgbox(format("HALE: Four. Forest, basin, watershed, and a mountain you couldn't save and didn't pretend to.\pThat last one's what makes a RANGER. The rest is competence."), MSGBOX_DEFAULT)
                    msgbox(format("HALE: Take the ferry from SALTWICK. DELIBIRD ISLE first; you've earned the breather. Then up the coast to the MEREHOLT works.\pThe coast won't bother hiding what it is."), MSGBOX_DEFAULT)
                    release
                    end
                }
                msgbox(format("HALE: Three certifications. Forest, basin, watershed.\pNow the climb. Follow the river up past the clean water, to where it comes from. The high cold."), MSGBOX_DEFAULT)
                msgbox(format("HALE: It won't be like the others. You won't get to fix this one.\pILEX is up there already, measuring how much of it is left. Go learn what 'too late' looks like, so you know it next time it isn't."), MSGBOX_DEFAULT)
                if (!flag(FLAG_SKALDMERE_RANGER_KIT)) {
                    msgbox(format("HALE: One more thing. The country gets rough from here. Your clearances open the hard ground now.\pField craft, not force. A deadfall across the only path, a slide of rock over a culvert, we clear those. We don't tear up a living place for fun.\pMove what has to move. Light what has to be seen."), MSGBOX_DEFAULT)
                    setflag(FLAG_SKALDMERE_RANGER_KIT)
                }
                release
                end
            }
            msgbox(format("HALE: Two certifications. A sick forest corridor and a sicker basin.\pThe river's next. First place you'll go that isn't already lost. There's still a window there."), MSGBOX_DEFAULT)
            msgbox(format("HALE: Follow the channel up out of the basin. North, past the discharge, where the trees thin out. ILEX is working the bank up there.\pRead the whole river before you name any part of it."), MSGBOX_DEFAULT)
            msgbox(format("HALE: The people on that water have even less reason to like us than the last lot. Listen anyway."), MSGBOX_DEFAULT)
            release
            end
        }
        setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
        setvar(VAR_0x8004, 6)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("HALE: I read it twice. I'm not going to argue with any of it.\pYou couldn't fix it."), MSGBOX_DEFAULT)
            msgbox(format("{PLAYER}: No."), MSGBOX_DEFAULT)
            msgbox(format("HALE: And you didn't pretend you had. That's the certification. Not the cleanup. Refusing to sign off on a lie.\pWetland Certification. Done."), MSGBOX_DEFAULT)
            giveitem(ITEM_SUPER_POTION, 5)
            giveitem(ITEM_PARALYZE_HEAL, 5)
            msgbox(format("HALE: Kit's topped up. ILEX will tell you it won't just come back. Now you know that in your hands."), MSGBOX_DEFAULT)
            setflag(FLAG_SKALDMERE_WETLAND_CERT)
            release
            end
        }
        if (flag(FLAG_SKALDMERE_FLOODBASIN_ARRIVAL)) {
            msgbox(format("HALE: Walk it slowly. Read every stake. Talk to whoever's manning the booth.\pThen tell ILEX what you saw."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("HALE: Forest Certification. Don't get attached to praise. Get attached to results."), MSGBOX_DEFAULT)
        msgbox(format("HALE: The wetlands are sick. North of here the forest gives out and the marsh begins; there's a fishing landing on the backwater.\pPeople up there are angry, and somebody's feeding them a story. Go listen. Document what you see. Don't argue with anyone's paycheck."), MSGBOX_DEFAULT)
        msgbox(format("HALE: Past the landing, east, there's an old service cut through the trees. It opens onto the FLOODBASIN.\pYour exam was the warm-up. That's the work."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_BADGE01_GET)) {
        msgbox(format("HALE: TARN passed you. He doesn't pass people. I've seen him fail a man for standing wrong."), MSGBOX_DEFAULT)
        msgbox(format("HALE: Forest Certification. No fanfare. That's how it should feel."), MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        waitfanfare
        msgbox(format("HALE: Proper field kit. Sample vials, a flow gauge, a better headlamp, spare red cloth. And these."), MSGBOX_DEFAULT)
        giveitem(ITEM_POKE_BALL, 10)
        giveitem(ITEM_POTION, 5)
        setflag(FLAG_SKALDMERE_FOREST_CERT)
        msgbox(format("HALE: Now the wetlands. North of here the forest gives out and the marsh begins; there's a fishing landing on the backwater.\pPeople up there are angry, and somebody's feeding them a story. Go listen. Document what you see. Don't argue with anyone's paycheck."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_STATION_BRIEF)) {
        msgbox(format("HALE: The Certification Hall is across the boulevard. TARN. Practical exam.\pGo on. I've got paperwork, and you've got a partner that needs the practice."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HALE: No welcome ceremony. We document ecological change, we interrupt exploitation, we coordinate restoration. Often without anyone's support."), MSGBOX_DEFAULT)
    msgbox(format("HALE: We don't win. We reduce harm. We keep corridors open. We stop the worst of it."), MSGBOX_DEFAULT)
    msgbox(format("HALE: Your mentor worked with us. Whatever happened at that lab wasn't random.\pThat's all I'll say about it today."), MSGBOX_DEFAULT)
    msgbox(format("HALE: Here. A proper pack, a marked map, and a card stamped PROVISIONAL. This isn't ownership. It's responsibility."), MSGBOX_DEFAULT)
    giveitem(ITEM_POKE_BALL, 5)
    msgbox(format("HALE: And this came care of the Station, addressed to you, in her hand. Nobody's opened it.\pHer field notebook. Keep it on you. Read it when you can; it'll tell you where you are."), MSGBOX_DEFAULT)
    giveitem(ITEM_FIELD_NOTEBOOK)
    setflag(FLAG_SYS_POKEDEX_GET)
    msgbox(format("HALE: You keep one of your own, I see. Older than you are, by the binding.\pGood. Keep both. Two hands on a page is how a thing gets remembered right."), MSGBOX_DEFAULT)
    msgbox(format("HALE: The Certification Hall is across the boulevard. TARN runs the practical. Pass it and you're a provisional for real.\pThen we'll talk about the marsh."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_STATION_BRIEF)
    release
    end
}

script ParcelFernwickHQ_ReadCase {
    msgbox(format("Under the glass, a surveyor's red cloth, forty years old, the dye gone to rust. The card says: FIRST STAKE, KEYSTONE MARSH. No name."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHQ_ReadCounter {
    msgbox(format("The duty counter. A ledger of who is where: eight names, eight zones. One line reads WREN -- FIELD, and nothing after it.\pHale's hand."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelFernwickHQ_Pinned {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Where the poster was: the minutes of the river meeting at Elvsund, pinned with four tacks, typed on the hall's machine.\pPRESENT: the Board's clerk, the Commissioner's deputy, forty-one ratepayers, two rangers, one surveyor.\pTHE RATEPAYERS ASKED why the gauge read normal when their fields did not. THE CLERK SAID the gauge was calibrated. THE SURVEYOR ASKED to which year.\pTHE DEPUTY SAID the Commissioner regretted he could not attend. THE ROOM NOTED this.\pRESOLVED, by show of hands, that the Board publish its readings against the old datum as well as the new. Carried. Six abstained."), MSGBOX_SIGN)
        if (flag(FLAG_SKALD_CH_SPOKE)) {
            msgbox(format("Down the margin, six names in Hale's small capitals. The six who stood up first. Under them, smaller, a seventh: yours.\pHe has not mentioned it. He pinned it where you would see it."), MSGBOX_SIGN)
        } else {
            msgbox(format("Down the margin, six names in Hale's small capitals. The six who stood up first. Not ours, the ranger said. Theirs."), MSGBOX_SIGN)
        }
    } else {
        msgbox(format("A poster, the Foundation's green and grey. A ranger on a ridge with the light behind.\pSTEWARDSHIP. A Mereholt Foundation partnership with the Skaldmere Climate Corps. Two field stations. The certification programme. Equipment for every ranger in the region.\pSmaller, at the bottom: the Climate Corps is funded in part by Mereholt Foundation conservation grants administered through the Office of Public-Private Partnerships.\pSomeone has pressed a thumbnail into the word PART and left a crescent."), MSGBOX_SIGN)
    }
}

// --- books (2026-11-10) ---

script ParcelFernwickHQ_Handbook {
    msgbox(format("The Corps handbook, on the counter for provisionals to read while they wait. The spine is broken at the same page in every copy.\pSECTION 1. WHAT WE ARE. The Skaldmere Climate Corps surveys, documents, restrains, removes, cites and, rarely, seizes. It does not permit. It does not license. It does not decide. Rangers who want to decide things should stand for the Council; several have.\pSECTION 2. THE RECORD. A ranger's record is admissible, durable and slow. It is the only one of our tools that works after we have gone home. Write it as if the reader hates you and is clever."), MSGBOX_SIGN)
    msgbox(format("SECTION 4. THE PARTNER. The Corps does not issue partners. The holding meadow holds edge species that tolerate us; one will recognise the ranger or none will. A ranger who leaves the meadow alone has not failed. A ranger who takes one that did not choose them has.\pSECTION 6. SPONSORS. The Corps is funded in part by the Mereholt Foundation. Rangers will see the crest on their own equipment. The crest does not read the record. Neither does the Director. Only the reader does."), MSGBOX_SIGN)
    msgbox(format("SECTION 9. WHEN THE WORK IS WRONG. If a ranger is asked to round up, round down, omit, soften, delay or lose a record, the ranger will decline, in writing, once, and then file the record anyway. This section is short because it is not complicated. It is only hard.\pThe page the spine is broken at is this one. Someone has written beside it, in the ink the Corps issues: it is also the whole job. H."), MSGBOX_SIGN)
    end
}

// --- books, round two (2026-11-10) ---

script ParcelFernwickHQ_RedCloth {
    msgbox(format("A pamphlet on the Corps counter, between the leaflets, older than any of them. RED CLOTH. THE SURVEY'S METHOD, IN NINE RULES.\pONE. Drive the stake where the habitat is, not where the path is. You will walk further. The habitat does not care.\pTWO. Tie red cloth at the top. Red so it can be found in a wet year. Cloth so it rots when nobody comes back, and the stake tells you that too.\pTHREE. Read the same thing the same way at the same time of year. A method changed is a record ended."), MSGBOX_SIGN)
    msgbox(format("FOUR. Write the number you got. Not the number you expected, not the number that would help. The number.\pFIVE. Write what is absent. None is a reading. A blank is not.\pSIX. Do not model. Modelling is for people who will not be here next year. The Survey will be here next year.\pSEVEN. Keep the old sheets. The sheet is the baseline. The baseline is the argument. There is no other argument."), MSGBOX_SIGN)
    msgbox(format("EIGHT. Sign with an initial. The Survey is not a career.\pNINE. When the stake has fallen and the cloth is gone and the habitat is gone with it, drive a new stake in the same hole and read it. The last reading is the one that matters.\pAt the bottom, in the Corps' type: Provisionals are reminded that Corps surveys are filed with the regional office and are not bound by the Survey's rules. In pencil beneath: they should be."), MSGBOX_SIGN)
    end
}

// --- notices (2026-11-10) ---

script ParcelFernwickHQ_Roster {
    msgbox(format("HALE's duty roster, pinned behind the desk. Eight stations, eight names, the shifts in his square hand.\pAt the bottom a ninth line with no station and one name: the provisional's. The duty is written as one word. LOOK."), MSGBOX_SIGN)
    end
}
