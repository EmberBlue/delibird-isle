// ParcelHighlandsBore -- Survey Station Six: the Foundation's bore into the freeze.
mapscripts ParcelHighlandsBore_MapScripts {
}
script ParcelHighlandsBore_Geologist {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GEOLOGIST: Housing's dead. Capped at ninety metres. The freeze starts at forty and now nobody's drilling through it. I'm on half pay to watch a cap. It's the best job I've had here."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("GEOLOGIST: Fifty-two metres to the freeze this week. The coast office asked me to round it to fifty. I wrote fifty-two and 'rounded by request' beside it.\pYou put a quay full of fishermen on paper, I hear. I can manage a number."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GEOLOGIST: Don't touch the housing, it's live. The bore's at ninety metres. The freeze starts at forty. Started at twelve, in the old logs.\pExploratory. Yes. We're exploring how fast forty becomes fifty."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsBore_ItemMaxRevive { finditem(ITEM_MAX_REVIVE) end }
script ParcelHighlandsBore_Cores {
    msgbox(format("Core samples racked by depth. The labels change colour at forty metres: ICE. Below that, a second set of labels in a different hand: GAS -- EST. YIELD. The second set is newer."), MSGBOX_SIGN)
    end
}
