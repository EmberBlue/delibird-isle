// ParcelCoastHouse4 -- a house in Coast: residents in two story states (before / after the hearing).

mapscripts ParcelCoastHouse4_MapScripts {
}

script ParcelCoastHouse4_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The line's on half days under the review. Half days, full pay; HARLAND's union saw to that. I've a garden now."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: Six to two, and the line stopped for a day. 'Pending the ranger.' The tins stopped coming down.\pYou don't know how loud a cannery is until it's quiet. Then you don't know how to feel about either."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Cannery line, six to two. The tins come down faster than the fish come in. Somebody's filling tins with sea."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastHouse4_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: They read the eleven-fish line at the hearing. My line. I sorted them. Nobody asked my name. That's fine. It was true."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("MAN: Eleven fish, every one the same length. I needed a ranger to write it down, and now it's written, and I'm the one who sorted them, so my name's near it.\pI don't mind. I counted them. They're mine too."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: I sort the catch. Eleven fish, every one the same length. I didn't need a ranger to tell me. I needed one to write it down."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastHouse4_ReadDresser {
    msgbox(format("Two alarm clocks on the dresser, set an hour apart. Six to two, and the other shift."), MSGBOX_SIGN)
    end
}

script ParcelCoastHouse4_ReadDrawer {
    msgbox(format("A drawer of gutting gloves, every pair mended at the same finger.\pThe fish are all one size. So is the work."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelCoastHouse4_PaperRota {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The line rota, this week's. Half days, full pay, HARLAND'S UNION in the corner where the crest used to be.\pThursday says: nothing. The tins stopped coming when the dredge did. The woman says she has started sleeping through to six, which she had forgotten was possible."), MSGBOX_SIGN)
    } else {
        msgbox(format("The line rota, this week's, on the door. Six to two, six days. Grading, canning, labelling. The undersize column has its own shift now.\pSomeone has written the word TINS beside Thursday and underlined it, as if the tins were the point."), MSGBOX_SIGN)
    }
    end
}
