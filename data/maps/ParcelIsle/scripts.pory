// ParcelIsle -- SALTWICK, the arrival dock town on the Saltmarsh Coast (§07
// Scene 1). Hand-drawn 44x36 on the FireRed harbour tileset; the drawing is
// data/layouts/ParcelIsle/canvas.txt. The held-breath town: residents subtly
// evasive, never hostile. Everyone implies more than they state (§00).
//
// Three story states run through every resident:
//   arrival           -- before FLAG_SKALDMERE_FOREST_CERT
//   after the forest  -- FLAG_SKALDMERE_FOREST_CERT (you went past the bridge)
//   after the finale  -- FLAG_SKALDMERE_FINALE_DONE (the record is filed)
// Mereholt is the ferry you arrived on (§02): the town runs on it and knows it.

const LOCALID_HEAVYCOAT     = 1
const LOCALID_FISHER        = 2
const LOCALID_CHANDLER_BRO  = 3
const LOCALID_NEIGHBOR      = 4
const LOCALID_FERRY_CAPTAIN = 7
const LOCALID_INNKEEPER     = 9
const LOCALID_CLERK         = 10
const LOCALID_KID_A         = 11
const LOCALID_KID_B         = 12
const LOCALID_OLDMAN        = 13
const LOCALID_BIRDER        = 14
const LOCALID_NETMENDER     = 16
const LOCALID_DOCKWORKER    = 17
const LOCALID_HARBOUR_LAD   = 18
const LOCALID_WIDOW         = 19

mapscripts ParcelIsle_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelIsle_SetVisited
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: ParcelIsle_Arrival
    ]
}

script ParcelIsle_SetVisited {
    setflag(FLAG_VISITED_PARCEL_ISLE)
    end
}

// One-time §07 opening: the ferry horn, boots on damp wood.
script ParcelIsle_Arrival {
    setvar(VAR_TEMP_0, 1)
    if (flag(FLAG_SKALDMERE_ARRIVAL_INTRO)) {
        end
    }
    lockall
    playse(SE_SHIP)
    delay(96)
    msgbox(format("The ferry horn fades out across the water.\pThe boards are damp under your boots. Gulls on the racks. A town holding its breath."), MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_SKALDMERE_ARRIVAL_INTRO)
    releaseall
    end
}

// ---------------------------------------------------------------------------
// THE QUAY
// ---------------------------------------------------------------------------

// §07: "An NPC in a heavy coat points the way." Bram, the ferry hand.
script ParcelIsle_HeavyCoat {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Bram: Schedule board's got a date on it again. First time in a year.\pThey want to look busy while the hearings run, I reckon.\pMind the boards. Some things don't change."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Bram: So you went past the bridge after all.\pThe red cloth on your pack -- that's the Survey's knot. Nobody ties that for show.\p…Keep your questions for morning, still. Morning's when I answer them."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Bram: Off the ferry, then. Lodging's up the track--the door with the lamp lit. Up the lane, past the Center."), MSGBOX_DEFAULT)
        msgbox(format("Mind the boards. They're slick when the fog sits.\p…And keep your questions for morning, eh?"), MSGBOX_DEFAULT)
    }
    release
    end
}

// §07: a fisher at the pier says the currents "have been wrong for weeks."
// Old Tobin, on the landing platform. Also the far end of Anni's errand.
script ParcelIsle_Fisher {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_ANNI_NET) && !flag(FLAG_SKALD_Q_ANNI_DONE)) {
        msgbox(format("Tobin: That's my net. Anni's stitch -- nobody else doubles the selvedge.\pShe sent you down with it? Then she likes you, and she doesn't like anyone."), MSGBOX_DEFAULT)
        msgbox(format("Tobin: Here. My spare rod. Old, but it knows the inlet.\pFish it honest. Throw the small ones back. There's fewer small ones every year, and you'll want to know why before I do."), MSGBOX_DEFAULT)
        giveitem(ITEM_OLD_ROD)
        setflag(FLAG_SKALD_Q_ANNI_DONE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Tobin: They'll have to count them now. Properly. In front of people.\pForty years I've counted for nobody but myself. Funny to be right and hate it."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Tobin: Herring came back thin this week. Thin and early. That's not a season, that's a symptom.\p…You'd know the word for it now, wouldn't you. Ranger."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Tobin: Currents have been wrong for weeks. The fish know it before we do.\p…You didn't hear that from me."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Rolf, Mereholt Coastal day-rate. The paycheck with a face.
script ParcelIsle_Dockworker {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
        msgbox(format("Rolf: Eighteen months, they're saying. Delay.\pYou know what eighteen months is to a man on a day rate? It's a number somebody else gets to say out loud."), MSGBOX_DEFAULT)
        msgbox(format("Rolf: …I'm not saying you're wrong. I read it. Anni read it to me, the parts with the frogs.\pI'm saying it's easier to be right when it's not your boat."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Rolf: Boat's not late today. Boat's not coming. Office says 'pending review'.\pThat your review? …Thought so."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Rolf: The crest on the crates is the crest on my cheque. Same kerning. I stopped noticing it years ago.\pFunny what a stranger's face makes you notice again."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Rolf: Boat's late. Boat's always late now.\pNothing to unload but weather. You want work, there's a board by the lodging. Mostly it says 'no'."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Anni, mending nets on the quay. Side quest: carry the mended net to Tobin.
script ParcelIsle_NetMender {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_ANNI_DONE)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("Anni: Rolf had me read him the filing. The frog part, twice.\pHe didn't say anything after. That's a lot, for Rolf.\pKeep the rod. Tobin never lent it to anyone."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("Anni: Tobin gave you the spare rod? Then you're in his books, and there's only ever been three names in them.\pFish the inlet. Tell me if the Magikarp are still there. They used to be so thick you could walk on them."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ANNI_NET)) {
        msgbox(format("Anni: Tobin's on the landing, at the end of the jetty. He won't come up. He says the town's gone strange.\pHe's right, but the net still needs carrying."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Anni: You're the ranger they're talking about at the hall. The one who went out and came back with a knot on the pack.\pGood. Then you can carry something. This net's mended and Tobin's is torn, and my knees don't do the jetty."), MSGBOX_DEFAULT)
        msgbox(format("Anni: Take it down to him. End of the jetty, the one who won't look up.\pTell him the selvedge is doubled. He'll know whose it is."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_ANNI_NET)
        release
        end
    }
    msgbox(format("Anni: Nets don't tear like they used to. Nothing in them heavy enough to tear them.\p…Don't put that in your notebook. It's not a fact. It's just true."), MSGBOX_DEFAULT)
    release
    end
}

// Kip, the harbour lad -- an optional battle on the quay. Talk-triggered.
script ParcelIsle_HarbourLad {
    trainerbattle_single(TRAINER_SKALD_HARBOUR_LAD,
        format("Kip: You came off the ferry with a bag and no Pokémon, and now look at you.\pBet you can't beat my Krabby. The channel used to be full of them."),
        format("Kip: …Used to be. Yeah."))
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Kip: My dad says you cost him his berth. My mum says you saved the channel.\pThey had that argument at dinner. I ate in the loft."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Kip: Krabby was under the jetty when I was little. Dozens. Now I go out to the rocks to find one.\pI'm not sad about it. I'm just saying where they went."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Sigrun, the widow at the drying racks. Side quest: count the Wingull.
script ParcelIsle_Widow {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_SIGRUN_DONE)) {
        msgbox(format("Sigrun: Eleven this morning. I count them anyway. It's a way of saying good morning to someone who isn't here."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_SIGRUN)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("Sigrun: You wrote it down. All of it. The whole coast, in a notebook, and you put the gulls in.\pHe'd have liked that. He never trusted a number he hadn't counted himself."), MSGBOX_DEFAULT)
            msgbox(format("Sigrun: This was his. It's the only thing on the boat the sea didn't take.\pIt should go with someone who counts."), MSGBOX_DEFAULT)
            giveitem(ITEM_LUCKY_EGG)
            setflag(FLAG_SKALD_Q_SIGRUN_DONE)
        } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
            msgbox(format("Sigrun: Nine today. There were forty on these racks when Eirik still fished. The racks were white with them.\pWrite that in your book. Nine. Someone should have the number besides me."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("Sigrun: Twelve this morning. I'll tell you again when you're back. Numbers only mean something twice."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    msgbox(format("Sigrun: Count the gulls with me. On the racks. Go on.\pTwelve. Say it back, so it's two of us who know."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("Sigrun: Twelve. Good. My husband kept the count for thirty years and I keep it for him.\pCome back and I'll give you the next one. That's all a survey is. Somebody coming back."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_SIGRUN)
    } else {
        msgbox(format("Sigrun: No? Then it's just me who knows. That's been fine so far."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_FerrySign {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FERRY LANDING\pMainland schedule: SUSPENDED\nPENDING REGIONAL REVIEW\pSomeone has written underneath, in pencil: about time."), MSGBOX_SIGN)
    } else {
        msgbox(format("FERRY LANDING\pThe mainland schedule board is blank.\nIt has been for a while."), MSGBOX_SIGN)
    }
    end
}

// §09: the ferry hub. Delibird first (post-Highland cert), the Coast once
// you've made the Delibird crossing, the Climate Station once the Coastal
// cert is in hand. Outer islands each run a ferry home to here.
script ParcelIsle_FerryCaptain {
    lock
    faceplayer
    if (!flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("Captain: Passage out? The open channel's no crossing to make without a reason worth the cold.\pCome back when the Corps has sent you up the mountains. You'll know when."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Captain: Harbour's open. Where am I taking you?"), MSGBOX_DEFAULT)
    multichoice(1, 1, MULTI_SKALD_FERRY, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_DELIBIRD, 9, 22)
            waitstate
            end
        case 1:
            if (!flag(FLAG_SKALDMERE_DELIBIRD_ARRIVAL)) {
                msgbox(format("Captain: The coast run opens once you've made the Delibird crossing.\nOne island at a time."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_COAST, 38, 38)
            waitstate
            end
        case 2:
            if (!flag(FLAG_SKALDMERE_COASTAL_CERT)) {
                msgbox(format("Captain: The climate station? That route opens once you've worked the coast.\nNot before."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_WEATHER, 23, 36)
            waitstate
            end
        default:
            msgbox(format("Captain: Suit yourself. I'll be on the water."), MSGBOX_DEFAULT)
            release
            end
    }
    end
}

// --- Mereholt clearance checkpoint: the harbour-master (Moore) --------------
// Sight trainer on the lane down to the quay. A green provisional walks past
// him unproven; the player returns by ferry later with a team that holds.
script ParcelIsle_GateMoore {
    trainerbattle_single(TRAINER_SKALD_GATE_ISLE,
        format("Moore: Harbour-master. Every hull and every hand that moves through here is logged.\pYou want clearance on this water? Earn the entry."),
        format("Moore: …Noted. The harbour knows your name now."),
        ParcelIsle_GateMoore_Defeated)
    lock
    faceplayer
    msgbox(format("Moore: You're cleared through the landing. The ferry runs answer to the log,\nand the log answers for you."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelIsle_GateMoore_Defeated {
    setflag(FLAG_SKALDMERE_GATE_ISLE)
    msgbox(format("Moore: Harbour clearance: entered against your card. Filed with the manifest.\pNobody hands that out. You took it."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelIsle_ItemNetBall {
    finditem(ITEM_NET_BALL)
    end
}

// ---------------------------------------------------------------------------
// THE STREET AND THE GREEN
// ---------------------------------------------------------------------------

// Pell, Mereholt Logistics. A clipboard walking up and down the road.
script ParcelIsle_LogisticsClerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Pell: Half my manifests are on hold. The other half are lawyers.\pI used to log trucks. Now I log the absence of trucks. It's the same form. That's the part that gets me."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("Pell: Relief convoy for the basin, three trucks, Foundation crest, Council seal.\pRelief for what? Don't ask me. I log what moves. Somebody else decides what it means."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Pell: Corps is hiring provisionals again. That's you? Congratulations. Your gear's on a manifest with our crest on it.\pNot a complaint. Just accuracy. I'm paid for accuracy."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Pell: Everything that moves through Saltwick is on a manifest. Fuel, crates, the ferry you came in on, the potion on your belt if it came by boat.\pYou? Passenger, one, off at the island stop. I've got you already."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Ebba and Nils, on the green. The Poliwag seed, seen by children first.
script ParcelIsle_KidA {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Ebba: Nils says you wrote it down. All of it. Even the frogs.\pAre we in it? We saw them first."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_BRIDGE_SCENE)) {
        msgbox(format("Ebba: You saw them too. On the bridge. Going the wrong way.\pNils said you'd say we made it up. You didn't."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Ebba: There were frogs in the inlet going the WRONG way! Upstream, all in a line, like they were late for something.\pNils says frogs don't get late."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_KidB {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Nils: What's the word? For when a place is running out?\pEbba says you've got a word for it now. I want the word."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_BRIDGE_SCENE)) {
        msgbox(format("Nils: Gran says the Poliwag have always done that. Gran says a lot of things have always done that.\pI counted anyway. Fourteen. Less than last time."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Nils: Frogs don't get late. They get scared, maybe.\pDon't tell Ebba I said scared."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Halvar, on the bench. Forty years of the Corps, and he still watches the road.
script ParcelIsle_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Halvar: Somebody finally said it out loud. In writing. With a name at the bottom.\pIt cost you. It'll cost everyone. Forty years I walked that bridge and it never once occurred to me that the cost was the point."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Halvar: Hale signed for you? Hale doesn't sign for anyone. He didn't sign for me, and I ran his station before he did.\pWatch him. Not because he's wrong. Because he's tired, and tired men are careful in the wrong places."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Halvar: Forty years I walked that bridge for the Corps. Never saw the water this quiet.\pQuiet's not peace. Quiet's what a place does when it's counting."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Corwen, the birder at the inlet. Side quest: tell him when you've seen a Delibird.
script ParcelIsle_Birder {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_BIRDER_DONE)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("Corwen: The storm-relief birds were on the wireless this morning. By name. Delibird. Somebody read your filing on air.\pForty years of lists and I never once made the news. Good."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("Corwen: Eleven species on the inlet today. Twenty, the year I started.\pThe list is the only thing I own that gets shorter and heavier at the same time."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_ARRIVAL)) {
        msgbox(format("Corwen: You've been out to the island. I can see it on you -- the cold's still in your coat.\pTell me. Did you see one? A Delibird. On the ground, not in a picture."), MSGBOX_YESNO)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("Corwen: …Then they're still there. I haven't been able to cross since my knee. Fifteen years I've had them on the list from memory.\pTake this. It's for looking at what's far off. I'm done needing it."), MSGBOX_DEFAULT)
            giveitem(ITEM_SCOPE_LENS)
            setflag(FLAG_SKALD_Q_BIRDER_DONE)
        } else {
            msgbox(format("Corwen: No. …No, that's honest. Come back when you have."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Corwen: The Survey knot. Ilex ties them left over right; she's the only one. So you've met her.\pIf the Corps ever sends you north to the island, look for a bird with a tail like a rope. Then come and tell me."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Corwen: Wingull, Pelipper, one Swablu that has no business this far north.\pI keep a list. It's shorter than it was. That's not an opinion. That's a list."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_KidTrainer {
    trainerbattle_single(TRAINER_SKALD_KID,
        format("Timo: You came off the ferry! Mainlanders always have neat Pokémon. Battle me!"),
        format("Timo: Whoa. Okay."))
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Timo: You went past the bridge. Gran says you're allowed now because of the knot.\pWhat's past it? …No. Don't tell me. I want to be allowed first."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Timo: Gran says don't go past the bridge.\pShe won't say why."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_TownSign {
    msgbox(format("SALTWICK\pSaltmarsh Coast -- Skaldmere Regional Council\pA smaller plate beneath, newer than the sign: Harbour works by MEREHOLT COASTAL."), MSGBOX_SIGN)
    end
}

// ---------------------------------------------------------------------------
// THE LANES
// ---------------------------------------------------------------------------

// §07: a neighbour asks if you're "the one the scientist wrote about," then
// changes the subject. Marit.
script ParcelIsle_Neighbor {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Marit: I said forget I said anything. That first day.\pI'm not saying it now. She wrote about you because you'd do this. She knew. I think she was sorry, and I think she knew that too."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_LAB_SEEN)) {
        msgbox(format("Marit: You've been in the annex. I can tell; people come out of there quiet.\pShe left it tidy. That's what nobody says. Ransacked places aren't tidy."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Oh--you're the one the scientist wrote about, aren't you? The young naturalist with the--"), MSGBOX_DEFAULT)
        applymovement(LOCALID_NEIGHBOR, Movement_GlanceAway)
        waitmovement(0)
        msgbox(format("…Forget I said anything. It's cold out. You should get indoors, {PLAYER}."), MSGBOX_DEFAULT)
    }
    release
    end
}

movement Movement_GlanceAway {
    face_right
    delay_16
    delay_16
    step_end
}

// Liv, sweeping outside the lodging. Her mother keeps the rooms.
script ParcelIsle_Innkeeper {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Liv: Two lawyers and a journalist in the good rooms. Mum's charging them double and apologising for it.\pYour room's still yours. She won't let it."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Liv: Mum says rangers eat like they're paid in weather. She's made the big pot.\pShe hasn't made the big pot since the scientist left."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Liv: Mum's kept your room since the letter came. Swept it every week. She wouldn't say who for.\pThe lamp's lit. Go on in."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Ossian, the chandler's brother, smoking outside the shop.
script ParcelIsle_ChandlerBrother {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("Ossian: Kit's sold more rope this week than all winter. Everyone suddenly wants to tie something down.\pI sit. I've always sat. Turns out sitting was the wrong way to be right."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("Ossian: Kit's got the ranger stock in now. Repels, the good potions. Says the Corps pays on time, unlike some.\pShe means the fleet. She won't say the fleet."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("Ossian: Kit's inside. She sells; I sit. It's an arrangement.\pWind's coming off the water wrong all month. You get used to it. Mostly."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_ItemPotion {
    finditem(ITEM_POTION)
    end
}

script ParcelIsle_LabSign {
    msgbox(format("FIELD RESEARCH ANNEX\nSkaldmere Survey cooperative site\pA strip of red cloth is nailed under the plate, faded gray."), MSGBOX_SIGN)
    end
}

script ParcelIsle_HallSign {
    msgbox(format("SALTWICK FISHERS' CO-OPERATIVE\pMeetings first Tuesday. Members and guests.\pUnder that, stencilled: with the support of the MEREHOLT FOUNDATION."), MSGBOX_SIGN)
    end
}

script ParcelIsle_NoticeBoard {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("NOTICES\pREGIONAL HEARINGS -- COASTAL QUOTAS: public sessions, the Council hall, Thursdays. Transport provided.\pMereholt Coastal: day-rate hiring SUSPENDED pending review.\pSomeone has pinned a strip of red cloth to the corner of the board."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("NOTICES\pSkaldmere Climate Corps: provisional rangers wanted. Apply at the district station, past the bridge.\pMereholt Coastal: day-rate hiring, quay, dawn. Own boots.\pLost: one grey cat, answers to Sedge."), MSGBOX_SIGN)
    } else {
        msgbox(format("NOTICES\pMereholt Coastal: day-rate hiring, quay, dawn. Own boots.\pFerry schedule: see board at landing.\pLost: one grey cat, answers to Sedge.\pA fourth notice has been torn down. Two corners of it are still under the pins."), MSGBOX_SIGN)
    }
    end
}

script ParcelIsle_WeatherStationSign {
    msgbox(format("AUTOMATED WEATHER STATION 04\nSkaldmere Climate Corps\pInstrument sponsorship: the Mereholt Foundation\pThe anemometer turns. The logger light is off."), MSGBOX_SIGN)
    end
}

script ParcelIsle_PreserveGateSign {
    msgbox(format("MISTWOOD SHORE PRESERVE\nNo entry beyond this point without a Corps permit.\pThe green-and-grey crest of the Mereholt Foundation, cast in bronze, very clean.\pThe gate is chained."), MSGBOX_SIGN)
    end
}
