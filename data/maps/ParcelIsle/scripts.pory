// ParcelIsle -- SALTWICK, the arrival town. Hand-drawn 44x36 (canvas.txt).
// Voice rule (2026-09-26): people talk like people. Short, in character, a bit
// funny, and it tells you something you can use. No narrator boxes except
// signs. Story moments are played on screen, not described.
// Three states: arrival / after FLAG_SKALDMERE_FOREST_CERT / after
// FLAG_SKALDMERE_FINALE_DONE.

const LOCALID_HEAVYCOAT     = 1
const LOCALID_FISHER        = 2
const LOCALID_CHANDLER_BRO  = 3
const LOCALID_NEIGHBOR      = 4
const LOCALID_FERRY_CAPTAIN = 7
const LOCALID_INNKEEPER     = 9
const LOCALID_CLERK         = 10
const LOCALID_KID_A         = 11
const LOCALID_KID_B         = 12
const LOCALID_OLDMAN        = 13
const LOCALID_BIRDER        = 14
const LOCALID_NETMENDER     = 16
const LOCALID_DOCKWORKER    = 17
const LOCALID_HARBOUR_LAD   = 18
const LOCALID_WIDOW         = 19

mapscripts ParcelIsle_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelIsle_SetVisited
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: ParcelIsle_Arrival
    ]
}

script ParcelIsle_SetVisited {
    setflag(FLAG_VISITED_PARCEL_ISLE)
    end
}

// Arrival: the horn, then Bram comes down the jetty to meet the boat.
script ParcelIsle_Arrival {
    setvar(VAR_TEMP_0, 1)
    if (flag(FLAG_SKALDMERE_ARRIVAL_INTRO)) {
        end
    }
    lockall
    playse(SE_SHIP)
    delay(60)
    applymovement(LOCALID_HEAVYCOAT, Movement_BramToJetty)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_FaceUp)
    waitmovement(0)
    msgbox(format("BRAM: Hey! You're the mainlander, right? WREN?\pKnew it. Nobody else gets off at this stop."), MSGBOX_DEFAULT)
    msgbox(format("BRAM: Listen. The inn's up the lane, past the POKéMON CENTER. Look for the door with the lamp lit.\pAnd watch your step on the boards. They're slick when the fog rolls in."), MSGBOX_DEFAULT)
    msgbox(format("BRAM: Questions? Save them for tomorrow. Around here, nobody answers anything after dark."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_HEAVYCOAT, Movement_BramBack)
    waitmovement(0)
    msgbox(format("You stand a moment on the boards. The fog has the smell of a wet place at dusk, and for one breath you are nine years old and somebody small is painting the water beside you.\pYou shoulder the pack. You came empty on purpose."), MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_SKALDMERE_ARRIVAL_INTRO)
    releaseall
    end
}

movement Movement_BramToJetty {
    walk_left
    walk_left
    walk_down
    walk_down
    walk_down
    step_end
}

movement Movement_BramBack {
    walk_up
    walk_up
    walk_up
    walk_right
    walk_right
    face_left
    step_end
}

movement Movement_FaceUp {
    face_up
    step_end
}

// ---------------------------------------------------------------------------
// THE QUAY
// ---------------------------------------------------------------------------

script ParcelIsle_HeavyCoat {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BRAM: The schedule board's got a date on it again. First time in a year!\pI'd say things are looking up, but I've been wrong before."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BRAM: Mainland papers came in with the ferry. The river's on page two. Page two! Nothing from up here's been on page two since the wreck.\pYour name's not in it. The knot is, near enough. 'A Corps provisional.'"), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("BRAM: So you're a RANGER now. Provisional, but still.\pTake it from a ferry hand: the knot on your pack means more around here than the badge does."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("BRAM: The inn's up the lane, past the POKéMON CENTER. Door with the lamp.\pThe RANGERS are past the north gate, if that's who you're here for. Rin usually leaves it open."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Tobin, on the landing platform. Also the far end of Anni's errand.
script ParcelIsle_Fisher {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_ANNI_NET) && !flag(FLAG_SKALD_Q_ANNI_DONE)) {
        msgbox(format("TOBIN: That's my net! Only ANNI doubles the edge like that.\pShe sent you all the way down here? Then she likes you. She doesn't like anybody."), MSGBOX_DEFAULT)
        msgbox(format("TOBIN: Here, take my spare rod. It's old, but it knows this water.\pThrow the little ones back, okay? There's fewer every year."), MSGBOX_DEFAULT)
        giveitem(ITEM_OLD_ROD)
        setflag(FLAG_SKALD_Q_ANNI_DONE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("TOBIN: They have to count the fish properly now. In front of people!\pForty years I counted for nobody. Funny to be right and hate it."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("TOBIN: The herring came in thin this week. Thin and early.\pThat's not a season. That's a symptom. You're the RANGER, you tell me the word for it."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("TOBIN: The currents have been wrong for weeks. The fish know it before we do.\pYou didn't hear that from me."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Rolf, MEREHOLT COASTAL day-rate. The paycheck with a face.
script ParcelIsle_Dockworker {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
        msgbox(format("ROLF: Eighteen months of delay, they're saying. You know what eighteen months is to a guy on a day rate?\pI'm not saying you're wrong. ANNI read me the frog part. I'm saying it's easy to be right when it's not your boat."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ROLF: Boat's not late today. Boat's not coming. The office says 'pending review'.\pThat your review? Yeah. Thought so."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("ROLF: The crest on the crates is the crest on my paycheck. Same one that's on the RANGERS' gear, come to think of it.\pFunny what you stop noticing."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("ROLF: Boat's late. Boat's always late now.\pIf you want work, there's a board by the inn. Mostly it says 'no'."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Anni, mending nets. Side quest: carry the mended net to Tobin.
script ParcelIsle_NetMender {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_ANNI_DONE)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("ANNI: ROLF had me read him your report. The frog part, twice.\pHe didn't say anything after. For ROLF, that's a speech."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("ANNI: TOBIN gave you his rod? He's never lent that to anyone!\pGo fish the inlet. Tell me if the MAGIKARP are still in there. They used to be so thick you could walk across."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ANNI_NET)) {
        msgbox(format("ANNI: TOBIN's at the end of the jetty, on the platform. He won't come up. Says the town's gone strange.\pHe's right, but the net still needs carrying."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("ANNI: You're the new RANGER, right? Good, you can carry things.\pThis net's mended and TOBIN's is torn. My knees don't do the jetty anymore."), MSGBOX_DEFAULT)
        msgbox(format("ANNI: Take it down to him. End of the jetty, the grumpy one.\pTell him the edge is doubled. He'll know whose it is."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_ANNI_NET)
        release
        end
    }
    msgbox(format("ANNI: Nets don't tear like they used to. Nothing in them heavy enough to tear them.\pDon't write that down. It's not a fact. It's just true."), MSGBOX_DEFAULT)
    release
    end
}

// Kip -- an optional battle on the quay. Talk-triggered.
script ParcelIsle_HarbourLad {
    lock
    faceplayer
    if (!flag(FLAG_SYS_POKEMON_GET)) {
        msgbox(format("KIP: You got off the ferry with a bag and no POKéMON? Not even one?\pCome back when you've got something. Then we'll see."), MSGBOX_DEFAULT)
        release
        end
    }
    release
    trainerbattle_single(TRAINER_SKALD_HARBOUR_LAD,
        format("KIP: Hey, mainlander! Bet you can't beat my KRABBY.\pThe whole channel used to be full of them!"),
        format("KIP: Used to be. Yeah."))
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("KIP: My dad says you cost him his berth. My mom says you saved the channel.\pThey had that fight at dinner. I ate in the loft."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("KIP: There were dozens of KRABBY under the jetty when I was little. Now I have to go out to the rocks to find one.\pI'm not sad about it. I'm just saying where they went."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Sigrun at the drying racks. Side quest: count the WINGULL with her.
script ParcelIsle_Widow {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_SIGRUN_DONE)) {
        msgbox(format("SIGRUN: Eleven this morning. I still count them. It's how I say good morning to someone who isn't here."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_SIGRUN)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("SIGRUN: You put the gulls in your report. The actual gulls!\pMy EIRIK would have liked that. He never trusted a number he hadn't counted himself."), MSGBOX_DEFAULT)
            msgbox(format("SIGRUN: This was his. It's the only thing on the boat the sea didn't take.\pIt should go to someone who counts."), MSGBOX_DEFAULT)
            giveitem(ITEM_LUCKY_EGG)
            setflag(FLAG_SKALD_Q_SIGRUN_DONE)
        } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
            msgbox(format("SIGRUN: Nine today. When EIRIK still fished there were forty on these racks. Forty!\pWrite that down. Nine. Somebody should have the number besides me."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("SIGRUN: Twelve this morning. Come back another day and I'll give you the next one.\pA number only means something twice."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    msgbox(format("SIGRUN: Count the gulls with me. On the racks there. Go on.\pTwelve. Say it back, so two of us know it."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("SIGRUN: Twelve. Good. My husband kept that count for thirty years.\pCome back and I'll give you the next one. That's all a survey is, you know. Somebody coming back."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_SIGRUN)
    } else {
        msgbox(format("SIGRUN: No? Then it's just me who knows. That's been fine so far."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_FerrySign {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FERRY LANDING\pMainland service: SUSPENDED\nPENDING REGIONAL REVIEW\pSomeone wrote underneath in pencil: ABOUT TIME."), MSGBOX_SIGN)
    } else {
        msgbox(format("FERRY LANDING\pThe mainland schedule board is blank.\nIt has been for a while."), MSGBOX_SIGN)
    }
    end
}

// The ferry hub: DELIBIRD ISLE first, the COAST after that crossing, the
// CLIMATE STATION once the Coastal Certification is in hand.
script ParcelIsle_FerryCaptain {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CAPTAIN: Passage out, RANGER? Any time. Any weather. You've paid for the ferry for life, the harbour office says. I'd have taken you anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("CAPTAIN: Passage out? Not in this cold, not without a reason.\pCome back when the RANGERS have sent you up the mountains. You'll know when."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CAPTAIN: Harbour's open. Where to?"), MSGBOX_DEFAULT)
    multichoice(1, 1, MULTI_SKALD_FERRY, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_DELIBIRD, 9, 22)
            waitstate
            end
        case 1:
            if (!flag(FLAG_SKALDMERE_DELIBIRD_ARRIVAL)) {
                msgbox(format("CAPTAIN: The coast run opens after you've made the DELIBIRD crossing.\nOne island at a time."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_COAST, 30, 55)
            waitstate
            end
        case 2:
            if (!flag(FLAG_SKALDMERE_COASTAL_CERT)) {
                msgbox(format("CAPTAIN: The climate station? That run opens once you've worked the coast. Not before."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_WEATHER, 9, 34)
            waitstate
            end
        default:
            msgbox(format("CAPTAIN: Suit yourself. I'll be on the water."), MSGBOX_DEFAULT)
            release
            end
    }
    end
}

// Moore, the harbour-master. A sight trainer on the lane to the quay.
script ParcelIsle_GateMoore {
    trainerbattle_single(TRAINER_SKALD_GATE_ISLE,
        format("MOORE: Harbour-master. Every hull and every hand that moves through here goes in my log.\pYou want harbour clearance? Earn it."),
        format("MOORE: Noted. The harbour knows your name now."),
        ParcelIsle_GateMoore_Defeated)
    lock
    faceplayer
    msgbox(format("MOORE: You're cleared through the landing. The ferry runs answer to the log, and the log answers for you."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelIsle_GateMoore_Defeated {
    setflag(FLAG_SKALDMERE_GATE_ISLE)
    msgbox(format("MOORE: Harbour clearance, entered against your card.\pNobody hands that out. You took it."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelIsle_ItemNetBall {
    finditem(ITEM_NET_BALL)
    end
}

// ---------------------------------------------------------------------------
// THE STREET AND THE GREEN
// ---------------------------------------------------------------------------

// Pell, MEREHOLT LOGISTICS. A clipboard with legs.
script ParcelIsle_LogisticsClerk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("PELL: Half my manifests are on hold. The other half are lawyers.\pI used to log trucks. Now I log the absence of trucks. It's the same form!"), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("PELL: Three crates of soil cores, FERNWICK to the river, marked EVIDENCE. I've logged a lot of things. Never that word.\pAnd two trucks of sandbags back from the basin, empty. Empty is a manifest too."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("PELL: Relief convoy for the basin. Three trucks, FOUNDATION crest, Council seal.\pRelief for what? Don't ask me. I log what moves."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("PELL: The RANGERS are hiring again? Congratulations. Your gear came in on our manifest, by the way.\pNot a complaint. I'm paid for accuracy."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("PELL: Everything that moves through SALTWICK is on a manifest. Fuel, crates, the ferry you came in on.\pYou? 'Passenger, one, island stop.' I've already got you."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Ebba and Nils on the green. They saw the POLIWAG first.
script ParcelIsle_KidA {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("EBBA: NILS says you wrote everything down. Even the frogs!\pAre we in it? We saw them first!"), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("EBBA: NILS says the frogs in the river got counted by the WHOLE VILLAGE and it went in a book.\pOurs only got counted by us. Does ours count less? NILS says counting is counting."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_BRIDGE_SCENE)) {
        msgbox(format("EBBA: You saw them too! On the bridge! Going the wrong way!\pNILS said you'd say we made it up. You didn't."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("EBBA: There were frogs in the inlet going the WRONG way! Upstream! All in a line, like they were late for something!\pNILS says frogs don't get late."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_KidB {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("NILS: What's the word? For when a place is running out?\pEBBA says you've got a word for it now. I want the word."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("NILS: Counting is counting. Twelve this week, in the inlet. I wrote the date like you do.\pEBBA wants to send it to the river. I said they've got their own frogs. She said that's the point."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_BRIDGE_SCENE)) {
        msgbox(format("NILS: Gran says the POLIWAG have always done that. Gran says a lot of things have always done that.\pI counted anyway. Fourteen. Less than last time."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("NILS: Frogs don't get late. They get scared, maybe.\pDon't tell EBBA I said scared."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Halvar on the bench. Forty years in the RANGERS.
script ParcelIsle_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_HALVAR) && !flag(FLAG_SKALD_Q_HALVAR_DONE)) {
        if (flag(FLAG_SKALD_Q_HALVAR_FOUND)) {
            msgbox(format("HALVAR: ...Well. There it is. Twenty-two years in the water and it's cleaner than I am.\pBlow it? No. Let it be. Some things you keep because they're quiet now."), MSGBOX_DEFAULT)
            msgbox(format("HALVAR: Here. This came off my first partner's collar. She was a loud one too. Take it; the whistle and the bell don't need to be in the same drawer."), MSGBOX_DEFAULT)
            giveitem(ITEM_SOOTHE_BELL)
            setflag(FLAG_SKALD_Q_HALVAR_DONE)
            msgbox(format("HALVAR: Low water gave it back. Mark that in your book. Low water gives things back right before it takes the rest."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("HALVAR: The inlet, by the bridge. Low water. Look where the light goes flat on the stones."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HALVAR: Somebody finally said it out loud. In writing, with a name at the bottom.\pIt'll cost you. It'll cost everyone. Forty years on that bridge and it never once occurred to me that the cost was the point."), MSGBOX_DEFAULT)
    } elif (!flag(FLAG_SKALD_Q_HALVAR_DONE)) {
        msgbox(format("HALVAR: Forty years on that bridge and I lost one thing in all of it. A whistle. Corps issue, brass, on a lanyard. Went over the rail into the inlet the night the marsh road flooded.\pLow water this year. Lowest I've seen. If it's ever going to show, it's now.\pHave a look along the inlet by the bridge, would you. Humour an old man."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_HALVAR)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("HALVAR: Six people stood up in a river hall and the Board wrote down what they said. In my forty years that happened never.\pHALE will say it's procedure. It isn't. It's weather turning. Watch the water here. It'll know first."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("HALVAR: HALE signed for you? HALE doesn't sign for anyone! He didn't sign for me, and I ran his station before he did.\pWatch him. Not because he's wrong. Because he's tired."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("HALVAR: Forty years I walked that bridge for the RANGERS. Never saw the water this quiet.\pQuiet isn't peace, kid. Quiet is a place holding its breath."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Corwen, the birder at the inlet. Side quest: tell him when you've seen a DELIBIRD.
script ParcelIsle_Birder {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_BIRDER_DONE)) {
        if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
            msgbox(format("CORWEN: The storm birds were on the radio this morning! By name! DELIBIRD!\pForty years of lists and I never once made the news. Good."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("CORWEN: Eleven species on the inlet today. Twenty, the year I started.\pMy list is the only thing I own that gets shorter and heavier at the same time."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_ARRIVAL)) {
        msgbox(format("CORWEN: You've been out to the island! I can tell, the cold's still in your coat.\pTell me. Did you see one? A DELIBIRD. On the ground, not in a picture."), MSGBOX_YESNO)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("CORWEN: Then they're still there! I haven't been able to make the crossing since my knee went.\pTake this. It's for looking at far-off things. I'm done needing it."), MSGBOX_DEFAULT)
            giveitem(ITEM_SCOPE_LENS)
            setflag(FLAG_SKALD_Q_BIRDER_DONE)
        } else {
            msgbox(format("CORWEN: No? Well. That's honest. Come back when you have."), MSGBOX_DEFAULT)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("CORWEN: That's a survey knot on your pack. ILEX ties them left over right. Nobody else does.\pIf the RANGERS ever send you north to the island, look for a bird with a tail like a rope. Then come tell me."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("CORWEN: WINGULL, PELIPPER, and one SWABLU with no business this far north.\pI keep a list. It's shorter than it used to be. That's not an opinion. That's a list."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_KidTrainer {
    trainerbattle_single(TRAINER_SKALD_KID,
        format("TIMO: You're from the mainland! Mainlanders always have cool POKéMON. Let's battle!"),
        format("TIMO: Whoa. Okay!"))
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("TIMO: You went past the bridge! Gran says you're allowed because of the knot.\pWhat's out there? No, wait, don't tell me. I want to be allowed first."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("TIMO: Gran says don't go past the bridge.\pShe won't say why. She just gets quiet."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_TownSign {
    msgbox(format("SALTWICK\pSaltmarsh Coast -- Skaldmere Regional Council\pA newer plate underneath: HARBOUR WORKS BY MEREHOLT COASTAL."), MSGBOX_SIGN)
    end
}

// ---------------------------------------------------------------------------
// THE LANES
// ---------------------------------------------------------------------------

// Marit, next door. "The one the scientist wrote about."
script ParcelIsle_Neighbor {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MARIT: I told you to forget I said anything, that first day. I'm not saying it now.\pShe wrote about you because she knew you'd do this. I think she was sorry. I think she knew that too."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MARIT: The river story came up the coast on the ferry before the papers did. Fishwives are faster than print.\pThey say a Corps provisional read the Board's own numbers back to them. I said I know who that is. Then I shut my mouth, for once."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_LAB_SEEN)) {
        msgbox(format("MARIT: You've been in the annex. People come out of there quiet.\pShe left it tidy. That's what nobody says. Ransacked places aren't tidy."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("MARIT: Oh! You're the one the scientist wrote about, aren't you? The young naturalist with the--"), MSGBOX_DEFAULT)
        applymovement(LOCALID_NEIGHBOR, Movement_GlanceAway)
        waitmovement(0)
        msgbox(format("MARIT: Forget I said anything. It's cold out. Get indoors, {PLAYER}."), MSGBOX_DEFAULT)
    }
    release
    end
}

movement Movement_GlanceAway {
    face_right
    delay_16
    delay_16
    step_end
}

// Liv, sweeping outside the inn.
script ParcelIsle_Innkeeper {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("LIV: Two lawyers and a reporter in the good rooms. Mom's charging them double and apologizing for it.\pYour room's still yours. She won't let anyone else have it."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("LIV: Mom's making the big pot on Thursdays now, for whoever's off the ferry. Rangers, mostly. One from the basin cried into it.\pShe says the scientist would've approved. She says it to the pot, not to me."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("LIV: Mom says RANGERS eat like they get paid in weather. She made the big pot.\pShe hasn't made the big pot since the scientist left."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("LIV: Mom's kept your room since the letter came. Swept it every week. She wouldn't say who for.\pThe lamp's lit. Go on in, you'll freeze."), MSGBOX_DEFAULT)
    }
    release
    end
}

// Ossian, the chandler's brother, on his smoke break.
script ParcelIsle_ChandlerBrother {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OSSIAN: KIT's sold more rope this week than all winter. Everyone suddenly wants to tie something down.\pMe, I sit. Turns out sitting was the wrong way to be right."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OSSIAN: KIT's had a run on lamp oil. People reading late. Minutes from the river, passed hand to hand.\pI've read them. I sit. Reading is a kind of sitting."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("OSSIAN: KIT's got the RANGER stock in now. REPELS, the good POTIONS. Says the RANGERS pay on time, unlike some.\pShe means the fleet. She won't say the fleet."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("OSSIAN: KIT's inside. She sells, I sit. It's an arrangement.\pWind's been coming off the water wrong all month. You get used to it. Mostly."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsle_ItemPotion {
    finditem(ITEM_POTION)
    end
}

script ParcelIsle_LabSign {
    msgbox(format("FIELD RESEARCH ANNEX\nSkaldmere Survey cooperative site\pA strip of red cloth is nailed under the plate, faded gray."), MSGBOX_SIGN)
    end
}

script ParcelIsle_HallSign {
    msgbox(format("SALTWICK FISHERS' CO-OPERATIVE\pMeetings first Tuesday. Members and guests.\pStencilled underneath: WITH THE SUPPORT OF THE MEREHOLT FOUNDATION."), MSGBOX_SIGN)
    end
}

script ParcelIsle_NoticeBoard {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("NOTICES\pREGIONAL HEARINGS -- COASTAL QUOTAS. Public sessions Thursdays at the Council hall. Transport provided.\pMEREHOLT COASTAL: day-rate hiring SUSPENDED pending review.\pSomeone pinned a strip of red cloth to the corner of the board."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("NOTICES\pSKALDMERE CLIMATE CORPS: provisional RANGERS wanted. Apply at the district station.\pMEREHOLT COASTAL: day-rate hiring, quay, dawn. Own boots.\pLOST: one gray cat, answers to SEDGE."), MSGBOX_SIGN)
    } else {
        msgbox(format("NOTICES\pMEREHOLT COASTAL: day-rate hiring, quay, dawn. Own boots.\pFERRY SCHEDULE: see board at landing.\pLOST: one gray cat, answers to SEDGE.\pA fourth notice has been torn down. Two corners are still under the pins."), MSGBOX_SIGN)
    }
    end
}

script ParcelIsle_WeatherStationSign {
    msgbox(format("AUTOMATED WEATHER STATION 04\nSkaldmere Climate Corps\pInstrument sponsorship: the MEREHOLT FOUNDATION\pThe anemometer turns. The logger light is off."), MSGBOX_SIGN)
    end
}

script ParcelIsle_PreserveGateSign {
    msgbox(format("MISTWOOD SHORE PRESERVE\nSkaldmere Climate Corps -- Holding Meadow\pNo entry without a RANGER present.\pThe MEREHOLT FOUNDATION crest, cast in bronze, very clean."), MSGBOX_SIGN)
    end
}

// --- the Center door, before you have a partner ------------------------------
// A Corps medic stands on the step until FLAG_SYS_POKEMON_GET is set (the
// object's flag hides him after the meadow). The aid station can't do
// anything for an empty belt, and the engine has nothing to heal.
script ParcelIsle_CenterAide {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MEDIC: Aid station's for POKéMON. Yours look like they've walked a region. They have. Leave them with me an hour."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MEDIC: The aid station's been busier. Not with injuries. With rangers coming down off the ferry to sit a minute before they walk home.\pThe basin and the river, mostly. I don't ask. I put the kettle on."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MEDIC: Aid station's for POKéMON, and you haven't got one yet.\pRIN's up at the meadow, through the north gate. Go get picked. Then come back and I'll move."), MSGBOX_DEFAULT)
    release
    end
}

// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelIsle_T_Brand {
    trainerbattle_single(TRAINER_SKALD_ISLE_BRAND,
        format("BRAND: Off the ferry crew. Nothing to do till the tide. Battle me, RANGER, the harbour's dull."),
        format("BRAND: Tide's in. Figuratively."),
        ParcelIsle_T_Brand_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_ISLE_BRAND_R2)) {
        goto(ParcelIsle_T_Brand_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_ISLE_BRAND_R3)) {
        goto(ParcelIsle_T_Brand_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_ISLE_BRAND_R4)) {
        goto(ParcelIsle_T_Brand_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_ISLE_BRAND_R5)) {
        goto(ParcelIsle_T_Brand_R5)
    }
    msgbox(format("BRAND: Three ferry routes now. DELIBIRD, the coast, the station. The coast one's full every run. Nobody comes back smiling."), MSGBOX_DEFAULT)
    end
}
script ParcelIsle_T_Brand_FirstWin {
    msgbox(format("BRAND: Three ferry routes now. DELIBIRD, the coast, the station. The coast one's full every run. Nobody comes back smiling."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelIsle_T_Brand_R2 {
    lock
    faceplayer
    msgbox(format("BRAND: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("BRAND: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
