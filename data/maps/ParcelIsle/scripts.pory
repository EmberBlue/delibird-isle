// ParcelIsle -- the arrival dock town (§07 Scene 1; town name pending the
// §01 detail pass). The held-breath town: residents subtly evasive, never
// hostile. Dialogue beats are from design/07-prologue.md -- the two opening
// scroll paragraphs are canonical and verbatim. No exposition dumps;
// everyone implies more than they state (§00 anti-rules).

// Object event local IDs (must match data/maps/ParcelIsle/map.json)
const LOCALID_HEAVYCOAT  = 1
const LOCALID_FISHER     = 2
const LOCALID_SHOPKEEPER = 3
const LOCALID_NEIGHBOR   = 4
const LOCALID_FERRY_CAPTAIN = 7
// LOCALID_ISLE_GATE is resolved from map.json object order via the generated
// map_event_ids.h (the gate is sight-triggered; no script references the id).

mapscripts ParcelIsle_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelIsle_SetVisited
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_0, 0: ParcelIsle_Arrival
    ]
}

script ParcelIsle_SetVisited {
    setflag(FLAG_VISITED_PARCEL_ISLE)
    end
}

// One-time §07 opening: the scroll, the ferry horn, boots on damp wood.
// The full prologue cutscene (the letter, pronoun select) replaces the
// Birch skip later; this is the in-world half of it.
script ParcelIsle_Arrival {
    setvar(VAR_TEMP_0, 1)
    if (flag(FLAG_SKALDMERE_ARRIVAL_INTRO)) {
        end
    }
    lockall
    playse(SE_SHIP)
    delay(96)
    msgbox(format("The ferry horn fades out across the water.\pThe boards are damp under your boots."), MSGBOX_DEFAULT)
    closemessage
    setflag(FLAG_SKALDMERE_ARRIVAL_INTRO)
    releaseall
    end
}

// §07: "An NPC in a heavy coat points the way."
script ParcelIsle_HeavyCoat {
    lock
    faceplayer
    msgbox(format("Off the ferry, then. Lodging's up the track--the door with the lamp lit."), MSGBOX_DEFAULT)
    msgbox(format("Mind the boards. They're slick when the fog sits.\p…And keep your questions for morning, eh?"), MSGBOX_DEFAULT)
    release
    end
}

// §07: a fisher at the pier says the currents "have been wrong for weeks."
script ParcelIsle_Fisher {
    lock
    faceplayer
    msgbox(format("Currents have been wrong for weeks. The fish know it before we do.\p…You didn't hear that from me."), MSGBOX_DEFAULT)
    release
    end
}

// §07: a shopkeeper mentions "strange weather inland" like an everyday nuisance.
script ParcelIsle_Shopkeeper {
    lock
    faceplayer
    msgbox(format("Wind's been coming off the water wrong all month. Strange weather inland, too--my supplier says the fog sits in the valleys till noon."), MSGBOX_DEFAULT)
    msgbox(format("You get used to it.\nMostly.\pNeed supplies? The shelf's stocked, when the boat remembers us."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        pokemart(ParcelIsle_MartItems)
    }
    msgbox(format("Mind the fog out there."), MSGBOX_DEFAULT)
    release
    end
}

raw `
	.align 2
ParcelIsle_MartItems::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_REPEL
	.2byte ITEM_NONE
`

script ParcelIsle_KidTrainer {
    trainerbattle_single(TRAINER_SKALD_KID,
        format("Timo: You came off the ferry! Mainlanders always have neat Pokémon. Battle me!"),
        format("Timo: Whoa. Okay."))
    msgbox(format("Timo: Gran says don't go past the bridge.\pShe won't say why."), MSGBOX_DEFAULT)
    end
}

script ParcelIsle_ItemPotion {
    finditem(ITEM_POTION)
    end
}

// §07: a neighbor asks if you're "the one the scientist wrote about,"
// then quickly changes the subject.
script ParcelIsle_Neighbor {
    lock
    faceplayer
    msgbox(format("Oh--you're the one the scientist wrote about, aren't you? The young naturalist with the--"), MSGBOX_DEFAULT)
    applymovement(LOCALID_NEIGHBOR, Movement_GlanceAway)
    waitmovement(0)
    msgbox(format("…Forget I said anything. It's cold out. You should get indoors, {PLAYER}."), MSGBOX_DEFAULT)
    release
    end
}

movement Movement_GlanceAway {
    face_right
    delay_16
    delay_16
    step_end
}

script ParcelIsle_FerrySign {
    msgbox(format("FERRY LANDING\pThe mainland schedule board is blank.\nIt has been for a while."), MSGBOX_SIGN)
    end
}

// §09: the ferry to Delibird Isle (zone 6). Unlocks once the Highlands are
// behind you -- Hale names the boat at the summit. Reduce harm, then come here.
// The Dock Town ferry HUB: a clean destination menu (§region archipelago).
// Routes open as the Corps sends you on: Delibird first (post-Highland cert),
// the Coast once you've made the Delibird crossing, the Climate Station once
// the Coastal cert is in hand. Outer islands each run a ferry home to here.
script ParcelIsle_FerryCaptain {
    lock
    faceplayer
    if (!flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("Captain: Passage out? The open channel's no crossing to make without a reason worth the cold.\pCome back when the Corps has sent you up the mountains. You'll know when."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Captain: Harbour's open. Where am I taking you?"), MSGBOX_DEFAULT)
    multichoice(1, 1, MULTI_SKALD_FERRY, FALSE)
    switch (var(VAR_RESULT)) {
        case 0:
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_DELIBIRD, 30, 38)
            waitstate
            end
        case 1:
            if (!flag(FLAG_SKALDMERE_DELIBIRD_ARRIVAL)) {
                msgbox(format("Captain: The coast run opens once you've made the Delibird crossing.\nOne island at a time."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_COAST, 38, 38)
            waitstate
            end
        case 2:
            if (!flag(FLAG_SKALDMERE_COASTAL_CERT)) {
                msgbox(format("Captain: The climate station? That route opens once you've worked the coast.\nNot before."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            playse(SE_SHIP)
            delay(40)
            warp(MAP_PARCEL_WEATHER, 23, 36)
            waitstate
            end
        default:
            msgbox(format("Captain: Suit yourself. I'll be on the water."), MSGBOX_DEFAULT)
            release
            end
    }
    end
}


script ParcelIsle_LabSign {
    msgbox(format("FIELD RESEARCH ANNEX\nSkaldmere Survey cooperative site\pA strip of red cloth is nailed under the plate, faded gray."), MSGBOX_SIGN)
    end
}

// --- Mereholt clearance checkpoint: the harbour gate (Moore) ----------------
// The ferry hub's harbour-master, posted on the green by the landing. Not a
// badge, not an HM -- a Mereholt clearance the harbour logs against your card.
// Mid-game tier: the Isle is the start town with no team early, so a green
// provisional will walk past Moore unproven. He's a sight trainer; the player
// returns later, by ferry, with a team that can actually hold the line.
script ParcelIsle_GateMoore {
    trainerbattle_single(TRAINER_SKALD_GATE_ISLE,
        format("Moore: Harbour-master. Every hull and every hand that moves through here is logged.\pYou want clearance on this water? Earn the entry."),
        format("Moore: …Noted. The harbour knows your name now."),
        ParcelIsle_GateMoore_Defeated)
    lock
    faceplayer
    msgbox(format("Moore: You're cleared through the landing. The ferry runs answer to the log,\nand the log answers for you."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelIsle_GateMoore_Defeated {
    setflag(FLAG_SKALDMERE_GATE_ISLE)
    msgbox(format("Moore: Harbour clearance: entered against your card. Filed with the manifest.\pNobody hands that out. You took it."), MSGBOX_DEFAULT)
    release
    end
}
