// ParcelIsleOldCoupleHouse -- Aud and Sten. She kept the kettle Dr. Heron
// drank from; he rowed the RANGERS' boat for thirty years.

mapscripts ParcelIsleOldCoupleHouse_MapScripts {
}

script ParcelIsleOldCoupleHouse_Aud {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("AUD: She sat right where you're standing and read me your letters. Not the words, she'd never. Just that they'd come.\pI think you were the only person she was ever honest with. And you were a child, far away."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("AUD: The river village stood up to the Board. In a hall. With tea, they say. You can't stand up to anybody properly without tea.\pShe'd have liked that. Thursdays. She never missed one until she did."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("AUD: She took tea here every Thursday for years. Never said a word about her work. Talked about the gulls.\pThe last Thursday, she washed her own cup. She'd never done that."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("AUD: Sit down, you're letting the fog in! Oh, it's already in. It lives here.\pYou're the young one from the letters. Don't look so surprised. Everyone knows. Nobody says."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsleOldCoupleHouse_Sten {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("STEN: Thirty years on the RANGERS' boat. I rowed HALE out to his first survey. Rowed the old Director to his last, the day he took the FOUNDATION job.\pSame boat. Same oars. Never once asked either of them what they were counting."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("STEN: The currents are still wrong. But a river stood up to a Board, and that's a current too, of a kind.\pAUD says I'm being poetic. I'm being accurate. It's the same thing done slowly."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("STEN: They built the bridge the year the marsh road flooded. A temporary bridge. That was twenty-two years ago.\pEverything on this coast is temporary if you wait long enough."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("STEN: AUD will talk your ear off. Let her. I'm the quiet one. It's an arrangement.\pThe currents are wrong, by the way. She'll say they're not. They're wrong."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsleOldCoupleHouse_ReadDresser {
    msgbox(format("A tea service for two, and a third cup, washed and put away at the back. It has not been used since a Thursday."), MSGBOX_SIGN)
    end
}

script ParcelIsleOldCoupleHouse_ReadShelf {
    msgbox(format("Sten's tide notes, in a hand that does not waste ink. The last page says: currents wrong. AUD says not. Wrong."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelIsleOldCoupleHouse_PaperEnvelopes {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A bundle of envelopes tied with string, and one more now, loose, on top. It is addressed to the ranger, care of this house, in a hand AUD does not know.\pShe has not opened it. She says letters to this house have been opened by the wrong person before and she will not be the one to start again."), MSGBOX_SIGN)
    } else {
        msgbox(format("A bundle of envelopes tied with string, all addressed in the same careful hand to this house. AUD kept them after the letters themselves went back to the reader they were meant for.\pThe postmarks are a line up the region and back: the mainland, the Coast, here. The last is three weeks before the lab was cleared."), MSGBOX_SIGN)
    }
    end
}
