script ParcelCoastBreakwater_Holger {
    trainerbattle_single(TRAINER_SKALD_BRK_HOLGER,
        format("HOLGER: Nobody comes out here. The quota doesn't count what nobody sees. Battle, and then forget you saw me."),
        format("HOLGER: …Forget it."),
        ParcelCoastBreakwater_Holger_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_BRK_HOLGER_R2)) {
        goto(ParcelCoastBreakwater_Holger_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_BRK_HOLGER_R3)) {
        goto(ParcelCoastBreakwater_Holger_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_BRK_HOLGER_R4)) {
        goto(ParcelCoastBreakwater_Holger_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_BRK_HOLGER_R5)) {
        goto(ParcelCoastBreakwater_Holger_R5)
    }
    msgbox(format("HOLGER: Four fish. Big ones. Written down? Then I'm in the review too. Fine. Put my name next to HARLAND's."), MSGBOX_DEFAULT)
    end
}
