script ParcelCoastBreakwater_Beachcomber {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_TINS_DONE)) {
        msgbox(format("BEACHCOMBER: Thirty-one. I've written it on the wall in chalk. The tide will have it by spring. That's all right. It was true in between."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_TINS_FOUND)) {
        msgbox(format("BEACHCOMBER: Thirty-one. I had twenty-nine. My eyes.\pHere. The FOUNDATION's own coin for the FOUNDATION's own tins. I find those too."), MSGBOX_DEFAULT)
        giveitem(ITEM_NUGGET)
        setflag(FLAG_SKALD_Q_TINS_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_TINS)) {
        msgbox(format("BEACHCOMBER: The rocks past the hut. Start at the wall end. Don't skip the crushed ones; crushed is still a tin."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COAST_ARRIVAL)) {
        msgbox(format("BEACHCOMBER: Count the line for me. My eyes aren't what they were and the CORPS girl's photograph is out of date.\pStart at the wall end, past the hut, and don't skip the crushed ones."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_TINS)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BEACHCOMBER: Fewer tins this month. Three, with the crest. I lined them up anyway. A short line is still a line. Somebody should keep it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BEACHCOMBER: Every tide brings something with the crest on it. I line them up along the wall.\pThe CORPS girl photographed the line for her file. It's longer now than in the photograph."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastBreakwater_Sign {
    msgbox(format("MEREHOLT BREAKWATER. Beach closed to bathing pending water quality review. -- Harbour Office"), MSGBOX_SIGN)
    end
}
script ParcelCoastBreakwater_SignHouse {
    msgbox(format("Lifeguard hut. Closed for the season. The season was last year."), MSGBOX_SIGN)
    end
}
script ParcelCoastBreakwater_ItemPPUp { finditem(ITEM_PP_UP) end }

// --- DORSEY, off the clock, by the sign he signed ---
script ParcelCoastBreakwater_Dorsey {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DORSEY: The review kept the beach shut and reopened the breakwater side. Half a beach. I signed that too.\pFirst thing I've signed in years that I'd put my name on twice."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DORSEY: I come down here when the office is loud. The bathing sign is mine. I signed the closure.\pNobody signs a beach open, RANGER. You only ever sign them shut.\pI keep a tin from this beach on my desk. Crest up. I tell visitors it's what we make. It's what washes back."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastBreakwater_Tins {
    if (!flag(FLAG_SKALD_Q_TINS)) {
        end
    }
    msgbox(format("Tins along the rock, crest up, each with a tide line of salt. Thirty-one. Two crushed flat, counted anyway.\pThe newest still has its label."), MSGBOX_SIGN)
    setflag(FLAG_SKALD_Q_TINS_FOUND)
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelCoastBreakwater_PairBeach {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DREDGE HAND: Dredge is stopped. I'm on the quay crew now."), MSGBOX_DEFAULT)
        msgbox(format("OLD LIFEGUARD: Then take the sign down. There's nothing to keep people off."), MSGBOX_DEFAULT)
        msgbox(format("DREDGE HAND: The sea took the beach. The sign stays till the sea gives it back."), MSGBOX_DEFAULT)
        msgbox(format("OLD LIFEGUARD: …Fair. Put a date on the sign, then. People should know how long they've been waiting."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("OLD LIFEGUARD: The ranger walked the whole beach reading the line where the sand was. Didn't swim. Didn't need to."), MSGBOX_DEFAULT)
        msgbox(format("DREDGE HAND: What's to read on a beach?"), MSGBOX_DEFAULT)
        msgbox(format("OLD LIFEGUARD: The posts. The high-water mark three rows up the shingle from where it used to be. Krabby burrows with the roofs off. A beach is a page if you were ever taught letters."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("DREDGE HAND: Beach is closed. Sign says so."), MSGBOX_DEFAULT)
        msgbox(format("OLD LIFEGUARD: I know what the sign says. I put the first one up, before the sand went. Said no swimming on the dredge days."), MSGBOX_DEFAULT)
        msgbox(format("DREDGE HAND: Now it's every day."), MSGBOX_DEFAULT)
        msgbox(format("OLD LIFEGUARD: Now there's no sand to swim from. The breakwater you built took it. You can't close a beach that's already gone; you can only put a sign where it was."), MSGBOX_DEFAULT)
    }
    release
    end
}
