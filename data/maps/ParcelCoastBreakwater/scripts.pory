        format("TONE: …Further."),
        ParcelCoastBreakwater_Tone_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_BRK_TONE_R2)) {
