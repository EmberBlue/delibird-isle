    lock
    faceplayer
    msgbox(format("TONE: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TONE: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_BRK_TONE_R2, format("TONE: …Again, then. Later."))
    msgbox(format("TONE: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
