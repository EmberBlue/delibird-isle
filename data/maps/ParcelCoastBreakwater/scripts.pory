// ParcelCoastBreakwater -- the beach south of the quay (Route 109): closed to bathing, tins with
// the crest on every tide, swimmers over the dredge line, a fisherman on the far island who
// isn't in the quota. Eight trainers at 33-38 (the water ones need Surf).

mapscripts ParcelCoastBreakwater_MapScripts {
}

script ParcelCoastBreakwater_Ansgar {
    trainerbattle_single(TRAINER_SKALD_BRK_ANSGAR,
        format("ANSGAR: Off the boats a week. The quota review grounded us. Nothing to do but this. Battle."),
        format("ANSGAR: …Grounded again."),
        ParcelCoastBreakwater_Ansgar_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_BRK_ANSGAR_R2)) {
        goto(ParcelCoastBreakwater_Ansgar_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_BRK_ANSGAR_R3)) {
        goto(ParcelCoastBreakwater_Ansgar_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_BRK_ANSGAR_R4)) {
        goto(ParcelCoastBreakwater_Ansgar_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_BRK_ANSGAR_R5)) {
        goto(ParcelCoastBreakwater_Ansgar_R5)
    }
    msgbox(format("ANSGAR: Season to season, HARLAND says. I say season to hearing to season."), MSGBOX_DEFAULT)
    end
}
script ParcelCoastBreakwater_Ansgar_FirstWin {
    msgbox(format("ANSGAR: Season to season, HARLAND says. I say season to hearing to season."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastBreakwater_Ansgar_R2 {
    lock
    faceplayer
    msgbox(format("ANSGAR: Back this way? I've not been idle. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ANSGAR: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_BRK_ANSGAR_R2, format("ANSGAR: Noted. Properly, this time."))
    msgbox(format("ANSGAR: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastBreakwater_Ansgar_R3 {
    lock
    faceplayer
    msgbox(format("ANSGAR: Word gets up the river. Half a region signed off on you. Show me?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ANSGAR: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_BRK_ANSGAR_R3, format("ANSGAR: That's the one I wanted to see."))
    msgbox(format("ANSGAR: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastBreakwater_Ansgar_R4 {
    lock
    faceplayer
    msgbox(format("ANSGAR: I don't care about the paper. I care about the one I lost. Go?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ANSGAR: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_BRK_ANSGAR_R4, format("ANSGAR: …Again, then. Later."))
    msgbox(format("ANSGAR: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCoastBreakwater_Ansgar_R5 {
    lock
    faceplayer
    msgbox(format("ANSGAR: After everything, one more. For the ledger. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
