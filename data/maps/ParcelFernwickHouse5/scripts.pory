// ParcelFernwickHouse5 -- a house in Fernwick: residents in two story states (before / after the hearing).

mapscripts ParcelFernwickHouse5_MapScripts {
}

script ParcelFernwickHouse5_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_PAGE_DONE)) {
        msgbox(format("OLD MAN: Twenty-eight pairs, in the book, with the hole. And this spring twenty-eight again, in a new hand under mine. The boy's.\pThe book's not finished. I thought it was."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PAGE_DONE)) {
        msgbox(format("OLD MAN: Twenty-eight pairs. It's back in the book, pulp and all. A book with a hole in it is a book with a hole in it. Mine's whole."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PAGE_FOUND)) {
        msgbox(format("OLD MAN: You found it. Twenty-eight pairs. I remember writing that. I remember not believing it.\pTake this. I've no use for it now, and HALE won't take presents."), MSGBOX_DEFAULT)
        giveitem(ITEM_PP_UP)
        setflag(FLAG_SKALD_Q_PAGE_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PAGE)) {
        msgbox(format("OLD MAN: The marsh page. The pond's edge, the far bank, where the CORPS dug. If it's anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("OLD MAN: One page is missing from the '98 book. The marsh page. I dropped it at the pond the day I retired and the CORPS dug the pond out over it last spring.\pIf you're passing the far bank. You'll know it; it'll be the only paper in the water."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_PAGE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: HALE came by after the hearing. Didn't say much. Sat in that chair for an hour. That's him saying a lot."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: Thirty years in the CORPS. We counted everything and saved less than we counted.\pHALE was my cadet. He still stands like one."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse5_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: He reads the boy's counts against his own now. Then he puts them away and says 'good'.\pSame word. Different reason."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: He got the notebooks out and read your filing against them. Then he put them away and said 'good'. Just that."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: He took one of the old notebooks out of the chest last night. The river one. He read it with the Board's minutes beside it.\pHe said the numbers matched. Then he said that was the worst thing he'd heard all year."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: He keeps his old notebooks in the chest. Every page is a river that isn't there now."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse5_ReadDresser {
    msgbox(format("On the dresser, a pen with a bitten end and a pair of reading glasses folded over it, waiting."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse5_ReadDrawer {
    msgbox(format("The chest. Old notebooks in the top drawer, each one a river.\pYou don't open them. You know what a page full of a place that isn't there feels like under your hand."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelFernwickHouse5_PaperPondLedger {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The old man's own pond book. The spring after the sitting: twenty-eight pairs, fourteen paces, and a third column he has never kept before: WHO READ IT.\pOne name, yours, in capitals. He says a count somebody else has read is a different kind of number."), MSGBOX_SIGN)
    } else {
        msgbox(format("The old man's own pond book, kept since before the Survey's. One line a spring: WINGULL, pairs. Twenty-eight. Twenty-eight. Twenty-eight.\pBeside the last few: the water, in paces from the stone. Twelve. Fourteen. Fourteen. He writes the paces smaller, as if ashamed of them."), MSGBOX_SIGN)
    }
    end
}
