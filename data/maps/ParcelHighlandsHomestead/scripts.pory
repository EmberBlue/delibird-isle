// ParcelHighlandsHomestead -- the homesteader's cabin, near corner sunk a hand's depth.
mapscripts ParcelHighlandsHomestead_MapScripts {
}
script ParcelHighlandsHomestead_Grandson {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GRANDSON: I signed. Gran didn't. The leases are enjoined pending survey, so the boxes stay unpacked. She hasn't said 'told you'. She's said it with her face every morning."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("GRANDSON: Gran heard what the coast people said about the catch. All one size. She said that's what they want us to be, down in the valley houses. All one size.\pShe's unpacked a box. Just one. Don't tell her I noticed."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GRANDSON: I signed. The grant. Gran won't, so somebody has to carry the boxes down when the time comes.\pDon't tell her I've started packing. She knows. Don't tell her anyway."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsHomestead_Swinub {
    lock
    faceplayer
    msgbox(format("SWINUB: It won't leave either. Gran says that's the only vote in the house that counts."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsHomestead_Corner {
    msgbox(format("The floorboards slope to this corner. A marble on the table would roll here. There is a marble on the table. It has."), MSGBOX_SIGN)
    end
}

script ParcelHighlandsHomestead_ReadShelf {
    msgbox(format("A shelf of ledgers: lambing, shearing, the weather. The weather ledger is the thickest.\pThe last entry says: ground soft at the gate. March. Underlined."), MSGBOX_SIGN)
    end
}
