mapscripts ParcelRiverBoatyard_MapScripts {
}
script ParcelRiverBoatyard_Wright {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_PLANK_DONE)) {
        msgbox(format("BOATWRIGHT: The hill farmer's boat is in the water. He rows like a man carrying a hill. He'll learn.\pThe keel's sound. Twelve years under the eaves and a river to float in. That's a boat."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_PLANK) && !flag(FLAG_SKALD_Q_PLANK_DONE)) {
        if (flag(FLAG_SKALD_Q_PLANK_HAVE)) {
            msgbox(format("BOATWRIGHT: Seasoned. Twelve years under the eaves; you can hear it when you knock. That's a keel."), MSGBOX_DEFAULT)
            msgbox(format("BOATWRIGHT: The hill man paid a deposit in coin. Old coin, from a jar. Here -- the first one out of the jar. Keep it on a partner and the next jar fills faster. That's a boatyard superstition. We have a lot of them."), MSGBOX_DEFAULT)
            giveitem(ITEM_AMULET_COIN)
            setflag(FLAG_SKALD_Q_PLANK_DONE)
            msgbox(format("BOATWRIGHT: A boat built for water that hasn't arrived yet. My grandfather would have laughed. Then he'd have built it."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("BOATWRIGHT: The mill wood, west of the market. The sawyer. A keel plank, seasoned."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOATWRIGHT: HARLAND's boat was in the hearing transcript. His grandfather built it in this shed. I'm not saying I cried. The apprentice says I did."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_PLANK_DONE)) {
        msgbox(format("BOATWRIGHT: First new boat in two years, for a man off a hill. I'll build it right or not at all, and right means a seasoned plank for the keel, not the green stuff the depot sells.\pThe sawyer in the mill wood seasons his own. He won't sell to the depot. He might hand one to you.\pAsk him for a keel plank. Say it's for a hill farmer who's never seen the water. He'll understand that better than I do."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_PLANK)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("BOATWRIGHT: A man from HAUKFELL asked me to build him a boat. He's never lived near water. He said the water's coming to him, so he'll want one.\pI built HARLAND's boat for a river. I'm not sure what I'd build for a hill."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOATWRIGHT: I built HARLAND's boat. His grandfather built the one before it, in this shed.\pNow a coastal lender holds the paper on her. I built a boat and they bought a man. Funny old trade."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverBoatyard_Apprentice {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("APPRENTICE: Three orders. Small boats, review money, people who'd never thought of a boat.\pMaster says we build them all. He says it like he's forgotten we ever didn't."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("APPRENTICE: Somebody ordered a boat. A whole boat. First in four years. The review grounded the big fleet and the small ones are worth building again. I'm learning the keel."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("APPRENTICE: First new order in two years and it's from a hill farmer who's never seen a boat. Master says build it anyway.\pHe says people who order boats before they need them are the only customers worth having."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("APPRENTICE: Nobody orders boats. They order repairs. You don't need a new boat for four trout."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverBoatyard_ReadBench {
    msgbox(format("A boat's rib clamped to the bench, steaming. The grandfather's tools hang above it, each on its own nail, each nail with a name scratched beside it."), MSGBOX_SIGN)
    end
}

script ParcelRiverBoatyard_ReadHulls {
    msgbox(format("Hulls on frames, waiting for repairs. Each has a tag with a name and a date. The dates are getting further apart."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelRiverBoatyard_OrderBook {
    msgbox(format("The order book. Hulls built, by year, in the grandfather's hand and then the father's and then this one's.\pThe early pages are boats: a name, a length, a price, PAID. The middle pages are fewer boats and more names crossed through. The last page has no boats on it. It says REPAIRS ONLY and a date, and under that, in a hand that pressed hard: for now."), MSGBOX_SIGN)
    end
}
