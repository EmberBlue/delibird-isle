// ParcelCavern -- the CRYSTAL CAVERN under Delibird Isle's summit (§09): old
// blue ice, the one cold room left on the island. Rebuilt 2026-11 on the Shoal
// Cave ice room (General + Cave, 20x30): sliding ice between pockets of cave
// floor, Flash needed, KELDA's Deepwater audit at the mouth, the everfrost
// cache behind a sheared slab (a Strength boulder), the last Delibird at the
// deep end. Flag logic unchanged; words plain.

const LOCALID_CAVERN_BOULDER  = 1
const LOCALID_CAVERN_DELIBIRD = 2
const LOCALID_CAVERN_GATE     = 3
const LOCALID_CAVERN_CACHE    = 4

mapscripts ParcelCavern_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: ParcelCavern_FirstEntry
    ]
}

script ParcelCavern_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_CAVERN_ARRIVAL)) {
        end
    }
    lockall
    msgbox(format("Light blooms from the lamp and the cavern answers it: walls of old blue ice, crystal hung from the dark like frozen rain.\pThe air bites here. Truly bites. It's the only place on the whole island that still does."), MSGBOX_DEFAULT)
    msgbox(format("This is the cold the festival is named for, all of it, retreated into one room under the mountain. What the island used to be, kept in a jar against the thaw.\pThe floor is ice. Mind your feet."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_CAVERN_ARRIVAL)
    releaseall
    end
}

// --- KELDA's audit at the mouth (trigger on the two tiles off the ladder) --------------
script ParcelCavern_Audit {
    if (flag(FLAG_SKALDMERE_GATE_CAVERN)) {
        setvar(VAR_TEMP_3, 1)
        end
    }
    lockall
    msgbox(format("KELDA: Deepwater Ops. Even the cold is logged down here, provisional.\pYou want clearance to read the heart of this place? Earn the audit first."), MSGBOX_DEFAULT)
    msgbox(format("KELDA: For the ledger: the everfrost is an asset. It has a line, a value, and a depreciation schedule that assumes it will still be here.\pThe schedule was drawn up on the Coast by someone who has not stood in this room. I stand in it every day. Both of those are in the ledger too."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_GATE_CAVERN, format("KELDA: …Recorded. You read the cold; now the cold reads you."))
    setflag(FLAG_SKALDMERE_GATE_CAVERN)
    msgbox(format("KELDA: Cavern clearance, logged and filed. Deepwater keeps a close ledger. No one is granted the cold. You took it."), MSGBOX_DEFAULT)
    setvar(VAR_TEMP_3, 1)
    releaseall
    end
}
script ParcelCavern_GateKelda {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("KELDA: The everfrost is still on MEREHOLT's books. The books are under review. I hold a gate for a page that's being rewritten. I'll hold it properly anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("KELDA: You're entered against your card. The everfrost is on MEREHOLT's books. And now, so is your competence to stand near it."), MSGBOX_DEFAULT)
    release
    end
}

// --- the everfrost cache behind the slab (Strength) ----------------------------------------
script ParcelCavern_EverfrostCache {
    lock
    faceplayer
    playse(SE_ICE_CRACK)
    giveitem(ITEM_NEVER_MELT_ICE)
    giveitem(ITEM_RARE_CANDY, 2)
    setflag(FLAG_SKALDMERE_CAVERN_REWARD)
    removeobject(LOCALID_CAVERN_CACHE)
    msgbox(format("In the hollow the slab kept shut: a knot of true everfrost, and supplies an old surveyor cached here and never came back for. The date on the tin is older than you are."), MSGBOX_DEFAULT)
    release
    end
}

// --- the §09 quiet beat: the last Delibird of the cold ------------------------------------------
script ParcelCavern_Delibird {
    lock
    msgbox(format("A single DELIBIRD sits at the deep end, very still, watching the ice it can no longer count on.\pIt isn't delivering anything. There's no one down here to deliver to. It looks at you, and at the lamp, and seems to decide you are not the thaw."), MSGBOX_DEFAULT)
    msgbox(format("It goes back to watching the ice. You leave it the cold. It's the only gift the cavern has left to give, and it's giving it to one bird."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_Heart {
    msgbox(format("The oldest ice, blue to black. A mark scratched on the wall at head height, and a newer one a hand's width lower. The islanders measure their winters against it. You don't need the notebook to read this one."), MSGBOX_SIGN)
    end
}
script ParcelCavern_ItemIceHeal { finditem(ITEM_ICE_HEAL) end }

script ParcelCavern_TechA {
    trainerbattle_single(TRAINER_SKALD_CAV_TECH_A,
        format("ROLF: Deepwater survey. We core the ice. The cores are getting shorter. Battle me, it's warmer than standing still."),
        format("ROLF: Still cold."),
        ParcelCavern_TechA_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CAV_TECH_A_R2)) {
        goto(ParcelCavern_TechA_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CAV_TECH_A_R3)) {
        goto(ParcelCavern_TechA_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_CAV_TECH_A_R4)) {
        goto(ParcelCavern_TechA_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_CAV_TECH_A_R5)) {
        goto(ParcelCavern_TechA_R5)
    }
    msgbox(format("ROLF: Twenty metres of ice when they first cored it. Fourteen now. Deepwater calls that 'accessible'."), MSGBOX_DEFAULT)
    end
}
script ParcelCavern_TechA_FirstWin {
    msgbox(format("ROLF: Twenty metres of ice when they first cored it. Fourteen now. Deepwater calls that 'accessible'."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_TechA_R2 {
    lock
    faceplayer
    msgbox(format("ROLF: Back this way? I've not been idle. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ROLF: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CAV_TECH_A_R2, format("ROLF: Noted. Properly, this time."))
    msgbox(format("ROLF: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_TechA_R3 {
    lock
    faceplayer
    msgbox(format("ROLF: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ROLF: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CAV_TECH_A_R3, format("ROLF: That's the one I wanted to see."))
    msgbox(format("ROLF: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_TechA_R4 {
    lock
    faceplayer
    msgbox(format("ROLF: I've watched you walk past twice. Not a third time. Battle?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ROLF: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CAV_TECH_A_R4, format("ROLF: …Fair."))
    msgbox(format("ROLF: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_TechA_R5 {
    lock
    faceplayer
    msgbox(format("ROLF: I heard what you filed. Then show me what filed it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ROLF: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_CAV_TECH_A_R5, format("ROLF: Right. That's the whole of it."))
    msgbox(format("ROLF: Five. Write that one down too. I'll know you did."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCavern_TechB {
    trainerbattle_single(TRAINER_SKALD_CAV_TECH_B,
        format("UNN: Corps cadet, posted to watch the posted. KELDA watches me. I watch her. Spar, it passes the shift."),
        format("UNN: Shift passed."),
        ParcelCavern_TechB_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CAV_TECH_B_R2)) {
        goto(ParcelCavern_TechB_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CAV_TECH_B_R3)) {
        goto(ParcelCavern_TechB_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_CAV_TECH_B_R4)) {
        goto(ParcelCavern_TechB_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_CAV_TECH_B_R5)) {
        goto(ParcelCavern_TechB_R5)
    }
    msgbox(format("UNN: There's a DELIBIRD at the far end that never leaves. KELDA logged it as an asset. I logged it as a bird."), MSGBOX_DEFAULT)
    end
}
