script ParcelCavern_Leave {
    lockall
    msgbox(format("The ladder up to the summit, and the bright thin daylight beyond."), MSGBOX_DEFAULT)
    closemessage
    warp(MAP_PARCEL_DELIBIRD, 8, 4)
    waitstate
    end
}

// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelCavern_T_Brynjulf {
    trainerbattle_single(TRAINER_SKALD_CAV_BRYNJULF,
        format("BRYNJULF: Deepwater core crew. The ice is shorter every season. Battle, it's warmer."),
        format("BRYNJULF: Warmer. Briefly."),
        ParcelCavern_T_Brynjulf_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_CAV_BRYNJULF_R2)) {
        goto(ParcelCavern_T_Brynjulf_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_CAV_BRYNJULF_R3)) {
        goto(ParcelCavern_T_Brynjulf_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_CAV_BRYNJULF_R4)) {
