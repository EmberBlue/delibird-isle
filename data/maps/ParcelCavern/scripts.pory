    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_CAV_BRYNJULF_R5)) {
        goto(ParcelCavern_T_Brynjulf_R5)
    }
    msgbox(format("BRYNJULF: Twenty metres when they first cored it. Fourteen now. 'Accessible', the log says."), MSGBOX_DEFAULT)
    end
}
