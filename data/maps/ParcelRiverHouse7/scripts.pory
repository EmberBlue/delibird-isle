// ParcelRiverHouse7 -- a house in River: residents in two story states (before / after the hearing).

mapscripts ParcelRiverHouse7_MapScripts {
}

script ParcelRiverHouse7_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: My name's under HARLAND's in the record. I went to the coast and read it. My own name, typed.\pI'd have liked it bigger. It's the right size."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: HARLAND spoke at the hearing for the river people too. His name was in it where he put it. So's mine, under his."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("WOMAN: The net comes up honest and cold now. Meltwater, they say, off HAUKFELL. The fish don't like it either.\pHonest and cold. That's most of what this valley's got this year."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: I net the slow water below the town. Ten years ago the net came up heavy. Now it comes up honest."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse7_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: Small mesh, let the small ones through, and this spring there were big ones. Not many.\pI mended the HAUKFELL man's net again. He catches with it now. Badly. Honestly."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Mended the net for the review season. Smaller mesh, she says. Let the small ones through. We've learnt that the slow way."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("MAN: Mended a net for a HAUKFELL man who'd never held one. He's moving down to the valley house and wants to fish. I didn't tell him about the fish.\pThe holes in the net are the same size. He'll find out what comes through on his own."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: My wife fishes; I mend. The holes in the net are the same size every year. The fish aren't."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse7_ReadDresser {
    msgbox(format("A net needle on the dresser and a reel of twine. The holes are the same size every year. The twine runs out faster."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse7_ReadDrawer {
    msgbox(format("A drawer of weights for a net: river stones, drilled. Lighter ones at the front now. The slow water isn't as slow."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelRiverHouse7_PaperSixNames {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A list pinned over the table: six names, and under them the Board's own bulletin with the same six names typed at the foot of it.\pShe has written across the top: HARLAND spoke for us too. He is not on the list. He did not need to be."), MSGBOX_SIGN)
    } else {
        msgbox(format("A list pinned over the table: six names. The people on the river who said they would stand up at the hall if nobody else did. Her husband's is third.\pUnder the list, a date, and the word TONIGHT. The meeting was months ago. Nobody has taken the list down."), MSGBOX_SIGN)
    }
    end
}
