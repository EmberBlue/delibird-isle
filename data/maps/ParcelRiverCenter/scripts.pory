const LOCALID_RC_NURSE = 1
mapscripts ParcelRiverCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelRiverCenter_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}
script ParcelRiverCenter_OnTransition {
    setrespawn(HEAL_LOCATION_PARCEL_RIVER)
    end
}
script ParcelRiverCenter_Nurse {
    setvar(VAR_0x800B, LOCALID_RC_NURSE)
    call(Common_EventScript_PkmnCenterNurse)
    waitmessage
    waitbuttonpress
    release
    end
}
script ParcelRiverCenter_Trainer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("YOUNGSTER: The MARILL don't come in itchy from the lower river so much. The nurse still has the cream. She says keep it. Water has a memory, she says."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("YOUNGSTER: The nurse's cream is for the itch from the lower river. Now there's a SWINUB in here from HAUKFELL with no itch and no cold either.\pIt just lies by the stove. She says that's a mountain thing. She says everything's a thing."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("YOUNGSTER: Everyone's MARILL comes in itchy after the lower river. The nurse has a cream for it now. A CREAM. For a river."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverCenter_ReadRack {
    msgbox(format("Leaflets from the WATER BOARD on 'Responsible Allocation'. The stack hasn't gone down.\pBeside it, a jar of the nurse's cream, labelled LOWER RIVER, with a spoon."), MSGBOX_SIGN)
    end
}

script ParcelRiverCenter_ReadMap {
    msgbox(format("A map of the valley with the fourteen metered plots inked in. Plot nine is circled. Nobody will say who circled it."), MSGBOX_SIGN)
    end
}
