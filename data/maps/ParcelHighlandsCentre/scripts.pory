// ParcelHighlandsCentre -- the Haukfell Warming Centre (Mereholt Foundation).
// Forty beds, a stove, relocation advice. Opened Tuesday. The good beside the harm.
mapscripts ParcelHighlandsCentre_MapScripts {
}
script ParcelHighlandsCentre_Host {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HOST: Your survey said SHIFTED. Ours said 'transitioning'. The grants were paid out of 'transitioning'. The hearing used your word. The grants are 'under review'. I've learnt a new word too."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("HOST: Your survey says SHIFTED. Ours says 'transitioning'. The grants are paid out of 'transitioning'. Think about that before you pick a word."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HOST: Welcome to the Warming Centre. Beds through the back, soup at six, the relocation desk is me.\pMs. AUNE opened us on Tuesday. She cut the ribbon herself and then she stayed to serve the soup. People don't forget that."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsCentre_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: Came down when the well went. Warm here, soup's good. The leases are enjoined. I'd go back up if the well came back. Wells don't read hearings."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("OLD MAN: A fisherman from the coast came up to the centre. Lost his boat to the lending company. Said the soup here's better than the quay's.\pSame crest on his bowl as mine. We didn't talk about it. We ate."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: Came down from the north slope in the spring when the well went. Warm here. Soup's good.\pI'd go back up tomorrow if the ground would have me. It won't."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsCentre_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The grant's real, the house in the valley is real, and now the house we left is 'subject to review'. I don't know whose it is. I know it's not ours. That hasn't changed."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: The valley house came with a letter from the coast office saying the FOUNDATION 'values our resilience'.\pA woman on the coast told the ranger the fish are all one size. I read that in a paper. I'm all one size too, now. Resilient."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: The grant's real. The money came. The house we got in the valley is real too. It's just not ours. Nothing in it remembers us."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsCentre_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: The stove's still always on! HOLLIS came and sat by it. She didn't say anything. She drank the cocoa. Mum watched her the whole time."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("BOY: A boy from the coast says their beach is closed and the lifeguard just sits there. Our stove's always on and their beach is always shut.\pHe says it's the same man's fault. I said the same man can't be everywhere. He said you'd be surprised."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: There's a stove! It's always on! At home the stove was only on at night. I like it here. Mum doesn't."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsCentre_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Sign the form, get the grant. Don't sign, get soup. The old woman up the hill got soup for a year, and now she's got a page in a hearing. I signed. I've got a house. Hers is the page I'd rather have."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("MAN: Soup or grant. Now there's a third option: the coast office is hiring 'community liaisons'. Sign the form, get a lanyard.\pThe old woman up the hill got offered one. She asked if it came with soup."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Sign the relocation form, you get the grant. Don't sign, you get soup. The old woman up the hill gets soup delivered. Stubbornness has a menu."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsCentre_Board {
    msgbox(format("RELOCATION NOTICE. Households on the north slope are eligible for the Haukfell Resilience Grant. Conditions: vacate by first snow; sign the geotechnical waiver; no claim against the Foundation's survey works.\pThirty-one signatures. One line left blank, in a hand that pressed hard."), MSGBOX_SIGN)
    end
}

// --- Councilman DORSEY (fix B, zone 5): the public appearance, then the private moment ---
script ParcelHighlandsCentre_Dorsey {
    lock
    faceplayer
    if (flag(FLAG_SKALD_DORSEY_HL)) {
        msgbox(format("DORSEY: Sit. Nobody's listening; they're at the soup.\pThe old woman up the track won't sign. My mother wouldn't either. We carried her out in the end, my brother and I, with the roof already going.\pI'm quicker about it now. Quicker isn't kinder. I know the difference, RANGER. I've just stopped being able to afford it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DORSEY: --and the grant is yours the day you sign. The valley houses are warm, the school's a bus ride, and nobody winters on a slope that's moving.\pRANGER. You've come up as well. Good. Witness this one too: the FOUNDATION moving people before the mountain does.\pWrite that word. 'Before.' It's the only one that matters up here."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALD_DORSEY_HL)
    release
    end
}
