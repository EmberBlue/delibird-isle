script ParcelCorridorWorkings_Einar {
    trainerbattle_single(TRAINER_SKALD_WRK_EINAR,
        format("EINAR: Scratches on the north wall. Old. Not mining marks. Don't touch them. Fight."),
        format("EINAR: …Still standing. Good."),
        ParcelCorridorWorkings_Einar_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WRK_EINAR_R2)) {
        goto(ParcelCorridorWorkings_Einar_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_WRK_EINAR_R3)) {
        goto(ParcelCorridorWorkings_Einar_R3)
