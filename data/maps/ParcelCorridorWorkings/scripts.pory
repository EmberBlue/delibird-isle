        goto(ParcelCorridorWorkings_Knut_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WRK_KNUT_R5)) {
        goto(ParcelCorridorWorkings_Knut_R5)
    }
    msgbox(format("KNUT: Don't shout. The props are older than you."), MSGBOX_DEFAULT)
    end
}
script ParcelCorridorWorkings_Knut_FirstWin {
