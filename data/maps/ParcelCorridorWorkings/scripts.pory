    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WRK_EINAR_R5)) {
        goto(ParcelCorridorWorkings_Einar_R5)
    }
    msgbox(format("EINAR: Somebody was in this hill before the CORPS, before the road, before anyone wrote things down. They wrote on the wall anyway."), MSGBOX_DEFAULT)
    end
}
