script ParcelCorridorWorkings_Lise {
    trainerbattle_single(TRAINER_SKALD_WRK_LISE,
        format("LISE: Lamp's going. Fight me before it does. I don't want to walk out in the dark."),
        format("LISE: Lamp held. So did you."),
        ParcelCorridorWorkings_Lise_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WRK_LISE_R2)) {
        goto(ParcelCorridorWorkings_Lise_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_WRK_LISE_R3)) {
        goto(ParcelCorridorWorkings_Lise_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_WRK_LISE_R4)) {
        goto(ParcelCorridorWorkings_Lise_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WRK_LISE_R5)) {
        goto(ParcelCorridorWorkings_Lise_R5)
    }
    msgbox(format("LISE: Dark places tell you how much you brought. Most people bring too little."), MSGBOX_DEFAULT)
    end
}
