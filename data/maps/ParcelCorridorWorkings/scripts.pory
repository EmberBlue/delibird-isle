// ParcelCorridorWorkings -- the Hollowbend old workings: a gallery the Corps closed in '98 and the
// road crew reopened for ballast. One room (Altering Cave), eight trainers, the mouth on the
// Corridor's east plaza at (78,6). Flash-dark.

mapscripts ParcelCorridorWorkings_MapScripts {
}

script ParcelCorridorWorkings_Olav {
    trainerbattle_single(TRAINER_SKALD_WRK_OLAV,
        format("OLAV: Ballast crew. The road eats rock, and this hole had rock going spare. Mind the props. Battle."),
        format("OLAV: …Props held. Fair."),
        ParcelCorridorWorkings_Olav_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WRK_OLAV_R2)) {
        goto(ParcelCorridorWorkings_Olav_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_WRK_OLAV_R3)) {
        goto(ParcelCorridorWorkings_Olav_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_WRK_OLAV_R4)) {
        goto(ParcelCorridorWorkings_Olav_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WRK_OLAV_R5)) {
        goto(ParcelCorridorWorkings_Olav_R5)
    }
    msgbox(format("OLAV: They logged this gallery closed. Then they logged it a quarry. Same book, two pages."), MSGBOX_DEFAULT)
    end
}
script ParcelCorridorWorkings_Olav_FirstWin {
    msgbox(format("OLAV: They logged this gallery closed. Then they logged it a quarry. Same book, two pages."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCorridorWorkings_Olav_R2 {
    lock
    faceplayer
    msgbox(format("OLAV: You again. I've had time to think about last time. Go again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("OLAV: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_WRK_OLAV_R2, format("OLAV: That's the one I wanted to see."))
    msgbox(format("OLAV: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCorridorWorkings_Olav_R3 {
    lock
    faceplayer
    msgbox(format("OLAV: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("OLAV: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_WRK_OLAV_R3, format("OLAV: …Fair."))
    msgbox(format("OLAV: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCorridorWorkings_Olav_R4 {
    lock
    faceplayer
    msgbox(format("OLAV: Full strength, no excuses, mine or yours. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("OLAV: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_WRK_OLAV_R4, format("OLAV: Still yours."))
    msgbox(format("OLAV: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelCorridorWorkings_Olav_R5 {
    lock
    faceplayer
    msgbox(format("OLAV: I heard what you filed. Then show me what filed it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("OLAV: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_WRK_OLAV_R5, format("OLAV: Right. That's the whole of it."))
    msgbox(format("OLAV: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}
