script ParcelHighlands_Asbjorn_R4 {
    lock
    faceplayer
    msgbox(format("ASBJORN: Full strength, no excuses, mine or yours. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASBJORN: No hurry. The water keeps."), MSGBOX_DEFAULT)
