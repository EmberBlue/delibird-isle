// ParcelHighlands -- HAUKFELL (§01/§06 zone 5, Chapter 4): the first zone that
// reads SHIFTED. Witness, not repair. Rebuilt 2026-11 on vanilla Route 115
// (General + leob_fallarbor) with Route 114's waterfall grafted into the
// north-west pocket: the foothills (the homestead, the warming centre), the
// slide across the trail (rocks and boulders -- HM06 and HM04 earn their
// keep), VALE's permit gate at the corridor's neck, the bore (Survey Station
// Six) with HOLLIS at her field heater, the plateau where ILEX measures the
// cold band, HALE at the summit, the sea for Surf and the fall for Waterfall.
// Flag logic unchanged; words plain.
//
// VAR_SKALDMERE_CH4_EVIDENCE bits (count 0..5, mask 0x3F):
//   0  thermokarst ponds   1  drunken forest   2  Ilex's band
//   3  the lowlander       4  the drill sign   5  the homesteader
//   6  classified (Hale)   7  Hollis heard (uncounted)

const LOCALID_HL_ILEX        = 1
const LOCALID_HL_HOLLIS      = 2
const LOCALID_HL_HOMESTEADER = 3
const LOCALID_HL_HALE        = 4
const LOCALID_HL_LOWLANDER   = 5
const LOCALID_HL_GYM         = 8

const LOCALID_PERRIN = 35

mapscripts ParcelHighlands_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SKALD_EPILOGUE, 4: ParcelHighlands_Epilogue
    ]
}

// --- first entry ------------------------------------------------------------------
script ParcelHighlands_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_HIGHLAND_ARRIVAL)) {
        end
    }
    lockall
    bufferpartymonnick(0, 0)
    msgbox(format("The road climbs out of the farmland into cold air. Pale rock. Thin grass. Mist on the high ground.\p{STR_VAR_1} slows, and keeps to the middle of the trail. The ground gives underfoot where it should be iron."), MSGBOX_DEFAULT)
    msgbox(format("HALE's note: HIGHLAND. You won't get to fix this one. Walk it. Read it. Name it. Then come up to the summit."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_HIGHLAND_ARRIVAL)
    releaseall
    end
}

// --- the slide across the trail (the ground moved; the Foundation won't touch it) ---
script ParcelHighlands_SlideScene {
    setvar(VAR_TEMP_3, 1)
    if (flag(FLAG_SKALD_HL_SLIDE_SCENE)) {
        end
    }
    lockall
    msgbox(format("The trail is buried. Fresh scree, grey and wet, and boulders the size of carts where the slope let go.\pA voice, from above the slide."), MSGBOX_DEFAULT)
    msgbox(format("ILEX: RANGER? That you? The slope went last night. I'm fine. The old woman below you is fine, I checked.\pThe FOUNDATION crew won't touch the scree. 'Not in scope.' Get through if you can. The small rocks break. The big ones move, if you've the clearance for it."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALD_HL_SLIDE_SCENE)
    releaseall
    end
}
script ParcelHighlands_SlideSign {
    msgbox(format("Fresh scree across the trail, still settling. Nothing grew on this ground last year. Nothing holds it now."), MSGBOX_SIGN)
    end
}

// --- the tells ---------------------------------------------------------------------
script ParcelHighlands_Thermokarst {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The sunk ponds. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("The ground here has sunk into itself: a line of ponds in the rock, black water in each, the rims collapsing inward.\pThis was frozen ground. The ice under it melted and the land fell into the hole it left. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelHighlands_DrunkenForest {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 1)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The leaning trees. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("The trees along the slope lean every which way, roots half out of the ground, trunks crossed like dropped matches.\pThey grew straight on ground that held them. The ground stopped holding. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelHighlands_Lowlander {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 3)
    special(SkaldmereCertTaskMark)
    msgbox(format("A ZIGZAGOON, this high up, fat and unbothered on the scree.\pFive years ago nothing like it wintered above the tree line. The cold kept it out. The cold isn't here to keep anything out. Written down."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlands_DrillSign {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 4)
    special(SkaldmereCertTaskMark)
    msgbox(format("MEREHOLT PERMAFROST -- SURVEY STATION SIX. EXPLORATORY ONLY. No extraction is licensed at this site.\pThe bore runs down into the freeze. To learn how fast it is failing, and to stand first in line for whatever the failing lays bare. Written down."), MSGBOX_SIGN)
    release
    end
}
script ParcelHighlands_BandStakes {
    msgbox(format("A line of red cloth strung between stakes, an arm's length apart. Last season's stakes stand wider, pulled, beside them. The season before, wider still."), MSGBOX_SIGN)
    end
}

// --- ILEX at the compression band ------------------------------------------------------
script ParcelHighlands_Ilex {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ILEX: The hearings cite the cloth now. Decades of it, read into the record by a clerk who pronounced everything correctly.\pThe band is still shrinking. The number doesn't know it's been believed."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 2)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("ILEX: A hand's width in. Same as last season. I don't explain it twice."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("ILEX: Last season these stood wider. The season before, wider still.\pThis is the band the cold-lovers have left. The SNEASEL. The SWINUB that root the high snow. Pushed up the slope each year into a thinner ring of cold."), MSGBOX_DEFAULT)
    msgbox(format("ILEX: Above this is bare rock and sky. There is no higher for them to climb.\pI stopped recording where they are. Now I record how much less of it there is."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: And when the ring closes?"), MSGBOX_DEFAULT)
    msgbox(format("ILEX: Then I'll have a number for that, too.\pDownslope the red cloth marks what's still there. Up here it marks what's leaving. Same cloth. That's the part they never understand."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- HOLLIS AUNE at the bore (the mask made human; sets the uncounted bit 7) ----------
script ParcelHighlands_Hollis {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HOLLIS: Enjoined pending survey. Your survey, as it happens. There's a court seal on the housing; it's new enough to still lie flat.\pThe relocation grants are frozen with the rest of it, you know. The warming centre too. That's the part nobody prices."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 7)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("HOLLIS: The coffee's still warm, RANGER. The offer stands. So does the ground, for now."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HOLLIS: You must be the RANGER they sent up. HOLLIS AUNE, MEREHOLT FOUNDATION. Come in out of the wind, there's coffee.\pYou've seen the centre below? We opened it Tuesday. Forty beds, a stove that works, a nurse on Thursdays. I cut the ribbon myself."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: I know how the rig reads to you. But the thaw is coming whether we bore it or not. Better someone's here measuring it, funding the relocation grants, the centre, the training for what comes next."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: None of that is a lie. Check every line. We're doing real good up here, beside the real harm. That's not a contradiction. That's just how it actually works."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: I believe you. That isn't the part I'm writing down."), MSGBOX_DEFAULT)
    msgbox(format("HOLLIS: No. I don't suppose it is.\pThen let me be kind plainly, so you don't mistake it for a threat. Our science is the only science up here. A survey that contradicts ours doesn't stop the rig. It just defunds the coffee."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelHighlands_HollisTech {
    lock
    faceplayer
    msgbox(format("TECHNICIAN: Core samples go down to the coast office twice a week. The bore log says 'exploratory'. The bore log's a form. Forms say what's printed on them."), MSGBOX_DEFAULT)
    release
    end
}

// --- the homesteader: the one who won't be 'adapted' ------------------------------------
script ParcelHighlands_Homesteader {
    lock
    faceplayer
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        if (flag(FLAG_SKALDMERE_HIGHLAND_CERT) && !flag(FLAG_SKALD_HL_EGG_GIVEN)) {
            msgbox(format("HOMESTEADER: You said it. SHIFTED. First one of your lot who didn't say 'transitioning'.\pTake this. The SWINUB laid it in the spring. There won't be another born up here. Hatch it somewhere with a winter."), MSGBOX_DEFAULT)
            specialvar(VAR_RESULT, CalculatePlayerPartyCount)
            if (var(VAR_RESULT) == 6) {
                msgbox(format("HOMESTEADER: Your belt's full. Come back with room. It'll keep. It's the only thing up here that will."), MSGBOX_DEFAULT)
                release
                end
            }
            giveegg(SPECIES_SWINUB)
            setflag(FLAG_SKALD_HL_EGG_GIVEN)
            msgbox(format("HOMESTEADER: Don't name it after me. Name it after the slope."), MSGBOX_DEFAULT)
            release
            end
        }
        if (flag(FLAG_SKALD_HL_EGG_GIVEN)) {
            msgbox(format("HOMESTEADER: Somewhere with a winter. You promised."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("HOMESTEADER: Another log. It'll sit crooked. Everything does, up here, now."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HOMESTEADER: You're not from the company. Good. I'm tired of being adapted at.\pEight generations of us wintered this slope. You knew where you stood. The ground held, the cold came, the cold went, the ground held again."), MSGBOX_DEFAULT)
    msgbox(format("HOMESTEADER: Now the ground breathes. The doors won't shut true. The near corner's a hand's depth into the mud since spring. The well runs brown in a month it never ran brown."), MSGBOX_DEFAULT)
    msgbox(format("HOMESTEADER: The FOUNDATION's grant will move me somewhere warm and write 'resilience' on the cheque. The young ones already signed. I don't blame them.\pThe ground is dying. They call it opportunity. I call it leaving."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- HALE at the summit: the witness certification ----------------------------------------
script ParcelHighlands_Hale {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("HALE: You kept the record. That's the whole of the work up here.\pSomeday someone reads it and knows exactly what was lost, and when, and who was smiling while it went."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH4_EVIDENCE)
    setvar(VAR_0x8004, 63)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) == 6) {
        msgbox(format("HALE: The sunk ponds. The drunk trees. The band ILEX measures. The lowlander in the scree. The drill. The woman who won't take the grant.\pName it."), MSGBOX_DEFAULT)
        specialvar(VAR_RESULT, SkaldmereClassifyHighlands)
        msgbox(format("HALE: SHIFTED.\pThe frozen ground was the keystone, and it's going. The cold guild is gone from everywhere but that last ring. What moves in is whatever moves in anywhere. A poorer place, settling into being poorer."), MSGBOX_DEFAULT)
        msgbox(format("{PLAYER}: So what do we DO. There has to be something."), MSGBOX_DEFAULT)
        msgbox(format("HALE: There isn't. Not here. You cannot refreeze a mountain.\pThe runoff you can slow. The cut you can fight. This you cannot put back. It's the first time you'll have stood somewhere and known that for certain."), MSGBOX_DEFAULT)
        msgbox(format("HALE: So the work changes. Not save it. WITNESS it. Record it true, name the hand that's on it, and carry that down to a place you still can save.\pThat's not surrender. Surrender is letting them file this as 'adaptation' and signing underneath."), MSGBOX_DEFAULT)
        setvar(VAR_0x8004, 6)
        special(SkaldmereCertTaskMark)
        msgbox(format("HALE: Highland Certification. The hardest one to earn, because there's nothing to fix and you had to say so."), MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        waitfanfare
        setflag(FLAG_SKALDMERE_HIGHLAND_CERT)
        giveitem(ITEM_MAX_POTION, 3)
        giveitem(ITEM_REVIVE, 3)
        msgbox(format("HALE: There's a ferry to DELIBIRD ISLE from SALTWICK when your legs are under you. They hold a festival out there, on ground exactly like this.\pGo and see what people do with grief when they've agreed, together, not to name it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HALE: Don't name it from up here, looking down. Walk it first. The thaw ponds, the leaning trees, the band ILEX works, the drill, the lowlander that's moved in, the holdout who won't go.\pThen come back and tell me what it is."), MSGBOX_DEFAULT)
    release
    end
}

// --- items ---------------------------------------------------------------------------------
script ParcelHighlands_ItemPotion { finditem(ITEM_HYPER_POTION) end }
script ParcelHighlands_ItemMaxRepel { finditem(ITEM_MAX_REPEL) end }
script ParcelHighlands_ItemIceHeal { finditem(ITEM_ICE_HEAL) end }
script ParcelHighlands_SurfCache {
    finditem(ITEM_RARE_CANDY)
    setflag(FLAG_SKALD_ITEM_HL_SURF)
    end
}
script ParcelHighlands_FallsCache {
    finditem(ITEM_PP_MAX)
    setflag(FLAG_SKALD_ITEM_HL_FALLS)
    end
}

// --- signs -----------------------------------------------------------------------------------
script ParcelHighlands_SignSummit {
    msgbox(format("HAUKFELL SUMMIT. 1,140 m.\pCorps survey point. Red cloth marks the cold band. Do not move the stakes."), MSGBOX_SIGN)
    end
}
script ParcelHighlands_SignCentre {
    msgbox(format("HAUKFELL WARMING CENTRE -- a MEREHOLT FOUNDATION community partnership.\pForty beds. Relocation advice daily. Opened by H. AUNE."), MSGBOX_SIGN)
    end
}

// --- KASS, the Foundation surveyor (the mask, off the record) ------------------------------
script ParcelHighlands_SurveyorTrainer {
    trainerbattle_single(TRAINER_SKALD_SURVEYOR,
        format("KASS: FOUNDATION crew. You'll be the RANGER poking at our boreholes.\pKeep it sporting. Mons, not paperwork."),
        format("KASS: Tch. Fine. You're not wrong about the ground. I just get paid not to write it down."),
        ParcelHighlands_SurveyorTrainer_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SURVEYOR_R2)) {
        goto(ParcelHighlands_SurveyorTrainer_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SURVEYOR_R3)) {
        goto(ParcelHighlands_SurveyorTrainer_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SURVEYOR_R4)) {
        goto(ParcelHighlands_SurveyorTrainer_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SURVEYOR_R5)) {
        goto(ParcelHighlands_SurveyorTrainer_R5)
    }
    msgbox(format("KASS: Off the record? I've moved my stakes up the slope three years running. Same line your ILEX works.\pWe measure the same thing. They just pay me to call it opportunity."), MSGBOX_DEFAULT)
    end
}
script ParcelHighlands_SurveyorTrainer_FirstWin {
    msgbox(format("KASS: Off the record? I've moved my stakes up the slope three years running. Same line your ILEX works.\pWe measure the same thing. They just pay me to call it opportunity."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlands_SurveyorTrainer_R2 {
    lock
    faceplayer
    msgbox(format("KASS: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("KASS: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SURVEYOR_R2, format("KASS: That's the one I wanted to see."))
    msgbox(format("KASS: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlands_SurveyorTrainer_R3 {
    lock
    faceplayer
    msgbox(format("KASS: Word gets up the river. Half a region signed off on you. Show me?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("KASS: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SURVEYOR_R3, format("KASS: …Fair."))
    msgbox(format("KASS: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlands_SurveyorTrainer_R4 {
    lock
    faceplayer
    msgbox(format("KASS: Full strength, no excuses, mine or yours. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("KASS: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SURVEYOR_R4, format("KASS: Right. That's the whole of it."))
    msgbox(format("KASS: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlands_SurveyorTrainer_R5 {
    lock
    faceplayer
    msgbox(format("KASS: They read your name at the hearing. I'd like to read it myself. Battle?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("KASS: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SURVEYOR_R5, format("KASS: That's the one I wanted to see."))
    msgbox(format("KASS: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}

// --- Gym 5: VALE's permit gate at the corridor's neck ----------------------------------------
script ParcelHighlands_ValeGate {
    if (flag(FLAG_BADGE05_GET)) {
        setvar(VAR_TEMP_4, 1)
        end
    }
    lockall
    msgbox(format("VALE: That's far enough."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_HL_GYM, Movement_HL_ValeApproach)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_HL_FaceRight)
    waitmovement(0)
    msgbox(format("VALE: Highland Operations. Past this point the ground is no longer ours to fix. Only to clear people off of, in order.\pNobody goes up this slope on my ledger unproven. Show me you've earned the meltwater permit."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_GYM5, format("VALE: …Cleared. You go up with it signed."))
    setflag(FLAG_BADGE05_GET)
    call(Common_EventScript_PlayGymBadgeFanfare)
    msgbox(format("VALE: Vale clearance. Line item 05. The last one Highland Operations issues before the water.\pIt certifies you fit to cross what the thaw has put in the way."), MSGBOX_DEFAULT)
    giveitem(ITEM_HM03)
    msgbox(format("VALE: SURF. A meltwater permit, in plain terms. It moves you over the standing thaw the slope keeps making.\pThere's more of it every season. We don't advertise that."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_HL_GYM, Movement_HL_ValeBack)
    waitmovement(0)
    setvar(VAR_TEMP_4, 1)
    releaseall
    end
}
script ParcelHighlands_GymVale {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelHighlands_GymVale_Rematch)
    }
    msgbox(format("VALE: The ferry runs from the lowland landing. Take what you witnessed here with you. It's the only thing that leaves this slope unspoiled."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_HL_ValeApproach { walk_left * 2 }
movement Movement_HL_ValeBack { walk_right * 2 face_left }
movement Movement_HL_FaceRight { face_right }

// --- route trainers -----------------------------------------------------------------------------
script ParcelHighlands_Asbjorn {
    trainerbattle_single(TRAINER_SKALD_HL_ASBJORN,
        format("ASBJORN: The foothills are the easy bit. Enjoy them. Battle?"),
        format("ASBJORN: Easy bit's over."),
        ParcelHighlands_Asbjorn_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_HL_ASBJORN_R2)) {
        goto(ParcelHighlands_Asbjorn_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_HL_ASBJORN_R3)) {
        goto(ParcelHighlands_Asbjorn_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_HL_ASBJORN_R4)) {
        goto(ParcelHighlands_Asbjorn_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_HL_ASBJORN_R5)) {
        goto(ParcelHighlands_Asbjorn_R5)
    }
    msgbox(format("ASBJORN: The trail above the homestead went last night. Rocks, boulders. The FOUNDATION crew looked at it and went for coffee."), MSGBOX_DEFAULT)
    end
}
