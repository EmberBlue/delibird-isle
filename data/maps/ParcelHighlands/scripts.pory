script ParcelHighlands_Asbjorn_R5 {
    lock
    faceplayer
    msgbox(format("ASBJORN: The region's different now. Let's see if you are?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASBJORN: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
