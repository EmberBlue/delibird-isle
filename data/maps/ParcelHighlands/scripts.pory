    trainerbattle_no_intro(TRAINER_SKALD_HL_SIRI_R5, format("SIRI: …Again, then. Later."))
    msgbox(format("SIRI: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}

// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelHighlands_T_Snorre {
    trainerbattle_single(TRAINER_SKALD_HL_SNORRE,
        format("SNORRE: The slide took the trail. I've been sitting here deciding whether to climb it. Battle first."),
        format("SNORRE: Still deciding."),
        ParcelHighlands_T_Snorre_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_HL_SNORRE_R2)) {
        goto(ParcelHighlands_T_Snorre_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_HL_SNORRE_R3)) {
        goto(ParcelHighlands_T_Snorre_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_HL_SNORRE_R4)) {
        goto(ParcelHighlands_T_Snorre_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_HL_SNORRE_R5)) {
        goto(ParcelHighlands_T_Snorre_R5)
    }
    msgbox(format("SNORRE: ILEX went up through the scree. Alone. She's older than me and she didn't stop to decide."), MSGBOX_DEFAULT)
    end
}
