// --- PERRIN, encounter 5 (the peer; §04) -------------------------------------------
script ParcelHighlands_PerrinScene {
    if (flag(FLAG_SKALD_PERRIN_5)) {
        setvar(VAR_TEMP_5, 1)
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("PERRIN: WREN!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelHighlands_PerrinIn)
    waitmovement(0)
    msgbox(format("PERRIN: HOLLIS says hello. HOLLIS says you're 'thorough'. She said it like a diagnosis.\pI'm on the relocation team. We moved eleven families down the hill this month. ELEVEN. What did your notebook move? Battle."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_5, format("PERRIN: …Eleven's still eleven."))
    msgbox(format("PERRIN: The old woman won't go. I've been up to her door four times. She asks after you.\pNobody asks after me. That's not a complaint. I'm just saying it out loud once."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelHighlands_PerrinOut)
    waitmovement(0)
    removeobject(LOCALID_PERRIN)
    setflag(FLAG_SKALD_PERRIN_5)
    setvar(VAR_TEMP_5, 1)
    releaseall
    end
}
script ParcelHighlands_PerrinTalk {
    lock
    faceplayer
    msgbox(format("PERRIN: Hang on, I'm coming to you."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_ParcelHighlands_PerrinIn { walk_down * 2 }
movement Movement_ParcelHighlands_PerrinOut { walk_up * 2 }

// --- the epilogue, stop 4 of 8 ---
script ParcelHighlands_Epilogue {
    lockall
    delay(20)
    msgbox(format("HAUKFELL. The bore is capped. Enjoined pending survey, and the survey is yours. The leases wait on it. The ground doesn't.\pThe warming centre stays open past midnight now. HOLLIS cut the ribbon. It's still warm."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 5)
    warp(MAP_PARCEL_DELIBIRD, 13, 13)
    waitstate
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelHighlands_GymVale_Rematch {
    lock
    faceplayer
    msgbox(format("VALE: You went up with it signed, and the slope held. Mostly.\pI'd see what the cold made of you since. Full strength. Not a gate. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("VALE: Then mind the slope."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM5_R, format("VALE: …Cleared. There's nothing above this to clear, so take that as the word."))
    msgbox(format("VALE: The slope's here when you are."), MSGBOX_DEFAULT)
    release
    end
}
