mapscripts ParcelFernwickHouse2_MapScripts {
}

script ParcelFernwickHouse2_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: HALE was born in this house and he came by for the first time in a year. He ate a biscuit. He said the hearing was 'adequate'. From HALE that's a parade."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: HALE came by. Stood in the kitchen and didn't say anything for a while, then said the river people stood up.\pHe said it like news from a war. Have a biscuit. He wouldn't."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: HALE was born in this house. He'd hate that I told you.\pHe hates most things I tell people. Have a biscuit."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse2_Zigzagoon {
    lock
    faceplayer
    waitse
    playmoncry(SPECIES_ZIGZAGOON, CRY_MODE_NORMAL)
    msgbox(format("ZIGZAGOON is investigating your boots. Thoroughly."), MSGBOX_DEFAULT)
    waitmoncry
    release
    end
}

script ParcelFernwickHouse2_ReadShelf {
    msgbox(format("Tide tables going back to before the station. One winter's table has a child's handwriting in the margin: HIGH.\pSomebody small learned to read the water here."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse2_ReadFridge {
    msgbox(format("A biscuit tin on top of the fridge, dented. The dent is older than you. The biscuits are not."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse2_ReadDresser {
    msgbox(format("A photograph on the dresser: a boy on the quay with a notebook too big for him, scowling at whoever held the camera.\pThe scowl hasn't changed."), MSGBOX_SIGN)
    end
}
