// ParcelFernwickHall -- the Certification Hall. Gym 1: two cadets, then
// Tarn of the Tidewater Division. Passing sets BADGE01; Hale signs the
// Forest Certification at the station.

mapscripts ParcelFernwickHall_MapScripts {
}

script ParcelFernwickHall_Greeter {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GREETER: Three passed first time this year. TARN says the river minutes are on the reading list.\pHe says it like it was always there."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GREETER: Nobody passes first time, and nobody's name gets read at a hearing. Both happened this year. TARN says it's a bad precedent. He's smiling when he says it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GREETER: Two cadets failed this week and TARN passed one of them anyway. He said she'd read the river minutes without being told to.\pHe's never passed anyone for reading. He's never passed anyone for anything."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_BADGE01_GET)) {
        msgbox(format("GREETER: You passed! Nobody passes first time. Well, somebody just did. Go tell HALE before TARN changes his mind."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GREETER: The Certification Hall! Practical exams only. Two cadets, then TARN.\pYou can't skip the cadets. I've tried."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelFernwickHall_CadetA {
    trainerbattle_single(TRAINER_SKALD_FERNWICK_CADET_A,
        format("SOLVI: Cadet exam, round one! Don't go easy on me. They dock points for that."),
        format("SOLVI: Points docked."))
    msgbox(format("SOLVI: TARN's up the back. He talks slow. Don't mistake it for kindness."), MSGBOX_AUTOCLOSE)
    end
}

script ParcelFernwickHall_CadetB {
    trainerbattle_single(TRAINER_SKALD_FERNWICK_CADET_B,
        format("EGIL: I've been a cadet for three years. THREE. Let me have this one."),
        format("EGIL: Four years, then."))
    msgbox(format("EGIL: Go on. He's waiting. He's always waiting."), MSGBOX_AUTOCLOSE)
    end
}

script ParcelFernwickHall_Tarn {
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        goto(ParcelFernwickHall_Tarn_Rematch)
    }
    lock
    faceplayer
    if (flag(FLAG_BADGE01_GET)) {
        msgbox(format("TARN: Passed is passed. Go and see HALE. He signs; I only say whether you can fight."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("TARN: Tidewater Division. I examine.\pYou want the Forest Certification, provisional? Two parts. The reading, then the water."), MSGBOX_DEFAULT)
    msgbox(format("TARN: The pond across the boulevard. Twenty-eight pairs of WINGULL on it this spring, the same count her notebook gives for it years back.\pA healthy count, then?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("TARN: Wrong. Same number, half the water. They're closer together, not better off. Abundance is not health; write it on your hand if you have to.\pNow hold a line when the water's against you."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("TARN: Good. Same number, half the water. The birds are closer together, not better off. Most say yes because the number says yes.\pHold that thought while the current's against you."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_EXAM_1)
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM1, format("TARN: Hm. The current's yours, then."))
    goto(ParcelFernwickHall_Tarn_Defeated)
}

script ParcelFernwickHall_Tarn_Defeated {
    setflag(FLAG_BADGE01_GET)
    playfanfare(MUS_OBTAIN_BADGE)
    waitfanfare
    msgbox(format("TARN: Forest Certification, practical: passed. HALE signs the paper. I only say whether you can fight.\pYou can."), MSGBOX_DEFAULT)
    giveitem(ITEM_TM03)
    msgbox(format("TARN: WATER PULSE. Teach it to something. The marsh is mostly water, and most of it's against you."), MSGBOX_DEFAULT)
    release
    end
}

// --- post-game: the full-strength rematch, offered after the epilogue, repeatable ---
script ParcelFernwickHall_Tarn_Rematch {
    lock
    faceplayer
    msgbox(format("TARN: The author of the record, in my hall. I read it.\pI examine; I don't sign. But I'd examine you once more, at full strength. The current's older than both of us. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TARN: Another day, then. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_GYM1_R, format("TARN: …Still yours. The current, I mean."))
    msgbox(format("TARN: Come back when you want the water against you again. It always is."), MSGBOX_DEFAULT)
    release
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelFernwickHall_Register {
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("The register of certifications, a tall book with a ribbon in it.\pEach line: a name, a date, FOREST, and the leader who signed. The early pages are Tarn's own teacher signing for Tarn. Then Tarn, for twenty years of names.\pSome names carry a second and third line in other hands: WETLAND, WATERSHED, HIGHLAND. A few carry all of them. Hale's does. Rin's stops at three and has a note: field preference.\pThe newest line is yours. The ink is still a different black from the rest."), MSGBOX_SIGN)
    } else {
        msgbox(format("The register of certifications, a tall book with a ribbon in it.\pEach line: a name, a date, FOREST, and the leader who signed. The early pages are Tarn's own teacher signing for Tarn. Then Tarn, for twenty years of names.\pSome names carry a second and third line in other hands: WETLAND, WATERSHED, HIGHLAND. A few carry all of them. Hale's does. Rin's stops at three and has a note: field preference.\pThe next line is blank. The ribbon is in it."), MSGBOX_SIGN)
    }
}

script ParcelFernwickHall_Syllabus {
    msgbox(format("The syllabus, framed because somebody was proud of it once. Four competencies, four lines.\pSURVEY. Read the place before you touch it. Guilds, abundance, condition, signs. Against a baseline, or it is a guess.\pRESTRAINT. Knowing what not to do, and when. A deadfall over the only path we clear. A living corridor we leave.\pRESPONSE. The call comes at the wrong time or it would not be a call. Go anyway. Bring what the place needs, not what you wanted to bring.\pREMEDIATION. Put back what can be put back. Write down what cannot. The second half is the part people skip.\pIn pencil below the frame, not in the hand that framed it: and send the writing somewhere it will be read."), MSGBOX_SIGN)
}
