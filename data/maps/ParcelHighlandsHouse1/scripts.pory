// ParcelHighlandsHouse1 -- a house in Highlands: residents in two story states (before / after the hearing).

mapscripts ParcelHighlandsHouse1_MapScripts {
}

script ParcelHighlandsHouse1_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_MAREEP_DONE)) {
        msgbox(format("MAN: She came down. In the autumn, by herself, when the slope went quiet. She stands in the yard now and faces it.\pI don't tell her it's safe. I don't know that."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_MAREEP_DONE)) {
        msgbox(format("MAN: Standing. You said standing. She'll come down when the slope stops frightening her, or she won't. Either way I know where she is. That's most of shepherding."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_MAREEP_FOUND)) {
        msgbox(format("MAN: Standing? Legs braced? That's her. Good.\pTake these. The FOUNDATION sent a box for the relocations. I've no use for them where I'm not going."), MSGBOX_DEFAULT)
        giveitem(ITEM_HYPER_POTION, 3)
        setflag(FLAG_SKALD_Q_MAREEP_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_MAREEP)) {
        msgbox(format("MAN: Above the slide, on the scree. Don't bring her down. Just tell me she's standing."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_ARRIVAL)) {
        msgbox(format("MAN: One of the MAREEP went up after the old grazing. The slope's moving and I can't go up on these knees.\pIf you see her, don't bring her down. Just tell me she's standing."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_MAREEP)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: The leases are enjoined. The slope doesn't know. It'll keep moving at its own speed. So will I."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Sheep on the high ground until the ground stopped being ground. Now they graze the lower slope and I watch the upper one move."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelHighlandsHouse1_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: Grandad goes to the centre for the cocoa and comes back and tells me what everyone said. He never used to tell me anything.\pThe cocoa's good, he says. I think it's the telling."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Grandad went to the warming centre. He had the cocoa. He said it was good, and then he was quiet for a long time."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("GIRL: HOLLIS went down to the coast. The cocoa stopped the day after. Grandad said nothing's as much as you like, and then he said 'told you' very quietly."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: The warming centre has cocoa. HOLLIS said we could have as much as we liked. Grandad said nothing's as much as you like."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelHighlandsHouse1_ReadDresser {
    msgbox(format("A mug on the dresser with the FOUNDATION crest, washed and put upside down. A child's mug beside it, right way up, with cocoa rings inside."), MSGBOX_SIGN)
    end
}

script ParcelHighlandsHouse1_ReadDrawer {
    msgbox(format("A drawer of mittens, in pairs, by size. The smallest pairs have never been worn. There was no snow to wear them in."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelHighlandsHouse1_PaperGrantLetter {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The relocation grant letter, and across its face in the Council's stamp: VOID PENDING SURVEY. The survey is yours.\pThe man has pinned it where the girl can reach it. She has drawn a house on the back, standing, legs braced."), MSGBOX_SIGN)
    } else {
        msgbox(format("The relocation grant letter, in its envelope, on the shelf where the girl cannot reach it. MEREHOLT FOUNDATION: RESETTLEMENT ASSISTANCE, HAUKFELL SLOPE. A sum. A deadline. A box to sign.\pThe box is empty. The envelope has been opened and closed so many times the flap has gone soft."), MSGBOX_SIGN)
    }
    end
}
