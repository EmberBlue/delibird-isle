// ParcelStation -- the first Climate Corps field station + the Holding
// Meadow (§08 Acts I-II). Exterior staging for now (interiors come with the
// building pass). Quoted dialogue is canonical-verbatim from
// design/08-chapter-01.md. The recognition is authored along the Doduo path
// the prose follows (§10 partner-recognition; the lightly-responsive
// variant is a later pass). No fanfare anywhere -- §08: credentials, not
// trophies; "no welcome ceremony."

const LOCALID_STATION_HALE    = 1
const LOCALID_STATION_RIN     = 2
const LOCALID_STATION_ILEX    = 3
const LOCALID_MEADOW_LOTAD    = 4
const LOCALID_MEADOW_SHROOMISH = 5
const LOCALID_MEADOW_SEEDOT   = 6
const LOCALID_MEADOW_NUMEL    = 7
const LOCALID_MEADOW_ELECTRIKE = 8
const LOCALID_MEADOW_CARVANHA = 9
const LOCALID_MEADOW_DODUO    = 10
const LOCALID_SNARE_1         = 11
const LOCALID_SNARE_2         = 12
const LOCALID_SNARE_3         = 13
const LOCALID_LOOKOUT         = 14

mapscripts ParcelStation_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelStation_OnTransition
}

script ParcelStation_OnTransition {
    if (defeated(TRAINER_SKALD_LOOKOUT)) {
        setflag(FLAG_TEMP_5)
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 127)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) == 7) {
        clearflag(FLAG_TEMP_5)
    } else {
        setflag(FLAG_TEMP_5)
    }
    end
}

// --- Act I: the briefing (Hale, at the station yard) -----------------------
script ParcelStation_Hale {
    lock
    faceplayer
    if (flag(FLAG_SYS_POKEMON_GET)) {
        if (defeated(TRAINER_SKALD_LOOKOUT)) {
            msgbox(format("Hale: Four tasks. Logged.\pNo fanfare. That's how it should feel."), MSGBOX_DEFAULT)
            msgbox(format("Hale: North of here the forest gives out and the wetlands begin. There's a fishing landing on the backwater.\pPeople up there are angry, and somebody is feeding them a story."), MSGBOX_DEFAULT)
            msgbox(format("Hale: Go listen. Document what you see.\nDon't argue with anyone's paycheck."), MSGBOX_DEFAULT)
            release
            end
        }
        setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 127)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
        if (var(VAR_RESULT) == 7) {
            msgbox(format("Hale: A call just came in. West fringe, by the treeline.\pSomeone's working a line down there who shouldn't be."), MSGBOX_DEFAULT)
            msgbox(format("Hale: You have a partner now.\nGo do more than stare."), MSGBOX_DEFAULT)
            clearflag(FLAG_TEMP_5)
            addobject(LOCALID_LOOKOUT)
            release
            end
        }
        msgbox(format("Hale: Training. Three of our practice snares are out on the fringe--find them, clear them."), MSGBOX_DEFAULT)
        msgbox(format("Hale: Ilex set three survey stakes: bank, substrate, canopy. Read each one.\pAnd Rin wants a water sample from the channel."), MSGBOX_DEFAULT)
        msgbox(format("Hale: No deadline.\nDo it properly."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_STATION_BRIEF)) {
        msgbox(format("Hale: The meadow's east.\pYou walk. You observe. You stop where you're compelled to stop."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Hale: No welcome ceremony. We document ecological change, interrupt exploitation, coordinate restoration.\pOften without public support."), MSGBOX_DEFAULT)
    msgbox(format("Hale: We don't 'win.' We reduce harm. We keep corridors open.\nWe stop the worst of it."), MSGBOX_DEFAULT)
    msgbox(format("Hale: Your mentor worked with us.\pWhatever happened at that lab…\nwasn't random."), MSGBOX_DEFAULT)
    msgbox(format("Hale hands you a heavier second pack: an empty Poké Ball case, a hand-marked folded map, and a laminated card stamped PROVISIONAL.\pOn the card, a small printed strip of red cloth."), MSGBOX_DEFAULT)
    msgbox(format("Hale: This isn't ownership.\nIt's responsibility."), MSGBOX_DEFAULT)
    msgbox(format("Hale: The Holding Meadow is east. The ones that wait are there.\pYou don't pick. And they don't obey."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_STATION_BRIEF)
    release
    end
}

script ParcelStation_Rin {
    lock
    faceplayer
    if (flag(FLAG_SYS_POKEMON_GET)) {
        msgbox(format("Rin: Welcome to walking with consequences."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Rin doesn't look up. She is redirecting a channel's flow, one stone at a time.\pRin: Nothing stays here permanently.\nThat's the rule."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Ilex {
    lock
    faceplayer
    if (flag(FLAG_SYS_POKEMON_GET)) {
        setvar(VAR_0x8004, 3)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        copyvar(VAR_0x8005, VAR_RESULT)
        setvar(VAR_0x8004, 4)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        copyvar(VAR_0x8006, VAR_RESULT)
        setvar(VAR_0x8004, 5)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        if (var(VAR_0x8005) == 1 && var(VAR_0x8006) == 1 && var(VAR_RESULT) == 1) {
            msgbox(format("Ilex: Bank, substrate, canopy.\nLet's see what you saw."), MSGBOX_DEFAULT)
            special(SkaldmereClassifyMeadow)
            msgbox(format("Ilex: Reference state. Whole.\pKeystone breeding, every guild present, nothing swarming, no damage."), MSGBOX_DEFAULT)
            msgbox(format("Ilex: Remember exactly what this feels like.\pYou will spend the rest of your life measuring places against it."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("Ilex: Three stakes. Bank, substrate, canopy.\pRead all three, then come back."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("Ilex: They've all been displaced.\nBut not broken."), MSGBOX_DEFAULT)
    msgbox(format("Ilex: They aren't rare. They aren't powerful.\pThey are stable."), MSGBOX_DEFAULT)
    release
    end
}

// --- Act II: the ones that wait (non-uniform reactions, §08) ---------------
script ParcelStation_Lotad {
    lock
    msgbox(format("The Lotad rests at the pool's shaded edge.\pIt registers you, and goes back to being still.\nCalm."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Shroomish {
    lock
    msgbox(format("The Shroomish recoils--spores pulsing once, twice--\pthen settles. It doesn't move away."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Seedot {
    lock
    msgbox(format("The Seedot freezes mid-hop between the roots.\pIt is very committed to being a seed."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Numel {
    lock
    msgbox(format("The Numel is curled by the dry corner of the meadow, radiating heat.\pThe ground here is drier than it should be.\pYou write that down before you realize you're doing it."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Electrike {
    lock
    msgbox(format("The Electrike paces the perimeter, closer each pass.\pIt never quite stops."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Carvanha {
    lock
    msgbox(format("Something circles in the deeper channel.\pThe Carvanha keeps its distance.\nSo do you."), MSGBOX_DEFAULT)
    release
    end
}

// --- The recognition (the Doduo path; §08 Act II verbatim beats) -----------
script ParcelStation_Doduo {
    lock
    if (!flag(FLAG_SKALDMERE_STATION_BRIEF)) {
        msgbox(format("A Doduo stands at the clearing's edge.\pOne head watches you.\nThe other watches the forest."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("The Doduo moves. One head stays on you; the other sweeps the treeline.\pYou stop--\nbecause moving feels wrong."), MSGBOX_DEFAULT)
    msgbox(format("You kneel.\pBehind you, quiet footsteps: Rin sets a single Poké Ball on the ground between you, and steps back."), MSGBOX_DEFAULT)
    msgbox(format("Rin: If it chooses to enter,\nyou're provisional partners."), MSGBOX_DEFAULT)
    closemessage
    delay(60)
    playse(SE_BALL_THROW)
    delay(60)
    msgbox(format("The Doduo studies you a moment longer.\pThen it nudges the ball.\pThe ball closes with no shake.\nJust stillness."), MSGBOX_DEFAULT)
    removeobject(LOCALID_MEADOW_DODUO)
    givemon(SPECIES_DODUO, 5)
    setflag(FLAG_SYS_POKEMON_GET)
    msgbox(format("It feels warm.\pWREN received DODUO."), MSGBOX_DEFAULT)
    msgbox(format("Hale: This doesn't make you a Ranger."), MSGBOX_DEFAULT)
    msgbox(format("Ilex: It makes you accountable."), MSGBOX_DEFAULT)
    msgbox(format("Rin: Welcome to walking with consequences."), MSGBOX_DEFAULT)
    msgbox(format("You leave the meadow not empowered--\nbut entangled.\pAnd that is the point."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelStation_Sign {
    msgbox(format("CLIMATE CORPS -- FIELD STATION\pThe Holding Meadow is east.\nNothing stays there permanently."), MSGBOX_SIGN)
    end
}

// --- Act III: the certification training tasks ------------------------------
script ParcelStation_Snare1 {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 0)
    call(ParcelStation_ClearSnare)
    release
    end
}
script ParcelStation_Snare2 {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 1)
    call(ParcelStation_ClearSnare)
    release
    end
}
script ParcelStation_Snare3 {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 2)
    call(ParcelStation_ClearSnare)
    release
    end
}
script ParcelStation_ClearSnare {
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The cleared snare site. The wire is in your pack."), MSGBOX_DEFAULT)
        return
    }
    msgbox(format("A practice snare, half-hidden in the grass--a wire loop on a bent stake.\pYou unhook the trigger and wind the wire, the way the manual says.\nSlowly. No sudden pulls."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    return
}

script ParcelStation_StakeBank {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 3)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The bank stake. Already read."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A survey stake by the channel. A strip of red cloth, faded.\pBANK: edges soft but holding. Root mass intact.\nYou write it down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelStation_StakeSubstrate {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 4)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The substrate stake. Already read."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A survey stake in the open meadow. Red cloth, knotted twice.\pSUBSTRATE: mixed soil, no compaction, drains clean.\nYou write it down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelStation_StakeCanopy {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The canopy stake. Already read."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A survey stake at the tree line. Red cloth, nearly new.\pCANOPY: broken sunlight, layered growth, edge gradual--not cut.\nYou write it down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelStation_WaterSample {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CERT_TASKS)
    setvar(VAR_0x8004, 6)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The sampling point. Rin has your vial."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("You kneel at the channel and draw a sample.\pThe water runs clear--but colder than the air explains.\pConditions matter. You label the vial and note the temperature."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- Act III: the distress call (the first real battle) ---------------------
script ParcelStation_Lookout {
    trainerbattle_single(TRAINER_SKALD_LOOKOUT,
        format("Garr: Station kid, huh? This line was here before your stakes were.\pWalk away."),
        format("Garr: Tch. Practiced, are you."))
    msgbox(format("Garr coils his line, unhurried, and looks past you at the station.\pGarr: Write your little report.\nIt changes nothing out here."), MSGBOX_DEFAULT)
    end
}
