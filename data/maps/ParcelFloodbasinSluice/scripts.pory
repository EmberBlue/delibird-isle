}
script ParcelFloodbasinSluice_Sverre {
    trainerbattle_single(TRAINER_SKALD_SLU_SVERRE,
        format("SVERRE: Phase 2 starts here. Survey stakes to the river. I pulled three up. They put five back. Fight."),
        format("SVERRE: …Five, then."),
        ParcelFloodbasinSluice_Sverre_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SLU_SVERRE_R2)) {
