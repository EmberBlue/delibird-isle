// ParcelFloodbasinSluice -- the upper sluice: the old ford where Phase 2 would start (Route 118),
// west of Leirvik across the basin's open edge. Six trainers at 22-24 on the near bank, two at
// 32-33 on the far bank (Surf), a Board surveyor, the proposal sign.

mapscripts ParcelFloodbasinSluice_MapScripts {
}

script ParcelFloodbasinSluice_Nils {
    trainerbattle_single(TRAINER_SKALD_SLU_NILS,
        format("NILS: The crossing's the old ford. The Board put a gauge on it and called it a sluice. Battle."),
        format("NILS: …Gauged."),
        ParcelFloodbasinSluice_Nils_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SLU_NILS_R2)) {
        goto(ParcelFloodbasinSluice_Nils_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SLU_NILS_R3)) {
        goto(ParcelFloodbasinSluice_Nils_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SLU_NILS_R4)) {
        goto(ParcelFloodbasinSluice_Nils_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SLU_NILS_R5)) {
        goto(ParcelFloodbasinSluice_Nils_R5)
    }
    msgbox(format("NILS: Water's two hands lower than the gauge says normal. The gauge was set in a wet year."), MSGBOX_DEFAULT)
    end
}
script ParcelFloodbasinSluice_Nils_FirstWin {
    msgbox(format("NILS: Water's two hands lower than the gauge says normal. The gauge was set in a wet year."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinSluice_Nils_R2 {
    lock
    faceplayer
    msgbox(format("NILS: I kept the team up for this. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("NILS: Another time, then."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SLU_NILS_R2, format("NILS: …Again, then. Later."))
    msgbox(format("NILS: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinSluice_Nils_R3 {
    lock
    faceplayer
    msgbox(format("NILS: I've been training against the lake. You're the test. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("NILS: Another time, then."), MSGBOX_DEFAULT)
