script ParcelFloodbasinSluice_Grim {
    trainerbattle_single(TRAINER_SKALD_SLU_GRIM,
        format("GRIM: Stones in the river bed. Worked stones. Somebody built a weir here before the Board was a word. Battle."),
        format("GRIM: …Older than me too."),
        ParcelFloodbasinSluice_Grim_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SLU_GRIM_R2)) {
        goto(ParcelFloodbasinSluice_Grim_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SLU_GRIM_R3)) {
        goto(ParcelFloodbasinSluice_Grim_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SLU_GRIM_R4)) {
        goto(ParcelFloodbasinSluice_Grim_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SLU_GRIM_R5)) {
        goto(ParcelFloodbasinSluice_Grim_R5)
    }
    msgbox(format("GRIM: Every sluice is the third sluice on the same river. Nobody writes down the first two."), MSGBOX_DEFAULT)
    end
}
