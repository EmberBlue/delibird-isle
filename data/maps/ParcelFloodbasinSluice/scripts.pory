    }
    trainerbattle_no_intro(TRAINER_SKALD_SLU_NILS_R3, format("NILS: …Again, then. Later."))
    msgbox(format("NILS: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
