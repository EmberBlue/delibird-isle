script ParcelFloodbasinSluice_Surveyor {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("SURVEYOR: The weir's cancelled. The gates stay. I measure what I'm told, and this year they told me to measure the marsh too.\pMore to measure. I don't mind more."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SURVEYOR: Phase 2 goes ahead. Sluice gates here. The weir above is 'deferred'. I measure what I'm told. There's less to measure now, and I'm told it kindly."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("SURVEYOR: The river hall carried a vote against Phase 2. The Board doesn't count that vote. I've been told to keep measuring.\pSo I measure. I've started writing the vote in the margin of the field sheet, though. The river measures the rest."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SURVEYOR: Phase 2. Sluice gates here, a weir above, a reservoir where the ford was. 'Flood control.'\pI measure what I'm told to measure. The river measures the rest."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinSluice_Sign {
    msgbox(format("UPPER SLUICE (proposed). WATER BOARD / MEREHOLT CIVIL. Works commence on approval."), MSGBOX_SIGN)
    end
}
script ParcelFloodbasinSluice_ItemHyperPotion { finditem(ITEM_HYPER_POTION) end }

// --- route life (2026-11-10): the pairs ---

script ParcelFloodbasinSluice_PairFord {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ANGLER: The shelf's wider this year. The river's lower, not the shelf."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: Two boards on the gauge now. Old mark, new mark. I read the old one. I'm old."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: Which one does the Board read?"), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: Both, in public, every week. It's taken thirty years to make them do a thing they could have done in a morning."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OLD MAN: The ranger stood on the shelf in the shallows for an hour and counted nothing."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: Nothing?"), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: Wrote 'nothing' with the date. Said nothing with a date on it is a number. NILS heard that and hasn't spoken since."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: NILS doesn't speak anyway."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: He speaks less now. Thoughtfully."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("ANGLER: The Board put a gauge on the ford and called it a sluice."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: It was a ford when I was a boy. You walked across in August with your boots round your neck."), MSGBOX_DEFAULT)
        msgbox(format("ANGLER: You'd swim it now."), MSGBOX_DEFAULT)
        msgbox(format("OLD MAN: You'd swim it in August and read NORMAL on the gauge while you did. That's progress."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelFloodbasinSluice_Board1 {
    msgbox(format("A SURVEY BOARD on the sluice wall. The gate holds the basin's water back in spring and lets it go in summer, which is backwards from the marsh's point of view.\pThe GOLDEEN below the gate are counted at the drop. When the gate is right they are there. When the gate is late they are somewhere else. The gate has been late."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasinSluice_Board2 {
    msgbox(format("A SURVEY BOARD, the paint burnt off the gate side by the sun. MARILL on the quiet water above the sluice, young in the reeds.\pThe board notes that the young appear a fortnight after the gate closes, every year. The gate's timing is the marsh's timing now. It did not use to be."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round four ---

script ParcelFloodbasinSluice_PairGate {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GATEMAN: Gate's on the marsh's calendar now. Board order. First time the order's had a reason on it."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: What's the reason say?"), MSGBOX_DEFAULT)
        msgbox(format("GATEMAN: GOLDEEN. One word. I've worked this gate twenty years and never seen a fish on an order."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: The ranger stood on the wall and timed the drop. With a watch."), MSGBOX_DEFAULT)
        msgbox(format("GATEMAN: Everyone times it with the sun."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: The sun doesn't go in a report. A watch does. That's the difference between knowing and being believed."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GATEMAN: Gate's late this year. Orders."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: Late for the fields or late for the marsh?"), MSGBOX_DEFAULT)
        msgbox(format("GATEMAN: Late. I don't get told who for."), MSGBOX_DEFAULT)
        msgbox(format("WOMAN: The marsh doesn't get told either. That's two of you."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards, round two (2026-11-10) ---

script ParcelFloodbasinSluice_Board3 {
    msgbox(format("A SURVEY BOARD on the upper wall. MANECTRIC on the sluice gantries in a storm, drawn by the iron. The board notes the storms by the count of MANECTRIC on the gantry: three, five, eight.\pThe storms are the same size. The gantry is the same iron. There are more storms."), MSGBOX_SIGN)
    end
}

// --- survey boards, round three (2026-11-10) ---

script ParcelFloodbasinSluice_Board4 {
    msgbox(format("A SURVEY BOARD on the keeper's steps. The sluice has been kept by one family for four generations, and the board carries the keepers' initials and the years, and beside each the number of springs the gate opened on time.\pThe last keeper's row is the longest and the number is the lowest. The board gives no reason. The ledger inside does."), MSGBOX_SIGN)
    end
}

// --- survey boards, round five (2026-11-10) ---

script ParcelFloodbasinSluice_Board10 {
    msgbox(format("A SURVEY BOARD on the lower channel wall. ELECTRIKE on the gantry irons in a storm, counted from the keeper's window, because nobody goes onto the wall in a storm.\pThe board gives the count and the keeper's name for each year, four keepers, one family, and a note that the count is the only thing on the sluice that was never argued about."), MSGBOX_SIGN)
    end
}
