script ParcelFloodbasinSluice_Odd {
    trainerbattle_single(TRAINER_SKALD_SLU_ODD,
        format("ODD: Nobody comes this side without Surf. So you're the one. Full strength."),
        format("ODD: …The one."),
        ParcelFloodbasinSluice_Odd_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SLU_ODD_R2)) {
        goto(ParcelFloodbasinSluice_Odd_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SLU_ODD_R3)) {
        goto(ParcelFloodbasinSluice_Odd_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SLU_ODD_R4)) {
        goto(ParcelFloodbasinSluice_Odd_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SLU_ODD_R5)) {
        goto(ParcelFloodbasinSluice_Odd_R5)
    }
    msgbox(format("ODD: The far side of a river is where things get left alone. Not for long now."), MSGBOX_DEFAULT)
    end
}
