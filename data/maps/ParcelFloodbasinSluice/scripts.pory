    }
    trainerbattle_no_intro(TRAINER_SKALD_SLU_NILS_R4, format("NILS: That's the one I wanted to see."))
    msgbox(format("NILS: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinSluice_Nils_R5 {
    lock
    faceplayer
    msgbox(format("NILS: I heard what you filed. Then show me what filed it?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
