// ParcelFloodbasinRelief -- the Foundation relief store in Leirvik. Vouchers
// in, signatures out. The sheet is the point.
mapscripts ParcelFloodbasinRelief_MapScripts {
}
script ParcelFloodbasinRelief_Aide {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_ROOF_DONE)) {
        msgbox(format("AIDE: The store's open again under the review. The sheet's back from the hearing with a stamp on it.\pI put MRS. ASKE's name at the top of the new one. Habit. Good habit."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_ROOF_FOUND) && !flag(FLAG_SKALD_Q_ROOF_DONE)) {
        msgbox(format("AIDE: MRS. ASKE's roof. It's on the sheet. It's been on the sheet for four weeks.\pI'll put it at the top. I'm not supposed to re-order the sheet. Take this and don't tell the councilman I can read."), MSGBOX_DEFAULT)
        giveitem(ITEM_RARE_CANDY)
        setflag(FLAG_SKALD_Q_ROOF_DONE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("AIDE: The store's closed. The sheet's an exhibit. The councilman says the basin's recovering nicely. The hearing said 'recovering' is not a measurement. I liked that. I shouldn't have."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("AIDE: The store's closing. Relief period's over. The councilman says the basin's recovering nicely.\pThe sheet goes to the coast office. Forty-one signatures. They like a full sheet."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("AIDE: Residents only, RANGER. Fuel on the left, dry goods on the right. Sign the sheet.\pWhat's the sheet for? Records. The FOUNDATION believes in records."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinRelief_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: Her roof's new. Mine's fine. We don't talk about who signed. We talk about roofs.\pIt turns out roofs are enough to talk about."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: I signed. My neighbour didn't. Her roof's still got the tarp on, and now the Board's paying for a new one because she didn't sign. I'm not bitter. I'm confused. Same thing, round here."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: My neighbour still won't sign, and her roof's still got the tarp, and now she's got a letter from the river hall thanking her for 'standing'.\pShe didn't stand anywhere. She sat under a tarp. She's framed the letter."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: I signed. Everyone signs. My neighbour wouldn't, and her roof's still got the tarp on."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelFloodbasinRelief_Sheet {
    msgbox(format("RELIEF REGISTER -- LEIRVIK. Forty-one names. Beside each, a box ticked: 'I confirm that the Foundation's remediation of the basin is proceeding to my satisfaction.'\pThe box is ticked in the same pen on every line."), MSGBOX_SIGN)
    end
}

script ParcelFloodbasinRelief_ReadDresser {
    msgbox(format("A stack of blankets with the crest. The top one has been unfolded and refolded badly by someone who wanted to see if they were real.\pThey are."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelFloodbasinRelief_Ledger {
    msgbox(format("The relief ledger. Who came, what they were given, what they signed.\pBlankets, two per household, FOUNDATION stamped in the corner. Lamp oil. Dried fish, from the Coast, in cannery cartons. A voucher for the ferry, one way.\pEach line signed by the household and countersigned by the Commissioner's aide. At the foot of each page: relief provided by the Mereholt Foundation in partnership with the Regional Council.\pA column headed CAUSE OF NEED. It says FLOOD on every line. In one place, in another hand, under FLOOD: the works. It has been crossed out and FLOOD written again above it, firmly.\pThe ledger is honest about what was given. It is careful about why."), MSGBOX_SIGN)
    if (flag(FLAG_SKALD_CH_BLANKET)) {
        msgbox(format("The last line is yours, in the aide's hand. RANGER. BLANKET, ONE. CAUSE OF NEED: FLOOD.\pYou signed nothing. It is there anyway."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALD_FLD_RELIEF_DONE)) {
        msgbox(format("The last line has been ruled for a name and left empty. The aide ruled it the day you came down the bank.\pIt is the only empty line in the book."), MSGBOX_SIGN)
    }
}
