// ParcelIsleAnniHouse -- Anni's house. Her boy Piet, in bed with the fog in
// his chest.

mapscripts ParcelIsleAnniHouse_MapScripts {
}

script ParcelIsleAnniHouse_Piet {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE) && flag(FLAG_SKALD_Q_ANNI_DONE)) {
        msgbox(format("PIET: I'm better. I count the boats from the jetty now. Mom lets me. Fourteen today.\pROLF says it was twenty when he started. I wrote both."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("PIET: Mom read the frog part out loud. Twice for ROLF and once more for me.\pWhen I'm better I'm going to count something. Everything. I've got a list started."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALD_Q_ANNI_DONE)) {
        msgbox(format("PIET: You took the net down to TOBIN! Mom said you didn't even complain about the jetty.\pI'm not allowed on the jetty. 'When you're better.' That's what everyone says. When."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("PIET: The fog gets in my chest. That's what the doctor says. He says it like it's the fog's fault.\pMom says the fog's been here longer than the doctor."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsleAnniHouse_ReadBed {
    msgbox(format("A child's bed with the blanket turned back and a book face down on the pillow. The book is about boats. The pillow is damp."), MSGBOX_SIGN)
    end
}

script ParcelIsleAnniHouse_ReadShelf {
    msgbox(format("A shelf of medicines in a row, with the doctor's note weighted under the first bottle. 'Fog.'\pUnderlined, by somebody else."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelIsleAnniHouse_PaperPietsList {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A list in a child's hand, taped to the bed frame: THINGS TO COUNT WHEN I'M BETTER. Boats, ticked. Gulls on the stack, ticked, with a number. Stairs to the jetty, ticked twice.\pThe fog has a number after it now: days without. The number is seven. He wrote it very carefully."), MSGBOX_SIGN)
    } else {
        msgbox(format("A list in a child's hand, taped to the bed frame: THINGS TO COUNT WHEN I'M BETTER. Boats. Gulls on the stack. Stairs to the jetty. The fog.\pThe fog has a question mark after it. He has not worked out how yet."), MSGBOX_SIGN)
    }
    end
}
