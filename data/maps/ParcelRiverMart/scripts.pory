mapscripts ParcelRiverMart_MapScripts {
}
script ParcelRiverMart_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(ParcelRiverMart_Items)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release
    end
}
raw `
	.align 2
ParcelRiverMart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_NET_BALL
	.2byte ITEM_POTION
	.2byte ITEM_SUPER_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_BURN_HEAL
	.2byte ITEM_REPEL
	.2byte ITEM_SUPER_REPEL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_NONE
`
script ParcelRiverMart_Customer {
    lock
    faceplayer
    msgbox(format("WOMAN: NET BALLS are in. The river's full of things you'd want to catch before they're gone."), MSGBOX_DEFAULT)
    release
    end
}
