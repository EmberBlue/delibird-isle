// --- the beaver stump (side quest) --------------------------------------------------
script ParcelRiver_BeaverStump {
    lock
    if (flag(FLAG_SKALD_Q_BEAVER) && !flag(FLAG_SKALD_Q_BEAVER_SEEN)) {
        msgbox(format("A sapling stump on the bank, gnawed to a point. The chips at its foot are pale. Fresh.\pSomething is building above the town again. Written down, and the old man's name beside it."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_BEAVER_SEEN)
        release
        end
    }
    msgbox(format("A sapling stump on the bank, gnawed to a point."), MSGBOX_SIGN)
    release
    end
}

// --- PERRIN, encounter 4 (the peer; §04) -------------------------------------------
script ParcelRiver_PerrinScene {
    if (flag(FLAG_SKALD_PERRIN_4)) {
        setvar(VAR_TEMP_5, 1)
        end
    }
    lockall
    playse(SE_PIN)
    msgbox(format("PERRIN: WREN!"), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelRiver_PerrinIn)
    waitmovement(0)
    msgbox(format("PERRIN: DORSEY introduced me at the market! 'Our newest liaison.' LIAISON, WREN.\pPhase 2's going ahead, you know. Flood control. You can't argue with dry sheds. Battle!"), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_PERRIN_4, format("PERRIN: Okay. You CAN argue with it."))
    msgbox(format("PERRIN: I took the desk. Part time's full time now. It's good work. It IS.\pHOLLIS asked about you. She asks about everyone. It's her best trick."), MSGBOX_DEFAULT)
    closemessage
    applymovement(LOCALID_PERRIN, Movement_ParcelRiver_PerrinOut)
    waitmovement(0)
    removeobject(LOCALID_PERRIN)
    setflag(FLAG_SKALD_PERRIN_4)
    setvar(VAR_TEMP_5, 1)
    releaseall
    end
}
script ParcelRiver_PerrinTalk {
    lock
    faceplayer
    msgbox(format("PERRIN: Hang on, I'm coming to you."), MSGBOX_DEFAULT)
    release
    end
}
movement Movement_ParcelRiver_PerrinIn { walk_down * 2 }
movement Movement_ParcelRiver_PerrinOut { walk_up * 2 }

// --- the epilogue, stop 3 of 8 ---
script ParcelRiver_Epilogue {
    lockall
    delay(20)
    msgbox(format("ELVSUND. Market day. The WATER BOARD notice on the pole has six names under it, and the sentence they argued about for two hours is in.\pRead the whole river before you judge any part of it. SLUICE keeps the gate. The crossing is still the crossing."), MSGBOX_DEFAULT)
    msgbox(format("The gauge at the ford carries two boards now, one above the other. The old mark and the new. Children read them aloud to each other and argue about which is real.\pDELL is at the ford with no rod. Watching. He says he saw a red flank go up at first light. He says it every morning, and one morning it will be true."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 4)
    warp(MAP_PARCEL_HIGHLANDS, 20, 68)
    waitstate
    end
}

// --- the mill wood (side area), off the west edge ---
script ParcelRiver_ToMillWood {
    warp(MAP_PARCEL_RIVER_MILL_WOOD, 36, 37)
    waitstate
    end
}

script ParcelRiver_Hives {
    if (!flag(FLAG_SKALD_Q_HIVES)) {
        end
    }
    msgbox(format("Six hives on the bank, humming. The beekeeper is asleep against the end one with a smoker in his lap, perfectly well.\pThe flowers are out all along the bank."), MSGBOX_SIGN)
    setflag(FLAG_SKALD_Q_HIVES_FOUND)
    end
}

// The zone's survey stake (§13 fix E): reads the chapter's evidence back.
script ParcelRiver_SurveyStake {
    msgbox(format("A survey stake at the edge of the market ground, red cloth at the top, a child's blue ribbon tied under it by somebody who thought it needed company."), MSGBOX_SIGN)
    setvar(VAR_0x8004, 3)
    special(SkaldSurveyStake)
    msgbox(gStringVar4, MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs ---

script ParcelRiver_PairMeter {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FARMER: The Board's publishing both readings now. Old datum and new. Two columns."), MSGBOX_DEFAULT)
        msgbox(format("MILLER: Two columns and one river. The wet column and the honest one."), MSGBOX_DEFAULT)
        msgbox(format("FARMER: The honest one says my allocation is a quarter of what it was. On paper. It was always a quarter in the field."), MSGBOX_DEFAULT)
        msgbox(format("MILLER: Paper's catching up with the field. Give it another forty years."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MILLER: Forty-one of us signed. The reply was one paragraph. I've framed the paragraph."), MSGBOX_DEFAULT)
        msgbox(format("FARMER: The ranger read it. Twice. Then asked SLUICE which year the datum was set."), MSGBOX_DEFAULT)
        msgbox(format("MILLER: And?"), MSGBOX_DEFAULT)
        msgbox(format("FARMER: And SLUICE answered. In public. First Board officer to answer anything in public since the gauge went in."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("FARMER: Fourteen plots metered. The meter runs when the water runs. The water runs when the Board says."), MSGBOX_DEFAULT)
        msgbox(format("MILLER: My wheel turned for free for sixty years and now it's a 'draw'. A draw. Like a lottery."), MSGBOX_DEFAULT)
        msgbox(format("FARMER: You're ahead of me. They've called mine an 'allocation'."), MSGBOX_DEFAULT)
        msgbox(format("MILLER: Longer word. More expensive."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelRiver_PairFord {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DELL: OTTAR let the SEAKING go. The last one. Off the ford, at first light, nobody watching but me."), MSGBOX_DEFAULT)
        msgbox(format("GRANDDAUGHTER: Why would he do that?"), MSGBOX_DEFAULT)
        msgbox(format("DELL: The ranger's count is in the record. One fish. He said one fish in a record is a prisoner. One fish in a river is a chance."), MSGBOX_DEFAULT)
        msgbox(format("GRANDDAUGHTER: Is it?"), MSGBOX_DEFAULT)
        msgbox(format("DELL: Ask me in forty years. Write down that I said that."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GRANDDAUGHTER: The ranger stood in the shallows for an hour. Just counting."), MSGBOX_DEFAULT)
        msgbox(format("DELL: Counting what? There's nothing to count."), MSGBOX_DEFAULT)
        msgbox(format("GRANDDAUGHTER: That's what they were counting. They wrote down nothing, with the date. Said nothing with a date is a number."), MSGBOX_DEFAULT)
        msgbox(format("DELL: …Your great-grandfather would have liked that. He never wrote anything down and it's all gone with him."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("GRANDDAUGHTER: You said the SEAKING came up to the ford. In red."), MSGBOX_DEFAULT)
        msgbox(format("DELL: Every spring. You could walk across on them, my father said. He said a lot of things."), MSGBOX_DEFAULT)
        msgbox(format("GRANDDAUGHTER: Was that one true?"), MSGBOX_DEFAULT)
        msgbox(format("DELL: The ford part. The walking part was my father."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- the stringer (2026-11-10): MAREN, Skaldmere Courier ---

script ParcelRiver_Stringer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAREN: The Board publishes two columns now. Old datum, new datum. I ran them side by side without a word of comment.\pBest thing I never wrote. The miller framed it next to the Board's one-paragraph reply. He's got a wall going."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        if (flag(FLAG_SKALD_CH_SPOKE)) {
            msgbox(format("MAREN: The meeting ran as half a page. Including the ranger who stood up at the back and said refuse the straightened mile.\pI quoted you from memory. It was close. If it wasn't, you should have given me the sentence at Reedmere."), MSGBOX_DEFAULT)
        } else {
            msgbox(format("MAREN: The meeting ran as half a page. The ranger stood at the back and wrote. I put that in.\pStanding at the back writing is a position too. ILEX has held it for thirty years. Look where it's got the Board."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("MAREN: The water meeting's tonight. Forty-one ratepayers and a Board that won't name a year.\pI asked SLUICE which year. SLUICE said ask the Board. I asked the Board. The Board doesn't comment on individual readings. I've written that sentence so often I could set it in type myself."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- side quests, round three (2026-11-10) ---

script ParcelRiver_FordBoy {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_BOOK_DONE)) {
        msgbox(format("BOY: I'm keeping my own book now. One line a week. DAD says that's how it starts."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALD_Q_BOOK)) {
        if (flag(FLAG_SKALD_Q_BOOK_FOUND)) {
            msgbox(format("BOY: Eleven years NORMAL and then they moved the mark. So the floods didn't stop. The book stopped.\pDAD'll want to know he was right. He won't like it. Here, for telling me straight."), MSGBOX_DEFAULT)
            giveitem(ITEM_NET_BALL, 3)
            setflag(FLAG_SKALD_Q_BOOK_DONE)
        } else {
            msgbox(format("BOY: The gauge book. In the Board office, on the counter. The kept one."), MSGBOX_DEFAULT)
        }
    } else {
        msgbox(format("BOY: The Board's book has the real river in it. DAD says. He says there's two books, the one they show and the one they keep.\pYou can go in the office. Read the kept one and tell me which year the floods stopped."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_BOOK)
    }
    release
    end
}
