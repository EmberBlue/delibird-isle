// ParcelRiver -- ELVSUND and the farmland (§01/§06 zone 4, Chapter 3): "the
// river is stressed." Rebuilt 2026-11 as a 60x40 composite: vanilla Route 117
// (the farmland, the ponds, the depot) over Mauville (the market town), with
// the river painted down the east side and two fenced plots and a farmhouse
// east of town. The tells sit along the river bank, read from the water's
// edge; HARLAND's boat is moored at the bank; ILEX works the upstream reach;
// SLUICE audits from the Water Board office (gym 4, HM04); DORSEY holds the
// crossroads on market day; the town meeting plays in the hall. Flag logic
// unchanged; words plain.
//
// VAR_SKALDMERE_CH3_EVIDENCE bits (count 0..5 with mask 0x3F):
//   0  channelized cut         1  broken dam relic
//   2  runoff bloom            3  clean upstream reach (the baseline)
//   4  irrigation board (mask) 5  Harland heard (the lever, local)
//   6  classified + filed (Ilex)

const LOCALID_RIVER_ILEX    = 1
const LOCALID_RIVER_HARLAND = 2
const LOCALID_RIVER_FARMER  = 3
const LOCALID_RIVER_ANGLER  = 5
const LOCALID_RIV_DORSEY    = 6
const LOCALID_RIV_AIDE      = 7

const LOCALID_PERRIN = 34

mapscripts ParcelRiver_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelRiver_OnTransition
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SKALD_EPILOGUE, 3: ParcelRiver_Epilogue
    ]
}

script ParcelRiver_OnTransition {
    // Dorsey works the market until the Watershed Certification is signed.
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        setflag(FLAG_TEMP_2)
    } else {
        clearflag(FLAG_TEMP_2)
    }
    end
}

// --- first entry ------------------------------------------------------------------
script ParcelRiver_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_RIVER_ARRIVAL)) {
        end
    }
    lockall
    bufferpartymonnick(0, 0)
    msgbox(format("The land lifts and the trees thin. The water that fouled the basin runs out of here, clearer than below. Not clear."), MSGBOX_DEFAULT)
    msgbox(format("Market stalls up the street. Nets on a rail. A crop running green right down to the bank. {STR_VAR_1} takes the road ahead and doesn't hurry."), MSGBOX_DEFAULT)
    msgbox(format("HALE's note, folded in the kit: WATERSHED. LIVING SYSTEM, ACTIVE USE.\pRead the whole river before you judge any part of it."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_RIVER_ARRIVAL)
    releaseall
    end
}

// --- the survey: four tells + the mask, along the bank ------------------------------
script ParcelRiver_ChannelCut {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The straightened mile. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("Here the bank is cut straight as a rule, the bends dredged out, the slack water gone with them.\pBoard stakes every fifty paces. Nothing slows down here anymore, and nothing stays. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelRiver_DamRelic {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 1)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The old dam. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A tangle of grey timber across the current, gapped in the middle. Not built. Chewed.\pThe engineers who kept it are gone from this reach; nothing has patched it in years. The pond it held is a channel now. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelRiver_RunoffStain {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 2)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The bloom. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("Below the plots the water goes green and thick, a scum of it against the bank where the field drain comes in.\pIt smells of fertiliser, sweet and wrong. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelRiver_CleanReach {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 3)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The clean reach. The baseline. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("Above the town the river braids over gravel, cold and quick and clear to the bottom. Larvae under every stone. A SURSKIT on the eddy.\pThis is what the whole river was. It is still here. Written down, and underlined."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelRiver_IrrigationBoard {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 4)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The Board's notice. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("ELVSUND WATER BOARD -- a MEREHOLT FOUNDATION partnership.\pIRRIGATION ALLOCATION: plots 1-14, metered. CHANNEL IMPROVEMENT, PHASE 2: flood control works, upstream reach. Consultation closed.\pThe crest on the sign is the crest on the fertiliser sacks. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- HARLAND at the mooring (the lever, local) --------------------------------------
script ParcelRiver_Harland {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HARLAND: ILEX signed you off, and I signed under you at the hearing. The river's in the review with the coast. Both or neither, I told them. They took both."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        if (!flag(FLAG_SKALD_RIV_NIGHT_DONE)) {
            msgbox(format("HARLAND: ILEX signed you off. Good.\pStay the night. On the boat. The river's different in the dark, and you've only read it in daylight."), MSGBOX_DEFAULT)
            msgbox(format("Stay the night?"), MSGBOX_YESNO)
            if (var(VAR_RESULT) == 0) {
                msgbox(format("HARLAND: Offer stands."), MSGBOX_DEFAULT)
                release
                end
            }
            closemessage
            fadescreen(FADE_TO_BLACK)
            msgbox(format("HARLAND: Hear that? That's the cut. Day and night, same note. Used to be the water had a dozen voices along here."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: My father could tell the pools apart with his eyes shut. I can't. There aren't any."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: The note on this boat comes due in spring. If the catch holds, I keep her. If it doesn't, a MEREHOLT outfit I've never met owns a boat my grandfather built.\pThat's what 'relief' bought me. I'm not blaming you. I'm telling you the price."), MSGBOX_DEFAULT)
            msgbox(format("{PLAYER}: The upstream reach is still clean. ILEX says it can come back."), MSGBOX_DEFAULT)
            msgbox(format("HARLAND: Then write it so somebody with a pen believes it. I've tried the other way.\pGo to sleep, RANGER. River's not going anywhere. Yet."), MSGBOX_DEFAULT)
            closemessage
            delay(60)
            fadescreen(FADE_FROM_BLACK)
            msgbox(format("HARLAND: Morning. Coffee's bad. Catch was four. Go on, you've got a mountain to climb, I hear."), MSGBOX_DEFAULT)
            setflag(FLAG_SKALD_RIV_NIGHT_DONE)
            release
            end
        }
        msgbox(format("HARLAND: Catch was four. Same as yesterday. Go on."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 5)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("HARLAND: Read me right when you write it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HARLAND: You're the one with the notebook. Word came up the river ahead of you.\pCome to tell me the fishing's poor. As if I can't read my own water."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: The catch is down because the river is. The cut. The bloom off the fields."), MSGBOX_DEFAULT)
    msgbox(format("HARLAND: I KNOW why it's down. Knew before you could walk.\pMy father fished this. His father helped build half that old dam your people keep photographing, back when building it was the work."), MSGBOX_DEFAULT)
    msgbox(format("HARLAND: And the Board says straighten the cut and the floods stop taking my gear. The FOUNDATION carries the note on the boat so I keep working while it all gets sorted.\pSo what is it you'd have me do? Tie up and starve on principle?"), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: …Who holds the note on the boat?"), MSGBOX_DEFAULT)
    msgbox(format("HARLAND: A MEREHOLT outfit. Coastal lending.\pSame crest as the fertiliser sacks. Same crest as the Board. Hadn't set those side by side before. Don't care for how they line up."), MSGBOX_DEFAULT)
    msgbox(format("HARLAND: Write your report, RANGER. Read me right when you do.\pI'm not your villain. I'm the man they'll send the bill to."), MSGBOX_DEFAULT)
    special(SkaldmereCertTaskMark)
    release
    end
}

// --- the farmer: a real constraint, not a cartoon ------------------------------------
script ParcelRiver_Farmer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FARMER: ILEX's buffer strip, two rows, got written into the allocation. The fund paid. I didn't believe the fund. I believed it when the cheque cleared. The strip's going in. Two rows."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("FARMER: ILEX put a buffer strip in her report. Two rows. Named a fund that'd pay for it.\pI'll believe the fund when it's in my hand. But she wrote it down. Nobody else has."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FARMER: Mind the rows, RANGER.\pThey tell me my runoff greens the water. Likely true. They also tell me grow more for less, or sell to the FOUNDATION buyer at the FOUNDATION's number."), MSGBOX_DEFAULT)
    msgbox(format("FARMER: I'd put a buffer strip along the bank tomorrow. Costs me two rows and a season's yield.\pYou find me the one who'll pay for those two rows, and I'll dig it before you've walked home."), MSGBOX_DEFAULT)
    release
    end
}

// --- ILEX: the field debrief and the Watershed Certification ------------------------
script ParcelRiver_Ilex {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ILEX: Stressed, not shifted, and the hearing kept the difference. I held it like a coal for you. Now you hold it for the next one."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("ILEX: Stressed, not shifted. Hold that difference like a coal.\pMost of the country you'll meet from here has already chosen. This river hasn't. Yet."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 63)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) == 6) {
        msgbox(format("ILEX: The cut. The old dam. The bloom. The clean reach. The Board's sign. The man on the boat.\pPut a name on the river."), MSGBOX_DEFAULT)
        specialvar(VAR_RESULT, SkaldmereClassifyRiver)
        msgbox(format("ILEX: STRESSED.\pThe engineers are thinning. The cut took the slack water. The bloom is climbing. But the sensitive guild is still in that upstream reach. The web hasn't simplified yet."), MSGBOX_DEFAULT)
        msgbox(format("ILEX: Which means this is the rarest reading you will ever file. The one where doing the right thing in time still does something."), MSGBOX_DEFAULT)
        msgbox(format("{PLAYER}: So we intervene. Pull the cut, mend the dam…"), MSGBOX_DEFAULT)
        msgbox(format("ILEX: Some of it. Not all of it, and not by signing the Board's plan.\pRelieve what's reversible: the buffer strip, the bloom, the fish passage. Refuse what isn't, dressed as relief: another straightened mile, another 'flood control' that finishes the slack water."), MSGBOX_DEFAULT)
        msgbox(format("ILEX: A stressed river doesn't need a hero. It needs someone who can tell the two apart and has the spine to say so out loud. You said so in the hall. I heard you."), MSGBOX_DEFAULT)
        setvar(VAR_0x8004, 6)
        special(SkaldmereCertTaskMark)
        msgbox(format("ILEX: Watershed Certification. HALE would make you walk back for it. I won't.\pYou read the window. Now you keep it open."), MSGBOX_DEFAULT)
        playfanfare(MUS_OBTAIN_BADGE)
        waitfanfare
        setflag(FLAG_SKALDMERE_WATERSHED_CERT)
        giveitem(ITEM_SUPER_POTION, 5)
        giveitem(ITEM_REVIVE, 2)
        release
        end
    }
    msgbox(format("ILEX: Don't classify a river from one bend. Walk the bank: the cut, the old dam, the bloom off the fields, the clean water above the town. Read the Board's sign. Hear the man on the boat.\pThen come put a name to it."), MSGBOX_DEFAULT)
    release
    end
}

// --- DORSEY on market day (the public face; gone after the cert) ------------------------
script ParcelRiver_Dorsey {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DORSEY: Phase 2 goes ahead. Six farms kept dry. You'd have done it too, RANGER, with a different word on the sign. I've stopped saying 'flood control'. I say 'the sluice'. It's the same sluice."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH3_EVIDENCE)
    setvar(VAR_0x8004, 63)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) >= 4) {
        msgbox(format("DORSEY: You've walked the bank. I can see it on your boots.\pPhase 2 is flood control, RANGER. Six farms lost gear last spring. The Board's plan stops that. Your ILEX calls it 'finishing the slack water'. I call it keeping people's sheds dry."), MSGBOX_DEFAULT)
        msgbox(format("DORSEY: Come to the hall. There's a meeting. Say your piece in front of them, not behind my back. I'd rather lose an argument in public than win one in a report."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("DORSEY: RANGER! Market day. Best day to see ELVSUND. Eggs, trout, the first greens.\pTrout's down this year. The Board has a plan for that. Phase 2. You'll have seen the notice."), MSGBOX_DEFAULT)
    msgbox(format("DORSEY: Walk the bank first, then come and tell me what you think. I mean that. I grew up two valleys over. My father's fields flooded every spring and nobody came.\pI came."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_Aide {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("AIDE: Phase 2 consultation reopened by order. The councilman takes questions every market day now, not just when it suits. Form a line. There is one."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("AIDE: The councilman's up at HAUKFELL this week. The warming centre. He takes questions there now; nobody forms a line there either.\pPhase 2 consultation remains closed. I'm to say 'remains'."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("AIDE: Phase 2 consultation is closed, but the councilman takes questions on market days. Form a line. There is no line."), MSGBOX_DEFAULT)
    release
    end
}

// --- market day residents ------------------------------------------------------------------
script ParcelRiver_VendorEggs {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_HIVES_DONE)) {
        msgbox(format("WOMAN: He came down the next morning with six jars and no apology. I took the jars. Buy something or move along, RANGER. I've a stall."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_HIVES_FOUND)) {
        msgbox(format("WOMAN: Asleep! Against a hive! I'll give him asleep.\pHere. Three jars. Don't pay. You've earned honey, which is more than most people manage."), MSGBOX_DEFAULT)
        giveitem(ITEM_HONEY, 3)
        setflag(FLAG_SKALD_Q_HIVES_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_HIVES)) {
        msgbox(format("WOMAN: Up the bank, above the plots, where the flowers still come. Six hives. If he's not there, he's in the river, and I'll want to know that too."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_RIVER_ARRIVAL)) {
        msgbox(format("WOMAN: The honey's from upstream, where the flowers still come. The beekeeper's not been down in a fortnight. His hives are on the bank above the plots.\pI can't leave the stall. You've legs."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_HIVES)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: Eggs, greens, honey. The honey's from upstream, where the flowers still come. More of them this year, the beekeeper says. He says it like he doesn't believe it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: Eggs, greens, a jar of honey. The honey's from upstream, where the flowers still come. Buy something or move along, RANGER, I've a stall to mind."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_VendorFish {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: HARLAND's cousin. Six trout today. Sold two to the FOUNDATION buyer at my number, not his. First time. He paid it. He looked surprised to be paying it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: HARLAND's cousin. Four trout today. I sold them to the FOUNDATION buyer at his number because nobody else was buying.\pYour ILEX wrote 'fish passage' in her report. Tell her I'll hold her to it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: HARLAND's cousin. I sell what he catches. There's less to sell every spring and more people asking why.\pI tell them the Board has a plan. The Board always has a plan."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_OldMan {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OLD MAN: The pond above the town. The allocation gives the beaver reach a flow. Beavers don't read allocations, but water does. I'll walk up and look. Every day, till I see one."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("OLD MAN: They say the ground up at HAUKFELL has let go. Houses carried down a slope by hand. I swam in a beaver pond as a boy; those people skated on ground that's water now.\pA ditch I can live beside. That, I couldn't."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("OLD MAN: There was a pond above the town. Beaver-built. We swam in it as boys. Then the trappers, then the Board.\pNow it's a ditch with a stake every fifty paces. Progress, they call it. I call it a ditch."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: The councilman gave me a ribbon. PHASE 2, in blue. Mum put it in a drawer after the hearing. She said it's history now. I don't know what that means but it's still blue."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("GIRL: The councilman's up the mountain giving out blankets with the same crest as my ribbon!\pMum says the blankets are real. She said it like the ribbon isn't. It IS. It's blue."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: The councilman gave me a ribbon! It says PHASE 2 on it. I don't know what that is but it's blue."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: Mum says I can swim below the plots again by summer. The green stuff's going. She says a ranger wrote it down and then men came and measured. I asked if writing works. She said 'sometimes'."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("BOY: A boy from HAUKFELL came down to stay with his aunt. He says the ground there goes soft and the trees lean.\pHe says it like it's normal. I told him the green water's normal. He didn't believe me either."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: Don't swim below the plots. Mum says the water's got green stuff in it that makes your skin go funny. Above the town's fine. Above the town's freezing."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiver_PondFisher {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: I fish the town pond. Stocked. The river's getting better below the plots, they say. I'll fish it when I believe them. Not yet. Soon, maybe."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("FISHER: Stocked pond, stocked fish. Up at HAUKFELL they've got a stocked house now, they tell me. A grant and a house in the valley.\pSame thing. Not the same. The fish know. The people know."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: I fish the town pond now. Stocked. It's not the same, but it's not green either."), MSGBOX_DEFAULT)
    release
    end
}

// --- DELL and his lure (side quest -> Super Rod) -------------------------------------------
script ParcelRiver_AnglerTrainer {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_DELL_DONE)) {
        msgbox(format("DELL: Forty years on this reach. You're the first one came up here to LOOK instead of promise. Means something."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_DELL_LURE)) {
        msgbox(format("DELL: That's it! That's the one. My father's. Snagged it on the gravel above town thirty years back and never found it.\pYou went and looked. Nobody looks."), MSGBOX_DEFAULT)
        msgbox(format("DELL: Take the rod. The good one. I'm done with the big water; my knees say so.\pSomebody ought to be pulling SEAKING out of this river who'll write down how many."), MSGBOX_DEFAULT)
        giveitem(ITEM_SUPER_ROD)
        setflag(FLAG_SKALD_Q_DELL_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_DELL)) {
        msgbox(format("DELL: Above the town, on the gravel, where the water's still clear. A brass lure. You'd see it if anyone would."), MSGBOX_DEFAULT)
        release
        end
    }
    release
    trainerbattle_single(TRAINER_SKALD_ANGLER,
        format("DELL: Forty years I worked this reach. Pulled SEAKING out by the armful, once.\pNow look at it. Battle me. I could use the distraction."),
        format("DELL: Hah. You've still got the eye for it. Wish the river did."))
    msgbox(format("DELL: The Board swears the cut'll bring the fish back. The Board swears a lot of things.\pYou've got the eye. Do an old man a kindness. There's a brass lure on the gravel above town, my father's, lost thirty years. If anyone can spot it in that clear water, it's you."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALD_Q_DELL)
    end
}
script ParcelRiver_Lure {
    lock
    if (flag(FLAG_SKALD_Q_DELL) && !flag(FLAG_SKALD_Q_DELL_LURE)) {
        msgbox(format("Something glints on the gravel under the clear water. A brass lure, green with age, the hook long gone.\pFished out."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_DELL_LURE)
        release
        end
    }
    msgbox(format("Clear water over clean gravel. You can count the stones."), MSGBOX_SIGN)
    release
    end
}

// --- route trainers ----------------------------------------------------------------------------
script ParcelRiver_Arna {
    trainerbattle_single(TRAINER_SKALD_RIV_ARNA,
        format("ARNA: The flower plots are the best picnic in the district. Shame about the smell off the river. Battle?"),
        format("ARNA: Lovely. Now go away, I'm eating."),
        ParcelRiver_Arna_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_RIV_ARNA_R2)) {
        goto(ParcelRiver_Arna_R2)
    }
