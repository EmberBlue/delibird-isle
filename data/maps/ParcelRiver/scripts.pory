script ParcelRiver_T_Aud {
    trainerbattle_single(TRAINER_SKALD_RIV_AUD,
        format("AUD: The high meadow's the last place the flowers come up on their own. Battle me among them."),
        format("AUD: Among them, beaten."),
        ParcelRiver_T_Aud_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_RIV_AUD_R2)) {
        goto(ParcelRiver_T_Aud_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_RIV_AUD_R3)) {
        goto(ParcelRiver_T_Aud_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_RIV_AUD_R4)) {
        goto(ParcelRiver_T_Aud_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_RIV_AUD_R5)) {
        goto(ParcelRiver_T_Aud_R5)
    }
    msgbox(format("AUD: Below the town they spray. Above the town they don't. You can draw the line with your nose."), MSGBOX_DEFAULT)
    end
}
