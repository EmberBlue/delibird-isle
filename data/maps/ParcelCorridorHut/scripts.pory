// ParcelCorridorHut -- the Hollowbend drainage crew's site hut (the Route 116
// house). The spec sheet is here. The flow data is not. That is the point.

mapscripts ParcelCorridorHut_MapScripts {
}

script ParcelCorridorHut_Foreman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FOREMAN: Pre-construction flow data. Turns out we do do it, now. Eleven pages of it, every month, to FERNWICK. One of my lads drew the chart. He's proud of it. I let him be."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH1_EVIDENCE)
    setvar(VAR_0x8004, 10)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("FOREMAN: One of my lads says a RANGER's been asking about flow data. Pre-construction.\pWe don't do pre-construction. We do construction. Somebody else does the before."), MSGBOX_DEFAULT)
        msgbox(format("FOREMAN: Here's what I'll tell you for free. The culvert's on the drawing at twice the width it got built. Twice.\pSomebody signed the change. It wasn't me."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FOREMAN: Crew hut. Mind the mud. If you're from MEREHOLT the invoices are on the shelf. If you're from the CORPS, the kettle's on."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCorridorHut_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_SIGN) && !flag(FLAG_SKALD_Q_SIGN_DONE)) {
        msgbox(format("CLERK: The closure sign. 1998, CORPS stamp, the miner's name on the back. That goes in the Phase 2 file as exhibit one. Nobody can say the gallery wasn't closed now.\pTake these for the carrying. The foreman keeps them for the lads; the lads don't read either."), MSGBOX_DEFAULT)
        giveitem(ITEM_REVIVE, 2)
        setflag(FLAG_SKALD_Q_SIGN_DONE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Eleven pages, filed where they couldn't be unfiled. They weren't. They were read. I didn't sign them. I'm thinking I should have."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_FLOW_DONE)) {
        msgbox(format("CLERK: Eleven pages, filed with the CORPS station at FERNWICK. Somewhere they can't be unfiled. I didn't sign the cover sheet. You did."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_FLOW_FOUND)) {
        msgbox(format("CLERK: …Those are them. The flow survey. Pre-construction. The bore in the plan is twice what got built.\pI'll see they're filed. Take this; it was in the satchel's pocket and it isn't the company's."), MSGBOX_DEFAULT)
        giveitem(ITEM_TM39)
        setflag(FLAG_SKALD_Q_FLOW_DONE)
        release
        end
    }
    if (flag(FLAG_SKALD_Q_FLOW)) {
        msgbox(format("CLERK: The survey crew worked out of the old adit up the cut, before the FOUNDATION sealed it. If the pages are anywhere, they're in there. I never said that."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: I keep the paperwork. Spec sheet, schedule, the grate order. All in order.\pThe flow survey? That'd be county. Or the contractor. Everyone says that, don't they. It's always somewhere else."), MSGBOX_DEFAULT)
    msgbox(format("CLERK: The folder's empty because the pages went somewhere. The survey crew worked out of the old adit before the FOUNDATION sealed it.\pIf a RANGER happened to find eleven pages in there, I never asked them to."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALD_Q_FLOW)
    release
    end
}

script ParcelCorridorHut_Plans {
    msgbox(format("HOLLOWBEND SPUR -- DRAINAGE WORKS. Spec sheet, revision C.\pCulvert: 1.2 m bore. A handwritten line through it. 0.6 m. Initialled. The initials are not the foreman's."), MSGBOX_SIGN)
    end
}

script ParcelCorridorHut_Shelf {
    msgbox(format("Invoices. Grate order, 12 units, due next month.\pA folder labelled FLOW SURVEY. It is empty."), MSGBOX_SIGN)
    end
}
