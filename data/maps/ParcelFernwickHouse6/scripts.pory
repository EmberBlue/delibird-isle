// ParcelFernwickHouse6 -- a house in Fernwick: residents in two story states (before / after the hearing).

mapscripts ParcelFernwickHouse6_MapScripts {
}

script ParcelFernwickHouse6_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: Feed the review's clerks the first Tuesday, the Survey girl Thursdays, HALE whenever he remembers to eat.\pNobody's thin this year. I check."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Fed the hearing's clerks for a week. They eat like people who sit all day. They have."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: Rangers back from the basin eat like they've been digging, because they have. Sandbags.\pI've started putting sugar in the pot without being asked. Nobody's objected."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: I cook for the District Station. Rangers eat like people who've walked all day, because they have."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse6_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: Dad says the whole region's still eating what you cooked. He says you don't have to be hungry to be fed.\pI don't understand it. He says I will."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Dad says you fed a whole region a truth. He says that's cooking."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GIRL: Dad says the river people fed the whole meeting from one pot and nobody went home hungry or quiet.\pThat IS the same job. I told you."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: I'm going to be a ranger. Or a cook. Dad says they're the same job."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse6_ReadDresser {
    msgbox(format("A cook's apron on the dresser, washed thin. Embroidered on the pocket, badly, by a child: RANGER."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse6_ReadShelf {
    msgbox(format("Cookbooks, and between them the District Station duty roster, so he knows how many to feed. Tonight's number is circled twice."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse6_ReadPantry {
    msgbox(format("A sugar jar with a note taped to it: FOR THE BASIN LOT. NO ARGUMENTS."), MSGBOX_SIGN)
    end
}
