script ParcelWeather_Brit {
    trainerbattle_single(TRAINER_SKALD_WEA_BRIT,
        format("BRIT: Solar plot. We're at thirty-one days without rain, on purpose. Battle before the NUMEL overheats."),
        format("BRIT: It overheated."),
        ParcelWeather_Brit_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WEA_BRIT_R2)) {
        goto(ParcelWeather_Brit_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_WEA_BRIT_R3)) {
        goto(ParcelWeather_Brit_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_WEA_BRIT_R4)) {
        goto(ParcelWeather_Brit_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WEA_BRIT_R5)) {
        goto(ParcelWeather_Brit_R5)
    }
    msgbox(format("BRIT: Day thirty-two tomorrow. The grass went brown on day nine. Nobody's written that down. It's not a result, it's a side effect."), MSGBOX_DEFAULT)
    end
}
