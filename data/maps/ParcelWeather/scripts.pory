// --- assistants -----------------------------------------------------------------------------
script ParcelWeather_Ask {
    trainerbattle_single(TRAINER_SKALD_WEA_ASK,
        format("ASK: Breeder, Hydrology plot. My CASTFORM changes with the plot. So do I. Battle."),
        format("ASK: Changed again."),
        ParcelWeather_Ask_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WEA_ASK_R2)) {
        goto(ParcelWeather_Ask_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_WEA_ASK_R3)) {
        goto(ParcelWeather_Ask_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_WEA_ASK_R4)) {
        goto(ParcelWeather_Ask_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_WEA_ASK_R5)) {
        goto(ParcelWeather_Ask_R5)
    }
    msgbox(format("ASK: CASTFORM's the station mascot. It becomes whatever sky you put it under. The director says that's the whole philosophy. He doesn't say it like a compliment."), MSGBOX_DEFAULT)
    end
}
