script ParcelWeather_Sand {
    trainerbattle_single(TRAINER_SKALD_SAND,
        format("DUNE: Aridity Division. This plot used to be marsh. I made it a desert in a season, for science. Watch your footing."),
        format("DUNE: Grit, you've got. Fitting. It's the only thing that grows in my conditions."),
        ParcelWeather_Sand_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SAND_R2)) {
        goto(ParcelWeather_Sand_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SAND_R3)) {
        goto(ParcelWeather_Sand_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SAND_R4)) {
        goto(ParcelWeather_Sand_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SAND_R5)) {
        goto(ParcelWeather_Sand_R5)
    }
    msgbox(format("DUNE: My job is proving a dried-out place can still 'support managed use'. It can support a sandstorm and a lawsuit, mostly.\pYou can take a wetland apart fast. Putting one back is not in my budget line."), MSGBOX_DEFAULT)
    end
}
