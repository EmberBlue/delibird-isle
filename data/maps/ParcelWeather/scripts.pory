// ParcelWeather -- the MEREHOLT CLIMATE STATION (the Weather Institute and the
// ground around it: Route 119's north third, General + Fortree). Reached by
// the third ferry route (Coastal cert). Four climatologists each run a plot
// of private weather on the slopes; VANE, the Director, waits upstairs in the
// institute with the weather rocks, the Deepwater stamp (badge 7) and HM08.
// Flag logic unchanged; words plain.

const LOCALID_WS_SAILOR = 5

mapscripts ParcelWeather_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: ParcelWeather_FirstEntry
    ]
}

script ParcelWeather_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_WEATHER_ARRIVAL)) {
        end
    }
    lockall
    msgbox(format("A sign over the landing: MEREHOLT CLIMATE FUTURES -- ATMOSPHERIC DIVISION. Managing tomorrow's weather, today.\pFans. Instruments. Four plots up the slope, each under its own private sky: rain on one, a fine afternoon on the next, sand, frost."), MSGBOX_DEFAULT)
    msgbox(format("The whole journey has been the real weather. The thaw, the bloom, the failing marsh.\pThese are the people paid to call it adjustable. Beat them on their own plots. Then take what they know somewhere it might do some good."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_WEATHER_ARRIVAL)
    releaseall
    end
}

// --- the four divisions -------------------------------------------------------------------
script ParcelWeather_Rain {
    trainerbattle_single(TRAINER_SKALD_RAIN,
        format("MARLOWE: Hydrology Division. I don't forecast the rain, RANGER. I make it. Stand under this and learn."),
        format("MARLOWE: …Hm. The model held. The team didn't. I hate when those come apart separately."))
    msgbox(format("MARLOWE: We can drop a monsoon on a test plot to order. People see the demo and assume we can end a drought.\pWe can't. We can only move the misery to someone else's map. But the demo is what gets funded."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Sun {
    trainerbattle_single(TRAINER_SKALD_SUN,
        format("HELIO: Solar Forcing. I keep this plot in a permanent fine afternoon. Nothing dies of a fine afternoon. Until it does."),
        format("HELIO: Bright work. You don't wilt. Most do, in my weather."))
    msgbox(format("HELIO: A little more sun, a longer season, a bigger yield. That's the pitch. They leave out the part where the soil cooks and the water leaves.\pPleasant is not the same as alive. I tell them. They like pleasant."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Sand {
    trainerbattle_single(TRAINER_SKALD_SAND,
        format("DUNE: Aridity Division. This plot used to be marsh. I made it a desert in a season, for science. Watch your footing."),
        format("DUNE: Grit, you've got. Fitting. It's the only thing that grows in my conditions."))
    msgbox(format("DUNE: My job is proving a dried-out place can still 'support managed use'. It can support a sandstorm and a lawsuit, mostly.\pYou can take a wetland apart fast. Putting one back is not in my budget line."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Ice {
    trainerbattle_single(TRAINER_SKALD_ICE,
        format("FROSK: Cryosphere Division. I keep one plot frozen while the world thaws. It costs a fortune. That's rather the point."),
        format("FROSK: Cold-blooded battling. I approve. The warm-hearted ones never last my hail."))
    msgbox(format("FROSK: I can hold ice on a single square against the whole summer, if you pay the power bill.\pThat's what 'climate resilience' means once you read the invoice. A frozen plot for whoever can afford one."), MSGBOX_DEFAULT)
    end
}

// --- assistants -----------------------------------------------------------------------------
script ParcelWeather_Ask {
    trainerbattle_single(TRAINER_SKALD_WEA_ASK,
        format("ASK: Breeder, Hydrology plot. My CASTFORM changes with the plot. So do I. Battle."),
        format("ASK: Changed again."))
    msgbox(format("ASK: CASTFORM's the station mascot. It becomes whatever sky you put it under. The director says that's the whole philosophy. He doesn't say it like a compliment."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Brit {
    trainerbattle_single(TRAINER_SKALD_WEA_BRIT,
        format("BRIT: Solar plot. We're at thirty-one days without rain, on purpose. Battle before the NUMEL overheats."),
        format("BRIT: It overheated."))
    msgbox(format("BRIT: Day thirty-two tomorrow. The grass went brown on day nine. Nobody's written that down. It's not a result, it's a side effect."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Cato {
    trainerbattle_single(TRAINER_SKALD_WEA_CATO,
        format("CATO: Aridity plot. I shovel sand onto a marsh for a living. Battle. Please."),
        format("CATO: Thanks. Needed that."))
    msgbox(format("CATO: There were POLIWAG in this plot when I started. I don't know where they went. I know I'm not supposed to ask."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Dis {
    trainerbattle_single(TRAINER_SKALD_WEA_DIS,
        format("DIS: Cryosphere plot. We keep one square frozen. It's the most expensive square on the island. Battle."),
        format("DIS: Expensive loss."))
    msgbox(format("DIS: The power for the ice plot comes up from the coast works. The coast works run on the catch. So the frozen square is made of fish, if you follow it back."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Ebba {
    trainerbattle_single(TRAINER_SKALD_WEA_EBBA,
        format("EBBA: Corps liaison. I'm meant to observe. Observing's dull. Spar."),
        format("EBBA: Observed."))
    msgbox(format("EBBA: HALE sent me to count what the station publishes against what it measures. Two different numbers. Every month."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Frode {
    trainerbattle_single(TRAINER_SKALD_WEA_FINN2,
        format("FRODE: I study the old ground under the plots. Pollen. Peat. What the weather WAS. Nobody funds what was. Battle."),
        format("FRODE: What was, lost to what is."))
    msgbox(format("FRODE: The peat says this slope had a marsh for nine thousand years. The plot's had sand for one. Guess which one's in the brochure."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Gaute {
    trainerbattle_single(TRAINER_SKALD_WEA_GAUTE,
        format("GAUTE: I fly the instrument birds. SWELLOW with sensors. They hate it. Battle."),
        format("GAUTE: They'd have won."))
    msgbox(format("GAUTE: The birds read the real sky, over the fence. The plots read the pretend sky. The director keeps both sets. He only publishes one."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Hege {
    trainerbattle_single(TRAINER_SKALD_WEA_HEGE,
        format("HEGE: The bridge is the best place to think. The water doesn't care what the plots say. Battle me on it."),
        format("HEGE: The water still doesn't care."))
    msgbox(format("HEGE: The director isn't a liar. That's what's hard. He knows exactly what the station is. He runs it anyway, so somebody honest does."), MSGBOX_DEFAULT)
    end
}

// --- the ferry home, items, signs ------------------------------------------------------------
script ParcelWeather_ReturnFerry {
    lock
    faceplayer
    msgbox(format("SAILOR: Back to SALTWICK, RANGER? Honest air out there, at least. Whatever they sell in here, it isn't that."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SAILOR: Take your time. Mind the fans."), MSGBOX_DEFAULT)
        release
        end
    }
    closemessage
    playse(SE_SHIP)
    delay(40)
    warp(MAP_PARCEL_ISLE, 15, 31)
    waitstate
    end
}
script ParcelWeather_ItemMaxEther { finditem(ITEM_MAX_ETHER) end }
script ParcelWeather_ItemRareCandy { finditem(ITEM_RARE_CANDY) end }
script ParcelWeather_SignGate {
    msgbox(format("MEREHOLT CLIMATE FUTURES -- ATMOSPHERIC DIVISION\pManaging tomorrow's weather, today. Visitors report to the institute. Plots are live: do not enter a plot during a demonstration."), MSGBOX_SIGN)
    end
}
script ParcelWeather_SignPlots {
    msgbox(format("TEST PLOTS. North-west: Aridity. North-east: Solar Forcing. East slope: Cryosphere. River: Hydrology.\pThe real sky is not a plot."), MSGBOX_SIGN)
    end
}

// --- more trainers (2026-11 volume pass) ---------------------------------------
script ParcelWeather_T_Amund {
    trainerbattle_single(TRAINER_SKALD_WEA_AMUND,
        format("AMUND: Up the east slope. The frost plot's behind me. It hums. Battle."),
        format("AMUND: Humming's louder than I am, apparently."))
    msgbox(format("AMUND: One frozen square on a warming hill. I asked what it's for. 'Demonstration.' Of what? Nobody said."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_T_Ragnhild {
    trainerbattle_single(TRAINER_SKALD_WEA_RAGNHILD,
        format("RAGNHILD: Breeder, east plots. CASTFORM for the demos, LUDICOLO for the rain. Battle."),
        format("RAGNHILD: Rained on."))
    msgbox(format("RAGNHILD: The station publishes the plot weather. The real weather goes in a drawer. I've seen the drawer."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_T_Oyvind {
    trainerbattle_single(TRAINER_SKALD_WEA_OYVIND,
        format("OYVIND: Instrument birds. XATU reads the sky better than the plots do. Battle before it tells me how this ends."),
        format("OYVIND: It told me."))
    msgbox(format("OYVIND: XATU watches the real sky over the fence. The real sky's not for sale. The plots are."), MSGBOX_DEFAULT)
    end
}
