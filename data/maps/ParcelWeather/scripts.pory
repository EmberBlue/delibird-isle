    msgbox(format("MARLOWE: One more in me. After the high ground."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeather_Rain_R4 {
    lock
    faceplayer
    msgbox(format("MARLOWE: I don't care about the paper. I care about the one I lost. Go?"), MSGBOX_YESNO)
