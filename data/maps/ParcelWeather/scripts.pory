// --- the ferry home, items, signs ------------------------------------------------------------
script ParcelWeather_ReturnFerry {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("SAILOR: Back to SALTWICK? The station's logbooks are in the review, both of them. VANE handed them over himself. Honest air out there, and now a bit in here too."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("SAILOR: Back to SALTWICK, RANGER? Honest air out there, at least. Whatever they sell in here, it isn't that."), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("SAILOR: Take your time. Mind the fans."), MSGBOX_DEFAULT)
        release
        end
    }
    closemessage
    playse(SE_SHIP)
    delay(40)
    warp(MAP_PARCEL_ISLE, 15, 31)
    waitstate
    end
}
script ParcelWeather_ItemMaxEther { finditem(ITEM_MAX_ETHER) end }
script ParcelWeather_ItemRareCandy { finditem(ITEM_RARE_CANDY) end }
script ParcelWeather_SignGate {
    msgbox(format("MEREHOLT CLIMATE FUTURES -- ATMOSPHERIC DIVISION\pManaging tomorrow's weather, today. Visitors report to the institute. Plots are live: do not enter a plot during a demonstration."), MSGBOX_SIGN)
    end
}
script ParcelWeather_SignPlots {
    msgbox(format("TEST PLOTS. North-west: Aridity. North-east: Solar Forcing. East slope: Cryosphere. River: Hydrology.\pThe real sky is not a plot."), MSGBOX_SIGN)
    end
}

