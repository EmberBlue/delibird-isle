// ParcelWeather -- the MEREHOLT CLIMATE STATION (the Weather Institute and the
// ground around it: Route 119's north third, General + Fortree). Reached by
// the third ferry route (Coastal cert). Four climatologists each run a plot
// of private weather on the slopes; VANE, the Director, waits upstairs in the
// institute with the weather rocks, the Deepwater stamp (badge 7) and HM08.
// Flag logic unchanged; words plain.

const LOCALID_WS_SAILOR = 5

mapscripts ParcelWeather_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: ParcelWeather_SetVisited
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: ParcelWeather_FirstEntry
    ]
}

script ParcelWeather_SetVisited {
    setflag(FLAG_VISITED_PARCEL_WEATHER)
    end
}

script ParcelWeather_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_WEATHER_ARRIVAL)) {
        end
    }
    lockall
    msgbox(format("A sign over the landing: MEREHOLT CLIMATE FUTURES -- ATMOSPHERIC DIVISION. Managing tomorrow's weather, today.\pFans. Instruments. Four plots up the slope, each under its own private sky: rain on one, a fine afternoon on the next, sand, frost."), MSGBOX_DEFAULT)
    msgbox(format("The whole journey has been the real weather. The thaw, the bloom, the failing marsh.\pThese are the people paid to call it adjustable. Beat them on their own plots. Then take what they know somewhere it might do some good."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_WEATHER_ARRIVAL)
    releaseall
    end
}

// --- the four divisions -------------------------------------------------------------------
script ParcelWeather_Rain {
    trainerbattle_single(TRAINER_SKALD_RAIN,
        format("MARLOWE: Hydrology Division. I don't forecast the rain, RANGER. I make it. Stand under this and learn."),
        format("MARLOWE: …Hm. The model held. The team didn't. I hate when those come apart separately."),
        ParcelWeather_Rain_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_RAIN_R2)) {
        goto(ParcelWeather_Rain_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_RAIN_R3)) {
        goto(ParcelWeather_Rain_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_RAIN_R4)) {
        goto(ParcelWeather_Rain_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_RAIN_R5)) {
        goto(ParcelWeather_Rain_R5)
    }
    msgbox(format("MARLOWE: We can drop a monsoon on a test plot to order. People see the demo and assume we can end a drought.\pWe can't. We can only move the misery to someone else's map. But the demo is what gets funded."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Rain_FirstWin {
    msgbox(format("MARLOWE: We can drop a monsoon on a test plot to order. People see the demo and assume we can end a drought.\pWe can't. We can only move the misery to someone else's map. But the demo is what gets funded."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeather_Rain_R2 {
    lock
    faceplayer
    msgbox(format("MARLOWE: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("MARLOWE: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_RAIN_R2, format("MARLOWE: Right. That's the whole of it."))
    msgbox(format("MARLOWE: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeather_Rain_R3 {
    lock
    faceplayer
    msgbox(format("MARLOWE: Word gets up the river. Half a region signed off on you. Show me?"), MSGBOX_YESNO)
