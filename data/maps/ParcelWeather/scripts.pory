script ParcelWeather_Ice {
    trainerbattle_single(TRAINER_SKALD_ICE,
        format("FROSK: Cryosphere Division. I keep one plot frozen while the world thaws. It costs a fortune. That's rather the point."),
        format("FROSK: Cold-blooded battling. I approve. The warm-hearted ones never last my hail."),
        ParcelWeather_Ice_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_ICE_R2)) {
        goto(ParcelWeather_Ice_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_ICE_R3)) {
        goto(ParcelWeather_Ice_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_ICE_R4)) {
        goto(ParcelWeather_Ice_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_ICE_R5)) {
        goto(ParcelWeather_Ice_R5)
    }
    msgbox(format("FROSK: I can hold ice on a single square against the whole summer, if you pay the power bill.\pThat's what 'climate resilience' means once you read the invoice. A frozen plot for whoever can afford one."), MSGBOX_DEFAULT)
    end
}
