    trainerbattle_no_intro(TRAINER_SKALD_WEA_AMUND_R5, format("AMUND: …Again, then. Later."))
    msgbox(format("AMUND: Five. Write that one down too. I'll know you did."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWeather_T_Ragnhild {
    trainerbattle_single(TRAINER_SKALD_WEA_RAGNHILD,
        format("RAGNHILD: Breeder, east plots. CASTFORM for the demos, LUDICOLO for the rain. Battle."),
        format("RAGNHILD: Rained on."),
        ParcelWeather_T_Ragnhild_FirstWin)
