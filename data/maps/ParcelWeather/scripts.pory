script ParcelWeather_Cato {
    trainerbattle_single(TRAINER_SKALD_WEA_CATO,
        format("CATO: Aridity plot. I shovel sand onto a marsh for a living. Battle. Please."),
        format("CATO: Thanks. Needed that."),
        ParcelWeather_Cato_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_WEA_CATO_R2)) {
