script ParcelWeather_Sun {
    trainerbattle_single(TRAINER_SKALD_SUN,
        format("HELIO: Solar Forcing. I keep this plot in a permanent fine afternoon. Nothing dies of a fine afternoon. Until it does."),
        format("HELIO: Bright work. You don't wilt. Most do, in my weather."),
        ParcelWeather_Sun_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUN_R2)) {
        goto(ParcelWeather_Sun_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUN_R3)) {
        goto(ParcelWeather_Sun_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUN_R4)) {
        goto(ParcelWeather_Sun_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUN_R5)) {
        goto(ParcelWeather_Sun_R5)
    }
    msgbox(format("HELIO: A little more sun, a longer season, a bigger yield. That's the pitch. They leave out the part where the soil cooks and the water leaves.\pPleasant is not the same as alive. I tell them. They like pleasant."), MSGBOX_DEFAULT)
    end
}
script ParcelWeather_Sun_FirstWin {
    msgbox(format("HELIO: A little more sun, a longer season, a bigger yield. That's the pitch. They leave out the part where the soil cooks and the water leaves.\pPleasant is not the same as alive. I tell them. They like pleasant."), MSGBOX_DEFAULT)
    release
    end
}
