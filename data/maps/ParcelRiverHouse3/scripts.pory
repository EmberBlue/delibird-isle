mapscripts ParcelRiverHouse3_MapScripts {
}
script ParcelRiverHouse3_Mother {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MOTHER: Two rows. The fund paid for the strip. My husband measured it twice and planted it once. The CORPS woman's report had our plot number in it. We've framed the page."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MOTHER: Two rows. The CORPS woman wrote it in her report, with a fund named beside it. My husband's already measured the strip. He's never measured anything before it was paid for."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MOTHER: The drain runs under MARIT's window. She says she can smell the sacks in the water at night. I tell her it's the river. She says that's what she means."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverHouse3_Zigzagoon {
    lock
    faceplayer
    msgbox(format("ZIGZAGOON: Zig! Zig!"), MSGBOX_DEFAULT)
    release
    end
}

script ParcelRiverHouse3_ReadDresser {
    msgbox(format("A tape measure on the dresser, pulled out to two rows' width and left. He measured the strip before the fund paid.\pHe has never done that before."), MSGBOX_SIGN)
    end
}

script ParcelRiverHouse3_ReadDrawer {
    msgbox(format("Seed packets in the drawer, sorted, the ones for the strip at the front. Hedge, alder, sedge. None of them is a crop."), MSGBOX_SIGN)
    end
}
