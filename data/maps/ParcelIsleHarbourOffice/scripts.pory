// ParcelIsleHarbourOffice -- MEREHOLT LOGISTICS, Saltwick. Bright room,
// crest on everything, coffee on. The face of the company is always pleasant.

mapscripts ParcelIsleHarbourOffice_MapScripts {
}

script ParcelIsleHarbourOffice_Dagny {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("DAGNY: I'm allowed to talk to you now. In writing, even. The coffee's on.\pThe manifests say what's in the crates. I never thought I'd find that exciting."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_CORDELIA_DONE)) {
        msgbox(format("DAGNY: I've been asked, in writing, to say nothing to you. So here's what I'll say: the coffee's still on.\pWe're a logistics office. We move whatever the region decides to move. That was never the problem, was it?"), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("DAGNY: Every manifest since Tuesday has 'PENDING' on it. I had to order more of the stamp.\pI'm not joking. I ordered the stamp. That's my job now."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("DAGNY: The new RANGER! Welcome. Your field kit came through this office. FOUNDATION grant, COASTAL freight, LOGISTICS handling. All one family.\pThat's not a threat, it's an org chart. People confuse the two."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("DAGNY: MEREHOLT LOGISTICS. Freight, fuel, ferry coordination. And the storm-relief blankets, if you're wondering who paid for those.\pWe're the part of the company that's easy to like. Coffee?"), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsleHarbourOffice_Osk {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("OSK: Four forms, still. The fourth one's got a column for what came back. I've filled it in twice.\p'Relief, returned, empty' and 'evidence, returned, read'."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("OSK: I filed the same three forms for six years. This week they sent me a fourth.\pIt's called an 'impact acknowledgement'. Nobody can tell me what it acknowledges."), MSGBOX_DEFAULT)
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("OSK: Two manifests this month I've never written before. 'Evidence, three crates.' And 'relief, returned, empty.'\pIf you want to know what a region's doing, don't ask the papers. Ask what moved."), MSGBOX_DEFAULT)
        release
        end
    } else {
        msgbox(format("OSK: I do the manifests. Everything off the boat, everything onto it.\pIf you want to know what a town runs on, don't ask the mayor. Ask the manifest."), MSGBOX_DEFAULT)
    }
    release
    end
}

script ParcelIsleHarbourOffice_ReadCounter {
    msgbox(format("Manifests on the counter, weighted with a shackle. Fuel, crates, passengers.\pYour name is on one of them: PASSENGER, ONE, ISLAND STOP."), MSGBOX_SIGN)
    end
}

script ParcelIsleHarbourOffice_ReadShelf {
    msgbox(format("A shelf of bound manifests, every month for thirty years. You could read the town's whole life off them. Osk already has."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelIsleHarbourOffice_Log {
    msgbox(format("The harbour log, open at last month. Every hull in and out, with the hour and the master's initials.\pThe ferry, twice a day, in the harbourmaster's hand. Fishing boats before light. A Mereholt Logistics coaster on the first of the month, as every month.\pOne night entry, not in the harbourmaster's hand: LOGISTICS, VAN AND LAUNCH, 02:10, NO CARGO DECLARED. Initials you cannot read. The launch left at 04:40, riding low.\pThe next morning's entry is the harbourmaster's again. It says: lab on the front cleared out overnight. Police informed. Nothing to do with the harbour.\pThe two entries are three lines apart. Nobody has drawn a line between them. Nobody needed to."), MSGBOX_SIGN)
}
