// ParcelWetlandsHide -- the Reedmere bird hide: a trail west of the landing (Route 102), the
// pond that is the backwater's last clean water, eight trainers at 14-16, a warden, two signs.
// In and out by the east end (49,10-11) <-> the Wetlands' west edge (2-3,26-27).

mapscripts ParcelWetlandsHide_MapScripts {
}

script ParcelWetlandsHide_Aslak {
    trainerbattle_single(TRAINER_SKALD_HID_ASLAK,
        format("ASLAK: Hide's full. Sit on the bank with me and keep your voice down. After this."),
        format("ASLAK: …Quietly done."),
        ParcelWetlandsHide_Aslak_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_HID_ASLAK_R2)) {
        goto(ParcelWetlandsHide_Aslak_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_HID_ASLAK_R3)) {
        goto(ParcelWetlandsHide_Aslak_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_HID_ASLAK_R4)) {
        goto(ParcelWetlandsHide_Aslak_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_HID_ASLAK_R5)) {
        goto(ParcelWetlandsHide_Aslak_R5)
    }
    msgbox(format("ASLAK: Forty-one WINGULL on the count this morning. Last spring it was ninety. Nobody wants that number."), MSGBOX_DEFAULT)
    end
}
script ParcelWetlandsHide_Aslak_FirstWin {
    msgbox(format("ASLAK: Forty-one WINGULL on the count this morning. Last spring it was ninety. Nobody wants that number."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWetlandsHide_Aslak_R2 {
    lock
    faceplayer
    msgbox(format("ASLAK: Back this way? I've not been idle. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASLAK: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_HID_ASLAK_R2, format("ASLAK: Still yours."))
    msgbox(format("ASLAK: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWetlandsHide_Aslak_R3 {
    lock
    faceplayer
    msgbox(format("ASLAK: Word gets up the river. Half a region signed off on you. Show me?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASLAK: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_HID_ASLAK_R3, format("ASLAK: Right. That's the whole of it."))
    msgbox(format("ASLAK: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWetlandsHide_Aslak_R4 {
    lock
    faceplayer
    msgbox(format("ASLAK: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ASLAK: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_HID_ASLAK_R4, format("ASLAK: …Again, then. Later."))
    msgbox(format("ASLAK: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWetlandsHide_Aslak_R5 {
    lock
    faceplayer
    msgbox(format("ASLAK: Last one. I've put everything I've got into this team. Go?"), MSGBOX_YESNO)
