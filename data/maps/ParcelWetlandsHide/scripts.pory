script ParcelWetlandsHide_Warden {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WARDEN: DR. HERON's line is still on the wall. Somebody's written under it, in a steady hand: 'Counted. Written down.' I didn't see who. I've left it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WARDEN: The hide was DR. HERON's idea, twenty years back. Sit still long enough and the place tells you what it is.\pShe wrote that on the wall inside. It's still there. So are the counts, hers and everyone's since."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelWetlandsHide_Sign {
    msgbox(format("REEDMERE HIDE. Sit still. Count. Write it down."), MSGBOX_SIGN)
    end
}
script ParcelWetlandsHide_SignEast {
    msgbox(format("The backwater landing is east along the bank. Keep to the boards."), MSGBOX_SIGN)
    end
}
script ParcelWetlandsHide_ItemGreatBall { finditem(ITEM_GREAT_BALL) end }
script ParcelWetlandsHide_Leave {
    warp(MAP_PARCEL_WETLANDS, 3, 27)
    waitstate
    end
}
