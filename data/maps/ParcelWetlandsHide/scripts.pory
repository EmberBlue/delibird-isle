    faceplayer
    msgbox(format("TORVALD: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TORVALD: Suit yourself. I'm here."), MSGBOX_DEFAULT)
        release
