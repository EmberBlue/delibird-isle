script ParcelWetlandsHide_Asta {
    trainerbattle_single(TRAINER_SKALD_HID_ASTA,
        format("ASTA: Picnic on the one dry rise. You're standing on my cloth. Battle for the cloth."),
        format("ASTA: …Keep the cloth."),
        ParcelWetlandsHide_Asta_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_HID_ASTA_R2)) {
        goto(ParcelWetlandsHide_Asta_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_HID_ASTA_R3)) {
        goto(ParcelWetlandsHide_Asta_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_HID_ASTA_R4)) {
        goto(ParcelWetlandsHide_Asta_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_HID_ASTA_R5)) {
        goto(ParcelWetlandsHide_Asta_R5)
    }
    msgbox(format("ASTA: The rise is dry because they drained the far side. My picnic spot is somebody's lost marsh."), MSGBOX_DEFAULT)
    end
}
script ParcelWetlandsHide_Asta_FirstWin {
    msgbox(format("ASTA: The rise is dry because they drained the far side. My picnic spot is somebody's lost marsh."), MSGBOX_DEFAULT)
    release
    end
}
