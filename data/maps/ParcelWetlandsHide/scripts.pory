        goto(ParcelWetlandsHide_Torvald_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_HID_TORVALD_R5)) {
        goto(ParcelWetlandsHide_Torvald_R5)
    }
    msgbox(format("TORVALD: There used to be BARBOACH in the mud here. The mud's dry four months a year now. Written down, you say? Good."), MSGBOX_DEFAULT)
    end
}
script ParcelWetlandsHide_Torvald_FirstWin {
    msgbox(format("TORVALD: There used to be BARBOACH in the mud here. The mud's dry four months a year now. Written down, you say? Good."), MSGBOX_DEFAULT)
    release
    end
