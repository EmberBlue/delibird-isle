// ParcelFernwickHouse4 -- a house in Fernwick: residents in two story states (before / after the hearing).

mapscripts ParcelFernwickHouse4_MapScripts {
}

script ParcelFernwickHouse4_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The hearing asked for every page. I carried them to the coast myself. Eleven hundred, their clerk said. I'd counted twelve."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: The river report filled the second drawer on its own. I've asked for a cabinet.\pThe Survey's never asked for a cabinet. ILEX signed the form without reading it. ILEX reads everything."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: I file the field reports at the Survey office. Yours come in thicker than anyone's. I've started a second drawer."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse4_Boy {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BOY: Dad read your name in the paper and said 'wet on purpose'. He was smiling when he said it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("BOY: Dad says you went to the river and made the Board count out loud.\pI didn't know you could make grown-ups count. I'm going to try it on Dad."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BOY: Dad says the rangers are the ones who get wet on purpose."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickHouse4_ReadDresser {
    msgbox(format("A Survey office lanyard hung on the mirror, and a second-drawer key on a ribbon beside it. The ribbon is new."), MSGBOX_SIGN)
    end
}

script ParcelFernwickHouse4_ReadDrawer {
    msgbox(format("A boy's boots drying on newspaper. The newspaper is a river report. The boots are wet on purpose."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelFernwickHouse4_PaperRequisition {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A requisition form, carbon copy, pinned by the door. ONE (1) FILING CABINET, FOUR-DRAWER. APPROVED, in a different ink, dated the week after the sitting.\pUnder APPROVED, in her own hand: eleven hundred pages. One cabinet. They still don't know what they've got."), MSGBOX_SIGN)
    } else {
        msgbox(format("A requisition form, carbon copy, pinned by the door so it can be waved at people. ONE (1) FILING CABINET, FOUR-DRAWER, for the river report. DENIED: PENDING BUDGET REVIEW. Initialled at the Coast.\pShe has filed the denial in the drawer it was meant to relieve."), MSGBOX_SIGN)
    }
    end
}
