// ParcelWetlandsHouse1 -- a house in Wetlands: residents in two story states (before / after the hearing).

mapscripts ParcelWetlandsHouse1_MapScripts {
}

script ParcelWetlandsHouse1_Fisher {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FISHER: The works' permit has a new page. I read it at the office. The discharge has a number on it now. A number you can argue with."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("FISHER: I still fish upstream of it. But the dredge crew's stood down and the discharge has a number on it now, like the river's water has.\pNumbers don't clean a channel. They do make it harder to pretend it's clean."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FISHER: Landing's been sick since the discharge. I fish upstream of it now. Upstream of it is a long way."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsHouse1_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: A CORPS monitor sits on the bank with a jar. I bring him tea. He says the jar's getting clearer. I'll believe the children's feet before the jar."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("WOMAN: The children still swim off the landing. But the councilman's boat hasn't been out since the river meeting.\pFunny what children notice. They've stopped waving at the boat. Nobody told them to."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: The children aren't to swim off the landing. They do anyway. We did."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelWetlandsHouse1_ReadDresser {
    msgbox(format("A map of the backwater on the dresser with a line drawn across it: UPSTREAM OF IT. Everything below the line has been shaded in."), MSGBOX_SIGN)
    end
}

script ParcelWetlandsHouse1_ReadDrawer {
    msgbox(format("Children's swimming things in the drawer, damp. Nobody has told them to stop. Nobody has put the things away either."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelWetlandsHouse1_PaperCatchDiary {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("The fisher's catch diary. The downstream column has writing in it again: a date, the monitor's jar, and one fish, small, let go.\pUnder it, in capitals he does not usually use: FIRST SINCE. He has not written since what. Everyone on the landing knows since what."), MSGBOX_SIGN)
    } else {
        msgbox(format("The fisher's catch diary, two columns since the year the pipe went in: UPSTREAM and DOWNSTREAM. Upstream, fish. Downstream, the word SHEEN more often than any number.\pHe stopped writing the downstream column two winters ago. The column is still ruled. He keeps ruling it."), MSGBOX_SIGN)
    }
    end
}
