// ParcelCoastBreakwaterHut -- a house in CoastBreakwater: residents in two story states (before / after the hearing).

mapscripts ParcelCoastBreakwaterHut_MapScripts {
}

script ParcelCoastBreakwaterHut_Lifeguard {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("LIFEGUARD: Open, breakwater side, by the readings. Closed the far side, by the readings. Same sign, two arrows.\pIt's the truest sign on this coast, and I painted it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("LIFEGUARD: Closed 'pending review'. The review's running, so the sign stays, and so do I. It's good work, saying a true thing forty times a day."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("LIFEGUARD: Beach is closed to bathing. You're the first one today who already knew why.\pThe coast office sent a new sign. Same words, bigger letters. I'm paid to sit by the bigger letters now."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("LIFEGUARD: Beach is closed to bathing. I'm paid to sit here and say so. I say so about forty times a day. You're forty-one."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastBreakwaterHut_Woman {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("WOMAN: Twenty-one summers of ices. The mums read the readings every morning before they buy.\pI put the readings up myself now. Beside the prices."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("WOMAN: The TUBERS came back when the review posted the readings. Mums read the readings. Mums are the whole economy of a beach."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("WOMAN: Twenty summers of ices, and this is the first week a stranger's asked me what the beach was like before.\pI told him. He wrote it down. Not you -- a man with a crest. I don't know what he's going to do with my twenty summers."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("WOMAN: I sold ices here for twenty summers. Now I sell them to the lifeguard. He's my only customer and he's on a diet."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastBreakwaterHut_Tuber {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("TUBER: I swam to the first post and back. Properly. The lifeguard clapped.\pMum didn't watch. She read the readings, and then she watched."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("TUBER: The readings say it's fine on the breakwater side! Mum read them. I'm swimming. Properly. Watch."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("TUBER: I'm standing in the water. Still not swimming. A ranger wrote down that the water's sick and the lifeguard says that's why.\pI asked if standing counts. He said standing's fine. Standing's always fine. That's the problem, he said."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("TUBER: I'm not swimming. I'm standing in the water. That's different. The sign says BATHING."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelCoastBreakwaterHut_ReadCounter {
    msgbox(format("The ices counter. Twenty flavours on the board, three in the freezer. The lifeguard's diet is written on a card and pinned where he can see it from his chair."), MSGBOX_SIGN)
    end
}

script ParcelCoastBreakwaterHut_ReadRings {
    msgbox(format("A rack of life rings with the FOUNDATION crest. New. The old ones, cork and canvas, are in a heap behind, still good."), MSGBOX_SIGN)
    end
}

script ParcelCoastBreakwaterHut_ReadBench {
    msgbox(format("A bench facing the sea. Initials cut into it, and dates, twenty summers deep. The last date is six years old."), MSGBOX_SIGN)
    end
}
