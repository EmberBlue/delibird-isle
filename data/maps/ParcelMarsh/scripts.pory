// ParcelMarsh -- THE LAST CORRIDOR (§01/§06 zone 8, Chapter 7): the keystone
// freshwater marsh, the climax. Rebuilt 2026-11 on Route 119's north half
// (rows 36-71; General + Fortree): you arrive on the graded east road where
// HALE waits at the treeline and AUNE holds the last Mereholt gate; the river
// is the only way in (Surf); the pond under the stream mouth is where the
// Poliwag huddle and DR. HERON kneels, counting. The survey is the final
// credential; the Hollis choice is asked out loud. Flag logic unchanged.
//
// VAR_SKALDMERE_CH7_EVIDENCE bits (count 0..3, mask 0xF): 0 drying channel,
//   1 dead reeds, 2 the graded edge, 3 the Poliwag

const LOCALID_MARSH_HERON   = 1
const LOCALID_MARSH_POLIWAG = 2
const LOCALID_MARSH_HALE    = 5

mapscripts ParcelMarsh_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_SKALD_EPILOGUE, 6: ParcelMarsh_Epilogue
        VAR_TEMP_1, 0: ParcelMarsh_FirstEntry
    ]
}

script ParcelMarsh_FirstEntry {
    setvar(VAR_TEMP_1, 1)
    if (flag(FLAG_SKALDMERE_CORRIDOR_ARRIVAL)) {
        end
    }
    lockall
    bufferpartymonnick(0, 0)
    msgbox(format("HALE: This is as far as I go. The road stops here because they haven't needed it to go further. Yet.\pThe marsh is past the water. You'll have to swim it. Nobody's built a way in, which is the only reason it's still a marsh."), MSGBOX_DEFAULT)
    msgbox(format("HALE: There's a MEREHOLT director on the road. Don't ask me why. She'll want a word. Give her one.\pThen read the place. All of it. And whoever you find in there, {PLAYER}, you read them too. I'll be here."), MSGBOX_DEFAULT)
    msgbox(format("{STR_VAR_1} goes still, and looks at the water."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_CORRIDOR_ARRIVAL)
    releaseall
    end
}

// --- HALE at the treeline: before, and the coda after ------------------------------
script ParcelMarsh_Hale {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        if (!flag(FLAG_SKALD_MARSH_CHOICE_DONE)) {
            msgbox(format("HALE: Is it done?"), MSGBOX_DEFAULT)
            msgbox(format("{PLAYER}: …It's true."), MSGBOX_DEFAULT)
            msgbox(format("HALE: That's the only done there is.\pThey'll bury it, some of them. And some of them will read it. And a few of those will be standing where you're standing now, one day, with a notebook of their own.\pThat's the work. Not the winning. The witnessing, and the writing it down."), MSGBOX_DEFAULT)
            msgbox(format("HALE: Come on. Station's a long walk and I'm not as young as the road thinks I am.\pWhen you're ready, the coast office will want to see the author. Let them. You've earned watching their faces."), MSGBOX_DEFAULT)
            setflag(FLAG_SKALD_MARSH_CHOICE_DONE)
            release
            end
        }
        msgbox(format("HALE: The record exists. Honest, in your hand. It's the only kind that ever changed anything."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("HALE: I'll be here. Past the water it's yours."), MSGBOX_DEFAULT)
    release
    end
}

// --- the four tells ---------------------------------------------------------------------
script ParcelMarsh_DryChannel {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH7_EVIDENCE)
    setvar(VAR_0x8004, 0)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The drying channel. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("The channel that feeds the marsh from the north runs over cracked grey mud at its edges. It should run cold and full to the bank.\pThe marsh is losing its water from the top, a little less every season, from everything upstream that this whole journey has written down. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelMarsh_DeadReeds {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH7_EVIDENCE)
    setvar(VAR_0x8004, 1)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The dead reeds. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("A band of fine sedge gone straw-pale and brittle: the reeds that need their feet wet the year round. They're the first to feel a marsh begin to leave.\pThe small things first. The big things only confirm it. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelMarsh_Edge {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH7_EVIDENCE)
    setvar(VAR_0x8004, 2)
    specialvar(VAR_RESULT, SkaldmereCertTaskGet)
    if (var(VAR_RESULT) == 1) {
        msgbox(format("The graded edge. In the notebook."), MSGBOX_SIGN)
        release
        end
    }
    msgbox(format("On the east side the wild stops in a straight line. Graded ground, a survey flag, the start of a road to nothing yet.\pNobody has taken this marsh. Someone has simply begun to stand at its edge and wait. That's all it takes now. Written down."), MSGBOX_SIGN)
    special(SkaldmereCertTaskMark)
    release
    end
}
script ParcelMarsh_Poliwag {
    lock
    setvar(VAR_0x8005, VAR_SKALDMERE_CH7_EVIDENCE)
    setvar(VAR_0x8004, 3)
    special(SkaldmereCertTaskMark)
    msgbox(format("The POLIWAG press together where the stream still runs, fewer than the bank was worn for. They flinch, and hold their ground, because there's no ground left behind them to take."), MSGBOX_DEFAULT)
    msgbox(format("On the bridge, the first morning, you thought something was chasing them upstream. Nothing was. The water in front of them was running out. It has been running out their whole lives, and yours. Written down."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelMarsh_PoliwagWatch {
    lock
    msgbox(format("POLIWAG: …"), MSGBOX_DEFAULT)
    release
    end
}

// --- DR. HERON: the confession, the battle, the survey, the choice ---------------------
script ParcelMarsh_Heron {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("HERON: Forty-one this morning. Thirty-nine yesterday. Don't read anything into two. I never let you read anything into two."), MSGBOX_DEFAULT)
        release
        end
    }
    setvar(VAR_0x8005, VAR_SKALDMERE_CH7_EVIDENCE)
    setvar(VAR_0x8004, 15)
    specialvar(VAR_RESULT, SkaldmereCertTaskCount)
    if (var(VAR_RESULT) < 4) {
        if (flag(FLAG_SKALDMERE_HERON_MET)) {
            msgbox(format("HERON: Not yet. The drying channel. The dead reeds. The edge they've cut. And them, the frogs, last of all.\pRead the whole place. Then we'll talk about the part of it that's me."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("HERON: You found me. Of course you did. I taught you how to find the things that don't want finding."), MSGBOX_DEFAULT)
        msgbox(format("{PLAYER}: …DR. HERON."), MSGBOX_DEFAULT)
        msgbox(format("HERON: Don't. Not yet.\pYou came to read a place, not a person. So read the place first, all of it, the way I taught you. Then come back to me. I'm not going anywhere. I've seen to that."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALDMERE_HERON_MET)
        release
        end
    }
    msgbox(format("HERON: COLLAPSING. You don't have to say it; I can see you've already written it. The keystone's going. The web's thinning. The edge is leaning in.\pI should know how long they can hang on. I built half my name on the number."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: The recovery model on the coast. The curves. They're yours."), MSGBOX_DEFAULT)
    msgbox(format("HERON: They're mine.\pForty years ago. A marsh like this one, north of MAHOGANY. The POLIWAG were going under and the law would not lift a finger for a number that small. So I made the number bigger. I wrote down a recovery that hadn't happened yet."), MSGBOX_DEFAULT)
    msgbox(format("HERON: It worked. The preserve was protected. The frogs held on, barely, but they held. And for thirty years I told myself a lie with a good heart and good results was near enough to the truth."), MSGBOX_DEFAULT)
    msgbox(format("HERON: Then the concern read my beautiful lie and saw the shape of a key. If one marsh bounces back, they all do. If they all do, then nothing you take can't be given back later.\pMy little mercy became their permission. For everything."), MSGBOX_DEFAULT)
    msgbox(format("{PLAYER}: You could have said. Somewhere, sometime, you could have said…"), MSGBOX_DEFAULT)
    msgbox(format("HERON: Said what, to whom, on whose coin? The same hand that funds the lab holds the lie. The day I tell the truth, the work dies, the name dies, and the movement I gave my life to dies discredited by its own founder.\pThat's how it's done now, {PLAYER}. No villains in a tower. Just people you love, standing in the door, very sorry, not moving."), MSGBOX_DEFAULT)
    msgbox(format("HERON: You came to read me too. Then read me all the way. Patient, now. Wait for the thing to show itself. The way I taught you."), MSGBOX_DEFAULT)
    trainerbattle_no_intro(TRAINER_SKALD_HERON, format("HERON: …There. All of me, in the open. The good years and the bought ones both."))
    msgbox(format("HERON: I can't give you the rest. Some of it I can't say aloud even now. But it's in the notebook. The margins. You can read them at last. You couldn't, when I sent it ahead. That was the whole point of sending it ahead."), MSGBOX_DEFAULT)
    msgbox(format("HERON: I came here to do the one honest thing I had left. Count them. Truly, this time. Write down how many, and the day the last one goes.\pI'm not leaving this marsh. Don't spend your breath on it."), MSGBOX_DEFAULT)
    msgbox(format("HERON: So finish it. Take the record, mine, and ILEX's long cloth, and yours, and put it somewhere it can't be unsaid.\pIt will cost you. It will cost the MAHOGANY frogs the protection my lie bought them. It will cost me the last of the name. HOLLIS will have told you the price. HOLLIS is never wrong about a price."), MSGBOX_DEFAULT)
    msgbox(format("HERON: Honesty isn't free. Pay for it anyway, and keep the receipt.\pWell? Will you file it true?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("HERON: Then sit with it until you can. I'm not going anywhere. Neither, for a while yet, are they."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("{PLAYER}: It's true. That's all it has to be."), MSGBOX_DEFAULT)
    closemessage
    delay(30)
    bufferpartymonnick(0, 0)
    msgbox(format("The last survey. The woman who taught you the verb watches you do it, and {STR_VAR_1} stays quiet at your shoulder.\pThe failing keystone. The thinning web. The edge leaning in. Read the way six broken places taught you to read, and written down true."), MSGBOX_DEFAULT)
    specialvar(VAR_RESULT, SkaldmereClassifyCorridor)
    msgbox(format("No certification this time. No red cloth from anyone's hand. The last strip ties to your own pack, and nobody signs it.\pThe notebook was your teacher's eye. The first words in your own hand go under hers. They're not the same hand. That's the point."), MSGBOX_DEFAULT)
    msgbox(format("HERON: Go on. HALE's at the road. He'll pretend he wasn't worried. Let him."), MSGBOX_DEFAULT)
    closemessage
    playse(SE_PIN)
    msgbox(format("In the last of the running water a single POLIWAG slips upstream in a tight, tired line. The way they did at the bridge, the first morning, before you had the word for it.\pYou have the word now."), MSGBOX_DEFAULT)
    setflag(FLAG_SKALDMERE_FINALE_DONE)
    release
    end
}

// --- items, leaving, the gate ---------------------------------------------------------------
script ParcelMarsh_Item { finditem(ITEM_MAX_REVIVE) end }
script ParcelMarsh_ItemFullRestore { finditem(ITEM_FULL_RESTORE) end }

script ParcelMarsh_Leave {
    lockall
    msgbox(format("The road east leads back out of the wilderness to FERNWICK, and whatever the record does next."), MSGBOX_DEFAULT)
    closemessage
    warp(MAP_PARCEL_FERNWICK, 11, 16)
    waitstate
    end
}

script ParcelMarsh_GateAune {
    trainerbattle_single(TRAINER_SKALD_GATE_MARSH,
        format("AUNE: Director, MEREHOLT. I came out to the end of the road to see what's worth the paperwork.\pNothing past me is cleared until I clear it. Show me why you should reach the water at all."),
        format("AUNE: …Sufficient. The last gate logs you. Go and read what's left to read."),
        ParcelMarsh_GateAune_Defeated)
    lock
    faceplayer
    msgbox(format("AUNE: You're entered. The final clearance, against your card.\pWhat you find past here is no longer the regime's to grant or deny. It was only ever yours to record."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelMarsh_GateAune_Defeated {
    setflag(FLAG_SKALDMERE_GATE_MARSH)
    msgbox(format("AUNE: Marsh clearance, granted. The last one MEREHOLT has to give.\pEverything that matters now is downstream of this, and out of our hands. Funny, that."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelMarsh_SecA {
    trainerbattle_single(TRAINER_SKALD_MARSH_SEC_A,
        format("VIG: Road's closed. Director's orders. You can argue with me or with her. Me first."),
        format("VIG: …Her, then."))
    msgbox(format("VIG: We graded fifty metres of road to nowhere and posted two guards on it. Ask me what we're guarding. Go on. I don't know either."), MSGBOX_DEFAULT)
    end
}
script ParcelMarsh_SecB {
    trainerbattle_single(TRAINER_SKALD_MARSH_SEC_B,
        format("TOVA: Survey flag's ours. Everything past the flag is 'pending'. You're pending. Battle."),
        format("TOVA: Pending, still."))
    msgbox(format("TOVA: There's an old woman in there. Past the water. The director knows. The director's not in a hurry. That's the strange part."), MSGBOX_DEFAULT)
    end
}

// --- the epilogue, stop 6 of 8: her spot on the bank. HERON's object is hidden by
// FLAG_SKALDMERE_EPILOGUE_DONE from the stairs on; the count stays, as a sign. ---
script ParcelMarsh_Epilogue {
    lockall
    delay(20)
    msgbox(format("The marsh. The count in the notebook runs to the last day in her hand, steady to the end. Forty-one. Forty-one. Thirty-nine. Forty.\pNo entry after it. A strip of red cloth on the reeds, and nobody to sign it.\pThe POLIWAG hold where the stream still runs. The corridor listing went through on the day she stopped writing."), MSGBOX_DEFAULT)
    closemessage
    setvar(VAR_SKALD_EPILOGUE, 7)
    warp(MAP_PARCEL_COAST, 30, 53)
    waitstate
    end
}
script ParcelMarsh_HeronCount {
    if (!flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        end
    }
    msgbox(format("The notebook she kept here, open to the last page. A count, steady to the end: forty-one, forty-one, thirty-nine, forty.\pNo entry after it."), MSGBOX_SIGN)
    end
}
