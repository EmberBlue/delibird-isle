mapscripts ParcelFernwickMart_MapScripts {
}

script ParcelFernwickMart_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(ParcelFernwickMart_Items)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release
    end
}

raw `
	.align 2
ParcelFernwickMart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_POTION
	.2byte ITEM_SUPER_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_REPEL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_NONE
`

script ParcelFernwickMart_Customer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("YOUNGSTER: REPELS are still on sale. The marsh still has a lot of WOOPER. Some things the hearing didn't fix. The WOOPER are fine about it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("YOUNGSTER: REPELS are off sale. The marsh has fewer WOOPER than it did.\pThat's good, right? The clerk says it's good. He said it like a question."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("YOUNGSTER: REPELS are on sale. The marsh has a lot of WOOPER.\pA LOT."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickMart_ReadShelf {
    msgbox(format("Top shelf: REPELS, by the crate. A handwritten sign: FOR THE MARSH. NO REFUNDS ON WOOPER."), MSGBOX_SIGN)
    end
}

script ParcelFernwickMart_ReadKit {
    msgbox(format("The middle shelf is Corps field kit: vials, labels, a flow gauge with a cracked face marked AS SEEN."), MSGBOX_SIGN)
    end
}
