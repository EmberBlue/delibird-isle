mapscripts ParcelFernwickMart_MapScripts {
}

script ParcelFernwickMart_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(ParcelFernwickMart_Items)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    release
    end
}

raw `
	.align 2
ParcelFernwickMart_Items::
	.2byte ITEM_POKE_BALL
	.2byte ITEM_GREAT_BALL
	.2byte ITEM_POTION
	.2byte ITEM_SUPER_POTION
	.2byte ITEM_ANTIDOTE
	.2byte ITEM_PARALYZE_HEAL
	.2byte ITEM_AWAKENING
	.2byte ITEM_REPEL
	.2byte ITEM_ESCAPE_ROPE
	.2byte ITEM_NONE
`

script ParcelFernwickMart_Customer {
    lock
    faceplayer
    msgbox(format("YOUNGSTER: REPELS are on sale. The marsh has a lot of WOOPER.\pA LOT."), MSGBOX_DEFAULT)
    release
    end
}
