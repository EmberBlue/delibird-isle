// ParcelHighlandsTarn -- the tarn under Haukfell (Shoal Cave's entrance room): the cold water the
// bore drilled into and called groundwater. Eight trainers at 30-33, a cadet learning the cold,
// the mouth on the Highlands at (24,37) west of the bore door.

mapscripts ParcelHighlandsTarn_MapScripts {
}

script ParcelHighlandsTarn_Arnfinn {
    trainerbattle_single(TRAINER_SKALD_TRN_ARNFINN,
        format("ARNFINN: The tarn's under the hill. Cold enough to stop a clock. You'll want to be warm for this. Battle."),
        format("ARNFINN: …Warm enough."),
        ParcelHighlandsTarn_Arnfinn_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_TRN_ARNFINN_R2)) {
        goto(ParcelHighlandsTarn_Arnfinn_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_TRN_ARNFINN_R3)) {
        goto(ParcelHighlandsTarn_Arnfinn_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_TRN_ARNFINN_R4)) {
        goto(ParcelHighlandsTarn_Arnfinn_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_TRN_ARNFINN_R5)) {
        goto(ParcelHighlandsTarn_Arnfinn_R5)
    }
    msgbox(format("ARNFINN: VALE sends the cadets up here to learn cold. Most learn it in an hour and go down."), MSGBOX_DEFAULT)
    end
}
script ParcelHighlandsTarn_Arnfinn_FirstWin {
    msgbox(format("ARNFINN: VALE sends the cadets up here to learn cold. Most learn it in an hour and go down."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsTarn_Arnfinn_R2 {
    lock
    faceplayer
    msgbox(format("ARNFINN: Didn't think you'd come back through. Good. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ARNFINN: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_TRN_ARNFINN_R2, format("ARNFINN: Still yours."))
    msgbox(format("ARNFINN: Come back with more clearances. I'll have more for you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsTarn_Arnfinn_R3 {
    lock
    faceplayer
    msgbox(format("ARNFINN: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ARNFINN: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_TRN_ARNFINN_R3, format("ARNFINN: That's the one I wanted to see."))
    msgbox(format("ARNFINN: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsTarn_Arnfinn_R4 {
    lock
    faceplayer
    msgbox(format("ARNFINN: Full strength, no excuses, mine or yours. Rematch?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ARNFINN: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_TRN_ARNFINN_R4, format("ARNFINN: …Again, then. Later."))
    msgbox(format("ARNFINN: Four. There's one more, after. Whatever after is."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsTarn_Arnfinn_R5 {
    lock
    faceplayer
    msgbox(format("ARNFINN: The region's different now. Let's see if you are?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("ARNFINN: No hurry. The water keeps."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_TRN_ARNFINN_R5, format("ARNFINN: Right. That's the whole of it."))
    msgbox(format("ARNFINN: That's all I've got. It was enough to see it done."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelHighlandsTarn_Halvard {
    trainerbattle_single(TRAINER_SKALD_TRN_HALVARD,
        format("HALVARD: Ice scour on the walls, head height. The tarn was higher once. Much. Fight."),
        format("HALVARD: …Scoured."),
        ParcelHighlandsTarn_Halvard_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_TRN_HALVARD_R2)) {
        goto(ParcelHighlandsTarn_Halvard_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_TRN_HALVARD_R3)) {
        goto(ParcelHighlandsTarn_Halvard_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_TRN_HALVARD_R4)) {
