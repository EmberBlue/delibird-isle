    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_TRN_HALVARD_R5)) {
        goto(ParcelHighlandsTarn_Halvard_R5)
    }
    msgbox(format("HALVARD: Everything in this region was higher, colder or wetter once. The hard part is which ones are coming back."), MSGBOX_DEFAULT)
    end
}
