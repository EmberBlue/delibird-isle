script ParcelHighlandsTarn_Randi {
    trainerbattle_single(TRAINER_SKALD_TRN_RANDI,
        format("RANDI: I sketch the ice lines. They're a calendar nobody wrote. Battle, quickly, my fingers are going."),
        format("RANDI: …Fingers held."),
        ParcelHighlandsTarn_Randi_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_TRN_RANDI_R2)) {
        goto(ParcelHighlandsTarn_Randi_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_TRN_RANDI_R3)) {
        goto(ParcelHighlandsTarn_Randi_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_TRN_RANDI_R4)) {
        goto(ParcelHighlandsTarn_Randi_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_TRN_RANDI_R5)) {
        goto(ParcelHighlandsTarn_Randi_R5)
    }
    msgbox(format("RANDI: Fourteen lines, fourteen high years. Then nothing for thirty. The nothing is the part that matters."), MSGBOX_DEFAULT)
    end
}
script ParcelHighlandsTarn_Randi_FirstWin {
