mapscripts ParcelFernwickFlats_MapScripts {
}

script ParcelFernwickFlats_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("MAN: Six rangers, one bathroom, and nobody reads the transcript any more. It's on the shelf. We did that; now we do the next thing.\pThat's the job HALE never explained and didn't need to."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Corps housing. Six rangers, one bathroom, and a transcript on the kitchen table that everyone's read twice. We reduce harm. We still don't reduce queues."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("MAN: Two of us got sent to the basin for the relief line and came back not talking. Not sulking. Thinking.\pSix rangers, one bathroom, and now a queue for the kettle as well."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Corps housing. Six rangers, one bathroom.\pWe reduce harm. We do not reduce queues."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickFlats_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_EPILOGUE_DONE)) {
        msgbox(format("GIRL: Daddy laughs at work sometimes now. Not a lot. He says the job's got laughing in it if you do it long enough.\pHe said it quietly."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Daddy came home from the hearing and said 'we reduced some harm'. Then he laughed. I didn't know the job had laughing in it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("GIRL: Daddy came back from the river smelling like a meeting. That's a smell. Coffee and paper.\pHe said six people stood up. I asked if he did. He said he was holding the door. That counts."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: Daddy's a RANGER. He says he doesn't win, he reduces harm.\pI told him that's a weird job."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickFlats_ReadFridge {
    msgbox(format("Six names on the fridge, six shelves, one note: WHOEVER TOOK THE BASIN LOT'S SUGAR, THE COOK KNOWS."), MSGBOX_SIGN)
    end
}

script ParcelFernwickFlats_ReadBunk {
    msgbox(format("Six bunks, one bathroom. Each bunk has a boot print on the wall at the same height, where a ranger lies down without taking the boots off first."), MSGBOX_SIGN)
    end
}

// --- household papers (2026-11-10) ---

script ParcelFernwickFlats_PaperRentCard {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("A rent card for the flat, stamped weekly. The two FOUNDATION stamps have been struck through and CORPS written over them, and a note: housing budget restored, Director's office.\pThe man says he never understood the stamps and understands the correction less. He has kept the card anyway. Everything in this town keeps its paper now."), MSGBOX_SIGN)
    } else {
        msgbox(format("A rent card for the flat, stamped weekly. The landlord is the Corps' housing office; the flats were built for provisionals and their families and the stamps are small and reliable.\pTwo weeks are stamped FOUNDATION instead of CORPS. Nobody in the flat knows what that means. Nobody has asked."), MSGBOX_SIGN)
    }
    end
}
