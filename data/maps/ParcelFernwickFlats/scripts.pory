mapscripts ParcelFernwickFlats_MapScripts {
}

script ParcelFernwickFlats_Man {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("MAN: Corps housing. Six rangers, one bathroom, and a transcript on the kitchen table that everyone's read twice. We reduce harm. We still don't reduce queues."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("MAN: Corps housing. Six rangers, one bathroom.\pWe reduce harm. We do not reduce queues."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickFlats_Girl {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("GIRL: Daddy came home from the hearing and said 'we reduced some harm'. Then he laughed. I didn't know the job had laughing in it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("GIRL: Daddy's a RANGER. He says he doesn't win, he reduces harm.\pI told him that's a weird job."), MSGBOX_DEFAULT)
    release
    end
}
