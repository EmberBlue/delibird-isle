// ParcelFernwickSurvey -- the Skaldmere Survey district office. Ilex. The
// Floodbasin classification (Chapter 2) is filed here, as it was at the old
// station; same var bits, plain voice.

mapscripts ParcelFernwickSurvey_MapScripts {
}

script ParcelFernwickSurvey_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_CRATE) && !flag(FLAG_SKALD_Q_CRATE_DONE)) {
        if (flag(FLAG_SKALD_Q_CRATE_FOUND)) {
            msgbox(format("CLERK: There it is. Forty years of basement, one word, one boot print. I'll keep the boot print."), MSGBOX_DEFAULT)
            msgbox(format("CLERK: Take this. Survey issue, from the drawer nobody opens. It steadied forty years of surveyors. It can steady one more."), MSGBOX_DEFAULT)
            giveitem(ITEM_FOCUS_BAND)
            setflag(FLAG_SKALD_Q_CRATE_DONE)
            msgbox(format("CLERK: Chain of custody. That's the whole trick, you know. Not finding a thing. Being able to say where it's been."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("CLERK: The river hall floor. A label the size of your hand. EVIDENCE, in my writing. You'll know my writing; it's the only neat one."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Forty years of soil cores in the basement, and the hearing wanted the cores from the marsh. I carried them up myself. They're heavier than paper. They were read anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_CRATE_DONE)) {
        msgbox(format("CLERK: The soil cores came back from the river. Forty years of them, in the crate marked EVIDENCE. The crate came back. The label didn't.\pI need that label. Chain of custody. Without it the cores are just mud in boxes, which is what they always were, but now it matters.\pIt'll be on the floor of the river hall where they stacked the crates. Nobody there reads floors."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_CRATE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("CLERK: The soil cores went to the river. On a truck. Forty years in the basement and they rode to a meeting in a crate marked EVIDENCE.\pI labelled the crate myself. I've never labelled anything evidence. I liked it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Forty years of soil cores in the basement. Nobody ever asked to see them.\pNobody, until this month."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickSurvey_Ilex {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("ILEX: It's filed. It's read. HALE signed it in front of me, and he didn't smile, and his hand was steady. That's the version I'll remember."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
        setvar(VAR_0x8004, 6)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("ILEX: It's filed. The paper's HALE's to sign. Don't expect him to smile about it."), MSGBOX_DEFAULT)
            release
            end
        }
        setvar(VAR_0x8004, 63)
        specialvar(VAR_RESULT, SkaldmereCertTaskCount)
        if (var(VAR_RESULT) == 6) {
            msgbox(format("ILEX: The pipe, the sheen, the dead reeds. The WOOPER. The MAGIKARP. The booth.\pPut a name on it."), MSGBOX_DEFAULT)
            specialvar(VAR_RESULT, SkaldmereClassifyFloodbasin)
            msgbox(format("ILEX: COLLAPSING. The keystone's straining, the apex is sick, the middle swarms.\pThat's what 'we're remediating that' looks like in real life."), MSGBOX_DEFAULT)
            setvar(VAR_0x8004, 6)
            special(SkaldmereCertTaskMark)
            msgbox(format("ILEX: I'll have your report typed by morning. Go tell HALE you're done. The certification's his to give."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("ILEX: Damage wears the mask of improvement. You'll see it everywhere now.\pSorry. Nobody warned me either."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("ILEX: Skaldmere Survey. We measure things over time and write the numbers down.\pIt's less exciting than it sounds, and it sounds boring."), MSGBOX_DEFAULT)
    msgbox(format("ILEX: Get certified first. Then come back and I'll show you how to read a place properly.\pReading is the whole job. The battles are just how you get there."), MSGBOX_DEFAULT)
    release
    end
}
