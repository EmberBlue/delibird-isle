// ParcelFernwickSurvey -- the Skaldmere Survey district office. Ilex. The
// Floodbasin classification (Chapter 2) is filed here, as it was at the old
// station; same var bits, plain voice.

mapscripts ParcelFernwickSurvey_MapScripts {
}

script ParcelFernwickSurvey_Clerk {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_CRATE) && !flag(FLAG_SKALD_Q_CRATE_DONE)) {
        if (flag(FLAG_SKALD_Q_CRATE_FOUND)) {
            msgbox(format("CLERK: There it is. Forty years of basement, one word, one boot print. I'll keep the boot print."), MSGBOX_DEFAULT)
            msgbox(format("CLERK: Take this. Survey issue, from the drawer nobody opens. It steadied forty years of surveyors. It can steady one more."), MSGBOX_DEFAULT)
            giveitem(ITEM_FOCUS_BAND)
            setflag(FLAG_SKALD_Q_CRATE_DONE)
            msgbox(format("CLERK: Chain of custody. That's the whole trick, you know. Not finding a thing. Being able to say where it's been."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("CLERK: The river hall floor. A label the size of your hand. EVIDENCE, in my writing. You'll know my writing; it's the only neat one."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CLERK: Forty years of soil cores in the basement, and the hearing wanted the cores from the marsh. I carried them up myself. They're heavier than paper. They were read anyway."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_CRATE_DONE)) {
        msgbox(format("CLERK: The soil cores came back from the river. Forty years of them, in the crate marked EVIDENCE. The crate came back. The label didn't.\pI need that label. Chain of custody. Without it the cores are just mud in boxes, which is what they always were, but now it matters.\pIt'll be on the floor of the river hall where they stacked the crates. Nobody there reads floors."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_CRATE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("CLERK: The soil cores went to the river. On a truck. Forty years in the basement and they rode to a meeting in a crate marked EVIDENCE.\pI labelled the crate myself. I've never labelled anything evidence. I liked it."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("CLERK: Forty years of soil cores in the basement. Nobody ever asked to see them.\pNobody, until this month."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickSurvey_Ilex {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        if (flag(FLAG_SKALD_SECOND_DONE)) {
            msgbox(format("ILEX: Seven second readings in the register, under the seven first ones. The column had never been used. It has a date in it now, in your hand.\pTie the cloth to something that needs reading. That's the whole of the job, and you've done it twice."), MSGBOX_DEFAULT)
        } elif (flag(FLAG_SKALD_SECOND)) {
            if (flag(FLAG_SKALD_SECOND_0) && flag(FLAG_SKALD_SECOND_1) && flag(FLAG_SKALD_SECOND_2) && flag(FLAG_SKALD_SECOND_3) && flag(FLAG_SKALD_SECOND_4) && flag(FLAG_SKALD_SECOND_5) && flag(FLAG_SKALD_SECOND_6)) {
                msgbox(format("ILEX: Seven, after. Reedmere up four and no trend. Hollowbend: two frogs. Leirvik: grey. Elvsund: two boards. Haukfell: SHIFTED, dated both sides. The quay: a padlock. The marsh: forty-two, in your hand.\pNobody has ever walked the whole set twice. The register has a column for it that has never been used."), MSGBOX_DEFAULT)
                msgbox(format("ILEX: Here. The Survey's cloth. I've a drawer of it and nobody to give it to.\pTie it to something that needs reading. That's the whole of the job, and you've done it twice."), MSGBOX_DEFAULT)
                giveitem(ITEM_RED_SCARF, 1)
                setflag(FLAG_SKALD_SECOND_DONE)
            } else {
                msgbox(format("ILEX: Not all seven yet. Read them after, the way you read them before. The after is the part nobody funds.\pReedmere, Hollowbend, Leirvik, Elvsund, Haukfell, the quay, the marsh. The stakes are where they were. That's rather the point of stakes."), MSGBOX_DEFAULT)
            }
        } else {
            msgbox(format("ILEX: It's filed. It's read. HALE signed it in front of me, and he didn't smile, and his hand was steady. That's the version I'll remember."), MSGBOX_DEFAULT)
            msgbox(format("ILEX: One more thing, if you've the boots for it. The seven stakes. Go back and read them again, after.\pA first reading is a claim. A second is a record. Nobody has ever given me the second set. Tell me what changed."), MSGBOX_DEFAULT)
            setflag(FLAG_SKALD_SECOND)
        }
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        setvar(VAR_0x8005, VAR_SKALDMERE_CH2_EVIDENCE)
        setvar(VAR_0x8004, 6)
        specialvar(VAR_RESULT, SkaldmereCertTaskGet)
        if (var(VAR_RESULT) == 1) {
            msgbox(format("ILEX: It's filed. The paper's HALE's to sign. Don't expect him to smile about it."), MSGBOX_DEFAULT)
            release
            end
        }
        setvar(VAR_0x8004, 63)
        specialvar(VAR_RESULT, SkaldmereCertTaskCount)
        if (var(VAR_RESULT) == 6) {
            msgbox(format("ILEX: The pipe, the sheen, the dead reeds. The WOOPER. The MAGIKARP. The booth.\pPut a name on it."), MSGBOX_DEFAULT)
            specialvar(VAR_RESULT, SkaldmereClassifyFloodbasin)
            msgbox(format("ILEX: COLLAPSING. The keystone's straining, the apex is sick, the middle swarms.\pThat's what 'we're remediating that' looks like in real life."), MSGBOX_DEFAULT)
            setvar(VAR_0x8004, 6)
            special(SkaldmereCertTaskMark)
            msgbox(format("ILEX: I'll have your report typed by morning. Go tell HALE you're done. The certification's his to give."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("ILEX: Damage wears the mask of improvement. You'll see it everywhere now.\pSorry. Nobody warned me either."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("ILEX: Skaldmere Survey. We measure things over time and write the numbers down.\pIt's less exciting than it sounds, and it sounds boring."), MSGBOX_DEFAULT)
    msgbox(format("ILEX: Get certified first. Then come back and I'll show you how to read a place properly.\pReading is the whole job. The battles are just how you get there."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelFernwickSurvey_ReadBoard {
    msgbox(format("The blackboard, in a surveyor's chalk: READ THE PLACE. THEN READ IT AGAIN. THEN WRITE WHAT IS THERE.\pUnder it, smaller, someone has added: NOT WHAT YOU HOPED."), MSGBOX_SIGN)
    end
}

script ParcelFernwickSurvey_ReadDesk {
    msgbox(format("An open field guide on a pupil's desk, forty years old. The marsh-plant pages have been read until they're soft.\pOne plant is ringed, with a date beside it, and a place you know the name of."), MSGBOX_SIGN)
    end
}

// --- papers (2026-11-10): the documents on the desks ---

script ParcelFernwickSurvey_Letters {
    msgbox(format("A box file: CORRESPONDENCE, H. Three letters in the hand from your notebook's margins, years apart, each to the Survey.\pThe first. Dear Ilex. I need your baselines for the lower river. Mine start when I arrived and yours start before anyone was counting. Say what the Survey charges and I will find it.\pThe second. Dear Ilex. The Foundation has asked for my models in a form the company can use. I have asked what the company plans. They sent a brochure. Send me the red-cloth dates for the Floodbasin, please. I want to know how long it was healthy before it was not.\pThe third, short. Ilex. If anyone ever asks you for my baselines, give them yours instead. Yours were never adjusted. H.\pUnderneath, in the Surveyor's hand on the file's lid: ANSWERED. ANSWERED. NOT ANSWERED. WHO WOULD I HAVE SENT IT TO."), MSGBOX_SIGN)
}

script ParcelFernwickSurvey_Index {
    msgbox(format("The sheet index. Every place the Survey has ever staked, one line each, with the year of the first stake and the year of the last reading.\pSaltwick Shoals, the old oyster ground. First stake, last reading, then the word GONE and a date.\pReedmere Landing, the turf. Still read. The Hollowbend culvert, the pool below. Still read. Leirvik bridge reach. Still read, with a note: the state changed. Do not reset.\pFive lines carry GONE. A sixth has been written and then rubbed at with a thumb until the paper roughened. Under it, faint: NOT YET.\pNo line has ever been removed from the index. Ilex does not throw things away. That is the whole method."), MSGBOX_SIGN)
}
