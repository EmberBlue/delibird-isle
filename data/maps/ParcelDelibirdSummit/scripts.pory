// ParcelDelibirdSummit -- the Snowy Summit (§09 / §13 fix A). Three terraces
// above the Holiday Village: the drunken forest and its slump pond, the snow
// stakes, the summit tarn. The name is the point: there is almost no snow. The
// thaw is read here the way the culvert was read in §08 -- in the ground, in
// the stakes, in what people say when they think they are talking about
// something else. Ingrid, at the top, carries one of Marta's three parcels.
// Trainers are 28-32 (zone 6); their rematch tiers come from rematch_tiers.py.

const LOCALID_SUM_INGRID = 1
const LOCALID_SUM_KARI   = 2

mapscripts ParcelDelibirdSummit_MapScripts {
}

// --- Ingrid, the watcher: the summit parcel ------------------------------------
script ParcelDelibirdSummit_Ingrid {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("INGRID: You said it to their faces. ILEX read me the part about the stakes. My stakes, in a hearing, in the capital.\pThe paint is still three winters bare. But it is on the record now, and the record outlasts paint."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALD_DEL_INGRID_DONE)) {
        msgbox(format("INGRID: The lamp's lit. Tell MARTA it's lit. She'll know what I mean by it."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_DELIBIRD_PARCEL)) {
        msgbox(format("An old woman in a canvas coat repaints a date on a wooden stake. She does not look up until the brush is clean.\pINGRID: From MARTA. Lamp oil, and the good tea, and a note I'm not to read till dark. Set it down by the hut."), MSGBOX_DEFAULT)
        msgbox(format("INGRID: Sixty years the stakes were painted to the snowline on Midwinter morning. I paint the date now, and the line stays where it was.\pThe line is the only thing on this island that isn't moving."), MSGBOX_DEFAULT)
        msgbox(format("INGRID: Take this. It fell out of the sky, near enough -- a bird dropped it by the stakes and looked at me as if I'd asked."), MSGBOX_DEFAULT)
        giveitem(ITEM_RARE_CANDY)
        setflag(FLAG_SKALD_DEL_INGRID_DONE)
        msgbox(format("INGRID: Go down careful. The stairs are new and the ground under them isn't."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("INGRID: Watcher. Not warden, not keeper. I watch. The stakes are what I watch.\pThe top stake is where the snow should start. It never did, this year. Nor last. MARTA sends oil up when she can spare it. The lamp is company, nights."), MSGBOX_DEFAULT)
    release
    end
}

// --- Kari, by the pond that was her sledge run ---------------------------------
script ParcelDelibirdSummit_Kari {
    lock
    faceplayer
    if (flag(FLAG_SKALD_Q_SLEDGE) && !flag(FLAG_SKALD_Q_SLEDGE_DONE)) {
        if (flag(FLAG_SKALD_Q_SLEDGE_FOUND)) {
            msgbox(format("KARI: You got it! It's got moss on it. It didn't have moss.\pThere's nowhere to use it. Gran says there will be, up the top, if the snow comes back. Gran says 'if' now. She used to say 'when'."), MSGBOX_DEFAULT)
            msgbox(format("KARI: Here. Gran gave me this for being brave about the pond. I wasn't brave. I was just here. You should have it; you climbed."), MSGBOX_DEFAULT)
            giveitem(ITEM_SHELL_BELL)
            setflag(FLAG_SKALD_Q_SLEDGE_DONE)
            msgbox(format("KARI: I'm going to keep the sledge inside. Dad says that's silly. I say the tree was silly."), MSGBOX_DEFAULT)
            release
            end
        }
        msgbox(format("KARI: The tree by the pond. The fork. You can see the runner sticking out."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("KARI: They put a rope round my pond. Dad says it's for the little ones.\pI'm little. I think it's for everybody."), MSGBOX_DEFAULT)
        release
        end
    }
    if (!flag(FLAG_SKALD_Q_SLEDGE_DONE)) {
        msgbox(format("KARI: My sledge is up in the tree. Dad put it there, out of the wet, when the pond came. He says it's safe there. I can see it from here.\pIt's not safe. It's just high.\pCan you get it down? You're tall. I'm not allowed to climb since the ground went soft."), MSGBOX_DEFAULT)
        setflag(FLAG_SKALD_Q_SLEDGE)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("KARI: Gran says the sea by the coast is sick and the ranger wrote it in a book. Is my pond in the book?\pI want it in the book. Not because it's sick. Because it was my sledge run first."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("KARI: The pond wasn't here last Midwinter. My sledge run went right where the middle is.\pGran says keep off it. There's nothing to keep off.\pThe trees are leaning. Dad says they're sad. I think they're just leaning."), MSGBOX_DEFAULT)
    release
    end
}

// --- environmental storytelling: the thaw, read like a culvert ------------------
script ParcelDelibirdSummit_PeakSign {
    msgbox(format("From the peak you can see the whole crescent of the island at once -- and the meltwater pooling in the high hollows where the snowpack should still be holding.\pThis is the cold the festival is named for. There is less of it than there was last Midwinter. There will be less next.\pIt is the most beautiful view in Skaldmere. You write down why it won't last."), MSGBOX_SIGN)
    end
}

script ParcelDelibirdSummit_StakesSign {
    msgbox(format("SNOW STAKES\pPainted to the snowline every Midwinter morning for sixty years. The lowest stake has been bare three winters. The one above it, two.\pSomeone has painted this year's date on the top stake and left the line where it was."), MSGBOX_SIGN)
    end
}

script ParcelDelibirdSummit_PondSign {
    msgbox(format("The ground here has let go. A pond nobody dug. Trees leaning away from each other like people who have stopped speaking.\pA child's sledge has been wedged up in the fork of the nearest tree, out of the wet, as if someone expected to need it again."), MSGBOX_SIGN)
    end
}

// --- items -------------------------------------------------------------------
script ParcelDelibirdSummit_ItemMaxRevive {
    finditem(ITEM_MAX_REVIVE)
    end
}
script ParcelDelibirdSummit_ItemHyperPotion {
    finditem(ITEM_HYPER_POTION)
    end
}
script ParcelDelibirdSummit_ItemRareCandy {
    finditem(ITEM_RARE_CANDY)
    end
}

// --- trainers (28-32) ---------------------------------------------------------
script ParcelDelibirdSummit_T_Ragnar {
    trainerbattle_single(TRAINER_SKALD_SUM_RAGNAR,
        format("RAGNAR: Twenty years I've climbed this on Midwinter morning. Used to be on skis. Now it's boots, and mud to the ankle.\pBattle me before the mud gets you too."),
        format("RAGNAR: Good footing."),
        ParcelDelibirdSummit_T_Ragnar_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUM_RAGNAR_R2)) {
        goto(ParcelDelibirdSummit_T_Ragnar_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUM_RAGNAR_R3)) {
        goto(ParcelDelibirdSummit_T_Ragnar_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUM_RAGNAR_R4)) {
        goto(ParcelDelibirdSummit_T_Ragnar_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUM_RAGNAR_R5)) {
        goto(ParcelDelibirdSummit_T_Ragnar_R5)
    }
    msgbox(format("RAGNAR: The stairs are cut where the old snow slope was. We didn't need stairs when there was snow."), MSGBOX_DEFAULT)
    end
}
script ParcelDelibirdSummit_T_Ragnar_FirstWin {
    msgbox(format("RAGNAR: The stairs are cut where the old snow slope was. We didn't need stairs when there was snow."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Ragnar_R2 {
    lock
    faceplayer
    msgbox(format("RAGNAR: Clearances or not, I want that one back. Go?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("RAGNAR: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_RAGNAR_R2, format("RAGNAR: Noted. Properly, this time."))
    msgbox(format("RAGNAR: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Ragnar_R3 {
    lock
    faceplayer
    msgbox(format("RAGNAR: They say you don't lose any more. Let's check?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("RAGNAR: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_RAGNAR_R3, format("RAGNAR: That's the one I wanted to see."))
    msgbox(format("RAGNAR: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Ragnar_R4 {
    lock
    faceplayer
    msgbox(format("RAGNAR: Seven stamps. I've one more fight in me that's worth the name. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("RAGNAR: Later, then. I'm not going anywhere."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_RAGNAR_R4, format("RAGNAR: That's the one I wanted to see."))
    msgbox(format("RAGNAR: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
