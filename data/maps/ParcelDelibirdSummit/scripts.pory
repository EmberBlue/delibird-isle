script ParcelDelibirdSummit_T_Eskil {
    trainerbattle_single(TRAINER_SKALD_SUM_ESKIL,
        format("ESKIL: Hush. The DELIBIRD nest on the far side of the stakes. Fewer every year.\pIf you must make noise, make it a battle."),
        format("ESKIL: Loud enough."),
        ParcelDelibirdSummit_T_Eskil_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUM_ESKIL_R2)) {
        goto(ParcelDelibirdSummit_T_Eskil_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUM_ESKIL_R3)) {
        goto(ParcelDelibirdSummit_T_Eskil_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUM_ESKIL_R4)) {
        goto(ParcelDelibirdSummit_T_Eskil_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUM_ESKIL_R5)) {
        goto(ParcelDelibirdSummit_T_Eskil_R5)
    }
    msgbox(format("ESKIL: They cache food in the snow for the hard months. There's less snow to cache in, so they're learning the rocks.\pClever birds. Cleverer than us, maybe. We're still caching in the snow."), MSGBOX_DEFAULT)
    end
}
