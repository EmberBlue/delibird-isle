        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_TORVALD_R2, format("TORVALD: That's the one I wanted to see."))
    msgbox(format("TORVALD: That's two to you. Get the next stamp and come back."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Torvald_R3 {
    lock
    faceplayer
    msgbox(format("TORVALD: I've been training against the lake. You're the test. Yes?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TORVALD: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_TORVALD_R3, format("TORVALD: …Fair."))
    msgbox(format("TORVALD: Three. I'll be stronger when the coast's done with you."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Torvald_R4 {
    lock
    faceplayer
    msgbox(format("TORVALD: Nearly the top, they say. Not past me. Again?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TORVALD: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_TORVALD_R4, format("TORVALD: …Again, then. Later."))
    msgbox(format("TORVALD: When it's all filed, come and find me. Once more."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelDelibirdSummit_T_Torvald_R5 {
    lock
    faceplayer
    msgbox(format("TORVALD: They read your name at the hearing. I'd like to read it myself. Battle?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 0) {
        msgbox(format("TORVALD: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_TORVALD_R5, format("TORVALD: Noted. Properly, this time."))
    msgbox(format("TORVALD: Five. Write that one down too. I'll know you did."), MSGBOX_DEFAULT)
    release
    end
}

script ParcelDelibirdSummit_Sledge {
    if (flag(FLAG_SKALD_Q_SLEDGE) && !flag(FLAG_SKALD_Q_SLEDGE_FOUND)) {
        msgbox(format("A child's sledge wedged in the fork of the leaning tree, runners up, out of the wet. The tree has leaned further since it was put there; the sledge is nearly level now.\pYou work it loose. It is lighter than it looks. A name is burned into the slat: KARI."), MSGBOX_SIGN)
        setflag(FLAG_SKALD_Q_SLEDGE_FOUND)
        end
    }
    msgbox(format("A leaning tree with something wedged in its fork, out of the wet. A child's sledge, by the runners."), MSGBOX_SIGN)
    end
}

// --- route life (2026-11-10): the pairs ---

script ParcelDelibirdSummit_PairStakes {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("CADET LIV: Thirteen patches. ILEX counted them from the cliffs."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Thirteen's a number for a sledge run. Not a snowfield."), MSGBOX_DEFAULT)
        msgbox(format("CADET LIV: It's in the record now. Against the regime's books."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Then it's thirteen for good. Even when it's nine. Even when it's none. Somebody wrote thirteen and the year."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("OLD WOMAN: The ranger carried tea to INGRID up here and wrote the stakes on the way. Both. In the same hour."), MSGBOX_DEFAULT)
        msgbox(format("CADET LIV: That's the round and the survey."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: That's the island. Giving and counting in the same hour. Nobody off the ferry ever managed both before."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("CADET LIV: Zero on the gauge. Third winter running."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: Zero on the gauge means snow to the top of the gauge, when I was a girl. They've turned the numbers over."), MSGBOX_DEFAULT)
        msgbox(format("CADET LIV: Zero means no snow now."), MSGBOX_DEFAULT)
        msgbox(format("OLD WOMAN: I know what it means. I'm telling you what it meant."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards (2026-11-10) ---

script ParcelDelibirdSummit_Board1 {
    msgbox(format("A SURVEY BOARD at the summit path, iced over. SNOWY SUMMIT. Snow patches that last the year: 31 when the board was made, 13 now, each marked on the board's map with a nail.\pThe SNORUNT live in them and move when they move. There is no higher ground. The board does not say what happens then. It does not need to."), MSGBOX_SIGN)
    end
}

script ParcelDelibirdSummit_Board2 {
    msgbox(format("A SURVEY BOARD on the cairn. The cairn is older than the Survey and taller every year; the islanders add a stone when they reach it.\pThe board asks that you add one, count the SWINUB tracks on the way up, and write the count in the tin. The tin is full of slips. The numbers get smaller as the stack gets taller."), MSGBOX_SIGN)
    end
}

// --- town life (2026-11-10): the pairs, round four ---

script ParcelDelibirdSummit_PairCairn {
    lock
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("YOUNG MAN: Twelve patches. Down one."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: The board says thirteen."), MSGBOX_DEFAULT)
        msgbox(format("YOUNG MAN: The board's a year old. The cairn's a stone taller. Both of those are true. Add yours."), MSGBOX_DEFAULT)
    } elif (flag(FLAG_SKALDMERE_DELIBIRD_GIFT)) {
        msgbox(format("GIRL: The ranger wrote the SNORUNT. All of them. In the patches."), MSGBOX_DEFAULT)
        msgbox(format("YOUNG MAN: How many?"), MSGBOX_DEFAULT)
        msgbox(format("GIRL: She wouldn't say. She said the number belongs to the island first."), MSGBOX_DEFAULT)
        msgbox(format("YOUNG MAN: Then it'll be in the hall by the festival. That's fair."), MSGBOX_DEFAULT)
    } else {
        msgbox(format("YOUNG MAN: Thirteen patches. The board at the path says thirteen."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: There were more when Gran came up. She said the snow never left the top."), MSGBOX_DEFAULT)
        msgbox(format("YOUNG MAN: It leaves. It just comes back less."), MSGBOX_DEFAULT)
        msgbox(format("GIRL: Then we should add a stone."), MSGBOX_DEFAULT)
        msgbox(format("YOUNG MAN: We always add a stone."), MSGBOX_DEFAULT)
    }
    release
    end
}

// --- survey boards, round two (2026-11-10) ---

script ParcelDelibirdSummit_Board3 {
    msgbox(format("A SURVEY BOARD at the last snow patch. PILOSWINE come up to the patches in the warm months to lie on the cold. The board counts the PILOSWINE on the patches, not the patches.\pWhen the patches go, the count will go with them, and the board says so, plainly, as the last line."), MSGBOX_SIGN)
    end
}

// --- survey boards, round five (2026-11-10) ---

script ParcelDelibirdSummit_Board10 {
    msgbox(format("A SURVEY BOARD by the upper cairn. STANTLER come up with the melt and go down with the first snow, and the board gives their coming and going by date. The two dates used to be a season apart. They are six weeks apart now.\pThe board does not say where the STANTLER spend the rest of the year. The Survey does not know."), MSGBOX_SIGN)
    end
}
