script ParcelDelibirdSummit_T_Torvald {
    trainerbattle_single(TRAINER_SKALD_SUM_TORVALD,
        format("TORVALD: The tarn's new. Three winters. INGRID says the ground under it was ice since before the island had a name.\pYou want the top, you come through me first."),
        format("TORVALD: Go on up, then."),
        ParcelDelibirdSummit_T_Torvald_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUM_TORVALD_R2)) {
        goto(ParcelDelibirdSummit_T_Torvald_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUM_TORVALD_R3)) {
        goto(ParcelDelibirdSummit_T_Torvald_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUM_TORVALD_R4)) {
        goto(ParcelDelibirdSummit_T_Torvald_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUM_TORVALD_R5)) {
        goto(ParcelDelibirdSummit_T_Torvald_R5)
    }
    msgbox(format("TORVALD: Look at the tarn and tell me you can see the bottom. You can.\pThat's the problem. There's no bottom to it that isn't us."), MSGBOX_DEFAULT)
    end
}
