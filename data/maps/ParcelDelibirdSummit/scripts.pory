script ParcelDelibirdSummit_T_Birgitta {
    trainerbattle_single(TRAINER_SKALD_SUM_BIRGITTA,
        format("BIRGITTA: I taught every child on this island to ski on this slope. Watch your step -- there is nothing to ski on.\pLet me see what you've learned instead."),
        format("BIRGITTA: Well taught, by someone."),
        ParcelDelibirdSummit_T_Birgitta_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUM_BIRGITTA_R2)) {
        goto(ParcelDelibirdSummit_T_Birgitta_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUM_BIRGITTA_R3)) {
        goto(ParcelDelibirdSummit_T_Birgitta_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUM_BIRGITTA_R4)) {
        goto(ParcelDelibirdSummit_T_Birgitta_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUM_BIRGITTA_R5)) {
        goto(ParcelDelibirdSummit_T_Birgitta_R5)
    }
    msgbox(format("BIRGITTA: The young ones will remember a green summit at Midwinter and think it normal.\pThat is the part I cannot forgive. Not the thaw. The forgetting."), MSGBOX_DEFAULT)
    end
}
