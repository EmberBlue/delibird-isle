        msgbox(format("TORVALD: Fine. Same spot."), MSGBOX_DEFAULT)
        release
        end
    }
    trainerbattle_no_intro(TRAINER_SKALD_SUM_TORVALD_R5, format("TORVALD: Noted. Properly, this time."))
    msgbox(format("TORVALD: Five. Write that one down too. I'll know you did."), MSGBOX_DEFAULT)
    release
    end
}
