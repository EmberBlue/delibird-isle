script ParcelDelibirdSummit_T_Liv {
    trainerbattle_single(TRAINER_SKALD_SUM_LIV,
        format("LIV: Cadet LIV, Skaldmere Survey, snow gauge detail. The gauge reads zero. It has read zero since I was posted.\pA battle would at least be a number."),
        format("LIV: That's a number."),
        ParcelDelibirdSummit_T_Liv_FirstWin)
    specialvar(VAR_RESULT, SkaldRematchTier)
    if (var(VAR_RESULT) >= 2 && !defeated(TRAINER_SKALD_SUM_LIV_R2)) {
        goto(ParcelDelibirdSummit_T_Liv_R2)
    }
    if (var(VAR_RESULT) >= 3 && !defeated(TRAINER_SKALD_SUM_LIV_R3)) {
        goto(ParcelDelibirdSummit_T_Liv_R3)
    }
    if (var(VAR_RESULT) >= 4 && !defeated(TRAINER_SKALD_SUM_LIV_R4)) {
        goto(ParcelDelibirdSummit_T_Liv_R4)
    }
    if (var(VAR_RESULT) >= 5 && !defeated(TRAINER_SKALD_SUM_LIV_R5)) {
        goto(ParcelDelibirdSummit_T_Liv_R5)
    }
    msgbox(format("LIV: ILEX says write the zero down anyway. A zero is data.\pNobody believes you until there are twenty of them in a row."), MSGBOX_DEFAULT)
    end
}
