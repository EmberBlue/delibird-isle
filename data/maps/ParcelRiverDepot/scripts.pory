// ParcelRiverDepot -- the Foundation produce depot (the Day Care building).
// Buys at the Foundation's number. Sells the sacks with the crest.
mapscripts ParcelRiverDepot_MapScripts {
}
script ParcelRiverDepot_Buyer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("BUYER: Produce by weight, same day, no haggling. The review put a floor under the price. I pay the floor. Head office hates the floor. I don't mind it. It's a floor."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("BUYER: Credit's extended to next season for everyone, no questions. The FOUNDATION's being generous. The FOUNDATION's always generous the season after a hard one.\pFertiliser's on the pallet. The HAUKFELL grant forms are on the counter. Both good offers."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("BUYER: Produce by weight, paid same day, no haggling, no questions. That's the FOUNDATION offer. It's a good offer. Ask anyone who's taken it.\pFertiliser's on the pallet. Credit available against next season. Everyone takes the credit."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverDepot_Farmer {
    lock
    faceplayer
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("FARMER: The depot's every day and now it pays the floor. The market pays more again. I split between them. Having a choice is the thing. I'd forgotten the thing."), MSGBOX_DEFAULT)
        release
        end
    }
    if (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("FARMER: Sold to the depot again. The market's one day a week, and the hill people are coming down to it with nothing to sell and no money to buy.\pI gave a sack away last week. First time. Felt like something. Don't know what."), MSGBOX_DEFAULT)
        release
        end
    }
    msgbox(format("FARMER: I sell here because the market pays less and the market's one day a week. The depot's every day. That's all. That's the whole reason. It's enough."), MSGBOX_DEFAULT)
    release
    end
}
script ParcelRiverDepot_Board {
    msgbox(format("PRICES, POSTED. Trout: by weight, Foundation rate. Greens: Foundation rate. Eggs: Foundation rate.\pFERTILISER, FOUNDATION BLEND: credit terms available. The crest on the poster is the crest on the Board's notice."), MSGBOX_SIGN)
    end
}
