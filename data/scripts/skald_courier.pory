// The Skaldmere Courier, pinned by the Center door: this week's front page, by story state.
// INGER's paper (section 04). One script, every Center; the board is a bg event at (4,1).
script Skald_EventScript_Courier {
    if (flag(FLAG_SKALDMERE_FINALE_DONE)) {
        msgbox(format("THE SKALDMERE COURIER. Above the fold, under INGER's name: ITEM SEVEN TOOK THE AFTERNOON.\pA ranger's survey, the Survey's thirty-one years of baselines and a statement read for Dr. Heron in her absence were entered in full at Tuesday's sitting. The Foundation's recovery model was withdrawn before the vote. Dredging consent suspended pending review; the Permafrost licence deferred; the keystone marsh referred for listing.\pBelow the fold, the Commissioner's reply, two paragraphs, headlined DEVELOPMENT THAT LISTENS. The quotation marks around LISTENS are the paper's."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_COASTAL_CERT)) {
        msgbox(format("THE SKALDMERE COURIER. FORTY JOBS: QUAY EXPANSION APPROVED IN PRINCIPLE. The Commissioner, photographed beside the model: six berths, a cold store, a turbine where the union hall stands.\pPage four, under INGER's name: THIRTY-ONE. A count of the jobs on the quay, by name, with a note that nine are described by the Foundation as in the pipeline. The paper has asked which pipeline. The question is printed. The answer is not."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_HIGHLAND_CERT)) {
        msgbox(format("THE SKALDMERE COURIER. HAUKFELL SLIDE A WEATHER EVENT, SAYS BOARD. Three fields in two years; the Highland Operations officer declines to comment on the exploratory bore.\pThe facing column: FOUNDATION OPENS WARMING CENTRE. A photograph of a ribbon. The two stories are separated by a rule and a date, two weeks apart. Nobody at the paper put them side by side. Everybody at the paper put them on the same page."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_WATERSHED_CERT)) {
        msgbox(format("THE SKALDMERE COURIER. ELVSUND RATEPAYERS ASK THE BOARD: WHICH YEAR? Forty-one signatures and a reply of one paragraph, printed in full because it is one paragraph.\pA photograph of the meeting from the back of the hall. A ranger is in it, writing. The caption does not name the ranger. The caption says: the record."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_WETLAND_CERT)) {
        msgbox(format("THE SKALDMERE COURIER. Page two: COMMISSIONER: NO EVIDENCE OF CONTAMINATION AT REEDMERE. Page four, under INGER's name: THE PIPE UNDER THE FALLS, and a photograph of a manifest, waterlogged, every line legible.\pThe front page is a ribbon-cutting. That is the ratio, this week and every week."), MSGBOX_SIGN)
    } elif (flag(FLAG_SKALDMERE_FOREST_CERT)) {
        msgbox(format("THE SKALDMERE COURIER. FIRST FOREST CERTIFICATION OUT OF SALTWICK IN NINE YEARS. A provisional from Johto, the hall confirms; the name is not given.\pBelow it, still: LAB ON THE FRONT CLEARED OVERNIGHT; POLICE SAY BURGLARY. The paper has used the word three weeks running and has started putting it in quotation marks."), MSGBOX_SIGN)
    } else {
        msgbox(format("THE SKALDMERE COURIER. LAB ON THE FRONT CLEARED OVERNIGHT. Police say burglary. The tenant, a regional ecologist, could not be reached. A Mereholt Logistics spokesman said the company had no comment and had not been asked for one.\pUnder it, smaller: FERRY TIMETABLE REDUCED FOR WINTER. Everything else on the page is weather."), MSGBOX_SIGN)
    }
    end
}
